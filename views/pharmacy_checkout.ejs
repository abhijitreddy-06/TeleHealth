<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeleHealth - Checkout</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root{--primary:#38bdf8;--primary-hover:#0ea5e9;--secondary:#10b981;--background:#f9fafb;--card-bg:#fff;--text-dark:#0f172a;--text-medium:#475569;--border:#e2e8f0;--error:#ef4444;--warning:#f59e0b;--success:#10b981;--transition:all .3s ease;--shadow:0 4px 6px -1px rgba(0,0,0,.1);--radius:12px}
        [data-theme="dark"]{--background:#1e293b;--card-bg:#334155;--text-dark:#f1f5f9;--text-medium:#cbd5e1;--border:#475569}
        *{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif}
        body{background:var(--background);color:var(--text-dark);min-height:100vh;display:flex;flex-direction:column;line-height:1.6}
        a{text-decoration:none!important;color:inherit}
        header{background:var(--card-bg);box-shadow:var(--shadow);position:sticky;top:0;z-index:100}
        .navbar{display:flex;justify-content:space-between;align-items:center;padding:1.2rem 5%;max-width:1400px;margin:0 auto}
        .logo{font-size:1.8rem;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:.5rem}
        .logo i{color:var(--secondary)}.logo-text{background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800}
        .nav-links{display:flex;gap:1rem;align-items:center}
        .nav-links a{color:var(--text-dark);font-weight:500;padding:.5rem .8rem;border-radius:8px;display:flex;align-items:center;gap:.5rem;transition:var(--transition)}
        .nav-links a:hover{color:var(--primary);background:rgba(56,189,248,.1)}
        .theme-toggle{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.2rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center}
        .profile-dropdown{position:relative}
        .profile-btn{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.3rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;transition:var(--transition)}
        .profile-btn:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .dropdown-menu{position:absolute;top:calc(100% + 4px);right:0;background:var(--card-bg);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);min-width:180px;padding:.5rem 0;display:none;z-index:200;border:1px solid var(--border)}
        .dropdown-menu.active{display:block}
        .dropdown-menu a{display:flex;align-items:center;gap:.8rem;padding:.7rem 1.2rem;font-size:.9rem;color:var(--text-dark);transition:var(--transition);border-radius:0}
        .dropdown-menu a:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .mobile-controls{display:none;align-items:center;gap:.5rem}
        .mobile-menu-btn{display:none;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%}
        .mobile-menu{position:fixed;top:0;right:-100%;width:280px;height:100vh;background:var(--card-bg);z-index:1000;padding:2rem;transition:var(--transition);box-shadow:-5px 0 15px rgba(0,0,0,.1);display:flex;flex-direction:column;gap:1.5rem}
        .mobile-menu.active{right:0}
        .close-menu{align-self:flex-end;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center}
        .mobile-menu a{display:flex;align-items:center;gap:1rem;padding:.8rem 1rem;border-radius:8px;color:var(--text-dark);transition:var(--transition)}
        .mobile-menu a:hover{color:var(--primary);background:rgba(56,189,248,.1)}

        .checkout-container{flex:1;max-width:1200px;margin:0 auto;padding:2rem 5%;width:100%}
        .checkout-header h1{font-size:2rem;background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:1.5rem}
        .checkout-layout{display:grid;grid-template-columns:1fr 380px;gap:2rem;align-items:start}
        .checkout-form{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:2rem}
        .checkout-form h2{font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem}
        .form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem}
        .form-group{display:flex;flex-direction:column;gap:.3rem}
        .form-group.full{grid-column:1/-1}
        .form-group label{font-size:.85rem;font-weight:500;color:var(--text-dark)}
        .form-group input,.form-group textarea{padding:.8rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-dark);font-size:.9rem;font-family:inherit;transition:var(--transition)}
        .form-group input:focus,.form-group textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(56,189,248,.15)}
        .form-group textarea{resize:vertical;height:80px}
        .form-group .error-msg{font-size:.75rem;color:var(--error);display:none}

        .order-summary{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:1.5rem;position:sticky;top:100px}
        .order-summary h2{font-size:1.1rem;margin-bottom:1rem;padding-bottom:.8rem;border-bottom:1px solid var(--border)}
        .summary-items{max-height:250px;overflow-y:auto;margin-bottom:1rem}
        .summary-item{display:flex;gap:.8rem;padding:.5rem 0;border-bottom:1px solid var(--border)}
        .summary-item:last-child{border-bottom:none}
        .summary-item img{width:50px;height:50px;border-radius:6px;object-fit:cover}
        .summary-item-info{flex:1;font-size:.85rem}
        .summary-item-info .name{font-weight:500;margin-bottom:.1rem}
        .summary-item-info .qty{color:var(--text-medium)}
        .summary-item .item-total{font-weight:600;white-space:nowrap}
        .summary-row{display:flex;justify-content:space-between;margin-bottom:.5rem;font-size:.9rem}
        .summary-row.total{font-size:1.1rem;font-weight:700;margin-top:.8rem;padding-top:.8rem;border-top:2px solid var(--border)}
        .summary-row.total .amt{color:var(--secondary)}
        .payment-info{background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);border-radius:8px;padding:1rem;margin:1rem 0;display:flex;align-items:center;gap:.8rem;font-size:.85rem}
        .payment-info i{color:var(--success);font-size:1.2rem}
        .btn{display:block;width:100%;padding:.9rem;border-radius:8px;font-weight:600;cursor:pointer;transition:var(--transition);border:none;font-size:1rem;text-align:center}
        .btn-success{background:var(--secondary);color:#fff}
        .btn-success:hover{background:#059669;transform:translateY(-2px);box-shadow:0 4px 12px rgba(16,185,129,.3)}
        .btn-success:disabled{opacity:.6;cursor:not-allowed;transform:none}
        .btn-outline{background:transparent;border:2px solid var(--border);color:var(--text-dark);margin-top:.5rem}
        .btn-outline:hover{border-color:var(--primary);color:var(--primary)}

        .success-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:9999}
        .success-overlay.active{display:flex}
        .success-box{background:var(--card-bg);border-radius:var(--radius);padding:2.5rem;text-align:center;max-width:400px;width:90%;animation:popIn .3s ease}
        .success-box i{font-size:3rem;color:var(--success);margin-bottom:1rem}
        .success-box h2{margin-bottom:.5rem}
        .success-box p{color:var(--text-medium);margin-bottom:1.5rem}
        @keyframes popIn{from{transform:scale(.8);opacity:0}to{transform:scale(1);opacity:1}}

        .toast-container{position:fixed;top:80px;right:20px;z-index:9999}
        .toast{background:var(--card-bg);border-radius:8px;padding:1rem 1.5rem;box-shadow:0 8px 24px rgba(0,0,0,.15);display:flex;align-items:center;gap:.8rem;margin-bottom:.5rem;animation:slideIn .3s ease;border-left:4px solid var(--success)}
        .toast.error{border-left-color:var(--error)}
        @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

        .simple-footer{all:unset;display:block;background:var(--card-bg);border-top:1px solid var(--border);padding:.6rem 5%;margin-top:auto}
        .simple-footer .footer-content{all:unset;max-width:1400px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;align-items:center}
        .simple-footer .footer-left{display:flex;align-items:center}
        .simple-footer .footer-logo{display:flex;align-items:center;gap:.5rem;color:var(--primary);font-weight:600}
        .simple-footer .footer-logo i{color:var(--secondary);font-size:1.2rem}
        .simple-footer .footer-center{text-align:center}
        .simple-footer .copyright{color:var(--text-dark);font-size:.9rem}
        .simple-footer .footer-name{color:var(--text-dark);font-weight:600}
        .simple-footer .footer-right{display:flex;gap:1rem;justify-content:flex-end}
        .simple-footer .footer-socials a{color:var(--text-dark);font-size:1.4rem}

        @media(max-width:768px){.nav-links{display:none}.mobile-controls{display:flex}.mobile-menu-btn{display:flex}.checkout-layout{grid-template-columns:1fr}.order-summary{position:static}.form-row{grid-template-columns:1fr}.simple-footer .footer-content{display:flex;flex-direction:column;gap:.3rem}}
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <a href="/user_home" class="logo"><i class="fas fa-heartbeat"></i><span class="logo-text">TeleHealth</span></a>
            <div class="nav-links">
                <a href="/user_home"><i class="fas fa-home"></i> Home</a>
                <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
                <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
                <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
                <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
                <a href="/records"><i class="fas fa-folder"></i> My Records</a>
                <div class="profile-dropdown">
                    <button class="profile-btn" id="profileBtn"><i class="fas fa-user-circle"></i></button>
                    <div class="dropdown-menu" id="profileDropdown">
                        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
                        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
                    </div>
                </div>
                <button class="theme-toggle" id="themeToggle"><i class="fas fa-moon"></i></button>
            </div>
            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle"><i class="fas fa-moon"></i></button>
                <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="fas fa-bars"></i></button>
            </div>
        </nav>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu"><i class="fas fa-times"></i></button>
        <a href="/user_home"><i class="fas fa-home"></i> Home</a>
        <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
        <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
        <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
        <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
        <a href="/records"><i class="fas fa-folder"></i> My Records</a>
        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <div class="success-overlay" id="successOverlay">
        <div class="success-box">
            <i class="fas fa-check-circle"></i>
            <h2>Order Placed!</h2>
            <p>Your order has been placed successfully. You will receive a confirmation soon.</p>
            <p id="orderNumber" style="font-weight:700;color:var(--primary);margin-bottom:1rem"></p>
            <a href="/pharmacy/orders" class="btn btn-success" style="display:inline-block;width:auto;padding:.8rem 2rem">View My Orders</a>
        </div>
    </div>

    <main class="checkout-container">
        <div class="checkout-header">
            <h1><i class="fas fa-lock"></i> Checkout</h1>
        </div>

        <div class="checkout-layout">
            <div class="checkout-form">
                <h2><i class="fas fa-shipping-fast"></i> Shipping Address</h2>
                <form id="checkoutForm" onsubmit="placeOrder(event)">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Full Name *</label>
                            <input type="text" id="shippingName" required minlength="2" maxlength="200" placeholder="Enter full name">
                        </div>
                        <div class="form-group">
                            <label>Phone Number *</label>
                            <input type="tel" id="shippingPhone" required minlength="10" maxlength="15" placeholder="Enter phone number">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full">
                            <label>Address *</label>
                            <textarea id="shippingAddress" required minlength="5" maxlength="500" placeholder="House/Flat No, Street, Landmark"></textarea>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>City *</label>
                            <input type="text" id="shippingCity" required minlength="2" maxlength="100" placeholder="City">
                        </div>
                        <div class="form-group">
                            <label>State *</label>
                            <input type="text" id="shippingState" required minlength="2" maxlength="100" placeholder="State">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Pincode *</label>
                            <input type="text" id="shippingPincode" required minlength="4" maxlength="10" placeholder="Pincode">
                        </div>
                        <div class="form-group">
                            <label>Notes (optional)</label>
                            <input type="text" id="shippingNotes" maxlength="500" placeholder="Delivery instructions">
                        </div>
                    </div>

                    <div class="payment-info">
                        <i class="fas fa-money-bill-wave"></i>
                        <div>
                            <strong>Cash on Delivery (COD)</strong>
                            <p style="margin:0;color:var(--text-medium);font-size:.8rem">Pay when your order arrives at your doorstep</p>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success" id="placeOrderBtn">
                        <i class="fas fa-check-circle"></i> Place Order (COD) - Rs.<%= (subtotal + shippingFee).toFixed(0) %>
                    </button>
                    <a href="/pharmacy/cart" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back to Cart</a>
                </form>
            </div>

            <div class="order-summary">
                <h2>Order Summary (<%= items.length %> items)</h2>
                <div class="summary-items">
                    <% items.forEach(item => { %>
                    <div class="summary-item">
                        <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400' %>" alt="<%= item.name %>" onerror="this.src='https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400'">
                        <div class="summary-item-info">
                            <div class="name"><%= item.name %></div>
                            <div class="qty">Qty: <%= item.quantity %> x Rs.<%= parseFloat(item.price).toFixed(0) %></div>
                        </div>
                        <span class="item-total">Rs.<%= (parseFloat(item.price) * item.quantity).toFixed(0) %></span>
                    </div>
                    <% }); %>
                </div>
                <div class="summary-row"><span>Subtotal</span><span>Rs.<%= subtotal.toFixed(0) %></span></div>
                <div class="summary-row"><span>Shipping</span><span><%= shippingFee === 0 ? 'FREE' : 'Rs.' + shippingFee %></span></div>
                <div class="summary-row total"><span>Total</span><span class="amt">Rs.<%= (subtotal + shippingFee).toFixed(0) %></span></div>
            </div>
        </div>
    </main>

    <footer class="simple-footer">
        <div class="footer-content">
            <div class="footer-left"><a href="/user_home" class="footer-logo"><i class="fas fa-heartbeat"></i><span>TeleHealth</span></a></div>
            <div class="footer-center"><span class="copyright">&copy; 2026 Built by <a href="https://abhijitreddy-portfolio.netlify.app/" target="_blank" class="footer-name">Abhijit Reddy</a>.</span></div>
            <div class="footer-right footer-socials">
                <a href="https://www.linkedin.com/in/abhijitreddy75" target="_blank"><i class="fab fa-linkedin"></i></a>
                <a href="https://github.com/abhijitreddy-06" target="_blank"><i class="fab fa-github"></i></a>
            </div>
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const html=document.documentElement;const saved=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');html.setAttribute('data-theme',saved);
        const tt=document.getElementById('themeToggle'),mtt=document.getElementById('mobileThemeToggle');
        function ui(t){const i=t==='dark'?'fa-sun':'fa-moon';tt.innerHTML='<i class="fas '+i+'"></i>';mtt.innerHTML='<i class="fas '+i+'"></i>';}ui(saved);
        tt.addEventListener('click',()=>{const t=html.getAttribute('data-theme')==='dark'?'light':'dark';html.setAttribute('data-theme',t);localStorage.setItem('theme',t);ui(t);});
        mtt.addEventListener('click',()=>{const t=html.getAttribute('data-theme')==='dark'?'light':'dark';html.setAttribute('data-theme',t);localStorage.setItem('theme',t);ui(t);});

        // Mobile Menu
        const mm=document.getElementById('mobileMenu');
        document.getElementById('mobileMenuBtn').addEventListener('click',e=>{e.stopPropagation();mm.classList.add('active');document.body.style.overflow='hidden';});
        document.getElementById('closeMenu').addEventListener('click',()=>{mm.classList.remove('active');document.body.style.overflow='';});

        // Profile Dropdown
        const profileBtn = document.getElementById('profileBtn');
        const profileDropdown = document.getElementById('profileDropdown');
        if (profileBtn) {
            profileBtn.addEventListener('click', function(e) { e.stopPropagation(); profileDropdown.classList.toggle('active'); });
            document.addEventListener('click', function(e) { if (!profileDropdown.contains(e.target) && e.target !== profileBtn) profileDropdown.classList.remove('active'); });
        }
    });

    async function placeOrder(e) {
        e.preventDefault();
        const btn = document.getElementById('placeOrderBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order...';

        const body = {
            name: document.getElementById('shippingName').value.trim(),
            phone: document.getElementById('shippingPhone').value.trim(),
            address: document.getElementById('shippingAddress').value.trim(),
            city: document.getElementById('shippingCity').value.trim(),
            state: document.getElementById('shippingState').value.trim(),
            pincode: document.getElementById('shippingPincode').value.trim(),
            notes: document.getElementById('shippingNotes').value.trim()
        };

        try {
            const res = await fetch('/api/pharmacy/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed to place order');

            document.getElementById('orderNumber').textContent = 'Order #' + data.order.order_number;
            document.getElementById('successOverlay').classList.add('active');
        } catch (err) {
            showToast(err.message, true);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check-circle"></i> Place Order (COD)';
        }
    }

    function showToast(msg, isError) {
        const c = document.getElementById('toastContainer');
        const t = document.createElement('div');
        t.className = 'toast' + (isError ? ' error' : '');
        t.innerHTML = '<i class="fas ' + (isError ? 'fa-exclamation-circle' : 'fa-check-circle') + '" style="color:' + (isError ? 'var(--error)' : 'var(--success)') + '"></i><span style="font-size:.9rem;font-weight:500">' + msg + '</span>';
        c.appendChild(t);
        setTimeout(() => t.remove(), 4000);
    }
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>
</html>
