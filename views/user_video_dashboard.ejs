<script src="/js/shared.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script defer>
        document.addEventListener('DOMContentLoaded', function () {
        const downloadBtn = document.getElementById('downloadMissedPrescription');
        const errorMsg = document.getElementById('prescriptionError');
        const successMsg = document.getElementById('prescriptionSuccess');

        downloadBtn.addEventListener('click', async () => {
            downloadBtn.disabled = true;
            downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking...';
            errorMsg.style.display = 'none';
            successMsg.style.display = 'none';

            try {
                const response = await fetch('/api/appointments/recent-prescription');

                if (!response.ok) {
                    const data = await response.json();
                    throw new Error(data.error || 'No recent prescription found');
                }

                const data = await response.json();

                downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Downloading...';

                const pdfResponse = await fetch(`/api/prescription/download/${data.roomId}`);

                if (!pdfResponse.ok) {
                    throw new Error('Failed to download prescription');
                }

                const blob = await pdfResponse.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Prescription_${data.roomId}.pdf`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);

                successMsg.textContent = 'Prescription downloaded successfully!';
                successMsg.style.display = 'block';

            } catch (error) {
                errorMsg.textContent = error.message || 'No recent prescription available to download.';
                errorMsg.style.display = 'block';
            } finally {
                downloadBtn.disabled = false;
                downloadBtn.innerHTML = '<i class="fas fa-download"></i> Download Recent Prescription';
            }
        });

        // Cancel Appointment
        const cancelBtn = document.getElementById('cancelAppointmentBtn');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', () => {
                const appointmentId = cancelBtn.dataset.appointmentId;
                showCancelModal(appointmentId);
            });
        }

        function showCancelModal(appointmentId) {
            const existingModal = document.getElementById('cancelModal');
            if (existingModal) existingModal.remove();

            const modal = document.createElement('div');
            modal.id = 'cancelModal';
            modal.className = 'modal-overlay active';
            modal.innerHTML = `
                <div class="modal" style="max-width: 450px;">
                    <div class="modal-header">
                        <h2><i class="fas fa-calendar-times" style="color: var(--error)"></i> Cancel Appointment</h2>
                        <button class="modal-close" onclick="closeCancelModal()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p style="margin-bottom: 1rem;">Are you sure you want to cancel this appointment?</p>
                        <div class="form-group">
                            <label for="cancelReason"><i class="fas fa-comment-alt"></i> Reason (optional)</label>
                            <textarea id="cancelReason" class="form-control" rows="3" placeholder="Please provide a reason for cancellation..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" onclick="closeCancelModal()">Keep Appointment</button>
                        <button class="btn btn-danger" id="confirmCancelBtn">Cancel Appointment</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            document.body.style.overflow = 'hidden';

            document.getElementById('confirmCancelBtn').addEventListener('click', () => {
                const reason = document.getElementById('cancelReason').value;
                cancelAppointment(appointmentId, reason);
            });
        }

        window.closeCancelModal = function () {
            const modal = document.getElementById('cancelModal');
            if (modal) {
                modal.remove();
                document.body.style.overflow = '';
            }
        }

        async function cancelAppointment(appointmentId, reason) {
            const confirmBtn = document.getElementById('confirmCancelBtn');
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';

            try {
                const response = await fetch(`/api/appointments/${appointmentId}/cancel`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ reason })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    closeCancelModal();
                    Toast.success('Your appointment has been cancelled.', 'Appointment Cancelled');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    Toast.error(result.error || 'Failed to cancel appointment');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = 'Cancel Appointment';
                }
            } catch (error) {
                console.error('Cancel error:', error);
                Toast.error('Unable to cancel appointment. Please try again.');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = 'Cancel Appointment';
            }
        }

        // --- Real-time Dashboard via Socket.IO /dashboard namespace ---
        let dashboardSocket = null;
        let fallbackTimer = null;

        function initDashboardSocket() {
            try {
                dashboardSocket = io('/dashboard', {
                    reconnection: true,
                    reconnectionAttempts: 5,
                    reconnectionDelay: 2000,
                    timeout: 15000
                });

                dashboardSocket.on('connect', () => {
                    console.log('Dashboard socket connected:', dashboardSocket.id);
                    if (fallbackTimer) {
                        clearTimeout(fallbackTimer);
                        fallbackTimer = null;
                    }
                });

                dashboardSocket.on('appointment-updated', (data) => {
                    console.log('Appointment updated:', data);
                    handleAppointmentUpdate(data);
                });

                dashboardSocket.on('connect_error', (error) => {
                    console.error('Dashboard socket error:', error);
                    startFallbackReload();
                });

                dashboardSocket.on('disconnect', (reason) => {
                    console.log('Dashboard socket disconnected:', reason);
                    if (reason !== 'io client disconnect') {
                        startFallbackReload();
                    }
                });

                // Fallback: if socket doesn't connect within 15s, use polling
                fallbackTimer = setTimeout(() => {
                    if (!dashboardSocket || !dashboardSocket.connected) {
                        console.log('Dashboard socket fallback: using polling');
                        startFallbackReload();
                    }
                }, 15000);

            } catch (error) {
                console.error('Failed to initialize dashboard socket:', error);
                startFallbackReload();
            }
        }

        function handleAppointmentUpdate(data) {
            const statusText = document.getElementById('statusText');
            const joinBtn = document.getElementById('joinBtn');

            if (data.status === 'started' && data.roomId) {
                // Doctor started the call - update UI in-place
                if (statusText) {
                    statusText.innerHTML = '<i class="fas fa-check-circle"></i> Doctor has started the call';
                    statusText.className = 'status ready';
                }

                // Replace disabled button with active join link
                if (joinBtn) {
                    const joinLink = document.createElement('a');
                    joinLink.href = `/user_video/${data.roomId}`;
                    joinLink.className = 'btn btn-primary btn-full';
                    joinLink.style.cssText = 'text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem;';
                    joinLink.innerHTML = '<i class="fas fa-video"></i> Join Video Call';
                    joinBtn.parentNode.replaceChild(joinLink, joinBtn);

                    // Remove cancel button if present
                    const cancelBtn = document.getElementById('cancelAppointmentBtn');
                    if (cancelBtn) cancelBtn.remove();
                }

                // Show toast notification
                if (typeof Toast !== 'undefined' && Toast.success) {
                    Toast.success('Your doctor has started the video call!', 'Call Ready');
                }
            } else if (data.status === 'cancelled') {
                // Appointment cancelled by doctor - update UI
                if (statusText) {
                    statusText.innerHTML = '<i class="fas fa-times-circle"></i> Appointment has been cancelled by the doctor';
                    statusText.className = 'status cancelled';
                    statusText.style.color = 'var(--error)';
                }

                // Remove join and cancel buttons
                if (joinBtn) joinBtn.remove();
                const cancelBtn = document.getElementById('cancelAppointmentBtn');
                if (cancelBtn) cancelBtn.remove();

                if (typeof Toast !== 'undefined' && Toast.error) {
                    Toast.error('Your appointment has been cancelled by the doctor.', 'Cancelled');
                }

                // Reload after brief delay to show updated state
                setTimeout(() => window.location.reload(), 3000);
            } else if (data.status === 'completed') {
                // Appointment completed - reload to show updated state
                window.location.reload();
            }
        }

        function startFallbackReload() {
            // Fallback to page reload every 15s if socket fails
            if (!window._fallbackInterval) {
                window._fallbackInterval = setInterval(() => {
                    window.location.reload();
                }, 15000);
            }
        }

        initDashboardSocket();
    });
</script>
<script>window.history.replaceState(null, document.title, window.location.href);</script>


</body>

