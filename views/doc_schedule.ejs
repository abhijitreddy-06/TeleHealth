                    </div>

                    <div class="schedule-day-row" data-day="1">
                        <span class="day-name">Monday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
                    </div>

                    <div class="schedule-day-row" data-day="2">
                        <span class="day-name">Tuesday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
                    </div>

                    <div class="schedule-day-row" data-day="3">
                        <span class="day-name">Wednesday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
                    </div>

                    <div class="schedule-day-row" data-day="4">
                        <span class="day-name">Thursday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
                    </div>

                    <div class="schedule-day-row" data-day="5">
                        <span class="day-name">Friday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
                    </div>

                    <div class="schedule-day-row" data-day="6">
                        <span class="day-name">Saturday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
                        <div class="time-inputs">
                            <input type="time" class="start-time" value="09:00" disabled />
                            <span class="time-separator">to</span>
                            <input type="time" class="end-time" value="17:00" disabled />
                        </div>
