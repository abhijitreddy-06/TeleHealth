                </div>

                <div class="save-schedule-wrapper">
                    <button class="btn btn-success" id="saveScheduleBtn" onclick="saveSchedule()">
                        <i class="fas fa-save"></i> Save Schedule
                    </button>
                </div>
            </div>

            <!-- ── Schedule Overrides Card ── -->
            <div class="card">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fas fa-calendar-times"></i>
                    </div>
                    <h2>Schedule Overrides</h2>
                </div>

                <div class="override-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="overrideDate"><i class="fas fa-calendar-day"></i> Date</label>
                            <input type="date" id="overrideDate" />
                        </div>
                        <div class="form-group">
                            <label for="overrideType"><i class="fas fa-tag"></i> Type</label>
                            <select id="overrideType">
                                <option value="unavailable">Unavailable</option>
                                <option value="custom">Custom Hours</option>
                            </select>
                        </div>
                    </div>

                    <div class="override-time-fields hidden" id="overrideTimeFields">
                        <div class="form-group">
                            <label for="overrideStart"><i class="fas fa-clock"></i> Start Time</label>
                            <input type="time" id="overrideStart" value="09:00" />
                        </div>
                        <div class="form-group">
                            <label for="overrideEnd"><i class="fas fa-clock"></i> End Time</label>
                            <input type="time" id="overrideEnd" value="17:00" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="overrideReason"><i class="fas fa-comment-alt"></i> Reason</label>
                        <textarea id="overrideReason" rows="2" placeholder="e.g. Public holiday, personal leave..."></textarea>
                    </div>

                    <div>
                        <button class="btn btn-primary" id="addOverrideBtn" onclick="addOverride()">
                            <i class="fas fa-plus"></i> Add Override
                        </button>
                    </div>
                </div>

                <div class="overrides-list" id="overridesList">
                    <div class="no-overrides">
                        <i class="fas fa-calendar-check"></i>
                        <p>No schedule overrides set</p>
