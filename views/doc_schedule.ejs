<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Schedule Management | TeleHealth</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/shared.css" />

    <style>
        :root {
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --success: #22c55e;
            --muted: #94a3b8;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;

            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
        }

        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        /* ── Header / Navbar ── */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* ── Mobile Controls ── */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* ── Main Content ── */
        main {
            flex: 1;
            padding: 3rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--text-dark);
        }

        .page-header p {
            color: var(--text-medium);
            max-width: 700px;
            margin: 0 auto;
            font-size: 1.1rem;
        }

        .schedule-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        /* ── Cards ── */
        .card {
            background-color: var(--card-bg);
            padding: 2.5rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .card-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.3rem;
        }

        .card-header h2 {
            font-size: 1.5rem;
            color: var(--text-dark);
        }

        /* ── Weekly Schedule ── */
        .schedule-day-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--border);
            transition: var(--transition);
        }

        .schedule-day-row:last-of-type {
            border-bottom: none;
        }

        .schedule-day-row:hover {
            background-color: rgba(56, 189, 248, 0.04);
        }

        .day-name {
            min-width: 100px;
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.95rem;
        }

        /* Toggle switch */
        .toggle-switch {
            position: relative;
            width: 48px;
            height: 26px;
            flex-shrink: 0;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--border);
            transition: var(--transition);
            border-radius: 26px;
        }

        .toggle-slider::before {
            content: "";
            position: absolute;
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: var(--transition);
            border-radius: 50%;
        }

        .toggle-switch input:checked + .toggle-slider {
            background-color: var(--secondary);
        }

        .toggle-switch input:checked + .toggle-slider::before {
            transform: translateX(22px);
        }

        .time-inputs {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
        }

        .time-inputs input[type="time"] {
            padding: 0.5rem 0.7rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background-color: var(--card-bg);
            color: var(--text-dark);
            font-family: "Poppins", sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
            width: 130px;
        }

        .time-inputs input[type="time"]:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        .time-inputs input[type="time"]:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .time-separator {
            color: var(--text-medium);
            font-weight: 500;
        }

        /* ── Buttons ── */
        .btn {
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(56, 189, 248, 0.3);
        }

        .btn-primary:disabled {
            background-color: var(--disabled);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-success {
            background-color: var(--success);
            color: white;
        }

        .btn-success:hover:not(:disabled) {
            background-color: #16a34a;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(34, 197, 94, 0.3);
        }

        .btn-danger {
            background-color: var(--error);
            color: white;
        }

        .btn-danger:hover:not(:disabled) {
            background-color: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(239, 68, 68, 0.3);
        }

        .btn-danger-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
            background-color: var(--error);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-weight: 500;
        }

        .btn-danger-sm:hover {
            background-color: #dc2626;
        }

        .save-schedule-wrapper {
            margin-top: 1.5rem;
            display: flex;
            justify-content: flex-end;
        }

        /* ── Override Form ── */
        .override-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .form-row {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            flex: 1;
            min-width: 140px;
        }

        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-medium);
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 0.6rem 0.8rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background-color: var(--card-bg);
            color: var(--text-dark);
            font-family: "Poppins", sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 60px;
        }

        .override-time-fields {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .override-time-fields.hidden {
            display: none;
        }

        /* ── Override List ── */
        .overrides-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-height: 340px;
            overflow-y: auto;
            padding-right: 0.5rem;
        }

        .overrides-list::-webkit-scrollbar {
            width: 6px;
        }

        .overrides-list::-webkit-scrollbar-track {
            background: var(--border);
            border-radius: 3px;
        }

        .overrides-list::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 3px;
        }

        .override-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem;
            background-color: var(--background);
            border-radius: 8px;
            border-left: 4px solid var(--warning);
            transition: var(--transition);
            gap: 1rem;
        }

        .override-item:hover {
            background-color: var(--border);
        }

        .override-item.unavailable {
            border-left-color: var(--error);
        }

        .override-item.custom {
            border-left-color: var(--info);
        }

        .override-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            flex: 1;
        }

        .override-date {
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .override-detail {
            font-size: 0.85rem;
            color: var(--text-medium);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .override-type-badge {
            padding: 0.2rem 0.6rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .override-type-badge.unavailable {
            background-color: rgba(239, 68, 68, 0.15);
            color: var(--error);
        }

        .override-type-badge.custom {
            background-color: rgba(96, 165, 250, 0.15);
            color: var(--info);
        }

        .no-overrides {
            text-align: center;
            padding: 2rem;
            color: var(--text-medium);
        }

        .no-overrides i {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
            opacity: 0.5;
            display: block;
        }

        /* ── Footer ── */
        .simple-footer {
            all: unset;
            display: block;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            padding: 0.6rem 5%;
            margin-top: auto;
        }

        .simple-footer .footer-content {
            all: unset;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
        }

        .simple-footer .footer-left {
            display: flex;
            align-items: center;
        }

        .simple-footer .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .simple-footer .footer-logo i {
            color: var(--secondary);
            font-size: 1.2rem;
        }

        .simple-footer .footer-center {
            text-align: center;
        }

        .simple-footer .copyright {
            color: var(--text-dark);
            font-size: 0.9rem;
            white-space: nowrap;
        }

        .simple-footer .footer-name {
            color: var(--text-dark);
            font-weight: 600;
            text-decoration: none;
        }

        .simple-footer .footer-name:hover {
            text-decoration: underline;
        }

        .simple-footer .footer-right {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
        }

        .simple-footer .footer-socials a {
            color: var(--text-dark);
            font-size: 1.4rem;
            text-decoration: none;
        }

        .simple-footer .footer-socials a:hover {
            opacity: 0.7;
        }

        /* ── Responsive ── */
        @media (max-width: 992px) {
            .schedule-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .mobile-menu {
                display: flex;
            }

            .simple-footer {
                padding: 0.5rem 5%;
            }

            .simple-footer .footer-content {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
            }

            .simple-footer .footer-center {
                text-align: center;
            }

            .simple-footer .footer-right {
                justify-content: center;
            }

            .simple-footer .copyright {
                font-size: 0.8rem;
            }

            .simple-footer .footer-socials a {
                font-size: 1.3rem;
            }

            .card {
                padding: 2rem;
            }

            .schedule-day-row {
                flex-wrap: wrap;
                gap: 0.75rem;
            }

            .day-name {
                min-width: 80px;
            }

            .time-inputs {
                width: 100%;
            }

            .time-inputs input[type="time"] {
                flex: 1;
                min-width: 0;
            }

            .form-row {
                flex-direction: column;
            }

            .override-item {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (max-width: 576px) {
            .page-header h1 {
                font-size: 1.75rem;
            }

            .page-header p {
                font-size: 0.95rem;
            }

            .navbar {
                padding: 1rem 5%;
            }

            main {
                padding: 1.5rem 4%;
            }

            .card {
                padding: 1.25rem;
            }

            .card-header h2 {
                font-size: 1.15rem;
            }

            .card-icon {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }

            .schedule-day-row {
                padding: 0.7rem 0.5rem;
                gap: 0.5rem;
            }

            .day-name {
                min-width: 60px;
                font-size: 0.85rem;
            }

            .toggle-switch {
                width: 40px;
                height: 22px;
            }

            .toggle-switch .toggle-slider::before {
                width: 16px;
                height: 16px;
            }

            .toggle-switch input:checked + .toggle-slider::before {
                transform: translateX(18px);
            }

            .time-inputs {
                flex-wrap: wrap;
            }

            .time-inputs input[type="time"] {
                font-size: 0.8rem;
                padding: 0.4rem 0.5rem;
            }

            .btn {
                padding: 0.6rem 1rem;
                font-size: 0.9rem;
            }

            .form-group {
                min-width: 100%;
            }

            .override-item {
                padding: 0.75rem;
                font-size: 0.85rem;
            }

            .schedule-grid {
                gap: 1.25rem;
            }
        }

        /* ── Dark mode extras ── */
        [data-theme="dark"] .schedule-day-row:hover {
            background-color: rgba(56, 189, 248, 0.06);
        }

        [data-theme="dark"] .override-item {
            background-color: rgba(255, 255, 255, 0.04);
        }

        [data-theme="dark"] .override-item:hover {
            background-color: rgba(255, 255, 255, 0.08);
        }

        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar">
            <a href="/doc_home" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
                <a href="/doc_video_dashboard"><i class="fas fa-video"></i> Video</a>
                <a href="/doc_schedule" class="active"><i class="fas fa-calendar-alt"></i> Schedule</a>
                <a href="/doc_profile"><i class="fas fa-user-md"></i> Profile</a>
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
        <a href="/doc_video_dashboard"><i class="fas fa-video"></i> Video</a>
        <a href="/doc_schedule" class="active"><i class="fas fa-calendar-alt"></i> Schedule</a>
        <a href="/doc_profile"><i class="fas fa-user-md"></i> Profile</a>
    </div>

    <main>
        <div class="page-header">
            <h1>Schedule Management</h1>
            <p>Set your weekly availability and manage schedule overrides for holidays or custom hours</p>
        </div>

        <div class="schedule-grid">

            <!-- ── Weekly Schedule Card ── -->
            <div class="card">
                <div class="card-header">
                    <div class="card-icon">
                        <i class="fas fa-calendar-week"></i>
                    </div>
                    <h2>Weekly Schedule</h2>
                </div>

                <div id="weeklySchedule">
                    <div class="schedule-day-row" data-day="0">
                        <span class="day-name">Sunday</span>
                        <label class="toggle-switch">
                            <input type="checkbox" class="day-toggle" />
                            <span class="toggle-slider"></span>
                        </label>
