    <script src="/js/shared.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            /* ── Toggle-switch wiring ── */
            document.querySelectorAll('.day-toggle').forEach(function (toggle) {
                toggle.addEventListener('change', function () {
                    var row = this.closest('.schedule-day-row');
                    var startInput = row.querySelector('.start-time');
                    var endInput = row.querySelector('.end-time');
                    startInput.disabled = !this.checked;
                    endInput.disabled = !this.checked;
                });
            });

            /* ── Override type dropdown ── */
            var overrideType = document.getElementById('overrideType');
            var overrideTimeFields = document.getElementById('overrideTimeFields');

            overrideType.addEventListener('change', function () {
                if (this.value === 'custom') {
                    overrideTimeFields.classList.remove('hidden');
                } else {
                    overrideTimeFields.classList.add('hidden');
                }
            });

            /* ── Mobile menu ── */
            var mobileMenuBtn = document.getElementById('mobileMenuBtn');
            var closeMenuBtn = document.getElementById('closeMenu');
            var mobileMenu = document.getElementById('mobileMenu');

            mobileMenuBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                mobileMenu.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            closeMenuBtn.addEventListener('click', function () {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });

            document.addEventListener('click', function (e) {
                if (mobileMenu.classList.contains('active') &&
                    !mobileMenu.contains(e.target) &&
                    e.target !== mobileMenuBtn) {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            /* ── Load schedule on page ready ── */
            loadSchedule();
        });

        /* ──────────────────────────────────────────
           Load Schedule
        ────────────────────────────────────────── */
        async function loadSchedule() {
            try {
                var res = await fetch('/api/schedule/my', {
                    method: 'GET',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                if (!res.ok) {
                    throw new Error('Failed to load schedule');
                }

                var data = await res.json();
                var payload = data.data || data;

                /* Populate weekly grid */
                var schedules = payload.weeklySchedule || payload.schedules || payload.schedule || [];
                var rows = document.querySelectorAll('.schedule-day-row');

                rows.forEach(function (row) {
                    var day = parseInt(row.getAttribute('data-day'), 10);
                    var toggle = row.querySelector('.day-toggle');
                    var startInput = row.querySelector('.start-time');
                    var endInput = row.querySelector('.end-time');

                    var match = schedules.find(function (s) {
                        return parseInt(s.dayOfWeek, 10) === day || parseInt(s.day_of_week, 10) === day;
                    });

                    if (match) {
                        toggle.checked = true;
                        startInput.disabled = false;
                        endInput.disabled = false;
                        startInput.value = (match.startTime || match.start_time || '09:00').substring(0, 5);
                        endInput.value = (match.endTime || match.end_time || '17:00').substring(0, 5);
                    } else {
                        toggle.checked = false;
                        startInput.disabled = true;
                        endInput.disabled = true;
                        startInput.value = '09:00';
                        endInput.value = '17:00';
                    }
                });

                /* Populate overrides list */
                var overrides = payload.overrides || [];
                renderOverrides(overrides);

            } catch (err) {
                console.error('loadSchedule error:', err);
                if (typeof Toast !== 'undefined') {
                    Toast.error('Unable to load schedule. Please try again.');
                }
            }
        }

        /* ──────────────────────────────────────────
           Save Weekly Schedule
        ────────────────────────────────────────── */
        async function saveSchedule() {
            var saveBtn = document.getElementById('saveScheduleBtn');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

            try {
                var rows = document.querySelectorAll('.schedule-day-row');
                var schedules = [];

                rows.forEach(function (row) {
                    var toggle = row.querySelector('.day-toggle');
                    if (toggle.checked) {
                        var day = parseInt(row.getAttribute('data-day'), 10);
                        var startTime = row.querySelector('.start-time').value;
                        var endTime = row.querySelector('.end-time').value;
                        schedules.push({
                            dayOfWeek: day,
                            startTime: startTime,
                            endTime: endTime
                        });
                    }
                });

                var res = await fetch('/api/schedule/my', {
                    method: 'PUT',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ schedules: schedules })
                });

                if (!res.ok) {
                    var errData = await res.json().catch(function () { return {}; });
                    throw new Error(errData.error || 'Failed to save schedule');
                }

                if (typeof Toast !== 'undefined') {
                    Toast.success('Weekly schedule saved successfully.');
                }
            } catch (err) {
                console.error('saveSchedule error:', err);
                if (typeof Toast !== 'undefined') {
                    Toast.error(err.message || 'Unable to save schedule.');
                }
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-save"></i> Save Schedule';
            }
        }

        /* ──────────────────────────────────────────
           Add Override
        ────────────────────────────────────────── */
        async function addOverride() {
            var dateInput = document.getElementById('overrideDate');
            var typeSelect = document.getElementById('overrideType');
            var startInput = document.getElementById('overrideStart');
            var endInput = document.getElementById('overrideEnd');
            var reasonInput = document.getElementById('overrideReason');

            if (!dateInput.value) {
                if (typeof Toast !== 'undefined') {
                    Toast.error('Please select a date for the override.');
                }
                return;
            }

            var addBtn = document.getElementById('addOverrideBtn');
            addBtn.disabled = true;
            addBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

            try {
                var body = {
                    date: dateInput.value,
                    type: typeSelect.value,
                    reason: reasonInput.value
                };

                if (typeSelect.value === 'custom') {
                    body.startTime = startInput.value;
                    body.endTime = endInput.value;
                }

                var res = await fetch('/api/schedule/override', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(body)
                });

                if (!res.ok) {
                    var errData = await res.json().catch(function () { return {}; });
                    throw new Error(errData.error || 'Failed to add override');
                }

                /* Clear form */
                dateInput.value = '';
                typeSelect.value = 'unavailable';
                reasonInput.value = '';
                startInput.value = '09:00';
                endInput.value = '17:00';
                document.getElementById('overrideTimeFields').classList.add('hidden');

                if (typeof Toast !== 'undefined') {
                    Toast.success('Schedule override added successfully.');
                }

                /* Reload data to get updated overrides */
                await loadSchedule();

            } catch (err) {
                console.error('addOverride error:', err);
                if (typeof Toast !== 'undefined') {
                    Toast.error(err.message || 'Unable to add override.');
                }
            } finally {
                addBtn.disabled = false;
                addBtn.innerHTML = '<i class="fas fa-plus"></i> Add Override';
            }
        }

        /* ──────────────────────────────────────────
           Delete Override
        ────────────────────────────────────────── */
        async function deleteOverride(id) {
            try {
                var res = await fetch('/api/schedule/override/' + id, {
                    method: 'DELETE',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                if (!res.ok) {
                    var errData = await res.json().catch(function () { return {}; });
                    throw new Error(errData.error || 'Failed to delete override');
                }

                if (typeof Toast !== 'undefined') {
                    Toast.success('Override removed successfully.');
                }

                await loadSchedule();

            } catch (err) {
                console.error('deleteOverride error:', err);
                if (typeof Toast !== 'undefined') {
                    Toast.error(err.message || 'Unable to delete override.');
                }
            }
        }

        /* ──────────────────────────────────────────
           Render Overrides List
        ────────────────────────────────────────── */
        function renderOverrides(overrides) {
            var container = document.getElementById('overridesList');

            if (!overrides || overrides.length === 0) {
                container.innerHTML =
                    '<div class="no-overrides">' +
                    '    <i class="fas fa-calendar-check"></i>' +
                    '    <p>No schedule overrides set</p>' +
                    '</div>';
                return;
            }

            var html = '';
            overrides.forEach(function (o) {
                var overrideType = o.type || 'unavailable';
                var overrideDate = o.date || o.override_date || '';
                var overrideReason = o.reason || '';
                var overrideId = o.id || o.override_id || '';
                var startTime = o.startTime || o.start_time || '';
                var endTime = o.endTime || o.end_time || '';

                /* Format date for display */
                var displayDate = overrideDate;
                try {
                    var dateObj = new Date(overrideDate + 'T00:00:00');
                    displayDate = dateObj.toLocaleDateString('en-US', {
                        weekday: 'short',
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                } catch (e) { /* keep raw */ }

                html +=
                    '<div class="override-item ' + overrideType + '">' +
                    '    <div class="override-info">' +
                    '        <div class="override-date">' +
                    '            <i class="fas fa-calendar-day"></i> ' + escapeHtml(displayDate) +
                    '            <span class="override-type-badge ' + overrideType + '">' + overrideType + '</span>' +
                    '        </div>';

                if (overrideType === 'custom' && startTime && endTime) {
                    html +=
                        '        <div class="override-detail">' +
                        '            <i class="fas fa-clock"></i> ' + escapeHtml(startTime.substring(0, 5)) + ' - ' + escapeHtml(endTime.substring(0, 5)) +
                        '        </div>';
                }

                if (overrideReason) {
                    html +=
                        '        <div class="override-detail">' +
                        '            <i class="fas fa-comment-alt"></i> ' + escapeHtml(overrideReason) +
                        '        </div>';
                }

                html +=
                    '    </div>' +
                    '    <button class="btn-danger-sm" onclick="deleteOverride(\'' + overrideId + '\')">' +
                    '        <i class="fas fa-trash-alt"></i> Remove' +
                    '    </button>' +
                    '</div>';
            });

            container.innerHTML = html;
        }

        /* ── Utility: escape HTML ── */
        function escapeHtml(str) {
            if (!str) return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>

