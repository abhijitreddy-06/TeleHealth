<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeleHealth - <%= product.name %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root{--primary:#38bdf8;--primary-hover:#0ea5e9;--secondary:#10b981;--background:#f9fafb;--card-bg:#fff;--text-dark:#0f172a;--text-light:#f1f5f9;--text-medium:#475569;--border:#e2e8f0;--error:#ef4444;--warning:#f59e0b;--success:#10b981;--transition:all .3s ease;--shadow:0 4px 6px -1px rgba(0,0,0,.1);--radius:12px}
        [data-theme="dark"]{--background:#1e293b;--card-bg:#334155;--text-dark:#f1f5f9;--text-medium:#cbd5e1;--border:#475569}
        *{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif}
        body{background:var(--background);color:var(--text-dark);min-height:100vh;display:flex;flex-direction:column;line-height:1.6}
        a{text-decoration:none!important;color:inherit}

        header{background:var(--card-bg);box-shadow:var(--shadow);position:sticky;top:0;z-index:100}
        .navbar{display:flex;justify-content:space-between;align-items:center;padding:1.2rem 5%;max-width:1400px;margin:0 auto}
        .logo{font-size:1.8rem;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:.5rem}
        .logo i{color:var(--secondary);font-size:1.5rem}
        .logo-text{background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800}
        .nav-links{display:flex;gap:1rem;align-items:center}
        .nav-links a{color:var(--text-dark);font-weight:500;padding:.5rem .8rem;border-radius:8px;display:flex;align-items:center;gap:.5rem;transition:var(--transition)}
        .nav-links a:hover,.nav-links a.active{color:var(--primary);background:rgba(56,189,248,.1)}
        .theme-toggle{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.2rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center}
        .cart-badge{position:relative}
        .cart-badge .badge{position:absolute;top:-4px;right:-8px;background:var(--error);color:#fff;font-size:.65rem;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}
        .profile-dropdown{position:relative}
        .profile-btn{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.3rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;transition:var(--transition)}
        .profile-btn:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .dropdown-menu{position:absolute;top:calc(100% + 4px);right:0;background:var(--card-bg);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);min-width:180px;padding:.5rem 0;display:none;z-index:200;border:1px solid var(--border)}
        .dropdown-menu.active{display:block}
        .dropdown-menu a{display:flex;align-items:center;gap:.8rem;padding:.7rem 1.2rem;font-size:.9rem;color:var(--text-dark);transition:var(--transition);border-radius:0}
        .dropdown-menu a:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .mobile-controls{display:none;align-items:center;gap:.5rem}
        .mobile-menu-btn{display:none;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%}
        .mobile-menu{position:fixed;top:0;right:-100%;width:280px;height:100vh;background:var(--card-bg);z-index:1000;padding:2rem;transition:var(--transition);box-shadow:-5px 0 15px rgba(0,0,0,.1);display:flex;flex-direction:column;gap:1.5rem}
        .mobile-menu.active{right:0}
        .close-menu{align-self:flex-end;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center}
        .mobile-menu a{display:flex;align-items:center;gap:1rem;padding:.8rem 1rem;border-radius:8px;color:var(--text-dark);transition:var(--transition)}
        .mobile-menu a:hover{color:var(--primary);background:rgba(56,189,248,.1)}

        .product-container{flex:1;max-width:1200px;margin:0 auto;padding:2rem 5%;width:100%}
        .breadcrumb{font-size:.85rem;color:var(--text-medium);margin-bottom:1.5rem;display:flex;gap:.5rem;flex-wrap:wrap}
        .breadcrumb a{color:var(--primary)}

        .product-detail{display:grid;grid-template-columns:1fr 1fr;gap:3rem;background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:2rem;margin-bottom:2rem}
        .product-image{border-radius:12px;overflow:hidden;background:#f1f5f9}
        .product-image img{width:100%;height:400px;object-fit:cover}
        .product-info h1{font-size:1.6rem;margin-bottom:.5rem}
        .info-category{font-size:.8rem;color:var(--primary);font-weight:500;text-transform:uppercase;letter-spacing:.5px;margin-bottom:.5rem}
        .info-rating{display:flex;align-items:center;gap:.5rem;margin-bottom:1rem}
        .info-rating .stars{color:var(--warning)}
        .info-rating span{color:var(--text-medium);font-size:.9rem}
        .info-price{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem}
        .info-price .current{font-size:1.8rem;font-weight:700;color:var(--secondary)}
        .info-price .was{font-size:1.1rem;color:var(--text-medium);text-decoration:line-through}
        .info-price .discount{background:var(--success);color:#fff;padding:2px 8px;border-radius:4px;font-size:.8rem;font-weight:600}
        .info-description{color:var(--text-medium);margin-bottom:1.5rem;line-height:1.8}
        .info-meta{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1.5rem}
        .meta-item{font-size:.85rem}
        .meta-item strong{display:block;color:var(--text-dark);font-weight:600}
        .meta-item span{color:var(--text-medium)}
        .stock-status{padding:.5rem 1rem;border-radius:8px;font-size:.85rem;font-weight:600;display:inline-block;margin-bottom:1rem}
        .stock-status.in-stock{background:rgba(16,185,129,.1);color:var(--success)}
        .stock-status.low-stock{background:rgba(245,158,11,.1);color:var(--warning)}
        .stock-status.no-stock{background:rgba(239,68,68,.1);color:var(--error)}
        .rx-badge{background:var(--warning);color:#fff;padding:4px 12px;border-radius:4px;font-size:.8rem;font-weight:600;display:inline-block;margin-bottom:1rem;margin-right:.5rem}
        .qty-control{display:flex;align-items:center;gap:.5rem;margin-bottom:1rem}
        .qty-control button{width:36px;height:36px;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;color:var(--text-dark);transition:var(--transition)}
        .qty-control button:hover{border-color:var(--primary);color:var(--primary)}
        .qty-control input{width:50px;text-align:center;border:1px solid var(--border);border-radius:8px;padding:.5rem;font-size:1rem;background:var(--card-bg);color:var(--text-dark)}
        .action-btns{display:flex;gap:.8rem;flex-wrap:wrap}
        .btn{padding:.8rem 2rem;border-radius:8px;font-weight:600;cursor:pointer;transition:var(--transition);border:none;font-size:.95rem;display:flex;align-items:center;gap:.5rem}
        .btn-primary{background:var(--primary);color:#fff}
        .btn-primary:hover{background:var(--primary-hover);transform:translateY(-2px)}
        .btn-primary:disabled{background:var(--border);cursor:not-allowed;transform:none;color:var(--text-medium)}
        .btn-outline{background:transparent;border:2px solid var(--primary);color:var(--primary)}
        .btn-outline:hover{background:var(--primary);color:#fff}
        .btn-outline.wishlisted{border-color:var(--error);color:var(--error)}

        .reviews-section{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:2rem;margin-bottom:2rem}
        .reviews-section h2{font-size:1.3rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem}
        .review-form{background:rgba(56,189,248,.05);border:1px solid var(--border);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem}
        .review-form h3{font-size:1rem;margin-bottom:1rem}
        .star-rating{display:flex;gap:.3rem;margin-bottom:1rem;font-size:1.5rem;cursor:pointer}
        .star-rating i{color:var(--border);transition:color .2s}
        .star-rating i.active,.star-rating i:hover{color:var(--warning)}
        .review-form input,.review-form textarea{width:100%;padding:.8rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--text-dark);font-size:.9rem;margin-bottom:.8rem;font-family:inherit}
        .review-form textarea{height:100px;resize:vertical}
        .review-form input:focus,.review-form textarea:focus{outline:none;border-color:var(--primary)}
        .review-list{display:flex;flex-direction:column;gap:1rem}
        .review-card{border:1px solid var(--border);border-radius:8px;padding:1rem}
        .review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem}
        .review-header .name{font-weight:600}
        .review-header .date{font-size:.8rem;color:var(--text-medium)}
        .review-stars{color:var(--warning);font-size:.85rem;margin-bottom:.3rem}
        .review-title{font-weight:600;margin-bottom:.3rem}
        .review-comment{color:var(--text-medium);font-size:.9rem}
        .verified-badge{font-size:.7rem;color:var(--success);font-weight:500}

        .toast-container{position:fixed;top:80px;right:20px;z-index:9999}
        .toast{background:var(--card-bg);border-radius:8px;padding:1rem 1.5rem;box-shadow:0 8px 24px rgba(0,0,0,.15);display:flex;align-items:center;gap:.8rem;margin-bottom:.5rem;animation:slideIn .3s ease;max-width:360px;border-left:4px solid var(--success)}
        .toast.error{border-left-color:var(--error)}
        @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

        .simple-footer{all:unset;display:block;background:var(--card-bg);border-top:1px solid var(--border);padding:.6rem 5%;margin-top:auto}
        .simple-footer .footer-content{all:unset;max-width:1400px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;align-items:center}
        .simple-footer .footer-left{display:flex;align-items:center}
        .simple-footer .footer-logo{display:flex;align-items:center;gap:.5rem;color:var(--primary);font-weight:600}
        .simple-footer .footer-logo i{color:var(--secondary);font-size:1.2rem}
        .simple-footer .footer-center{text-align:center}
        .simple-footer .copyright{color:var(--text-dark);font-size:.9rem}
        .simple-footer .footer-name{color:var(--text-dark);font-weight:600}
        .simple-footer .footer-right{display:flex;gap:1rem;justify-content:flex-end}
        .simple-footer .footer-socials a{color:var(--text-dark);font-size:1.4rem}

        @media(max-width:768px){
            .nav-links{display:none}.mobile-controls{display:flex}.mobile-menu-btn{display:flex}
            .product-detail{grid-template-columns:1fr;gap:1.5rem;padding:1.5rem}
            .product-image img{height:280px}
            .info-meta{grid-template-columns:1fr}
            .action-btns{flex-direction:column}
            .btn{width:100%;justify-content:center}
            .simple-footer .footer-content{display:flex;flex-direction:column;gap:.3rem}
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <a href="/user_home" class="logo"><i class="fas fa-heartbeat"></i><span class="logo-text">TeleHealth</span></a>
            <div class="nav-links">
                <a href="/user_home"><i class="fas fa-home"></i> Home</a>
                <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
                <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
                <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
                <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
                <a href="/records"><i class="fas fa-folder"></i> My Records</a>
                <div class="profile-dropdown">
                    <button class="profile-btn" id="profileBtn"><i class="fas fa-user-circle"></i></button>
                    <div class="dropdown-menu" id="profileDropdown">
                        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart<% if (cartCount > 0) { %><span class="badge" id="cartBadge" style="position:static;display:inline-flex;margin-left:auto"><%= cartCount %></span><% } %></a>
                        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
                    </div>
                </div>
                <button class="theme-toggle" id="themeToggle"><i class="fas fa-moon"></i></button>
            </div>
            <div class="mobile-controls">
                <div class="profile-dropdown">
                    <button class="profile-btn" id="mobileProfileBtn"><i class="fas fa-user-circle"></i></button>
                    <div class="dropdown-menu" id="mobileProfileDropdown">
                        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
                        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
                    </div>
                </div>
                <button class="theme-toggle" id="mobileThemeToggle"><i class="fas fa-moon"></i></button>
                <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="fas fa-bars"></i></button>
            </div>
        </nav>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu"><i class="fas fa-times"></i></button>
        <a href="/user_home"><i class="fas fa-home"></i> Home</a>
        <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
        <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
        <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
        <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
        <a href="/records"><i class="fas fa-folder"></i> My Records</a>
        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <main class="product-container">
        <div class="breadcrumb">
            <a href="/pharmacy">Pharmacy</a> <span>/</span>
            <a href="/pharmacy?category=<%= product.category_slug %>"><%= product.category_name %></a> <span>/</span>
            <span><%= product.name %></span>
        </div>

        <div class="product-detail">
            <div class="product-image">
                <img src="<%= product.image_url || 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400' %>" alt="<%= product.name %>" onerror="this.src='https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400'">
            </div>
            <div class="product-info">
                <span class="info-category"><%= product.category_name %></span>
                <h1><%= product.name %></h1>
                <div class="info-rating">
                    <span class="stars" id="avgStars"></span>
                    <span><%= parseFloat(product.avg_rating).toFixed(1) %> (<%= product.review_count %> reviews)</span>
                </div>

                <div class="info-price">
                    <span class="current">Rs.<%= parseFloat(product.price).toFixed(0) %></span>
                    <% if (product.compare_at_price) { %>
                        <span class="was">Rs.<%= parseFloat(product.compare_at_price).toFixed(0) %></span>
                        <span class="discount"><%= Math.round((1 - product.price / product.compare_at_price) * 100) %>% OFF</span>
                    <% } %>
                </div>

                <% if (product.prescription_required) { %>
                    <span class="rx-badge"><i class="fas fa-prescription"></i> Prescription Required</span>
                <% } %>

                <% if (product.stock_quantity > 10) { %>
                    <span class="stock-status in-stock"><i class="fas fa-check-circle"></i> In Stock</span>
                <% } else if (product.stock_quantity > 0) { %>
                    <span class="stock-status low-stock"><i class="fas fa-exclamation-circle"></i> Only <%= product.stock_quantity %> left</span>
                <% } else { %>
                    <span class="stock-status no-stock"><i class="fas fa-times-circle"></i> Out of Stock</span>
                <% } %>

                <p class="info-description"><%= product.description || product.short_description || 'No description available.' %></p>

                <div class="info-meta">
                    <% if (product.manufacturer) { %><div class="meta-item"><strong>Manufacturer</strong><span><%= product.manufacturer %></span></div><% } %>
                    <% if (product.dosage_form) { %><div class="meta-item"><strong>Form</strong><span><%= product.dosage_form %></span></div><% } %>
                    <% if (product.strength) { %><div class="meta-item"><strong>Strength</strong><span><%= product.strength %></span></div><% } %>
                    <% if (product.pack_size) { %><div class="meta-item"><strong>Pack Size</strong><span><%= product.pack_size %></span></div><% } %>
                    <div class="meta-item"><strong>SKU</strong><span><%= product.sku %></span></div>
                </div>

                <% if (product.stock_quantity > 0) { %>
                <div class="qty-control">
                    <button onclick="changeQty(-1)">-</button>
                    <input type="number" id="qtyInput" value="1" min="1" max="<%= Math.min(product.stock_quantity, 50) %>">
                    <button onclick="changeQty(1)">+</button>
                </div>
                <% } %>

                <div class="action-btns">
                    <button class="btn btn-primary" id="addToCartBtn" onclick="addToCart()" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>>
                        <i class="fas fa-cart-plus"></i> <%= product.stock_quantity > 0 ? 'Add to Cart' : 'Out of Stock' %>
                    </button>
                    <% if (user) { %>
                    <button class="btn btn-outline <%= inWishlist ? 'wishlisted' : '' %>" id="wishlistBtn" onclick="toggleWishlist()">
                        <i class="fas fa-heart"></i> <%= inWishlist ? 'Wishlisted' : 'Add to Wishlist' %>
                    </button>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="reviews-section">
            <h2><i class="fas fa-star"></i> Reviews & Ratings</h2>

            <% if (user && hasPurchased) { %>
            <div class="review-form" id="reviewForm">
                <h3><%= userReview ? 'Update Your Review' : 'Write a Review' %></h3>
                <div class="star-rating" id="starRating">
                    <i class="far fa-star" data-val="1"></i>
                    <i class="far fa-star" data-val="2"></i>
                    <i class="far fa-star" data-val="3"></i>
                    <i class="far fa-star" data-val="4"></i>
                    <i class="far fa-star" data-val="5"></i>
                </div>
                <input type="text" id="reviewTitle" placeholder="Review title (optional)" value="<%= userReview ? userReview.title || '' : '' %>" maxlength="200">
                <textarea id="reviewComment" placeholder="Write your review..." maxlength="1000"><%= userReview ? userReview.comment || '' : '' %></textarea>
                <button class="btn btn-primary" onclick="submitReview()"><i class="fas fa-paper-plane"></i> Submit Review</button>
            </div>
            <% } else if (user) { %>
            <p style="color:var(--text-medium);margin-bottom:1.5rem;font-size:.9rem;"><i class="fas fa-info-circle"></i> Purchase this product to leave a review</p>
            <% } else { %>
            <p style="color:var(--text-medium);margin-bottom:1.5rem;font-size:.9rem;"><a href="/user_login" style="color:var(--primary)">Log in</a> to write a review</p>
            <% } %>

            <div class="review-list" id="reviewList">
                <% if (reviews.length === 0) { %>
                    <p style="color:var(--text-medium)">No reviews yet. Be the first to review this product!</p>
                <% } %>
                <% reviews.forEach(r => { %>
                <div class="review-card">
                    <div class="review-header">
                        <span class="name"><%= r.reviewer_name %> <% if (r.is_verified) { %><span class="verified-badge"><i class="fas fa-check-circle"></i> Verified</span><% } %></span>
                        <span class="date"><%= new Date(r.created_at).toLocaleDateString('en-IN', {year:'numeric',month:'short',day:'numeric'}) %></span>
                    </div>
                    <div class="review-stars"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%= i<=r.rating?'var(--warning)':'var(--border)'%>"></i><%}%></div>
                    <% if (r.title) { %><div class="review-title"><%= r.title %></div><% } %>
                    <% if (r.comment) { %><div class="review-comment"><%= r.comment %></div><% } %>
                </div>
                <% }); %>
            </div>
        </div>
    </main>

    <footer class="simple-footer">
        <div class="footer-content">
            <div class="footer-left"><a href="/user_home" class="footer-logo"><i class="fas fa-heartbeat"></i><span>TeleHealth</span></a></div>
            <div class="footer-center"><span class="copyright">&copy; 2026 Built by <a href="https://abhijitreddy-portfolio.netlify.app/" target="_blank" class="footer-name">Abhijit Reddy</a>.</span></div>
            <div class="footer-right footer-socials">
                <a href="https://www.linkedin.com/in/abhijitreddy75" target="_blank"><i class="fab fa-linkedin"></i></a>
                <a href="https://github.com/abhijitreddy-06" target="_blank"><i class="fab fa-github"></i></a>
            </div>
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const html = document.documentElement;
        const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
        html.setAttribute('data-theme', savedTheme);
        const themeToggle = document.getElementById('themeToggle');
        const mobileThemeToggle = document.getElementById('mobileThemeToggle');
        function updateThemeIcon(t){const i=t==='dark'?'fa-sun':'fa-moon';themeToggle.innerHTML='<i class="fas '+i+'"></i>';mobileThemeToggle.innerHTML='<i class="fas '+i+'"></i>';}
        updateThemeIcon(savedTheme);
        function toggleTheme(){const t=html.getAttribute('data-theme')==='dark'?'light':'dark';html.setAttribute('data-theme',t);localStorage.setItem('theme',t);updateThemeIcon(t);}
        themeToggle.addEventListener('click',toggleTheme);
        mobileThemeToggle.addEventListener('click',toggleTheme);

        const mm=document.getElementById('mobileMenu');
        document.getElementById('mobileMenuBtn').addEventListener('click',e=>{e.stopPropagation();mm.classList.add('active');document.body.style.overflow='hidden';});
        document.getElementById('closeMenu').addEventListener('click',()=>{mm.classList.remove('active');document.body.style.overflow='';});

        // Profile Dropdown (Desktop + Mobile)
        document.querySelectorAll('.profile-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var dd = btn.nextElementSibling;
                document.querySelectorAll('.dropdown-menu').forEach(function(m) { if (m !== dd) m.classList.remove('active'); });
                dd.classList.toggle('active');
            });
        });
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.profile-dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(function(m) { m.classList.remove('active'); });
            }
        });

        // Avg stars
        const avgRating = <%= product.avg_rating || 0 %>;
        const starsEl = document.getElementById('avgStars');
        let sh = '';
        for(let i=1;i<=5;i++){
            if(i<=Math.floor(avgRating)) sh+='<i class="fas fa-star"></i>';
            else if(i-0.5<=avgRating) sh+='<i class="fas fa-star-half-alt"></i>';
            else sh+='<i class="far fa-star"></i>';
        }
        starsEl.innerHTML = sh;

        // Star rating form
        let selectedRating = <%= userReview ? userReview.rating : 0 %>;
        const starContainer = document.getElementById('starRating');
        if(starContainer) {
            const starIcons = starContainer.querySelectorAll('i');
            function highlightStars(n){starIcons.forEach((s,i)=>{s.className=i<n?'fas fa-star active':'far fa-star';});}
            highlightStars(selectedRating);
            starIcons.forEach(s=>{
                s.addEventListener('click',()=>{selectedRating=parseInt(s.dataset.val);highlightStars(selectedRating);});
                s.addEventListener('mouseenter',()=>{highlightStars(parseInt(s.dataset.val));});
            });
            starContainer.addEventListener('mouseleave',()=>{highlightStars(selectedRating);});
        }

        const isLoggedIn = <%= user ? 'true' : 'false' %>;
        const productId = <%= product.id %>;

        window.changeQty = function(d) {
            const inp = document.getElementById('qtyInput');
            const v = Math.max(1, Math.min(parseInt(inp.max), parseInt(inp.value)+d));
            inp.value = v;
        };

        window.addToCart = async function() {
            if(!isLoggedIn){window.location.href='/user_login';return;}
            const qty = parseInt(document.getElementById('qtyInput')?.value||1);
            const btn = document.getElementById('addToCartBtn');
            const orig = btn.innerHTML;
            btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Adding...';
            try{
                const res = await fetch('/api/pharmacy/cart/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,quantity:qty})});
                const data = await res.json();
                if(!data.success) throw new Error(data.error||'Failed');
                showToast('Added to cart!');
                const badge = document.getElementById('cartBadge');
                if(badge) badge.textContent = data.cartCount;
            }catch(err){showToast(err.message,true);}
            finally{btn.disabled=false;btn.innerHTML=orig;}
        };

        window.toggleWishlist = async function() {
            const btn = document.getElementById('wishlistBtn');
            try{
                const res = await fetch('/api/pharmacy/wishlist/toggle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId})});
                const data = await res.json();
                if(!data.success) throw new Error(data.error||'Failed');
                if(data.added){btn.classList.add('wishlisted');btn.innerHTML='<i class="fas fa-heart"></i> Wishlisted';showToast('Added to wishlist');}
                else{btn.classList.remove('wishlisted');btn.innerHTML='<i class="fas fa-heart"></i> Add to Wishlist';showToast('Removed from wishlist');}
            }catch(err){showToast(err.message,true);}
        };

        window.submitReview = async function() {
            if(selectedRating===0){showToast('Please select a rating',true);return;}
            const title = document.getElementById('reviewTitle').value.trim();
            const comment = document.getElementById('reviewComment').value.trim();
            try{
                const res = await fetch('/api/pharmacy/reviews',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,rating:selectedRating,title,comment})});
                const data = await res.json();
                if(!data.success) throw new Error(data.error||'Failed');
                showToast('Review submitted!');
                setTimeout(()=>location.reload(),1000);
            }catch(err){showToast(err.message,true);}
        };

        function showToast(msg,isError){
            const c=document.getElementById('toastContainer');
            const t=document.createElement('div');
            t.className='toast'+(isError?' error':'');
            t.innerHTML='<i class="fas '+(isError?'fa-exclamation-circle':'fa-check-circle')+'" style="color:'+(isError?'var(--error)':'var(--success)')+';font-size:1.2rem"></i><span style="font-size:.9rem;font-weight:500">'+msg+'</span>';
            c.appendChild(t);setTimeout(()=>t.remove(),3000);
        }
    });
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>
</html>
