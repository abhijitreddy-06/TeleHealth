<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Doctor Video Call | TeleHealth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        /* ===============================
           BASE STYLES FROM DOC_HOME
           =============================== */
        :root {
            /* Color Variables */
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;

            /* Other Variables */
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;

            /* Header heights */
            --header-height-desktop: 70px;
            --header-height-mobile: 60px;
        }

        /* Dark Theme Variables */
        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
            overflow: hidden;
        }

        /* ===============================
           HEADER & NAVIGATION (From doc_home)
           =============================== */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height-desktop);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            height: 100%;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: "Poppins", sans-serif;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* Mobile Menu (From doc_home) */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* ===============================
           VIDEO CALL PAGE LAYOUT
           =============================== */

        /* Main Container */
        .video-call-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            width: 100%;
            height: calc(100vh - var(--header-height-desktop));
            background: #000;
        }

        /* Status Overlay */
        .call-status-overlay {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 10;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-indicator {
            display: flex;
            gap: 0.25rem;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background-color: var(--success);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot:nth-child(2) {
            animation-delay: 0.5s;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.9);
            }
        }

        #callStatusText {
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* Main Video Area */
        .video-main-area {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: #000;
        }

        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Local Video (PiP) */
        .local-video-pip {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 220px;
            height: 165px;
            border-radius: var(--radius);
            overflow: hidden;
            border: 3px solid var(--primary);
            box-shadow: var(--shadow);
            background: #000;
            z-index: 5;
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .local-video-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.5rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            justify-content: center;
        }

        /* Video Loading State */
        .video-loading {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            z-index: 2;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 1rem;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===============================
           DESKTOP CONTROLS (15% height)
           =============================== */
        .desktop-controls {
            height: 15vh;
            min-height: 80px;
            max-height: 120px;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0 5%;
            width: 100%;
        }

        .controls-wrapper {
            display: flex;
            justify-content: center;
            gap: 2rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .control-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            background: none;
            border: none;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition);
            padding: 1rem;
            border-radius: var(--radius);
            min-width: 80px;
        }

        .control-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
            transform: translateY(-2px);
        }

        .control-btn.active {
            background-color: rgba(56, 189, 248, 0.15);
            color: var(--primary);
        }

        .control-btn.danger {
            color: var(--error);
        }

        .control-btn.danger:hover {
            background-color: rgba(239, 68, 68, 0.1);
        }

        .control-icon {
            font-size: 1.5rem;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--background);
            border-radius: 50%;
            transition: var(--transition);
        }

        .control-btn:hover .control-icon {
            transform: scale(1.1);
        }

        .control-btn.active .control-icon {
            background-color: var(--primary);
            color: white;
        }

        .control-btn.danger .control-icon {
            background-color: var(--error);
            color: white;
        }

        .control-label {
            font-size: 0.875rem;
            font-weight: 500;
        }

        /* ===============================
           MOBILE VIEW
           =============================== */
        @media (max-width: 768px) {
            :root {
                --header-height-mobile: 60px;
            }

            header {
                height: var(--header-height-mobile);
            }

            .navbar {
                padding: 0.8rem 5%;
            }

            .logo-text {
                display: none;
            }

            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
            }

            /* Video container for mobile */
            .video-call-container {
                height: calc(100vh - var(--header-height-mobile));
                padding-bottom: 80px;
                /* Space for fixed controls */
            }

            /* Mobile Controls - Fixed at bottom */
            .desktop-controls {
                display: none;
            }

            .mobile-controls-bar {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: 80px;
                background-color: var(--card-bg);
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 100;
                padding: 0 5%;
            }

            .mobile-controls-wrapper {
                display: flex;
                justify-content: space-around;
                width: 100%;
                max-width: 500px;
            }

            .mobile-control-btn {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 0.4rem;
                background: none;
                border: none;
                color: var(--text-dark);
                cursor: pointer;
                padding: 0.5rem;
                min-width: 60px;
            }

            .mobile-control-icon {
                font-size: 1.25rem;
                width: 48px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--background);
                border-radius: 50%;
            }

            .mobile-control-label {
                font-size: 0.75rem;
                font-weight: 500;
            }

            /* Local Video PiP - Mobile (above controls) */
            .local-video-pip {
                position: fixed;
                bottom: 90px;
                right: 10px;
                width: 140px;
                height: 105px;
                border-width: 2px;
                z-index: 50;
            }

            /* Status overlay mobile adjustments */
            .call-status-overlay {
                top: 0.5rem;
                left: 0.5rem;
                padding: 0.5rem 1rem;
                font-size: 0.85rem;
            }

            .status-dot {
                width: 6px;
                height: 6px;
            }
        }

        /* ===============================
           NOTES PANEL (Mobile Only)
           =============================== */
        .mobile-notes-panel {
            position: fixed;
            bottom: -50%;
            left: 0;
            right: 0;
            height: 50%;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            z-index: 1000;
            transition: bottom 0.3s ease-out;
            display: flex;
            flex-direction: column;
        }

        .mobile-notes-panel.active {
            bottom: 80px;
            /* Position above controls */
        }

        .notes-header {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notes-header h3 {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-dark);
            font-size: 1rem;
        }

        .notes-header h3 i {
            color: var(--primary);
        }

        .close-notes {
            background: none;
            border: none;
            color: var(--text-medium);
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .close-notes:hover {
            background-color: rgba(0, 0, 0, 0.1);
        }

        .notes-content {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
        }

        #mobileNotesText {
            width: 100%;
            height: 100%;
            min-height: 150px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background-color: var(--background);
            color: var(--text-dark);
            font-family: inherit;
            font-size: 1rem;
            resize: none;
        }

        #mobileNotesText:focus {
            outline: none;
            border-color: var(--primary);
        }

        .notes-footer {
            padding: 1rem;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notes-actions {
            display: flex;
            gap: 0.5rem;
        }

        .notes-footer .btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.875rem;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--primary);
            color: var(--primary);
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .char-count {
            color: var(--text-medium);
            font-size: 0.75rem;
        }

        /* Desktop Notes Modal (for desktop only) */
        .desktop-notes-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .desktop-notes-modal.active {
            display: flex;
        }

        .desktop-notes-panel {
            background-color: var(--card-bg);
            border-radius: var(--radius);
            width: 100%;
            max-width: 600px;
            max-height: 70vh;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow);
        }

        /* Hide mobile notes panel on desktop */
        @media (min-width: 769px) {
            .mobile-notes-panel {
                display: none;
            }

            .mobile-controls-bar {
                display: none;
            }
        }

        /* Hide desktop controls on mobile */
        @media (max-width: 768px) {
            .desktop-controls {
                display: none;
            }

            .desktop-notes-modal {
                display: none !important;
            }
        }

        /* ===============================
           UTILITY CLASSES
           =============================== */
        .hidden {
            display: none !important;
        }

        /* Remove all footer styles */
        .simple-footer,
        footer {
            display: none !important;
        }

        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar">
            <a href="/doc_home" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
                <a href="/doc_video_dashboard" class="active"><i class="fas fa-video"></i>Video</a>
                <a href="/doc_profile"><i class="fas fa-user-circle"></i> Profile</a>
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- Mobile Menu (From doc_home) -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
        <a href="/doc_video_dashboard" class="active"><i class="fas fa-video"></i>Video</a>
        <a href="/doc_profile"><i class="fas fa-user-circle"></i> Profile</a>
    </div>

    <!-- Main Video Call Container -->
    <main class="video-call-container">
        <!-- Status Overlay -->
        <div class="call-status-overlay" id="callStatusOverlay">
            <div class="status-indicator">
                <div class="status-dot"></div>
                <div class="status-dot"></div>
            </div>
            <span id="callStatusText">CALL STATUS: CONNECTED</span>
        </div>

        <!-- Main Video Area -->
        <div class="video-main-area">
            <!-- Remote Video Stream -->
            <video id="remoteVideo" autoplay playsinline></video>

            <!-- Local Video (Picture-in-Picture) -->
            <div class="local-video-pip">
                <video id="localVideo" autoplay muted playsinline></video>
                <div class="local-video-label">
                    <i class="fas fa-user-md"></i>
                    <span>YOU</span>
                </div>
            </div>

            <!-- Loading State -->
            <div class="video-loading hidden" id="videoLoading">
                <div class="loading-spinner"></div>
                <p>Establishing connection...</p>
            </div>
        </div>

        <!-- Desktop Controls (15% height) -->
        <div class="desktop-controls">
            <div class="controls-wrapper">
                <!-- Microphone Toggle -->
                <button class="control-btn active" id="toggleMic">
                    <div class="control-icon">
                        <i class="fas fa-microphone"></i>
                    </div>
                    <span class="control-label">Mute</span>
                </button>

                <!-- Camera Toggle -->
                <button class="control-btn active" id="toggleCam">
                    <div class="control-icon">
                        <i class="fas fa-video"></i>
                    </div>
                    <span class="control-label">Camera</span>
                </button>

                <!-- Notes Button -->
                <button class="control-btn" id="toggleNotes">
                    <div class="control-icon">
                        <i class="fas fa-notes-medical"></i>
                    </div>
                    <span class="control-label">Notes</span>
                </button>

                <!-- End Call -->
                <button class="control-btn danger" id="endCall">
                    <div class="control-icon">
                        <i class="fas fa-phone-slash"></i>
                    </div>
                    <span class="control-label">End</span>
                </button>
            </div>
        </div>

        <!-- Mobile Controls (Fixed at bottom) -->
        <div class="mobile-controls-bar">
            <div class="mobile-controls-wrapper">
                <!-- Microphone Toggle -->
                <button class="mobile-control-btn active" id="mobileToggleMic">
                    <div class="mobile-control-icon">
                        <i class="fas fa-microphone"></i>
                    </div>
                    <span class="mobile-control-label">Mute</span>
                </button>

                <!-- Camera Toggle -->
                <button class="mobile-control-btn active" id="mobileToggleCam">
                    <div class="mobile-control-icon">
                        <i class="fas fa-video"></i>
                    </div>
                    <span class="mobile-control-label">Camera</span>
                </button>

                <!-- Notes Button -->
                <button class="mobile-control-btn" id="mobileToggleNotes">
                    <div class="mobile-control-icon">
                        <i class="fas fa-notes-medical"></i>
                    </div>
                    <span class="mobile-control-label">Notes</span>
                </button>

                <!-- End Call -->
                <button class="mobile-control-btn danger" id="mobileEndCall">
                    <div class="mobile-control-icon">
                        <i class="fas fa-phone-slash"></i>
                    </div>
                    <span class="mobile-control-label">End</span>
                </button>
            </div>
        </div>
    </main>

    <!-- Desktop Notes Modal -->
    <div class="desktop-notes-modal" id="desktopNotesModal">
        <div class="desktop-notes-panel">
            <div class="notes-header">
                <h3>
                    <i class="fas fa-notes-medical"></i>
                    Consultation Notes
                </h3>
                <button class="close-notes" id="desktopCloseNotes">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="notes-content">
                <textarea id="notesText" placeholder="Enter consultation notes here...
• Symptoms observed
• Preliminary diagnosis
• Prescription details
• Follow-up recommendations
• Additional observations"></textarea>
            </div>
            <div class="notes-footer">
                <div class="notes-actions">
                    <button class="btn btn-outline" id="desktopClearNotes">
                        <i class="fas fa-trash-alt"></i> Clear
                    </button>
                    <button class="btn btn-primary" id="desktopSaveNotes">
                        <i class="fas fa-save"></i> Save Notes
                    </button>
                </div>
                <div class="char-count">
                    <span id="desktopCharCount">0</span> characters
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Notes Panel (Slides up from bottom) -->
    <div class="mobile-notes-panel" id="mobileNotesPanel">
        <div class="notes-header">
            <h3>
                <i class="fas fa-notes-medical"></i>
                Consultation Notes
            </h3>
            <button class="close-notes" id="mobileCloseNotes">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="notes-content">
            <textarea id="mobileNotesText" placeholder="Enter consultation notes here...
• Symptoms observed
• Preliminary diagnosis
• Prescription details
• Follow-up recommendations
• Additional observations"></textarea>
        </div>
        <div class="notes-footer">
            <div class="notes-actions">
                <button class="btn btn-outline" id="mobileClearNotes">
                    <i class="fas fa-trash-alt"></i> Clear
                </button>
                <button class="btn btn-primary" id="mobileSaveNotes">
                    <i class="fas fa-save"></i> Save
                </button>
            </div>
            <div class="char-count">
                <span id="mobileCharCount">0</span> characters
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ===============================
        // EXISTING LOGIC FROM DOC_VIDEO.EJS
        // ===============================

        // Variables
        const ROOM_ID = "<%= roomId %>";
        const APPOINTMENT_ID = "<%= appointment.id %>";

        // DOM Elements
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const callStatusText = document.getElementById('callStatusText');

        // Video call state
        let localStream = null;
        let remoteStream = null;
        let peerConnection = null;
        let socket = null;
        let callStartTime = null;
        let isAudioMuted = false;
        let isVideoOff = false;

        // ===============================
        // UI-SPECIFIC FUNCTIONS (NEW)
        // ===============================

        // Theme toggle functionality
        document.addEventListener('DOMContentLoaded', function () {
            const themeToggle = document.getElementById('themeToggle');
            const mobileThemeToggle = document.getElementById('mobileThemeToggle');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            if (savedTheme) {
                html.setAttribute('data-theme', savedTheme);
                updateThemeIcon(savedTheme);
            }

            function toggleTheme() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            }

            function updateThemeIcon(theme) {
                const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
                if (mobileThemeToggle) {
                    mobileThemeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
                }
            }

            themeToggle.addEventListener('click', toggleTheme);
            if (mobileThemeToggle) {
                mobileThemeToggle.addEventListener('click', toggleTheme);
            }

            // Mobile menu functionality (from doc_home)
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeMenuBtn = document.getElementById('closeMenu');
            const mobileMenu = document.getElementById('mobileMenu');

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    mobileMenu.classList.add('active');
                    document.body.style.overflow = 'hidden';
                });
            }

            if (closeMenuBtn) {
                closeMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            document.addEventListener('click', (e) => {
                if (mobileMenu.classList.contains('active') &&
                    !mobileMenu.contains(e.target) &&
                    e.target !== mobileMenuBtn) {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            // Notes functionality
            setupNotesFunctionality();

            // Setup control button sync between desktop and mobile
            setupControlButtons();
        });

        // Setup notes functionality for both desktop and mobile
        function setupNotesFunctionality() {
            // Desktop notes
            const toggleNotes = document.getElementById('toggleNotes');
            const desktopNotesModal = document.getElementById('desktopNotesModal');
            const desktopCloseNotes = document.getElementById('desktopCloseNotes');
            const notesText = document.getElementById('notesText');
            const desktopCharCount = document.getElementById('desktopCharCount');
            const desktopClearNotes = document.getElementById('desktopClearNotes');
            const desktopSaveNotes = document.getElementById('desktopSaveNotes');

            // Mobile notes
            const mobileToggleNotes = document.getElementById('mobileToggleNotes');
            const mobileNotesPanel = document.getElementById('mobileNotesPanel');
            const mobileCloseNotes = document.getElementById('mobileCloseNotes');
            const mobileNotesText = document.getElementById('mobileNotesText');
            const mobileCharCount = document.getElementById('mobileCharCount');
            const mobileClearNotes = document.getElementById('mobileClearNotes');
            const mobileSaveNotes = document.getElementById('mobileSaveNotes');

            // Character counters
            notesText.addEventListener('input', function () {
                desktopCharCount.textContent = this.value.length;
                mobileNotesText.value = this.value; // Sync with mobile
                mobileCharCount.textContent = this.value.length;
            });

            mobileNotesText.addEventListener('input', function () {
                mobileCharCount.textContent = this.value.length;
                notesText.value = this.value; // Sync with desktop
                desktopCharCount.textContent = this.value.length;
            });

            // Desktop notes toggle
            if (toggleNotes) {
                toggleNotes.addEventListener('click', () => {
                    desktopNotesModal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                });
            }

            if (desktopCloseNotes) {
                desktopCloseNotes.addEventListener('click', () => {
                    desktopNotesModal.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Mobile notes toggle
            if (mobileToggleNotes) {
                mobileToggleNotes.addEventListener('click', () => {
                    mobileNotesPanel.classList.add('active');
                    document.body.style.overflow = 'hidden';
                });
            }

            if (mobileCloseNotes) {
                mobileCloseNotes.addEventListener('click', () => {
                    mobileNotesPanel.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Clear notes buttons
            if (desktopClearNotes) {
                desktopClearNotes.addEventListener('click', function () {
                    if (confirm('Are you sure you want to clear all notes?')) {
                        notesText.value = '';
                        mobileNotesText.value = '';
                        desktopCharCount.textContent = '0';
                        mobileCharCount.textContent = '0';
                    }
                });
            }

            if (mobileClearNotes) {
                mobileClearNotes.addEventListener('click', function () {
                    if (confirm('Are you sure you want to clear all notes?')) {
                        notesText.value = '';
                        mobileNotesText.value = '';
                        desktopCharCount.textContent = '0';
                        mobileCharCount.textContent = '0';
                    }
                });
            }

            // Save notes buttons
            if (desktopSaveNotes) {
                desktopSaveNotes.addEventListener('click', saveNotes);
            }

            if (mobileSaveNotes) {
                mobileSaveNotes.addEventListener('click', saveNotes);
            }
        }

        // Sync control buttons between desktop and mobile
        function setupControlButtons() {
            // Get all control buttons
            const toggleMic = document.getElementById('toggleMic');
            const toggleCam = document.getElementById('toggleCam');
            const endCall = document.getElementById('endCall');
            const mobileToggleMic = document.getElementById('mobileToggleMic');
            const mobileToggleCam = document.getElementById('mobileToggleCam');
            const mobileEndCall = document.getElementById('mobileEndCall');

            // Mic toggle sync
            if (toggleMic && mobileToggleMic) {
                toggleMic.addEventListener('click', () => {
                    setTimeout(() => {
                        syncButtonState(toggleMic, mobileToggleMic);
                    }, 0);
                });
                mobileToggleMic.addEventListener('click', () => {
                    setTimeout(() => {
                        syncButtonState(mobileToggleMic, toggleMic);
                    }, 0);
                });
            }

            // Camera toggle sync
            if (toggleCam && mobileToggleCam) {
                toggleCam.addEventListener('click', () => {
                    setTimeout(() => {
                        syncButtonState(toggleCam, mobileToggleCam);
                    }, 0);
                });
                mobileToggleCam.addEventListener('click', () => {
                    setTimeout(() => {
                        syncButtonState(mobileToggleCam, toggleCam);
                    }, 0);
                });
            }

            // End call button sync
            if (endCall && mobileEndCall) {
                endCall.addEventListener('click', endCallHandler);
                mobileEndCall.addEventListener('click', endCallHandler);
            }
        }

        // Sync button state between desktop and mobile buttons
        function syncButtonState(sourceButton, targetButton) {
            const isActive = sourceButton.classList.contains('active');
            const icon = sourceButton.querySelector('i');
            const label = sourceButton.querySelector('.control-label, .mobile-control-label');

            // Update target button
            targetButton.classList.toggle('active', isActive);
            if (icon) {
                targetButton.querySelector('i').className = icon.className;
            }
            if (label) {
                targetButton.querySelector('.control-label, .mobile-control-label').textContent = label.textContent;
            }
        }

        // ===============================
        // EXISTING VIDEO CALL LOGIC
        // ===============================

        // Update status display
        function updateStatus(message, type) {
            if (callStatusText) {
                callStatusText.textContent = `CALL STATUS: ${message}`;

                // Update status indicator color
                const statusDots = document.querySelectorAll('.status-dot');
                const statusColor = type === 'connected' ? '#10b981' :
                    type === 'warning' ? '#f59e0b' :
                        type === 'disconnected' ? '#ef4444' : '#60a5fa';

                statusDots.forEach(dot => {
                    dot.style.backgroundColor = statusColor;
                });
            }
        }

        // Get user media
        async function getLocalStream() {
            try {
                localStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 1280 },
                        height: { ideal: 720 },
                        frameRate: { ideal: 30 }
                    },
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });

                localVideo.srcObject = localStream;
                const videoLoading = document.getElementById('videoLoading');
                if (videoLoading) videoLoading.classList.add('hidden');
            } catch (error) {
                console.error('Error accessing media devices:', error);
                updateStatus('MEDIA ERROR', 'disconnected');
                alert('Unable to access camera and microphone. Please check permissions.');
            }
        }

        // Create peer connection
        async function createPeerConnection() {
            const configuration = {
                iceServers: [
                    { urls: 'stun:stun.l.google.com:19302' },
                    { urls: 'stun:stun1.l.google.com:19302' },
                    { urls: 'stun:stun2.l.google.com:19302' }
                ]
            };

            peerConnection = new RTCPeerConnection(configuration);

            // Add local stream tracks
            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
            });

            // Handle remote stream
            peerConnection.ontrack = (event) => {
                if (!remoteVideo.srcObject) {
                    remoteVideo.srcObject = event.streams[0];
                    remoteStream = event.streams[0];
                }
            };

            // Handle ICE candidates
            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        candidate: event.candidate
                    });
                }
            };

            // Handle connection state changes
            peerConnection.oniceconnectionstatechange = () => {
                if (peerConnection.iceConnectionState === 'disconnected' ||
                    peerConnection.iceConnectionState === 'failed') {
                    updateStatus('CONNECTION LOST', 'disconnected');
                } else if (peerConnection.iceConnectionState === 'connected') {
                    updateStatus('CONNECTED', 'connected');
                    startTimer();
                }
            };
        }

        // Create offer
        async function createOffer() {
            try {
                const offer = await peerConnection.createOffer({
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: true
                });

                await peerConnection.setLocalDescription(offer);

                socket.emit('signal', {
                    roomId: ROOM_ID,
                    offer: offer
                });
            } catch (error) {
                console.error('Error creating offer:', error);
            }
        }

        // Initialize Socket.io
        function initSocket() {
            socket = io();

            socket.on('connect', () => {
                updateStatus('CONNECTING...', 'warning');
                socket.emit('join-room', { roomId: ROOM_ID, role: 'doctor' });
            });

            socket.on('user-ready', async () => {
                updateStatus('PATIENT CONNECTED', 'warning');
                await createPeerConnection();
                await createOffer();
            });

            socket.on('signal', async (data) => {
                if (!peerConnection) {
                    await createPeerConnection();
                }

                if (data.answer) {
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                    updateStatus('CONNECTED', 'connected');
                    startTimer();
                } else if (data.candidate) {
                    try {
                        await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                    } catch (e) {
                        console.error('Error adding ICE candidate:', e);
                    }
                }
            });

            socket.on('call-ended', () => {
                endCallHandler();
            });

            socket.on('disconnect', () => {
                updateStatus('DISCONNECTED', 'disconnected');
            });
        }

        // Start call timer
        function startTimer() {
            if (!callStartTime) {
                callStartTime = Date.now();
                // Timer display would go here if needed
            }
        }

        // Toggle microphone
        function setupMicToggle(button) {
            if (button && localStream) {
                button.addEventListener('click', () => {
                    localStream.getAudioTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isAudioMuted = !localStream.getAudioTracks()[0].enabled;
                    button.classList.toggle('active', !isAudioMuted);

                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.className = isAudioMuted ? 'fas fa-microphone-slash' : 'fas fa-microphone';
                    }

                    const label = button.querySelector('.control-label, .mobile-control-label');
                    if (label) {
                        label.textContent = isAudioMuted ? 'Unmute' : 'Mute';
                    }
                });
            }
        }

        // Toggle camera
        function setupCamToggle(button) {
            if (button && localStream) {
                button.addEventListener('click', () => {
                    localStream.getVideoTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isVideoOff = !localStream.getVideoTracks()[0].enabled;
                    button.classList.toggle('active', !isVideoOff);

                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.className = isVideoOff ? 'fas fa-video-slash' : 'fas fa-video';
                    }

                    const label = button.querySelector('.control-label, .mobile-control-label');
                    if (label) {
                        label.textContent = isVideoOff ? 'Camera On' : 'Camera Off';
                    }
                });
            }
        }

        // Save notes function
        async function saveNotes() {
            const notesText = document.getElementById('notesText');
            const notes = notesText ? notesText.value.trim() : '';

            if (notes) {
                try {
                    await fetch("/api/notes/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            roomId: ROOM_ID,
                            notes: notes
                        })
                    });
                    alert('Notes saved successfully!');

                    // Close notes panel on mobile
                    const mobileNotesPanel = document.getElementById('mobileNotesPanel');
                    if (mobileNotesPanel && mobileNotesPanel.classList.contains('active')) {
                        mobileNotesPanel.classList.remove('active');
                        document.body.style.overflow = '';
                    }

                    // Close notes modal on desktop
                    const desktopNotesModal = document.getElementById('desktopNotesModal');
                    if (desktopNotesModal && desktopNotesModal.classList.contains('active')) {
                        desktopNotesModal.classList.remove('active');
                        document.body.style.overflow = '';
                    }
                } catch (error) {
                    console.error('Error saving notes:', error);
                    alert('Error saving notes');
                }
            } else {
                alert('No notes to save.');
            }
        }

        // End call handler
        async function endCallHandler() {
            const notesText = document.getElementById('notesText');
            const notes = notesText ? notesText.value.trim() : '';

            // Save notes locally first
            if (notes) {
                try {
                    await fetch("/api/notes/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            roomId: ROOM_ID,
                            notes: notes
                        })
                    });
                } catch (error) {
                    console.error('Error saving notes:', error);
                }
            }

            // Notify server
            if (socket) {
                socket.emit('doctor-end-call', {
                    roomId: ROOM_ID,
                    appointmentId: APPOINTMENT_ID,
                    notes: notes
                });
            }

            // Close peer connection
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }

            // Stop local stream
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
            }

            // Complete appointment
            try {
                await fetch(`/appointments/${APPOINTMENT_ID}/complete`, {
                    method: "POST"
                });
            } catch (error) {
                console.error('Error completing appointment:', error);
            }

            // Disconnect socket
            if (socket) {
                socket.disconnect();
            }

            // Redirect to dashboard
            window.location.href = "/doc_video_dashboard";
        }

        // Setup control button event listeners
        function setupControlEventListeners() {
            // Setup mic toggles
            const toggleMic = document.getElementById('toggleMic');
            const mobileToggleMic = document.getElementById('mobileToggleMic');
            setupMicToggle(toggleMic);
            setupMicToggle(mobileToggleMic);

            // Setup camera toggles
            const toggleCam = document.getElementById('toggleCam');
            const mobileToggleCam = document.getElementById('mobileToggleCam');
            setupCamToggle(toggleCam);
            setupCamToggle(mobileToggleCam);

            // Setup end call buttons
            const endCall = document.getElementById('endCall');
            const mobileEndCall = document.getElementById('mobileEndCall');
            if (endCall) endCall.addEventListener('click', endCallHandler);
            if (mobileEndCall) mobileEndCall.addEventListener('click', endCallHandler);
        }

        // Initialize
        async function init() {
            updateStatus('INITIALIZING...', 'warning');
            await getLocalStream();
            initSocket();
            setupControlEventListeners();
        }

        init();

        // Handle page unload
        window.addEventListener('beforeunload', (e) => {
            if (peerConnection || socket?.connected) {
                e.preventDefault();
                e.returnValue = 'Are you sure you want to leave the call?';
                return e.returnValue;
            }
        });
    </script>

    <!-- Global Loader Script -->
    <script>
        (function () {
            // Create Loader HTML + CSS
            const style = document.createElement("style");
            style.innerHTML = `
                #global-loader {
                    position: fixed;
                    inset: 0;
                    background: #ffffff;
                    z-index: 99999;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
                }

                #global-loader.hidden {
                    opacity: 0;
                    pointer-events: none;
                    transition: opacity 0.3s ease;
                }

                #global-loader .spinner {
                    width: 46px;
                    height: 46px;
                    border: 4px solid #e5e7eb;
                    border-top-color: #2563eb;
                    border-radius: 50%;
                    animation: spin 0.9s linear infinite;
                    margin-bottom: 12px;
                }

                #global-loader p {
                    font-size: 14px;
                    color: #374151;
                }

                @keyframes spin {
                    to { transform: rotate(360deg); }
                }
            `;
            document.head.appendChild(style);

            const loader = document.createElement("div");
            loader.id = "global-loader";
            loader.innerHTML = `
                <div class="spinner"></div>
                <p>Loading, please wait…</p>
            `;
            document.body.appendChild(loader);

            // Hide loader when page loaded
            window.addEventListener("load", () => {
                loader.classList.add("hidden");
                setTimeout(() => loader.remove(), 400);
            });

            // Show loader on link navigation
            document.addEventListener("click", (e) => {
                const link = e.target.closest("a");

                if (!link) return;
                if (link.target === "_blank") return;
                if (link.href.startsWith("mailto:")) return;
                if (link.href.startsWith("tel:")) return;
                if (link.hasAttribute("download")) return;

                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // Show loader on form submit
            document.addEventListener("submit", () => {
                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // Safety fallback (10s)
            setTimeout(() => {
                if (document.body.contains(loader)) {
                    loader.remove();
                }
            }, 10000);
        })();
    </script>

</body>

