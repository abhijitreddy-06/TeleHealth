<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Doctor Consultation | TeleHealth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            /* Professional Color Palette */
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --secondary: #059669;
            --accent: #7c3aed;
            --background: #0f172a;
            --surface: #1e293b;
            --surface-light: #334155;
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-tertiary: #94a3b8;
            --border: #475569;
            --error: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
            --info: #3b82f6;
            --overlay: rgba(15, 23, 42, 0.95);

            /* Light Theme */
            --light-bg: #f8fafc;
            --light-surface: #ffffff;
            --light-surface-alt: #f1f5f9;
            --light-text: #0f172a;
            --light-text-secondary: #475569;
            --light-border: #e2e8f0;

            /* Design Tokens */
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --radius-sm: 8px;
            --radius: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-full: 9999px;
        }

        [data-theme="light"] {
            --background: var(--light-bg);
            --surface: var(--light-surface);
            --surface-light: var(--light-surface-alt);
            --text-primary: var(--light-text);
            --text-secondary: var(--light-text-secondary);
            --text-tertiary: #64748b;
            --border: var(--light-border);
            --overlay: rgba(255, 255, 255, 0.95);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Inter", "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: var(--background);
            color: var(--text-primary);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-size: 16px;
        }

        /* Header */
        header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            height: 64px;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            height: 100%;
            width: 100%;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
        }

        .logo-text {
            font-size: 22px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .call-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .patient-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: var(--surface-light);
            border-radius: var(--radius);
            font-size: 15px;
            font-weight: 500;
            white-space: nowrap;
        }

        .patient-badge i {
            color: var(--primary);
            font-size: 16px;
        }

        .timer {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            padding: 8px 16px;
            border-radius: var(--radius);
            color: white;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow);
            white-space: nowrap;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--surface-light);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            font-size: 18px;
        }

        .icon-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-1px);
        }

        /* Main Video Layout - Desktop Optimized */
        .video-container {
            display: grid;
            grid-template-columns: 1fr 380px;
            grid-template-rows: 1fr 80px;
            height: calc(100vh - 64px);
            gap: 16px;
            padding: 16px;
            position: relative;
            max-width: 1800px;
            margin: 0 auto;
            width: 100%;
        }

        /* Main Video Area */
        .video-main {
            grid-column: 1;
            grid-row: 1;
            background: #020617;
            border-radius: var(--radius-lg);
            overflow: hidden;
            position: relative;
            box-shadow: var(--shadow-xl);
            min-height: 0;
        }

        [data-theme="light"] .video-main {
            background: #1e293b;
        }

        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Local Video - PiP (Desktop - Made smaller) */
        .video-local {
            position: absolute;
            bottom: 16px;
            right: 16px;
            width: 200px;
            /* Reduced from 240px */
            height: 150px;
            /* Reduced from 180px */
            border-radius: var(--radius);
            overflow: hidden;
            border: 3px solid var(--primary);
            box-shadow: var(--shadow-xl);
            background: #000;
            z-index: 10;
            transition: var(--transition);
        }

        .video-local:hover {
            transform: scale(1.02);
            border-color: var(--accent);
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .video-label {
            position: absolute;
            bottom: -36px;
            left: 0;
            right: 0;
            background: var(--overlay);
            color: white;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            backdrop-filter: blur(10px);
            border-radius: 0 0 var(--radius) var(--radius);
        }

        /* Status Overlay */
        .status-overlay {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 20;
        }

        .connection-status {
            background: var(--overlay);
            padding: 12px 16px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            max-width: 320px;
        }

        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--success);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        #statusText {
            font-size: 15px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }

        .participant-info {
            background: var(--overlay);
            padding: 12px 16px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            max-width: 320px;
        }

        .participant-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 18px;
        }

        #participantName {
            font-size: 16px;
            font-weight: 600;
        }

        #callStatus {
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* Notes Panel */
        .notes-panel {
            grid-column: 2;
            grid-row: 1;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
            min-height: 0;
        }

        .notes-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .notes-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .notes-title i {
            color: var(--primary);
            font-size: 20px;
        }

        .notes-actions {
            display: flex;
            gap: 8px;
        }

        .notes-action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface-light);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            font-size: 16px;
        }

        .notes-action-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .notes-textarea {
            flex: 1;
            width: 100%;
            background: var(--surface-light);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            font-family: inherit;
            font-size: 15px;
            line-height: 1.6;
            resize: none;
            transition: var(--transition);
            min-height: 200px;
        }

        .notes-textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .notes-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
            font-size: 13px;
            color: var(--text-secondary);
        }

        .auto-save {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .auto-save i {
            color: var(--success);
            font-size: 14px;
        }

        .char-count {
            font-size: 13px;
            font-weight: 500;
        }

        /* Controls Bar (Desktop - Made smaller) */
        .controls-bar {
            grid-column: 1 / -1;
            grid-row: 2;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            padding: 12px;
            background: var(--surface);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            margin-top: 0;
            height: 80px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .control-btn {
            width: 48px;
            /* Reduced from 56px */
            height: 48px;
            /* Reduced from 56px */
            border-radius: 50%;
            border: none;
            background: var(--surface-light);
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            /* Reduced from 20px */
            transition: var(--transition);
            position: relative;
            box-shadow: var(--shadow);
        }

        .control-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .control-btn.active {
            background: var(--primary);
            color: white;
        }

        .control-btn.danger {
            background: var(--error);
            color: white;
        }

        .control-btn.danger:hover {
            background: #dc2626;
            transform: scale(1.05);
        }

        .control-label {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Loading State */
        .video-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 5;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(37, 99, 235, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 16px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .video-loading p {
            color: var(--text-secondary);
            font-size: 16px;
            font-weight: 500;
        }

        /* Utility Classes */
        .hidden {
            display: none !important;
        }

        .visible {
            display: block;
        }

        .text-center {
            text-align: center;
        }

        /* Mobile Close Button */
        .mobile-close-btn {
            display: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--error);
            color: white;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: var(--transition);
            margin-left: auto;
        }

        .mobile-close-btn:hover {
            background: #dc2626;
            transform: rotate(90deg);
        }

        /* Scrollbar Styling */
        .notes-textarea::-webkit-scrollbar {
            width: 6px;
        }

        .notes-textarea::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 3px;
        }

        .notes-textarea::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 3px;
        }

        .notes-textarea::-webkit-scrollbar-thumb:hover {
            background: var(--primary-hover);
        }

        /* Prevent text size adjustment on orientation change */
        html {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
        }

        /* Improve touch targets */
        button,
        .notes-action-btn,
        .control-btn,
        .icon-btn {
            touch-action: manipulation;
        }

        /* ============= MOBILE VIEW ============= */
        @media (max-width: 768px) {
            .video-container {
                display: flex;
                flex-direction: column;
                height: calc(100vh - 60px);
                gap: 0;
                padding: 0;
                overflow: hidden;
            }

            header {
                height: 60px;
            }

            .navbar {
                padding: 0 15px;
            }

            .logo-icon {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .logo-text {
                font-size: 18px;
            }

            .patient-badge {
                padding: 6px 10px;
                font-size: 13px;
                max-width: 120px;
            }

            .patient-badge span {
                display: none;
            }

            .patient-badge i {
                font-size: 14px;
            }

            .timer {
                padding: 6px 10px;
                font-size: 13px;
            }

            .icon-btn {
                width: 36px;
                height: 36px;
                font-size: 16px;
            }

            /* Video Main Area - Mobile */
            .video-main {
                flex: 1;
                min-height: 0;
                border-radius: 0;
                box-shadow: none;
                position: relative;
            }

            /* Local Video PiP - Mobile (Fixed to avoid controls overlap) */
            .video-local {
                position: absolute;
                bottom: 100px;
                /* Increased to avoid controls overlap */
                right: 10px;
                width: 140px;
                height: 105px;
                border-width: 2px;
                z-index: 25;
            }

            .video-label {
                font-size: 12px;
                padding: 6px 8px;
                bottom: -28px;
            }

            /* Status Overlay - Mobile */
            .status-overlay {
                top: 10px;
                left: 10px;
                right: 10px;
                flex-direction: row;
                flex-wrap: wrap;
                gap: 8px;
            }

            .connection-status,
            .participant-info {
                padding: 8px 12px;
                max-width: none;
                flex: 1;
                min-width: 0;
            }

            #statusText {
                font-size: 13px;
            }

            .participant-avatar {
                width: 32px;
                height: 32px;
                font-size: 14px;
            }

            #participantName {
                font-size: 14px;
            }

            #callStatus {
                font-size: 11px;
            }

            /* Controls Bar - Mobile (Fixed position) */
            .controls-bar {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--surface);
                border-top: 1px solid var(--border);
                padding: 12px;
                gap: 16px;
                border-radius: 0;
                margin-top: 0;
                z-index: 100;
                box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
                height: 80px;
            }

            .control-btn {
                width: 50px;
                height: 50px;
                font-size: 18px;
            }

            .control-label {
                font-size: 10px;
            }

            /* Notes Panel - Mobile (Half Screen with X button) */
            .notes-panel {
                position: fixed;
                top: auto;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--surface);
                border-top: 1px solid var(--border);
                box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
                z-index: 1000;
                height: 50vh;
                /* Half the screen */
                transform: translateY(100%);
                transition: transform 0.3s ease-out;
                display: flex;
                flex-direction: column;
                border-radius: var(--radius-lg) var(--radius-lg) 0 0;
                padding: 16px;
                padding-bottom: 20px;
            }

            .notes-panel.active {
                transform: translateY(0);
            }

            .notes-header {
                padding: 0 0 12px 0;
                margin-bottom: 12px;
                position: relative;
            }

            .mobile-close-btn {
                display: flex;
            }

            .notes-title {
                font-size: 16px;
            }

            .notes-title i {
                font-size: 18px;
            }

            .notes-action-btn {
                width: 36px;
                height: 36px;
                font-size: 15px;
            }

            .notes-textarea {
                padding: 12px;
                font-size: 15px;
                min-height: calc(50vh - 140px);
                /* Adjust based on header/footer */
                flex: 1;
            }

            .notes-footer {
                padding: 12px 0 0 0;
                font-size: 12px;
                margin-top: 12px;
            }

            /* Toggle Notes Button - Mobile */
            .toggle-notes-btn {
                position: fixed;
                bottom: 90px;
                /* Positioned above controls */
                left: 10px;
                width: 56px;
                height: 56px;
                border-radius: 50%;
                background: var(--primary);
                color: white;
                border: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                box-shadow: var(--shadow-xl);
                z-index: 40;
                transition: all 0.3s ease;
            }

            .toggle-notes-btn:hover {
                transform: scale(1.1);
                background: var(--primary-hover);
            }

            .toggle-notes-btn.active {
                background: var(--error);
            }
        }

        /* Extra Small Mobile */
        @media (max-width: 480px) {
            .logo-text {
                display: none;
            }

            .patient-badge {
                max-width: 40px;
                padding: 6px;
            }

            .timer {
                padding: 6px 8px;
                font-size: 12px;
            }

            .video-local {
                width: 120px;
                height: 90px;
                bottom: 90px;
                /* Adjusted for smaller screens */
                right: 8px;
            }

            .video-label {
                font-size: 11px;
                padding: 5px;
                bottom: -24px;
            }

            .controls-bar {
                padding: 10px;
                gap: 12px;
                height: 75px;
            }

            .control-btn {
                width: 46px;
                height: 46px;
                font-size: 16px;
            }

            .control-label {
                font-size: 9px;
            }

            .toggle-notes-btn {
                bottom: 85px;
                left: 8px;
                width: 50px;
                height: 50px;
                font-size: 20px;
            }

            .notes-panel {
                height: 50vh;
            }
        }

        /* Small Landscape Mobile */
        @media (max-width: 768px) and (orientation: landscape) {
            .video-container {
                flex-direction: row;
            }

            .video-main {
                flex: 2;
            }

            .video-local {
                width: 100px;
                height: 75px;
                bottom: 20px;
                right: 20px;
            }

            .notes-panel {
                height: 80vh;
                width: 300px;
                left: auto;
                right: 0;
                transform: translateX(100%);
                border-radius: var(--radius-lg) 0 0 var(--radius-lg);
            }

            .notes-panel.active {
                transform: translateX(0);
            }

            .notes-textarea {
                min-height: calc(80vh - 140px);
            }

            .controls-bar {
                height: 70px;
            }

            .toggle-notes-btn {
                bottom: 80px;
                left: 10px;
            }
        }

        /* Desktop Optimizations */
        @media (min-width: 769px) {

            /* Hide toggle notes button in desktop view */
            .toggle-notes-btn {
                display: none !important;
            }

            /* Hide mobile close button in desktop */
            .mobile-close-btn {
                display: none !important;
            }
        }

        @media (min-width: 1200px) {
            .video-container {
                grid-template-columns: 1fr 380px;
                gap: 16px;
                padding: 16px;
            }

            .notes-panel {
                padding: 20px;
            }

            .video-local {
                width: 220px;
                height: 165px;
            }

            .controls-bar {
                gap: 24px;
                padding: 14px;
            }

            .control-btn {
                width: 52px;
                height: 52px;
            }
        }

        @media (min-width: 1600px) {
            .video-container {
                grid-template-columns: 1fr 400px;
                gap: 20px;
                padding: 20px;
            }

            .notes-panel {
                padding: 24px;
            }

            .video-local {
                width: 240px;
                height: 180px;
                bottom: 20px;
                right: 20px;
            }
        }
        /* ===== FIX: Ensure PiP never overlaps controls ===== */
@media (max-width: 768px) {
    .video-local {
        bottom: auto; /* ❌ remove static bottom */
        right: 10px;
        z-index: 50;
    }

    /* Ensure toggle button always clickable */
    .toggle-notes-btn {
        z-index: 200;
        pointer-events: auto;
    }

    /* Controls should not block clicks above */
    .controls-bar {
        z-index: 100;
    }
}
@media (max-width: 768px) {
    .video-local {
        position: fixed;              /* ✅ KEY FIX */
        right: 10px;
        bottom: 96px;                 /* space for controls */
        width: 140px;
        height: 105px;
        z-index: 150;                 /* above controls */
        border-width: 2px;
        pointer-events: auto;
    }
}
.controls-bar {
    touch-action: manipulation;
}

    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <nav class="navbar">
            <div class="logo-container">
                <div class="logo-icon">
                    <i class="fas fa-stethoscope"></i>
                </div>
                <div class="logo-text">TeleHealth</div>
            </div>

            <div class="call-info">
                <div class="patient-badge">
                    <i class="fas fa-user-injured"></i>
                    <span>Patient Consultation</span>
                </div>
                <div class="timer" id="callTimer">
                    <i class="fas fa-clock"></i>
                    <span>00:00:00</span>
                </div>
            </div>

            <div class="header-controls">
                <button class="icon-btn" id="themeToggle" title="Toggle theme">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main class="video-container">
        <!-- Main Video Area -->
        <div class="video-main">
            <video id="remoteVideo" autoplay playsinline></video>

            <!-- Status Overlay -->
            <div class="status-overlay">
                <div class="connection-status" id="connectionStatus">
                    <div class="status-indicator" id="statusIndicator"></div>
                    <span id="statusText">Connecting...</span>
                </div>

                <div class="participant-info" id="participantInfo">
                    <div class="participant-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div id="participantName">Patient</div>
                        <div id="callStatus">
                            Waiting for patient to join...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Local Video PiP -->
            <div class="video-local">
                <video id="localVideo" autoplay muted playsinline></video>
                <div class="video-label">
                    <i class="fas fa-user-md"></i>
                    <span>You</span>
                </div>
            </div>

            <!-- Loading State -->
            <div class="video-loading hidden" id="videoLoading">
                <div class="loading-spinner"></div>
                <p>Establishing connection...</p>
            </div>
        </div>

        <!-- Notes Panel -->
        <div class="notes-panel" id="notesPanel">
            <div class="notes-header">
                <div class="notes-title">
                    <i class="fas fa-notes-medical"></i>
                    <span>Consultation Notes</span>
                </div>
                <div class="notes-actions">
                    <button class="notes-action-btn" id="clearNotes" title="Clear all notes">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <button class="notes-action-btn" id="saveNotes" title="Save notes">
                        <i class="fas fa-save"></i>
                    </button>
                    <button class="mobile-close-btn" id="mobileCloseNotes" title="Close notes">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <textarea id="notesText" class="notes-textarea" placeholder="Enter consultation notes here...
• Symptoms observed
• Preliminary diagnosis
• Prescription details
• Follow-up recommendations
• Additional observations"></textarea>
            <div class="notes-footer">
                <div class="auto-save">
                    <i class="fas fa-check-circle"></i>
                    <span>Auto-save enabled</span>
                </div>
                <div class="char-count">
                    <span id="charCount">0</span> characters
                </div>
            </div>
        </div>

        <!-- Toggle Notes Button (Mobile Only) -->
        <button class="toggle-notes-btn" id="toggleNotesBtn" title="Show notes">
            <i class="fas fa-notes-medical"></i>
        </button>

        <!-- Controls Bar -->
        <div class="controls-bar">
            <div class="control-group">
                <button class="control-btn active" id="toggleMic">
                    <i class="fas fa-microphone"></i>
                </button>
                <span class="control-label">Mic On</span>
            </div>

            <div class="control-group">
                <button class="control-btn active" id="toggleCam">
                    <i class="fas fa-video"></i>
                </button>
                <span class="control-label">Camera On</span>
            </div>

            <div class="control-group">
                <button class="control-btn danger" id="endCall">
                    <i class="fas fa-phone-slash"></i>
                </button>
                <span class="control-label">End Call</span>
            </div>
        </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Mobile-specific UI enhancements
        document.addEventListener('DOMContentLoaded', function () {
            // Variables
            const ROOM_ID = "<%= roomId %>";
            const APPOINTMENT_ID = "<%= appointment.id %>";

            // UI Elements for mobile
            const notesPanel = document.getElementById('notesPanel');
            const toggleNotesBtn = document.getElementById('toggleNotesBtn');
            const mobileCloseNotes = document.getElementById('mobileCloseNotes');
            const videoLocal = document.querySelector('.video-local');
            const isMobile = window.innerWidth <= 768;

            // Mobile-specific UI setup
            if (isMobile) {
                // Make notes panel slide smoothly
                notesPanel.style.transition = 'transform 0.3s ease-out';

                // Toggle notes panel with smooth animation
                toggleNotesBtn.addEventListener('click', function () {
                    openNotesPanel();
                });

                // Close notes panel with X button
                mobileCloseNotes.addEventListener('click', function () {
                    closeNotesPanel();
                });

                // Close notes panel when clicking outside on mobile
                document.addEventListener('click', function (event) {
                    if (notesPanel.classList.contains('active') &&
                        !notesPanel.contains(event.target) &&
                        event.target !== toggleNotesBtn &&
                        !toggleNotesBtn.contains(event.target)) {
                        closeNotesPanel();
                    }
                });

                // Function to open notes panel
                function openNotesPanel() {
                    notesPanel.classList.add('active');
                    toggleNotesBtn.classList.add('active');
                    toggleNotesBtn.innerHTML = '<i class="fas fa-times"></i>';
                    toggleNotesBtn.title = 'Hide notes';
                    document.body.style.overflow = 'hidden';

                    // Adjust local video position
                    adjustLocalVideoPosition();
                }

                // Function to close notes panel
                function closeNotesPanel() {
                    notesPanel.classList.remove('active');
                    toggleNotesBtn.classList.remove('active');
                    toggleNotesBtn.innerHTML = '<i class="fas fa-notes-medical"></i>';
                    toggleNotesBtn.title = 'Show notes';
                    document.body.style.overflow = '';

                    // Adjust local video position
                    adjustLocalVideoPosition();
                }

                // Adjust local video position based on notes panel state
                function adjustLocalVideoPosition() {
                    if (!videoLocal) return;

                    const controlsBar = document.querySelector('.controls-bar');
                    const controlsHeight = controlsBar ? controlsBar.offsetHeight : 80;

                    if (notesPanel.classList.contains('active')) {
                        // When notes are open (50vh), position local video higher
                        // Calculate space above notes panel
                        const notesHeight = window.innerHeight * 0.5; // 50vh
                        const availableSpace = window.innerHeight - notesHeight - controlsHeight;

                        // Position in the middle of available space above notes
                        const videoBottom = notesHeight + (availableSpace / 2) - 60;
                        videoLocal.style.bottom = `${Math.max(20, videoBottom)}px`;
                    } else {
                        // When notes are closed, position above controls
                        const bottomPosition = controlsHeight + 20;
                        videoLocal.style.bottom = `${bottomPosition}px`;
                    }
                }

                // Initial adjustment
                adjustLocalVideoPosition();

                // Adjust on resize
                window.addEventListener('resize', function () {
                    adjustLocalVideoPosition();
                });

                // Also adjust when orientation changes
                window.addEventListener('orientationchange', function () {
                    setTimeout(function () {
                        adjustLocalVideoPosition();
                    }, 300);
                });
            }

            // Your existing JavaScript code remains exactly the same
            let localStream = null;
            let remoteStream = null;
            let peerConnection = null;
            let socket = null;
            let callStartTime = null;
            let isAudioMuted = false;
            let isVideoOff = false;

            // DOM Elements
            const localVideo = document.getElementById('localVideo');
            const remoteVideo = document.getElementById('remoteVideo');
            const toggleMic = document.getElementById('toggleMic');
            const toggleCam = document.getElementById('toggleCam');
            const endCall = document.getElementById('endCall');
            const callTimer = document.getElementById('callTimer');
            const statusText = document.getElementById('statusText');
            const statusIndicator = document.getElementById('statusIndicator');
            const notesText = document.getElementById('notesText');
            const charCount = document.getElementById('charCount');

            // Theme Toggle
            const themeToggle = document.getElementById('themeToggle');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme') || 'dark';
            html.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);

            function toggleTheme() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            }

            function updateThemeIcon(theme) {
                const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }

            themeToggle.addEventListener('click', toggleTheme);

            // Notes Character Counter
            notesText.addEventListener('input', function () {
                charCount.textContent = this.value.length;
            });

            // Initialize Socket.io
            function initSocket() {
                socket = io();

                socket.on('connect', () => {
                    updateStatus('Connecting to patient...', 'warning');
                    socket.emit('join-room', { roomId: ROOM_ID, role: 'doctor' });
                });

                socket.on('user-ready', async () => {
                    updateStatus('Patient connected, establishing call...', 'warning');
                    await createPeerConnection();
                    await createOffer();
                });

                socket.on('signal', async (data) => {
                    if (!peerConnection) {
                        await createPeerConnection();
                    }

                    if (data.answer) {
                        await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                        updateStatus('Call connected', 'connected');
                        startTimer();
                    } else if (data.candidate) {
                        try {
                            await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                        } catch (e) {
                            console.error('Error adding ICE candidate:', e);
                        }
                    }
                });

                socket.on('call-ended', () => {
                    endCallHandler();
                });

                socket.on('disconnect', () => {
                    updateStatus('Disconnected from server', 'disconnected');
                });
            }

            // Update status display
            function updateStatus(message, type) {
                statusText.textContent = message;
                statusIndicator.style.background = type === 'connected' ? 'var(--success)' :
                    type === 'warning' ? 'var(--warning)' :
                        type === 'disconnected' ? 'var(--error)' : 'var(--info)';
            }

            // Get user media
            async function getLocalStream() {
                try {
                    localStream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            width: { ideal: 1280 },
                            height: { ideal: 720 },
                            frameRate: { ideal: 30 }
                        },
                        audio: {
                            echoCancellation: true,
                            noiseSuppression: true,
                            autoGainControl: true
                        }
                    });

                    localVideo.srcObject = localStream;
                } catch (error) {
                 
                    alert('Unable to access camera and microphone. Please check permissions.');
                }
            }

            // Create peer connection
            async function createPeerConnection() {
                const configuration = {
                    iceServers: [
                        { urls: 'stun:stun.l.google.com:19302' },
                        { urls: 'stun:stun1.l.google.com:19302' },
                        { urls: 'stun:stun2.l.google.com:19302' }
                    ]
                };

                peerConnection = new RTCPeerConnection(configuration);

                // Add local stream tracks
                localStream.getTracks().forEach(track => {
                    peerConnection.addTrack(track, localStream);
                });

                // Handle remote stream
                peerConnection.ontrack = (event) => {
                    if (!remoteVideo.srcObject) {
                        remoteVideo.srcObject = event.streams[0];
                        remoteStream = event.streams[0];
                    }
                };

                // Handle ICE candidates
                peerConnection.onicecandidate = (event) => {
                    if (event.candidate) {
                        socket.emit('signal', {
                            roomId: ROOM_ID,
                            candidate: event.candidate
                        });
                    }
                };

                // Handle connection state changes
                peerConnection.oniceconnectionstatechange = () => {
                    if (peerConnection.iceConnectionState === 'disconnected' ||
                        peerConnection.iceConnectionState === 'failed') {
                        updateStatus('Connection lost', 'disconnected');
                    } else if (peerConnection.iceConnectionState === 'connected') {
                        updateStatus('Call connected', 'connected');
                        startTimer();
                    }
                };
            }

            // Create offer
            async function createOffer() {
                try {
                    const offer = await peerConnection.createOffer({
                        offerToReceiveAudio: true,
                        offerToReceiveVideo: true
                    });

                    await peerConnection.setLocalDescription(offer);

                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        offer: offer
                    });
                } catch (error) {
                    console.error('Error creating offer:', error);
                }
            }

            // Start call timer
            function startTimer() {
                if (!callStartTime) {
                    callStartTime = Date.now();

                    setInterval(() => {
                        const elapsed = Date.now() - callStartTime;
                        const hours = Math.floor(elapsed / 3600000);
                        const minutes = Math.floor((elapsed % 3600000) / 60000);
                        const seconds = Math.floor((elapsed % 60000) / 1000);

                        callTimer.innerHTML = `
                            <i class="fas fa-clock"></i>
                            <span>${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}</span>
                        `;
                    }, 1000);
                }
            }

            // Toggle microphone
            toggleMic.addEventListener('click', () => {
                if (localStream) {
                    localStream.getAudioTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isAudioMuted = !localStream.getAudioTracks()[0].enabled;
                    toggleMic.classList.toggle('active', !isAudioMuted);
                    toggleMic.innerHTML = isAudioMuted ?
                        '<i class="fas fa-microphone-slash"></i>' :
                        '<i class="fas fa-microphone"></i>';

                    document.querySelector('.control-group:nth-child(1) .control-label').textContent =
                        isAudioMuted ? 'Mic Off' : 'Mic On';
                }
            });

            // Toggle camera
            toggleCam.addEventListener('click', () => {
                if (localStream) {
                    localStream.getVideoTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isVideoOff = !localStream.getVideoTracks()[0].enabled;
                    toggleCam.classList.toggle('active', !isVideoOff);
                    toggleCam.innerHTML = isVideoOff ?
                        '<i class="fas fa-video-slash"></i>' :
                        '<i class="fas fa-video"></i>';

                    document.querySelector('.control-group:nth-child(2) .control-label').textContent =
                        isVideoOff ? 'Camera Off' : 'Camera On';
                }
            });

            // End call handler
            async function endCallHandler() {
                const notes = notesText.value.trim();

                // Save notes locally first
                if (notes) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notes
                            })
                        });
                    } catch (error) {
                        console.error('Error saving notes:', error);
                    }
                }

                // Notify server and user that doctor is ending call WITH PRESCRIPTION
                if (socket) {
                    socket.emit('doctor-end-call', {
                        roomId: ROOM_ID,
                        appointmentId: APPOINTMENT_ID,
                        notes: notes
                    });
                }

                // Close peer connection
                if (peerConnection) {
                    peerConnection.close();
                    peerConnection = null;
                }

                // Stop local stream
                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                    localStream = null;
                }

                // Complete appointment on server (already done in socket handler)
                try {
                    await fetch(`/appointments/${APPOINTMENT_ID}/complete`, {
                        method: "POST"
                    });
                } catch (error) {
                    console.error('Error completing appointment:', error);
                }

                // Disconnect socket
                if (socket) {
                    socket.disconnect();
                }

                // Redirect to dashboard
                window.location.href = "/doc_video_dashboard";
            }

            endCall.addEventListener('click', endCallHandler);

            // Clear notes
            document.getElementById('clearNotes').addEventListener('click', function () {
                if (confirm('Are you sure you want to clear all notes?')) {
                    notesText.value = '';
                    charCount.textContent = '0';
                }
            });

            // Save notes
            document.getElementById('saveNotes').addEventListener('click', async function () {
                if (notesText.value.trim()) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notesText.value
                            })
                        });
                        alert('Notes saved successfully!');
                    } catch (error) {
                       
                        alert('Error saving notes');
                    }
                } else {
                    alert('No notes to save.');
                }
            });

            // Auto-save notes every 30 seconds
            setInterval(async () => {
                if (notesText.value.trim()) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notesText.value
                            })
                        });
                    } catch (error) {
                        console.error('Error auto-saving notes:', error);
                    }
                }
            }, 30000);

            // Initialize
            async function init() {
                updateStatus('Initializing call...', 'warning');
                await getLocalStream();
                initSocket();
            }

            init();

            // Handle page unload
            window.addEventListener('beforeunload', (e) => {
                if (peerConnection || socket?.connected) {
                    e.preventDefault();
                    e.returnValue = 'Are you sure you want to leave the call?';
                    return e.returnValue;
                }
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const notesPanel = document.getElementById('notesPanel');
            const toggleNotesBtn = document.getElementById('toggleNotesBtn');
            const mobileCloseNotes = document.getElementById('mobileCloseNotes');
            const videoLocal = document.querySelector('.video-local');
            const controlsBar = document.querySelector('.controls-bar');

            const isMobile = window.innerWidth <= 768;

            if (!isMobile) return;

            /* ---------- SAFE POSITIONING ---------- */
            function positionLocalVideo() {
                if (!videoLocal || !controlsBar) return;

                const controlsHeight = controlsBar.offsetHeight || 80;

                if (notesPanel.classList.contains('active')) {
                    const notesHeight = window.innerHeight * 0.5;
                    videoLocal.style.bottom = `${notesHeight + 20}px`;
                } else {
                    videoLocal.style.bottom = `${controlsHeight + 16}px`;
                }
            }

            positionLocalVideo();
            window.addEventListener('resize', positionLocalVideo);
            window.addEventListener('orientationchange', () =>
                setTimeout(positionLocalVideo, 300)
            );

            /* ---------- NOTES OPEN ---------- */
            toggleNotesBtn.addEventListener('click', function (e) {
                e.stopPropagation();   // ✅ CRITICAL FIX
                openNotes();
            });

            mobileCloseNotes.addEventListener('click', function (e) {
                e.stopPropagation();
                closeNotes();
            });

            function openNotes() {
                notesPanel.classList.add('active');
                toggleNotesBtn.classList.add('active');
                toggleNotesBtn.innerHTML = '<i class="fas fa-times"></i>';
                document.body.style.overflow = 'hidden';
                positionLocalVideo();
            }

            function closeNotes() {
                notesPanel.classList.remove('active');
                toggleNotesBtn.classList.remove('active');
                toggleNotesBtn.innerHTML = '<i class="fas fa-notes-medical"></i>';
                document.body.style.overflow = '';
                positionLocalVideo();
            }

            /* ---------- CLICK OUTSIDE (SAFE) ---------- */
            document.addEventListener('click', function (e) {
                if (
                    notesPanel.classList.contains('active') &&
                    !notesPanel.contains(e.target) &&
                    !toggleNotesBtn.contains(e.target)
                ) {
                    closeNotes();
                }
            });
        });
    </script>

</body>

</html>