<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Doctor Video Call | TeleHealth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <style>
        /* ===============================
           BASE STYLES
           =============================== */
        :root {
            /* Color Variables */
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;

            /* Layout Variables */
            --header-height-desktop: 70px;
            --header-height-mobile: 60px;
            --controls-height-desktop: 70px;
            --controls-height-mobile: 80px;

            /* Animation Variables */
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
        }

        /* Dark Theme Variables */
        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
            overflow: hidden;
        }

        /* ===============================
           HEADER & NAVIGATION
           =============================== */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height-desktop);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            height: 100%;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* Mobile Menu */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* ===============================
           MAIN VIDEO CALL LAYOUT
           =============================== */
        .video-call-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            width: 100%;
            height: calc(100vh - var(--header-height-desktop));
            transition: margin-right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .video-call-container.with-notes {
            margin-right: 400px;
            width: calc(100% - 400px);
        }

        /* Status Overlay */
        .call-status-overlay {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.75rem 1.25rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 10;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .video-call-container.with-notes .call-status-overlay {
            transform: translateX(-200px);
        }

        .status-indicator {
            display: flex;
            gap: 0.25rem;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background-color: var(--secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot:nth-child(2) {
            animation-delay: 0.5s;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.9);
            }
        }

        #callStatusText {
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* Main Video Area */
        .video-main-area {
            flex: 1;
            position: relative;
            overflow: hidden;
            background: #000;
            transition: none;
        }

        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Local Video (PiP) - Desktop */
        .local-video-pip {
            position: absolute;
            bottom: 100px;
            right: 20px;
            width: 220px;
            height: 165px;
            border-radius: var(--radius);
            overflow: hidden;
            border: 3px solid var(--primary);
            box-shadow: var(--shadow);
            background: #000;
            z-index: 95;
            transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1), bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .local-video-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.5rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            justify-content: center;
        }

        /* When desktop notes open, nudge PiP left */
        .video-call-container.with-notes .local-video-pip {
            right: 420px;
            transform: scale(0.95);
        }

        /* Video Loading State */
        .video-loading {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            z-index: 2;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 1rem;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===============================
           DESKTOP CONTROLS - FIXED HEIGHT, NO OVERFLOW
           =============================== */
        .desktop-controls {
            height: var(--controls-height-desktop);
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0 5%;
            width: 100%;
            position: relative;
            z-index: 10;
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .controls-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2rem;
            max-width: 500px;
            width: 100%;
            margin: 0 auto;
            padding: 0 1rem;
        }

        /* Control Buttons - Icon Only, No Text Labels */
        .control-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-bg);
            border: 2px solid var(--border);
            color: var(--text-medium);
            cursor: pointer;
            transition: var(--transition);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            position: relative;
            overflow: hidden;
        }

        /* MODERN HOVER EFFECTS */
        .control-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(56, 189, 248, 0.15);
            border-color: transparent;
        }

        .control-btn:active {
            transform: scale(0.98);
        }

        /* Active State */
        .control-btn.active {
            color: var(--primary);
            border-color: var(--primary);
            background-color: rgba(56, 189, 248, 0.08);
        }

        .control-btn.active:hover {
            box-shadow: 0 8px 16px rgba(56, 189, 248, 0.25);
        }

        /* Inactive/Muted State */
        .control-btn.inactive {
            color: var(--text-medium);
            border-color: var(--border);
            background-color: var(--card-bg);
            opacity: 0.7;
        }

        .control-btn.inactive i {
            position: relative;
        }

        .control-btn.inactive i::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 30px;
            height: 2px;
            background: var(--text-medium);
            transform: translate(-50%, -50%) rotate(45deg);
            border-radius: 1px;
        }

        /* Danger/End Call State */
        .control-btn.danger {
            color: var(--error);
            border-color: var(--error);
            background-color: rgba(239, 68, 68, 0.08);
        }

        .control-btn.danger:hover {
            box-shadow: 0 8px 16px rgba(239, 68, 68, 0.25);
        }

        /* Icon Styles */
        .control-btn i {
            font-size: 1.5rem;
            transition: var(--transition);
        }

        .control-btn:hover i {
            transform: scale(1.1);
        }

        /* ===============================
           DESKTOP NOTES PANEL (RIGHT SIDEBAR) - COMPLETELY FIXED
           =============================== */
        .notes-panel {
            position: fixed;
            top: var(--header-height-desktop);
            right: -400px;
            bottom: 0;
            width: 400px;
            background-color: var(--card-bg);
            border-left: 1px solid var(--border);
            z-index: 200;
            transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);
            opacity: 1;
            /* Content is always visible */
        }

        .notes-panel.active {
            right: 0;
            box-shadow: -2px 0 15px rgba(0, 0, 0, 0.08);
        }

        /* REMOVED: All opacity transitions - content always visible */
        .notes-content {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            opacity: 1 !important;
            /* Force opacity to be always 1 */
            visibility: visible !important;
            /* Force visibility */
        }

        .notes-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--card-bg);
        }

        .notes-header h3 {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-dark);
            font-size: 1.1rem;
        }

        .notes-header h3 i {
            color: var(--primary);
        }

        .close-notes {
            background: none;
            border: none;
            color: var(--text-medium);
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .close-notes:hover {
            background-color: rgba(0, 0, 0, 0.1);
            transform: rotate(90deg);
        }

        #notesText {
            width: 100%;
            height: 100%;
            min-height: 300px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background-color: var(--background);
            color: var(--text-dark);
            font-family: inherit;
            font-size: 0.95rem;
            line-height: 1.6;
            resize: none;
        }

        #notesText:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
        }

        .notes-footer {
            padding: 1.5rem;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--card-bg);
        }

        .notes-actions {
            display: flex;
            gap: 0.75rem;
        }

        .notes-footer .btn {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--primary);
            color: var(--primary);
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .char-count {
            color: var(--text-medium);
            font-size: 0.875rem;
        }

        /* ===============================
           MOBILE VIEW - UPDATED CONTROL BUTTONS
           =============================== */
        @media (max-width: 768px) {
            :root {
                --header-height-mobile: 60px;
                --controls-height-mobile: 80px;
            }

            /* NAVBAR MOBILE */
            header {
                height: var(--header-height-mobile);
            }

            .navbar {
                padding: 0.8rem 5%;
            }

            .logo-text {
                display: none;
            }

            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
            }

            /* VIDEO CONTAINER MOBILE */
            .video-call-container {
                height: calc(100vh - var(--header-height-mobile));
                padding-bottom: var(--controls-height-mobile);
            }

            .video-call-container.with-notes {
                margin-right: 0;
                width: 100%;
            }

            /* HIDE DESKTOP ELEMENTS ON MOBILE */
            .desktop-controls,
            .notes-panel {
                display: none !important;
            }

            /* MOBILE CONTROLS - FIXED AT BOTTOM */
            .mobile-controls-bar {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                height: var(--controls-height-mobile);
                background-color: var(--card-bg);
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 80;
                padding: 0 5%;
                overflow: hidden;
            }

            .mobile-controls-wrapper {
                display: flex;
                justify-content: space-around;
                align-items: center;
                width: 100%;
                max-width: 500px;
                padding: 0 1rem;
            }

            /* MOBILE CONTROL BUTTONS - UPDATED */
            .mobile-control-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--card-bg);
                border: 2px solid var(--border);
                color: var(--text-medium);
                cursor: pointer;
                transition: var(--transition);
                width: 55px;
                height: 55px;
                border-radius: 50%;
                position: relative;
                overflow: hidden;
            }

            .mobile-control-btn:hover {
                transform: scale(1.05);
                box-shadow: 0 8px 16px rgba(56, 189, 248, 0.15);
                border-color: transparent;
            }

            .mobile-control-btn:active {
                transform: scale(0.98);
            }

            .mobile-control-btn.active {
                color: var(--primary);
                border-color: var(--primary);
                background-color: rgba(56, 189, 248, 0.08);
            }

            .mobile-control-btn.inactive {
                color: var(--text-medium);
                border-color: var(--border);
                background-color: var(--card-bg);
                opacity: 0.7;
            }

            .mobile-control-btn.inactive i {
                position: relative;
            }

            .mobile-control-btn.inactive i::after {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                width: 26px;
                height: 2px;
                background: var(--text-medium);
                transform: translate(-50%, -50%) rotate(45deg);
                border-radius: 1px;
            }

            .mobile-control-btn.danger {
                color: var(--error);
                border-color: var(--error);
                background-color: rgba(239, 68, 68, 0.08);
            }

            .mobile-control-btn i {
                font-size: 1.3rem;
                transition: var(--transition);
            }

            /* LOCAL VIDEO PIP - MOBILE (fixed) */
            .local-video-pip {
                position: fixed;
                bottom: calc(var(--controls-height-mobile) + 20px);
                right: 10px;
                width: 140px;
                height: 105px;
                border-width: 2px;
                z-index: 110;
                transition: bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* STATUS OVERLAY MOBILE */
            .call-status-overlay {
                top: 0.5rem;
                left: 0.5rem;
                padding: 0.5rem 1rem;
                font-size: 0.85rem;
            }

            .status-dot {
                width: 6px;
                height: 6px;
            }
        }

        /* ===============================
           MOBILE NOTES PANEL (BOTTOM SLIDE-UP)
           =============================== */
        .mobile-notes-panel {
            position: fixed;
            bottom: -50vh;
            left: 0;
            right: 0;
            height: 50vh;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            z-index: 120;
            transition: bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        .mobile-notes-panel.active {
            bottom: var(--controls-height-mobile);
        }

        /* FIX: Mobile notes text area size */
        .mobile-notes-panel .notes-content {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            opacity: 1 !important;
        }

        #mobileNotesText {
            width: 100%;
            height: 100%;
            min-height: 200px;
            padding: 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background-color: var(--background);
            color: var(--text-dark);
            font-family: inherit;
            font-size: 0.95rem;
            line-height: 1.6;
            resize: none;
        }

        /* This class (added to <body>) moves local video up with notes panel on mobile */
        body.mobile-notes-open .local-video-pip {
            bottom: calc(50vh + var(--controls-height-mobile) + 12px);
        }

        /* Hide desktop notes panel on mobile */
        @media (min-width: 769px) {

            .mobile-notes-panel,
            .mobile-controls-bar {
                display: none !important;
            }
        }

        /* Hide mobile elements on desktop */
        @media (max-width: 768px) {

            .desktop-controls,
            .notes-panel {
                display: none !important;
            }
        }

        /* ===============================
           UTILITY CLASSES
           =============================== */
        .hidden {
            display: none !important;
        }

        /* Remove all footer styles */
        .simple-footer,
        footer {
            display: none !important;
        }

        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }
    </style>
</head>

<body>
    <!-- HEADER -->
    <header>
        <nav class="navbar">
            <a href="/doc_home" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
                <a href="/doc_video_dashboard" class="active"><i class="fas fa-video"></i>Video</a>
                <a href="/doc_profile"><i class="fas fa-user-circle"></i> Profile</a>
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

