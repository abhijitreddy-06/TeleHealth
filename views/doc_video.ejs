<script>
    // ===============================
    // COMPLETE VIDEO CALL SOLUTION - ALL ISSUES FIXED
    // ===============================

    // Global Variables
    const ROOM_ID = "<%= roomId %>";
    const APPOINTMENT_ID = "<%= appointment.id %>";

    // DOM Elements
    const localVideo = document.getElementById('localVideo');
    const remoteVideo = document.getElementById('remoteVideo');
    const callStatusText = document.getElementById('callStatusText');
    const audioIndicator = document.getElementById('audioIndicator');
    const echoWarning = document.getElementById('echoWarning');

    // Video call state
    let localStream = null;
    let remoteStream = null;
    let peerConnection = null;
    let socket = null;
    let callStartTime = null;
    let isAudioMuted = false;
    let isVideoOff = false;
    let currentAudioDevice = null;
    let reconnectAttempts = 0;
    const MAX_RECONNECT_ATTEMPTS = 3;
    let isRefreshing = false;
    let audioContext = null;
    let analyser = null;
    let microphone = null;
    let echoDetectionInterval = null;
    let audioLevelCheckInterval = null;

    // ===============================
    // INITIALIZATION
    // ===============================
    document.addEventListener('DOMContentLoaded', function () {
        console.log('Initializing video call...');

        // Theme toggle functionality
        initThemeToggle();

        // Mobile menu functionality
        initMobileMenu();

        // Notes panel functionality
        initNotesPanel();

        // Media toggle functionality
        initMediaToggles();

        // Video fit controls
        initVideoFitControls();

        // Initialize video call
        initVideoCall();

        // Add keyboard shortcuts
        initKeyboardShortcuts();

        // Add window resize handler
        initWindowResizeHandler();
    });

    // ===============================
    // THEME TOGGLE
    // ===============================
    function initThemeToggle() {
        const themeToggle = document.getElementById('themeToggle');
        const mobileThemeToggle = document.getElementById('mobileThemeToggle');
        const html = document.documentElement;

        const savedTheme = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        html.setAttribute('data-theme', savedTheme);
        updateThemeIcon(savedTheme);

        function toggleTheme() {
            const currentTheme = html.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
            if (themeToggle) themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            if (mobileThemeToggle) mobileThemeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
        }

        if (themeToggle) themeToggle.addEventListener('click', toggleTheme);
        if (mobileThemeToggle) mobileThemeToggle.addEventListener('click', toggleTheme);
    }

    // ===============================
    // MOBILE MENU
    // ===============================
    function initMobileMenu() {
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const closeMenuBtn = document.getElementById('closeMenu');
        const mobileMenu = document.getElementById('mobileMenu');

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                mobileMenu.classList.add('active');
                document.body.style.overflow = 'hidden';
            });
        }

        if (closeMenuBtn) {
            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });
        }

        document.addEventListener('click', (e) => {
            if (mobileMenu.classList.contains('active') &&
                !mobileMenu.contains(e.target) &&
                e.target !== mobileMenuBtn) {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            }
        });
    }

    // ===============================
    // NOTES PANEL - FIXED FOR DESKTOP & MOBILE
    // ===============================
    function initNotesPanel() {
        // Desktop notes elements
        const toggleNotes = document.getElementById('toggleNotes');
        const notesPanel = document.getElementById('notesPanel');
        const closeNotes = document.getElementById('closeNotes');
        const notesText = document.getElementById('notesText');
        const charCount = document.getElementById('charCount');
        const clearNotes = document.getElementById('clearNotes');
        const saveNotes = document.getElementById('saveNotes');
        const videoCallContainer = document.getElementById('videoCallContainer');

        // Mobile notes elements
        const mobileToggleNotes = document.getElementById('mobileToggleNotes');
        const mobileNotesPanel = document.getElementById('mobileNotesPanel');
        const mobileCloseNotes = document.getElementById('mobileCloseNotes');
        const mobileNotesText = document.getElementById('mobileNotesText');
        const mobileCharCount = document.getElementById('mobileCharCount');
        const mobileClearNotes = document.getElementById('mobileClearNotes');
        const mobileSaveNotes = document.getElementById('mobileSaveNotes');

        // Character counter
        function updateCharCount() {
            const text = notesText ? notesText.value : mobileNotesText ? mobileNotesText.value : '';
            const count = text.length;
            if (charCount) charCount.textContent = count;
            if (mobileCharCount) mobileCharCount.textContent = count;

            // Sync between desktop and mobile notes
            if (notesText && mobileNotesText) {
                mobileNotesText.value = notesText.value;
            }
            if (mobileNotesText && notesText) {
                notesText.value = mobileNotesText.value;
            }
        }

        if (notesText) {
            notesText.addEventListener('input', updateCharCount);
            // Load saved notes
            const savedNotes = localStorage.getItem(`notes_${ROOM_ID}`);
            if (savedNotes) {
                notesText.value = savedNotes;
                updateCharCount();
            }
        }

        if (mobileNotesText) {
            mobileNotesText.addEventListener('input', updateCharCount);
        }

        // Desktop notes toggle - FIXED
        if (toggleNotes) {
            toggleNotes.addEventListener('click', () => {
                const isActive = notesPanel.classList.toggle('active');
                videoCallContainer.classList.toggle('with-notes', isActive);
                toggleNotes.classList.toggle('active', isActive);
                notesPanel.setAttribute('aria-hidden', !isActive);

                // Add animation
                toggleNotes.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    toggleNotes.style.transform = '';
                }, 150);

                // Sync with mobile
                if (isActive && mobileNotesPanel.classList.contains('active')) {
                    mobileNotesPanel.classList.remove('active');
                    mobileToggleNotes.classList.remove('active');
                    document.body.classList.remove('mobile-notes-open');
                }
            });
        }

        if (closeNotes) {
            closeNotes.addEventListener('click', () => {
                notesPanel.classList.remove('active');
                videoCallContainer.classList.remove('with-notes');
                if (toggleNotes) toggleNotes.classList.remove('active');
                notesPanel.setAttribute('aria-hidden', 'true');

                // Add animation
                closeNotes.style.transform = 'rotate(90deg)';
                setTimeout(() => {
                    closeNotes.style.transform = '';
                }, 200);
            });
        }

        // Mobile notes toggle - FIXED
        if (mobileToggleNotes) {
            mobileToggleNotes.addEventListener('click', () => {
                const isActive = mobileNotesPanel.classList.toggle('active');
                mobileToggleNotes.classList.toggle('active', isActive);
                document.body.classList.toggle('mobile-notes-open', isActive);
                mobileNotesPanel.setAttribute('aria-hidden', !isActive);

                // Add animation
                mobileToggleNotes.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    mobileToggleNotes.style.transform = '';
                }, 150);

                // Sync with desktop
                if (isActive && notesPanel.classList.contains('active')) {
                    notesPanel.classList.remove('active');
                    videoCallContainer.classList.remove('with-notes');
                    if (toggleNotes) toggleNotes.classList.remove('active');
                }
            });
        }

        if (mobileCloseNotes) {
            mobileCloseNotes.addEventListener('click', () => {
                mobileNotesPanel.classList.remove('active');
                if (mobileToggleNotes) mobileToggleNotes.classList.remove('active');
                document.body.classList.remove('mobile-notes-open');
                mobileNotesPanel.setAttribute('aria-hidden', 'true');
            });
        }

        // Clear notes
        const clearNotesHandler = () => {
            if (confirm('Are you sure you want to clear all notes?')) {
                if (notesText) notesText.value = '';
                if (mobileNotesText) mobileNotesText.value = '';
                updateCharCount();
                localStorage.removeItem(`notes_${ROOM_ID}`);
                showToast('Notes cleared', 'info');
            }
        };

        if (clearNotes) clearNotes.addEventListener('click', clearNotesHandler);
        if (mobileClearNotes) mobileClearNotes.addEventListener('click', clearNotesHandler);

        // Save notes
        const saveNotesHandler = async () => {
            const notes = notesText ? notesText.value.trim() : mobileNotesText ? mobileNotesText.value.trim() : '';
            if (!notes) {
                showToast('No notes to save', 'warning');
                return;
            }

            try {
                // Save locally
                localStorage.setItem(`notes_${ROOM_ID}`, notes);

                // Send to server
                const response = await fetch("/api/notes/save", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        roomId: ROOM_ID,
                        appointmentId: APPOINTMENT_ID,
                        notes: notes
                    })
                });

                if (response.ok) {
                    showToast('Notes saved successfully!', 'success');

                    // Close mobile panel if open
                    if (mobileNotesPanel.classList.contains('active')) {
                        mobileNotesPanel.classList.remove('active');
                        if (mobileToggleNotes) mobileToggleNotes.classList.remove('active');
                        document.body.classList.remove('mobile-notes-open');
                    }
                } else {
                    throw new Error('Failed to save notes');
                }
            } catch (error) {
                console.error('Error saving notes:', error);
                showToast('Error saving notes. They have been saved locally.', 'error');
            }
        };

        if (saveNotes) saveNotes.addEventListener('click', saveNotesHandler);
        if (mobileSaveNotes) mobileSaveNotes.addEventListener('click', saveNotesHandler);
    }

    // ===============================
    // MEDIA TOGGLES
    // ===============================
    function initMediaToggles() {
        // Get all control buttons
        const toggleMic = document.getElementById('toggleMic');
        const toggleCam = document.getElementById('toggleCam');
        const toggleAudioDevice = document.getElementById('toggleAudioDevice');
        const refreshCall = document.getElementById('refreshCall');
        const endCall = document.getElementById('endCall');

        const mobileToggleMic = document.getElementById('mobileToggleMic');
        const mobileToggleCam = document.getElementById('mobileToggleCam');
        const mobileRefreshCall = document.getElementById('mobileRefreshCall');
        const mobileEndCall = document.getElementById('mobileEndCall');

        // MIC TOGGLE
        const toggleMicHandler = () => {
            if (!localStream) {
                console.error('Local stream not available');
                return;
            }

            const audioTracks = localStream.getAudioTracks();
            if (audioTracks.length > 0) {
                isAudioMuted = !isAudioMuted;
                audioTracks.forEach(track => {
                    track.enabled = !isAudioMuted;
                });

                // Update UI
                updateButtonState(toggleMic, mobileToggleMic, !isAudioMuted, 'fa-microphone', 'fa-microphone-slash');

                // Show feedback
                showToast(isAudioMuted ? 'Microphone muted' : 'Microphone on', !isAudioMuted ? 'success' : 'warning');

                // Send status to peer
                if (socket) {
                    socket.emit('audio-status', {
                        roomId: ROOM_ID,
                        muted: isAudioMuted
                    });
                }

                // Update audio indicator
                if (!isAudioMuted) {
                    setTimeout(() => initAudioMonitoring(), 100);
                }
            }
        };

        if (toggleMic) toggleMic.addEventListener('click', toggleMicHandler);
        if (mobileToggleMic) mobileToggleMic.addEventListener('click', toggleMicHandler);

        // CAMERA TOGGLE
        const toggleCamHandler = () => {
            if (!localStream) {
                console.error('Local stream not available');
                return;
            }

            const videoTracks = localStream.getVideoTracks();
            if (videoTracks.length > 0) {
                isVideoOff = !isVideoOff;
                videoTracks.forEach(track => {
                    track.enabled = !isVideoOff;
                });

                // Update UI
                updateButtonState(toggleCam, mobileToggleCam, !isVideoOff, 'fa-video', 'fa-video-slash');

                // Show feedback
                showToast(isVideoOff ? 'Camera off' : 'Camera on', !isVideoOff ? 'success' : 'warning');

                // Update local video display
                localVideo.style.opacity = isVideoOff ? '0.3' : '1';
                localVideo.style.filter = isVideoOff ? 'grayscale(100%)' : 'none';
            }
        };

        if (toggleCam) toggleCam.addEventListener('click', toggleCamHandler);
        if (mobileToggleCam) mobileToggleCam.addEventListener('click', toggleCamHandler);

        // AUDIO DEVICE TOGGLE
        if (toggleAudioDevice) {
            toggleAudioDevice.addEventListener('click', async () => {
                try {
                    await switchAudioDevice();
                    showToast('Audio device switched', 'info');
                } catch (error) {
                    console.error('Error switching audio device:', error);
                    showToast('Failed to switch audio device', 'error');
                }
            });
        }

        // REFRESH CALL
        const refreshCallHandler = () => {
            if (isRefreshing) return;
            refreshEverything();
        };

        if (refreshCall) refreshCall.addEventListener('click', refreshCallHandler);
        if (mobileRefreshCall) mobileRefreshCall.addEventListener('click', refreshCallHandler);

        // END CALL
        const endCallHandler = () => {
            if (confirm('Are you sure you want to end the call?')) {
                endCallProcedure();
            }
        };

        if (endCall) endCall.addEventListener('click', endCallHandler);
        if (mobileEndCall) mobileEndCall.addEventListener('click', endCallHandler);
    }

    // ===============================
    // VIDEO FIT CONTROLS
    // ===============================
    function initVideoFitControls() {
        const fitContain = document.getElementById('fitContain');
        const fitCover = document.getElementById('fitCover');

        if (fitContain && fitCover) {
            // Set initial state
            if (window.innerWidth <= 768) {
                // Mobile: use cover by default
                remoteVideo.style.objectFit = 'cover';
                if (fitCover) fitCover.classList.add('active');
                if (fitContain) fitContain.classList.remove('active');
            } else {
                // Desktop: use contain by default
                remoteVideo.style.objectFit = 'contain';
                if (fitContain) fitContain.classList.add('active');
                if (fitCover) fitCover.classList.remove('active');
            }

            fitContain.addEventListener('click', () => {
                remoteVideo.style.objectFit = 'contain';
                fitContain.classList.add('active');
                fitCover.classList.remove('active');
                showToast('Video set to fit mode', 'info');
            });

            fitCover.addEventListener('click', () => {
                remoteVideo.style.objectFit = 'cover';
                fitCover.classList.add('active');
                fitContain.classList.remove('active');
                showToast('Video set to fill mode', 'info');
            });
        }
    }

    // ===============================
    // KEYBOARD SHORTCUTS
    // ===============================
    function initKeyboardShortcuts() {
        document.addEventListener('keydown', (e) => {
            // Don't trigger if user is typing in textarea
            if (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') return;

            switch (e.code) {
                case 'Space':
                    e.preventDefault();
                    document.getElementById('toggleMic')?.click();
                    break;
                case 'KeyV':
                    e.preventDefault();
                    document.getElementById('toggleCam')?.click();
                    break;
                case 'KeyN':
                    e.preventDefault();
                    document.getElementById('toggleNotes')?.click();
                    break;
                case 'KeyR':
                    if (e.ctrlKey || e.metaKey) {
                        e.preventDefault();
                        refreshEverything();
                    }
                    break;
                case 'Escape':
                    if (confirm('End the call?')) {
                        endCallProcedure();
                    }
                    break;
                case 'KeyF':
                    e.preventDefault();
                    // Toggle fullscreen
                    const videoContainer = document.querySelector('.video-main-area');
                    if (!document.fullscreenElement) {
                        videoContainer.requestFullscreen().catch(console.log);
                    } else {
                        document.exitFullscreen();
                    }
                    break;
            }
        });
    }

    // ===============================
    // WINDOW RESIZE HANDLER
    // ===============================
    function initWindowResizeHandler() {
        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                adjustVideoLayout();
            }, 250);
        });
    }

    function adjustVideoLayout() {
        const isMobile = window.innerWidth <= 768;

        if (isMobile) {
            // Mobile adjustments
            const videoContainer = document.querySelector('.video-call-container');
            const headerHeight = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-height-mobile')) || 60;
            const controlsHeight = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--controls-height-mobile')) || 80;

            videoContainer.style.height = `calc(100vh - ${headerHeight}px - ${controlsHeight}px)`;
            videoContainer.style.top = `${headerHeight}px`;

            // Ensure video fills container
            remoteVideo.style.objectFit = 'cover';
        } else {
            // Desktop adjustments
            remoteVideo.style.objectFit = 'contain';
        }
    }

    // ===============================
    // VIDEO CALL CORE FUNCTIONALITY
    // ===============================

    // Update status display
    function updateStatus(message, type = 'info') {
        if (callStatusText) {
            callStatusText.textContent = `CALL STATUS: ${message}`;

            // Update status indicator color
            const statusDots = document.querySelectorAll('.status-dot');
            const statusColor = type === 'connected' ? '#10b981' :
                type === 'warning' ? '#f59e0b' :
                    type === 'error' ? '#ef4444' : '#60a5fa';

            statusDots.forEach(dot => {
                dot.style.backgroundColor = statusColor;
            });
        }
    }

    // Get user media with enhanced audio settings
    async function getLocalStream() {
        try {
            // First, get available devices
            const devices = await navigator.mediaDevices.enumerateDevices();
            const audioDevices = devices.filter(d => d.kind === 'audioinput');

            // Try to get the best audio device
            let audioConstraints = {
                echoCancellation: { ideal: true },
                noiseSuppression: { ideal: true },
                autoGainControl: { ideal: true },
                channelCount: 1,
                sampleRate: 48000,
                sampleSize: 16
            };

            // If we have multiple audio devices, let the browser choose the best one
            if (audioDevices.length > 0) {
                // Prefer devices with certain labels (like "default" or "communications")
                const defaultDevice = audioDevices.find(d =>
                    d.label.toLowerCase().includes('default') ||
                    d.label.toLowerCase().includes('communication')
                );

                if (defaultDevice) {
                    audioConstraints.deviceId = { exact: defaultDevice.deviceId };
                    currentAudioDevice = defaultDevice.deviceId;
                }
            }

            localStream = await navigator.mediaDevices.getUserMedia({
                video: {
                    width: { ideal: 1280, max: 1920 },
                    height: { ideal: 720, max: 1080 },
                    frameRate: { ideal: 30, max: 60 },
                    facingMode: 'user',
                    aspectRatio: 16 / 9
                },
                audio: audioConstraints
            });

            // Set video source
            localVideo.srcObject = localStream;

            // Initialize audio monitoring
            initAudioMonitoring();

            // Hide loading
            const videoLoading = document.getElementById('videoLoading');
            if (videoLoading) {
                videoLoading.classList.add('hidden');
            }

            console.log('Local stream obtained successfully', {
                video: localStream.getVideoTracks()[0]?.getSettings(),
                audio: localStream.getAudioTracks()[0]?.getSettings()
            });

            return true;

        } catch (error) {
            console.error('Error accessing media devices:', error);

            // Try fallback with simpler constraints
            try {
                localStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 640 },
                        height: { ideal: 480 },
                        frameRate: { ideal: 24 }
                    },
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true
                    }
                });

                localVideo.srcObject = localStream;
                const videoLoading = document.getElementById('videoLoading');
                if (videoLoading) videoLoading.classList.add('hidden');

                console.log('Fallback stream obtained');
                return true;

            } catch (fallbackError) {
                console.error('Fallback also failed:', fallbackError);
                updateStatus('MEDIA PERMISSION REQUIRED', 'error');

                // Show permission instructions
                showToast('Please allow camera and microphone access in browser settings', 'error');
                return false;
            }
        }
    }

    // Switch audio device
    async function switchAudioDevice() {
        if (!localStream) return;

        try {
            const devices = await navigator.mediaDevices.enumerateDevices();
            const audioInputs = devices.filter(d => d.kind === 'audioinput');

            if (audioInputs.length < 2) {
                showToast('Only one audio device available', 'warning');
                return;
            }

            // Get current device
            const currentTrack = localStream.getAudioTracks()[0];
            const currentDeviceId = currentTrack.getSettings().deviceId;

            // Find next device
            let nextIndex = audioInputs.findIndex(d => d.deviceId === currentDeviceId) + 1;
            if (nextIndex >= audioInputs.length) nextIndex = 0;

            const nextDevice = audioInputs[nextIndex];
            currentAudioDevice = nextDevice.deviceId;

            // Stop current track
            currentTrack.stop();

            // Get new track with better echo cancellation
            const newStream = await navigator.mediaDevices.getUserMedia({
                audio: {
                    deviceId: { exact: nextDevice.deviceId },
                    echoCancellation: { ideal: true },
                    noiseSuppression: { ideal: true },
                    autoGainControl: { ideal: true },
                    channelCount: 1
                }
            });

            // Replace audio track
            const newAudioTrack = newStream.getAudioTracks()[0];

            // Stop the video track from new stream to avoid duplicates
            newStream.getVideoTracks().forEach(track => track.stop());

            // Remove old track and add new one
            localStream.removeTrack(currentTrack);
            localStream.addTrack(newAudioTrack);

            // Update peer connection if exists
            if (peerConnection) {
                const senders = peerConnection.getSenders();
                const audioSender = senders.find(s => s.track && s.track.kind === 'audio');
                if (audioSender) {
                    audioSender.replaceTrack(newAudioTrack);
                }
            }

            console.log('Switched to audio device:', nextDevice.label);

            // Reinitialize audio monitoring
            initAudioMonitoring();

        } catch (error) {
            console.error('Error switching audio device:', error);
            throw error;
        }
    }

    // Initialize audio monitoring for echo detection
    function initAudioMonitoring() {
        if (!localStream || !localStream.getAudioTracks()[0]) return;

        try {
            // Clean up previous audio context
            if (audioContext && audioContext.state !== 'closed') {
                audioContext.close();
            }

            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            analyser = audioContext.createAnalyser();
            microphone = audioContext.createMediaStreamSource(localStream);

            microphone.connect(analyser);
            analyser.fftSize = 256;
            analyser.smoothingTimeConstant = 0.8;
            analyser.minDecibels = -60;
            analyser.maxDecibels = -10;

            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            let echoDetectionCount = 0;
            let lastLevel = 0;
            let audioLevelHistory = [];

            // Clear previous intervals
            if (audioLevelCheckInterval) {
                clearInterval(audioLevelCheckInterval);
            }
            if (echoDetectionInterval) {
                clearInterval(echoDetectionInterval);
            }

            // Monitor audio levels
            audioLevelCheckInterval = setInterval(() => {
                if (!localStream || isAudioMuted) {
                    audioIndicator.classList.remove('audio-active');
                    return;
                }

                analyser.getByteFrequencyData(dataArray);

                let sum = 0;
                for (let i = 0; i < bufferLength; i++) {
                    sum += dataArray[i];
                }
                const average = sum / bufferLength;

                // Keep history for echo detection
                audioLevelHistory.push(average);
                if (audioLevelHistory.length > 10) {
                    audioLevelHistory.shift();
                }

                // Show visual indicator
                if (average > 30 && !isAudioMuted) {
                    audioIndicator.classList.add('audio-active');
                    audioIndicator.style.height = `${Math.min(average / 10, 15)}px`;
                } else {
                    audioIndicator.classList.remove('audio-active');
                }

                // Echo detection logic (detect sudden spikes followed by similar patterns)
                if (audioLevelHistory.length >= 10) {
                    const recentAvg = audioLevelHistory.slice(-5).reduce((a, b) => a + b, 0) / 5;
                    const previousAvg = audioLevelHistory.slice(-10, -5).reduce((a, b) => a + b, 0) / 5;

                    if (recentAvg > 100 && Math.abs(recentAvg - previousAvg) > 80) {
                        echoDetectionCount++;
                        if (echoDetectionCount > 2) {
                            showEchoWarning();
                            echoDetectionCount = 0;
                        }
                    }
                }

                lastLevel = average;

            }, 100);

            // Reset echo detection counter periodically
            echoDetectionInterval = setInterval(() => {
                echoDetectionCount = Math.max(0, echoDetectionCount - 1);
                if (audioLevelHistory.length > 20) {
                    audioLevelHistory = audioLevelHistory.slice(-10);
                }
            }, 3000);

        } catch (error) {
            console.log('Audio monitoring not available:', error);
        }
    }

    // Show echo warning
    function showEchoWarning() {
        if (echoWarning) {
            echoWarning.style.display = 'block';

            // Add auto-dismiss
            setTimeout(() => {
                if (echoWarning.style.display === 'block') {
                    echoWarning.style.display = 'none';
                }
            }, 8000);

            // Log for debugging
            console.log('Echo detected - suggest using headphones or lowering volume');
        }
    }

    // Create peer connection
    async function createPeerConnection() {
        try {
            const configuration = {
                iceServers: [
                    { urls: 'stun:stun.l.google.com:19302' },
                    { urls: 'stun:stun1.l.google.com:19302' },
                    { urls: 'stun:stun2.l.google.com:19302' },
                    { urls: 'stun:stun3.l.google.com:19302' }
                ],
                iceTransportPolicy: 'all',
                bundlePolicy: 'max-bundle',
                rtcpMuxPolicy: 'require',
                iceCandidatePoolSize: 10
            };

            peerConnection = new RTCPeerConnection(configuration);

            // Add local tracks
            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
            });

            // Handle remote stream
            peerConnection.ontrack = (event) => {
                console.log('Received remote track:', event.track.kind);

                if (!remoteVideo.srcObject) {
                    remoteVideo.srcObject = event.streams[0];
                    remoteStream = event.streams[0];

                    // Ensure video plays
                    remoteVideo.play().catch(e => {
                        console.log('Auto-play prevented:', e);
                        // Show play button if needed
                        if (e.name === 'NotAllowedError') {
                            showToast('Click the video to start playback', 'warning');
                        }
                    });

                    // Show connection success
                    showToast('Connected to patient', 'success');
                }
            };

            // ICE candidate handling
            peerConnection.onicecandidate = (event) => {
                if (event.candidate && socket) {
                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        candidate: event.candidate
                    });
                }
            };

            // Connection state monitoring
            peerConnection.oniceconnectionstatechange = () => {
                console.log('ICE connection state:', peerConnection.iceConnectionState);

                switch (peerConnection.iceConnectionState) {
                    case 'connected':
                        updateStatus('CONNECTED', 'connected');
                        startTimer();
                        updateConnectionQuality('good');
                        reconnectAttempts = 0;
                        break;
                    case 'disconnected':
                        updateStatus('RECONNECTING...', 'warning');
                        updateConnectionQuality('fair');
                        handleDisconnection();
                        break;
                    case 'failed':
                        updateStatus('CONNECTION FAILED', 'error');
                        updateConnectionQuality('poor');
                        handleDisconnection();
                        break;
                    case 'checking':
                        updateStatus('CONNECTING...', 'warning');
                        break;
                    case 'closed':
                        updateStatus('CALL ENDED', 'info');
                        break;
                }
            };

            // Track statistics for quality monitoring
            setInterval(() => {
                if (peerConnection && peerConnection.iceConnectionState === 'connected') {
                    getConnectionStats();
                }
            }, 10000);

            return true;

        } catch (error) {
            console.error('Error creating peer connection:', error);
            updateStatus('PEER CONNECTION ERROR', 'error');
            showToast('Failed to establish connection', 'error');
            return false;
        }
    }

    // Update connection quality display
    function updateConnectionQuality(quality) {
        let qualityElement = document.getElementById('connectionQuality');

        if (!qualityElement) {
            qualityElement = document.createElement('div');
            qualityElement.id = 'connectionQuality';
            qualityElement.className = 'connection-quality';
            document.querySelector('.video-main-area').appendChild(qualityElement);
        }

        const qualityText = {
            'poor': 'POOR CONNECTION',
            'fair': 'FAIR CONNECTION',
            'good': 'GOOD CONNECTION'
        }[quality] || 'UNKNOWN';

        qualityElement.innerHTML = `
            <div class="connection-dot ${quality}"></div>
            <span>${qualityText}</span>
        `;
    }

    // Get connection statistics
    async function getConnectionStats() {
        if (!peerConnection) return;

        try {
            const stats = await peerConnection.getStats();
            let videoPacketsLost = 0;
            let videoPacketsSent = 0;
            let audioPacketsLost = 0;
            let audioPacketsSent = 0;

            stats.forEach(report => {
                if (report.type === 'outbound-rtp') {
                    if (report.mediaType === 'video') {
                        videoPacketsSent = report.packetsSent || 0;
                        videoPacketsLost = report.packetsLost || 0;
                    } else if (report.mediaType === 'audio') {
                        audioPacketsSent = report.packetsSent || 0;
                        audioPacketsLost = report.packetsLost || 0;
                    }
                }
            });

            const totalPacketsSent = videoPacketsSent + audioPacketsSent;
            const totalPacketsLost = videoPacketsLost + audioPacketsLost;

            const lossPercentage = totalPacketsSent > 0 ?
                (totalPacketsLost / totalPacketsSent) * 100 : 0;

            if (lossPercentage > 20) {
                updateConnectionQuality('poor');
                if (lossPercentage > 30) {
                    showToast('Poor connection detected. Consider refreshing.', 'warning');
                }
            } else if (lossPercentage > 10) {
                updateConnectionQuality('fair');
            } else {
                updateConnectionQuality('good');
            }

        } catch (error) {
            console.log('Error getting stats:', error);
        }
    }

    // Create offer
    async function createOffer() {
        try {
            const offer = await peerConnection.createOffer({
                offerToReceiveAudio: true,
                offerToReceiveVideo: true,
                voiceActivityDetection: true,
                iceRestart: false
            });

            await peerConnection.setLocalDescription(offer);

            if (socket) {
                socket.emit('signal', {
                    roomId: ROOM_ID,
                    offer: offer
                });
            }

            console.log('Offer created and sent');

        } catch (error) {
            console.error('Error creating offer:', error);
            throw error;
        }
    }

    // Initialize Socket.io
    function initSocket() {
        socket = io({
            reconnection: true,
            reconnectionAttempts: MAX_RECONNECT_ATTEMPTS,
            reconnectionDelay: 1000,
            reconnectionDelayMax: 5000,
            timeout: 20000,
            transports: ['websocket', 'polling']
        });

        socket.on('connect', () => {
            console.log('Socket connected:', socket.id);
            updateStatus('CONNECTING TO ROOM...', 'warning');
            socket.emit('join-room', {
                roomId: ROOM_ID,
                role: 'doctor',
                appointmentId: APPOINTMENT_ID
            });
        });

        socket.on('user-ready', async () => {
            console.log('Patient connected, creating peer connection...');
            updateStatus('PATIENT CONNECTED', 'warning');

            if (await createPeerConnection()) {
                await createOffer();
            }
        });

        socket.on('signal', async (data) => {
            if (!peerConnection) {
                await createPeerConnection();
            }

            if (data.answer) {
                try {
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                    updateStatus('CONNECTED', 'connected');
                    startTimer();
                    showToast('Call established successfully', 'success');
                } catch (error) {
                    console.error('Error setting remote description:', error);
                    showToast('Connection error', 'error');
                }
            } else if (data.candidate) {
                try {
                    await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                } catch (error) {
                    console.error('Error adding ICE candidate:', error);
                }
            }
        });

        socket.on('audio-status', (data) => {
            console.log('Remote audio status:', data.muted ? 'muted' : 'unmuted');
            // Could update UI to show remote mute status
        });

        socket.on('call-ended', () => {
            showToast('Patient ended the call', 'info');
            setTimeout(() => endCallProcedure(), 2000);
        });

        socket.on('disconnect', (reason) => {
            console.log('Socket disconnected:', reason);
            updateStatus('DISCONNECTED', 'error');
            handleDisconnection();
        });

        socket.on('connect_error', (error) => {
            console.error('Socket connection error:', error);
            updateStatus('CONNECTION ERROR', 'error');
            showToast('Connection error. Trying to reconnect...', 'error');
        });

        socket.on('error', (error) => {
            console.error('Socket error:', error);
            updateStatus('SOCKET ERROR', 'error');
        });
    }

    // Handle disconnection
    function handleDisconnection() {
        reconnectAttempts++;

        if (reconnectAttempts <= MAX_RECONNECT_ATTEMPTS) {
            showToast(`Reconnecting... (${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS})`, 'warning');

            setTimeout(() => {
                if (peerConnection) {
                    peerConnection.close();
                    peerConnection = null;
                }

                if (socket && !socket.connected) {
                    socket.connect();
                } else if (socket && socket.connected) {
                    socket.emit('join-room', {
                        roomId: ROOM_ID,
                        role: 'doctor'
                    });
                }
            }, 2000 * reconnectAttempts);
        } else {
            showToast('Connection lost. Please refresh or check your internet.', 'error');
            updateStatus('CONNECTION LOST', 'error');

            // Show retry button
            const retryBtn = document.createElement('button');
            retryBtn.textContent = 'Retry Connection';
            retryBtn.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                padding: 15px 30px;
                background: var(--primary);
                color: white;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                z-index: 1000;
                font-weight: 600;
                box-shadow: var(--shadow);
            `;
            retryBtn.onclick = () => {
                retryBtn.remove();
                refreshEverything();
            };
            document.body.appendChild(retryBtn);
        }
    }

    // Start call timer
    function startTimer() {
        if (!callStartTime) {
            callStartTime = Date.now();

            // Update timer every second
            const timerInterval = setInterval(() => {
                if (callStartTime) {
                    const duration = Date.now() - callStartTime;
                    const minutes = Math.floor(duration / 60000);
                    const seconds = Math.floor((duration % 60000) / 1000);

                    // Update status with timer
                    updateStatus(`CONNECTED - ${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`, 'connected');
                }

                // Clear interval if call ended
                if (!peerConnection || peerConnection.iceConnectionState === 'closed') {
                    clearInterval(timerInterval);
                }
            }, 1000);
        }
    }

    // ===============================
    // REFRESH FUNCTIONALITY
    // ===============================

    // Refresh everything
    async function refreshEverything() {
        if (isRefreshing) return;

        isRefreshing = true;
        const refreshBtn = document.getElementById('refreshCall');
        const mobileRefreshBtn = document.getElementById('mobileRefreshCall');

        // Show refreshing state
        if (refreshBtn) refreshBtn.classList.add('refreshing');
        if (mobileRefreshBtn) mobileRefreshBtn.classList.add('refreshing');

        updateStatus('REFRESHING...', 'warning');
        showToast('Refreshing connection...', 'info');

        // Clean up
        cleanupEverything();

        // Show loading
        const videoLoading = document.getElementById('videoLoading');
        if (videoLoading) {
            videoLoading.classList.remove('hidden');
            videoLoading.innerHTML = `
                <div class="loading-spinner"></div>
                <p>Refreshing connection...</p>
            `;
        }

        // Wait a moment
        await new Promise(resolve => setTimeout(resolve, 1000));

        try {
            // Reinitialize
            if (await getLocalStream()) {
                initSocket();
                updateStatus('REFRESHED - WAITING FOR CONNECTION', 'info');
                showToast('Connection refreshed successfully!', 'success');
            }

        } catch (error) {
            console.error('Refresh failed:', error);
            showToast('Refresh failed. Please try again.', 'error');
        } finally {
            // Hide loading
            if (videoLoading) videoLoading.classList.add('hidden');

            // Remove refreshing state
            if (refreshBtn) refreshBtn.classList.remove('refreshing');
            if (mobileRefreshBtn) mobileRefreshBtn.classList.remove('refreshing');

            isRefreshing = false;
        }
    }

    // Clean up everything
    function cleanupEverything() {
        console.log('Cleaning up resources...');

        // Clear intervals
        if (echoDetectionInterval) {
            clearInterval(echoDetectionInterval);
            echoDetectionInterval = null;
        }

        if (audioLevelCheckInterval) {
            clearInterval(audioLevelCheckInterval);
            audioLevelCheckInterval = null;
        }

        // Close audio context
        if (audioContext && audioContext.state !== 'closed') {
            audioContext.close().catch(console.error);
            audioContext = null;
        }

        // Close peer connection
        if (peerConnection) {
            peerConnection.close();
            peerConnection = null;
        }

        // Stop local stream
        if (localStream) {
            localStream.getTracks().forEach(track => {
                track.stop();
                track.enabled = false;
            });
            localStream = null;
        }

        // Clear video elements
        localVideo.srcObject = null;
        remoteVideo.srcObject = null;

        // Reset socket
        if (socket) {
            socket.disconnect();
            socket = null;
        }

        // Reset state
        reconnectAttempts = 0;
        callStartTime = null;
        if (audioIndicator) audioIndicator.classList.remove('audio-active');
    }

    // ===============================
    // END CALL PROCEDURE
    // ===============================

    async function endCallProcedure() {
        updateStatus('ENDING CALL...', 'warning');

        // Save notes automatically
        const notesText = document.getElementById('notesText');
        const notes = notesText ? notesText.value.trim() :
            document.getElementById('mobileNotesText') ?
                document.getElementById('mobileNotesText').value.trim() : '';

        if (notes) {
            try {
                const response = await fetch("/api/notes/save", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        roomId: ROOM_ID,
                        appointmentId: APPOINTMENT_ID,
                        notes: notes
                    })
                });

                if (response.ok) {
                    console.log('Notes saved successfully');
                }
            } catch (error) {
                console.error('Error saving notes:', error);
                // Still save locally
                localStorage.setItem(`notes_${ROOM_ID}`, notes);
            }
        }

        // Notify server
        if (socket) {
            socket.emit('doctor-end-call', {
                roomId: ROOM_ID,
                appointmentId: APPOINTMENT_ID,
                notes: notes
            });
        }

        // Clean up
        cleanupEverything();

        // Complete appointment
        try {
            await fetch(`/appointments/${APPOINTMENT_ID}/complete`, {
                method: "POST"
            });
        } catch (error) {
            console.error('Error completing appointment:', error);
        }

        // Show ending message
        showToast('Call ended. Redirecting...', 'info');

        // Redirect after delay
        setTimeout(() => {
            window.location.href = "/doc_video_dashboard";
        }, 1500);
    }

    // ===============================
    // HELPER FUNCTIONS
    // ===============================

    // Update button state
    function updateButtonState(button1, button2, isActive, activeIcon, inactiveIcon) {
        [button1, button2].forEach(button => {
            if (button) {
                button.classList.toggle('active', isActive);
                button.classList.toggle('inactive', !isActive);
                const icon = button.querySelector('i');
                if (icon) {
                    icon.className = `fas ${isActive ? activeIcon : inactiveIcon}`;
                }

                // Add click animation
                button.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    button.style.transform = '';
                }, 150);
            }
        });
    }

    // Show toast notification
    function showToast(message, type = 'info') {
        // Remove existing toast
        const existingToast = document.querySelector('.toast-notification');
        if (existingToast) existingToast.remove();

        // Create toast
        const toast = document.createElement('div');
        toast.className = `toast-notification ${type === 'error' ? 'toast-error' :
            type === 'warning' ? 'toast-warning' :
                type === 'success' ? '' : 'toast-info'}`;

        const icon = type === 'success' ? 'fa-check-circle' :
            type === 'error' ? 'fa-exclamation-circle' :
                type === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle';

        toast.innerHTML = `
            <i class="fas ${icon}"></i>
            <span>${message}</span>
        `;

        document.body.appendChild(toast);

        // Auto remove after delay
        setTimeout(() => {
            toast.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 300);
        }, type === 'error' ? 5000 : 3000);
    }

    // ===============================
    // INITIALIZE VIDEO CALL
    // ===============================

    async function initVideoCall() {
        console.log('Initializing video call...');
        updateStatus('INITIALIZING...', 'warning');

        try {
            // Adjust layout based on screen size
            adjustVideoLayout();

            // Get media stream
            if (await getLocalStream()) {
                // Initialize socket connection
                initSocket();

                // Auto-refresh safety net
                setTimeout(() => {
                    if (!peerConnection || peerConnection.iceConnectionState !== 'connected') {
                        console.log('Auto-refreshing due to no connection...');
                        refreshEverything();
                    }
                }, 15000);
            }
        } catch (error) {
            console.error('Initialization failed:', error);
            updateStatus('INITIALIZATION FAILED', 'error');
            showToast('Failed to initialize video call. Please refresh.', 'error');

            // Show retry button
            const retryBtn = document.createElement('button');
            retryBtn.textContent = 'Retry Connection';
            retryBtn.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                padding: 15px 30px;
                background: var(--primary);
                color: white;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                z-index: 1000;
                font-weight: 600;
                box-shadow: var(--shadow);
            `;
            retryBtn.onclick = () => {
                retryBtn.remove();
                initVideoCall();
            };
            document.body.appendChild(retryBtn);
        }
    }

    // Handle page unload
    window.addEventListener('beforeunload', (e) => {
        if (peerConnection || (socket && socket.connected)) {
            e.preventDefault();
            e.returnValue = 'Are you sure you want to leave the video call?';
            return e.returnValue;
        }
    });

    // Handle page visibility change
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            // Page is hidden - reduce bandwidth
            if (peerConnection && localStream) {
                const videoTrack = localStream.getVideoTracks()[0];
                if (videoTrack && videoTrack.enabled) {
                    // Could implement bandwidth reduction here
                    console.log('Page hidden, optimizing connection...');
                }
            }
        } else {
            // Page is visible again
            console.log('Page visible again');
            if (peerConnection && peerConnection.iceConnectionState === 'disconnected') {
                handleDisconnection();
            }
        }
    });

    // ===============================
    // GLOBAL LOADER
    // ===============================
    (function () {
        // Create Loader HTML + CSS
        const style = document.createElement("style");
        style.innerHTML = `
            #global-loader {
                position: fixed;
                inset: 0;
                background: var(--background);
                z-index: 99999;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-family: "Poppins", sans-serif;
                transition: opacity 0.3s ease;
            }

            #global-loader.hidden {
                opacity: 0;
                pointer-events: none;
            }

            #global-loader .spinner {
                width: 60px;
                height: 60px;
                border: 4px solid var(--border);
                border-top-color: var(--primary);
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin-bottom: 20px;
            }

            #global-loader p {
                font-size: 16px;
                color: var(--text-dark);
                font-weight: 500;
            }

            @keyframes spin {
                to { transform: rotate(360deg); }
            }
        `;
        document.head.appendChild(style);

        const loader = document.createElement("div");
        loader.id = "global-loader";
        loader.innerHTML = `
            <div class="spinner"></div>
            <p>Loading TeleHealth Video Call...</p>
        `;
        document.body.appendChild(loader);

        // Hide loader when page loaded
        window.addEventListener("load", () => {
            setTimeout(() => {
                loader.classList.add("hidden");
                setTimeout(() => {
                    if (loader.parentNode) loader.parentNode.removeChild(loader);
                }, 400);
            }, 500);
        });

        // Safety fallback (10s)
        setTimeout(() => {
            if (document.body.contains(loader)) {
                loader.classList.add("hidden");
                setTimeout(() => {
                    if (loader.parentNode) loader.parentNode.removeChild(loader);
                }, 400);
            }
        }, 10000);
    })();
</script>