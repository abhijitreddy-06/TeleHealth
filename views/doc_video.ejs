    <!-- Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ===============================
        // EXISTING LOGIC FROM DOC_VIDEO.EJS (PRESERVED)
        // ===============================

        // Variables
        const ROOM_ID = "<%= roomId %>";
        const APPOINTMENT_ID = "<%= appointment.id %>";

        // DOM Elements
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const callStatusText = document.getElementById('callStatusText');

        // Video call state
        let localStream = null;
        let remoteStream = null;
        let peerConnection = null;
        let socket = null;
        let callStartTime = null;
        let isAudioMuted = false;
        let isVideoOff = false;

        // ===============================
        // NEW UI FUNCTIONALITY - SIMPLIFIED FIX
        // ===============================

        document.addEventListener('DOMContentLoaded', function () {
            // Theme toggle functionality
            const themeToggle = document.getElementById('themeToggle');
            const mobileThemeToggle = document.getElementById('mobileThemeToggle');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            if (savedTheme) {
                html.setAttribute('data-theme', savedTheme);
                updateThemeIcon(savedTheme);
            }

            function toggleTheme() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            }

            function updateThemeIcon(theme) {
                const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
                if (mobileThemeToggle) {
                    mobileThemeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
                }
            }

            themeToggle.addEventListener('click', toggleTheme);
            if (mobileThemeToggle) {
                mobileThemeToggle.addEventListener('click', toggleTheme);
            }

            // Mobile menu functionality
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeMenuBtn = document.getElementById('closeMenu');
            const mobileMenu = document.getElementById('mobileMenu');

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    mobileMenu.classList.add('active');
                    document.body.style.overflow = 'hidden';
                });
            }

            if (closeMenuBtn) {
                closeMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            document.addEventListener('click', (e) => {
                if (mobileMenu.classList.contains('active') &&
                    !mobileMenu.contains(e.target) &&
                    e.target !== mobileMenuBtn) {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            // NOTES PANEL FUNCTIONALITY - SIMPLIFIED FIX
            setupNotesPanels();

            // MIC AND CAMERA TOGGLE FUNCTIONALITY
            setupMediaToggles();

            // Initialize video call (existing logic)
            initVideoCall();
        });

        // Setup notes panels for desktop and mobile - SIMPLIFIED
        function setupNotesPanels() {
            // Desktop notes
            const toggleNotes = document.getElementById('toggleNotes');
            const notesPanel = document.getElementById('notesPanel');
            const closeNotes = document.getElementById('closeNotes');
            const notesText = document.getElementById('notesText');
            const charCount = document.getElementById('charCount');
            const clearNotes = document.getElementById('clearNotes');
            const saveNotes = document.getElementById('saveNotes');
            const videoCallContainer = document.getElementById('videoCallContainer');

            // Mobile notes
            const mobileToggleNotes = document.getElementById('mobileToggleNotes');
            const mobileNotesPanel = document.getElementById('mobileNotesPanel');
            const mobileCloseNotes = document.getElementById('mobileCloseNotes');
            const mobileNotesText = document.getElementById('mobileNotesText');
            const mobileCharCount = document.getElementById('mobileCharCount');
            const mobileClearNotes = document.getElementById('mobileClearNotes');
            const mobileSaveNotes = document.getElementById('mobileSaveNotes');

            // Character counters
            if (notesText && mobileNotesText) {
                notesText.addEventListener('input', function () {
                    charCount.textContent = this.value.length;
                    mobileNotesText.value = this.value;
                    mobileCharCount.textContent = this.value.length;
                });

                mobileNotesText.addEventListener('input', function () {
                    mobileCharCount.textContent = this.value.length;
                    notesText.value = this.value;
                    charCount.textContent = this.value.length;
                });
            }

            // DESKTOP NOTES TOGGLE - SIMPLIFIED
            if (toggleNotes) {
                toggleNotes.addEventListener('click', () => {
                    // Close mobile notes if open
                    const mobileNotesPanel = document.getElementById('mobileNotesPanel');
                    if (mobileNotesPanel.classList.contains('active')) {
                        mobileNotesPanel.classList.remove('active');
                        document.getElementById('mobileToggleNotes').classList.remove('active');
                        document.body.style.overflow = '';
                        document.body.classList.remove('mobile-notes-open');
                    }

                    const isOpening = !notesPanel.classList.contains('active');

                    // Button animation
                    toggleNotes.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        toggleNotes.style.transform = '';
                    }, 150);

                    if (isOpening) {
                        // OPEN: Both happen at the same time
                        notesPanel.classList.add('active');
                        notesPanel.setAttribute('aria-hidden', 'false');
                        videoCallContainer.classList.add('with-notes');
                        toggleNotes.classList.add('active');
                    } else {
                        // CLOSE: Remove container shift first, then panel after delay
                        videoCallContainer.classList.remove('with-notes');
                        toggleNotes.classList.remove('active');

                        setTimeout(() => {
                            notesPanel.classList.remove('active');
                            notesPanel.setAttribute('aria-hidden', 'true');
                        }, 350); // Match transition duration
                    }
                });
            }

            if (closeNotes) {
                closeNotes.addEventListener('click', () => {
                    // CLOSE: Remove container shift first, then panel
                    videoCallContainer.classList.remove('with-notes');
                    toggleNotes.classList.remove('active');

                    setTimeout(() => {
                        notesPanel.classList.remove('active');
                        notesPanel.setAttribute('aria-hidden', 'true');
                    }, 350);

                    // Button animation
                    closeNotes.style.transform = 'rotate(90deg)';
                    setTimeout(() => {
                        closeNotes.style.transform = '';
                    }, 200);
                });
            }

            // MOBILE NOTES TOGGLE
            if (mobileToggleNotes) {
                mobileToggleNotes.addEventListener('click', () => {
                    // Close desktop notes if open
                    if (notesPanel.classList.contains('active')) {
                        videoCallContainer.classList.remove('with-notes');
                        toggleNotes.classList.remove('active');
                        setTimeout(() => {
                            notesPanel.classList.remove('active');
                            notesPanel.setAttribute('aria-hidden', 'true');
                        }, 350);
                    }

                    const isOpening = !mobileNotesPanel.classList.contains('active');

                    if (isOpening) {
                        mobileNotesPanel.classList.add('active');
                        mobileNotesPanel.setAttribute('aria-hidden', 'false');
                        document.body.style.overflow = 'hidden';
                        document.body.classList.add('mobile-notes-open');
                    } else {
                        mobileNotesPanel.classList.remove('active');
                        mobileNotesPanel.setAttribute('aria-hidden', 'true');
                        document.body.style.overflow = '';
                        document.body.classList.remove('mobile-notes-open');
                    }

                    // Update button state
                    mobileToggleNotes.classList.toggle('active', isOpening);
                });
            }

            if (mobileCloseNotes) {
                mobileCloseNotes.addEventListener('click', () => {
                    mobileNotesPanel.classList.remove('active');
                    mobileNotesPanel.setAttribute('aria-hidden', 'true');
                    mobileToggleNotes.classList.remove('active');
                    document.body.style.overflow = '';
                    document.body.classList.remove('mobile-notes-open');
                });
            }

            // Clear notes buttons
            if (clearNotes) {
                clearNotes.addEventListener('click', function () {
                    if (confirm('Are you sure you want to clear all notes?')) {
                        if (notesText) notesText.value = '';
                        if (mobileNotesText) mobileNotesText.value = '';
                        if (charCount) charCount.textContent = '0';
                        if (mobileCharCount) mobileCharCount.textContent = '0';
                    }
                });
            }

            if (mobileClearNotes) {
                mobileClearNotes.addEventListener('click', function () {
                    if (confirm('Are you sure you want to clear all notes?')) {
                        if (notesText) notesText.value = '';
                        if (mobileNotesText) mobileNotesText.value = '';
                        if (charCount) charCount.textContent = '0';
                        if (mobileCharCount) mobileCharCount.textContent = '0';
                    }
                });
            }

            // Save notes buttons
            if (saveNotes) {
                saveNotes.addEventListener('click', saveNotesHandler);
            }

            if (mobileSaveNotes) {
                mobileSaveNotes.addEventListener('click', saveNotesHandler);
            }
        }

        // Setup mic and camera toggle functionality
        function setupMediaToggles() {
            // Get all control buttons
            const toggleMic = document.getElementById('toggleMic');
            const toggleCam = document.getElementById('toggleCam');
            const endCall = document.getElementById('endCall');
            const mobileToggleMic = document.getElementById('mobileToggleMic');
            const mobileToggleCam = document.getElementById('mobileToggleCam');
            const mobileEndCall = document.getElementById('mobileEndCall');

            // MIC TOGGLE FUNCTIONALITY
            if (toggleMic && mobileToggleMic) {
                const toggleMicHandler = () => {
                    if (!localStream) {
                        console.error('Local stream not available');
                        return;
                    }

                    const audioTracks = localStream.getAudioTracks();
                    if (audioTracks.length > 0) {
                        isAudioMuted = !isAudioMuted;
                        audioTracks.forEach(track => {
                            track.enabled = !isAudioMuted;
                        });

                        // Update UI state for both desktop and mobile
                        updateButtonState(toggleMic, mobileToggleMic, !isAudioMuted, 'fa-microphone', 'fa-microphone-slash');

                        // Show visual feedback
                        showMediaToggleFeedback(isAudioMuted ? 'Microphone muted' : 'Microphone on');
                    }
                };

                toggleMic.addEventListener('click', toggleMicHandler);
                mobileToggleMic.addEventListener('click', toggleMicHandler);
            }

            // CAMERA TOGGLE FUNCTIONALITY
            if (toggleCam && mobileToggleCam) {
                const toggleCamHandler = () => {
                    if (!localStream) {
                        console.error('Local stream not available');
                        return;
                    }

                    const videoTracks = localStream.getVideoTracks();
                    if (videoTracks.length > 0) {
                        isVideoOff = !isVideoOff;
                        videoTracks.forEach(track => {
                            track.enabled = !isVideoOff;
                        });

                        // Update UI state for both desktop and mobile
                        updateButtonState(toggleCam, mobileToggleCam, !isVideoOff, 'fa-video', 'fa-video-slash');

                        // Show visual feedback
                        showMediaToggleFeedback(isVideoOff ? 'Camera off' : 'Camera on');
                    }
                };

                toggleCam.addEventListener('click', toggleCamHandler);
                mobileToggleCam.addEventListener('click', toggleCamHandler);
            }

            // END CALL BUTTON SYNC
            if (endCall && mobileEndCall) {
                endCall.addEventListener('click', endCallHandler);
                mobileEndCall.addEventListener('click', endCallHandler);
            }
        }

        // Helper function to update button state
        function updateButtonState(button1, button2, isActive, activeIcon, inactiveIcon) {
            // Add click animation
            if (button1) {
                button1.style.transform = 'scale(0.9)';
            }
            if (button2) {
                button2.style.transform = 'scale(0.9)';
            }
            setTimeout(() => {
                if (button1) button1.style.transform = '';
                if (button2) button2.style.transform = '';
            }, 150);

            // Update button classes and icons
            [button1, button2].forEach(button => {
                if (button) {
                    button.classList.toggle('active', isActive);
                    button.classList.toggle('inactive', !isActive);
                    const iconElement = button.querySelector('i');
                    if (iconElement) {
                        iconElement.className = `fas ${isActive ? activeIcon : inactiveIcon}`;
                    }
                }
            });
        }

        // Helper function to show media toggle feedback
        function showMediaToggleFeedback(message) {
            // Create feedback element
            let feedback = document.getElementById('mediaToggleFeedback');
            if (!feedback) {
                feedback = document.createElement('div');
                feedback.id = 'mediaToggleFeedback';
                feedback.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    background: rgba(0, 0, 0, 0.8);
                    color: white;
                    padding: 12px 24px;
                    border-radius: 8px;
                    z-index: 1000;
                    font-size: 14px;
                    pointer-events: none;
                    opacity: 0;
                    transition: opacity 0.3s;
                `;
                document.body.appendChild(feedback);
            }

            feedback.textContent = message;
            feedback.style.opacity = '1';

            // Hide after 1.5 seconds
            setTimeout(() => {
                feedback.style.opacity = '0';
                setTimeout(() => {
                    if (feedback.parentNode) {
                        feedback.parentNode.removeChild(feedback);
                    }
                }, 300);
            }, 1500);
        }

        // ===============================
        // EXISTING VIDEO CALL LOGIC (PRESERVED)
        // ===============================

        // Update status display
        function updateStatus(message, type) {
            if (callStatusText) {
                callStatusText.textContent = `CALL STATUS: ${message}`;

                // Update status indicator color
                const statusDots = document.querySelectorAll('.status-dot');
                const statusColor = type === 'connected' ? '#10b981' :
                    type === 'warning' ? '#f59e0b' :
                        type === 'disconnected' ? '#ef4444' : '#60a5fa';

                statusDots.forEach(dot => {
                    dot.style.backgroundColor = statusColor;
                });
            }
        }

        // Get user media
        async function getLocalStream() {
            try {
                localStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 1280 },
                        height: { ideal: 720 },
                        frameRate: { ideal: 30 }
                    },
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });

                localVideo.srcObject = localStream;
                const videoLoading = document.getElementById('videoLoading');
                if (videoLoading) videoLoading.classList.add('hidden');
            } catch (error) {
                console.error('Error accessing media devices:', error);
                updateStatus('MEDIA ERROR', 'disconnected');
                alert('Unable to access camera and microphone. Please check permissions.');
            }
        }

        // Create peer connection
        async function createPeerConnection() {
            const configuration = {
                iceServers: [
                    { urls: 'stun:stun.l.google.com:19302' },
                    { urls: 'stun:stun1.l.google.com:19302' },
                    { urls: 'stun:stun2.l.google.com:19302' }
                ]
            };

            peerConnection = new RTCPeerConnection(configuration);

            // Add local stream tracks
            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
            });

            // Handle remote stream
            peerConnection.ontrack = (event) => {
                if (!remoteVideo.srcObject) {
                    remoteVideo.srcObject = event.streams[0];
                    remoteStream = event.streams[0];
                }
            };

            // Handle ICE candidates
            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        candidate: event.candidate
                    });
                }
            };

            // Handle connection state changes
            peerConnection.oniceconnectionstatechange = () => {
                if (peerConnection.iceConnectionState === 'disconnected' ||
                    peerConnection.iceConnectionState === 'failed') {
                    updateStatus('CONNECTION LOST', 'disconnected');
                } else if (peerConnection.iceConnectionState === 'connected') {
                    updateStatus('CONNECTED', 'connected');
                    startTimer();
                }
            };
        }

        // Create offer
        async function createOffer() {
            try {
                const offer = await peerConnection.createOffer({
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: true
                });

                await peerConnection.setLocalDescription(offer);

                socket.emit('signal', {
                    roomId: ROOM_ID,
                    offer: offer
                });
            } catch (error) {
                console.error('Error creating offer:', error);
            }
        }

        // Initialize Socket.io
        function initSocket() {
            socket = io();

            socket.on('connect', () => {
                updateStatus('CONNECTING...', 'warning');
                socket.emit('join-room', { roomId: ROOM_ID, role: 'doctor' });
            });

            socket.on('user-ready', async () => {
                updateStatus('PATIENT CONNECTED', 'warning');
                await createPeerConnection();
                await createOffer();
            });

            socket.on('signal', async (data) => {
                if (!peerConnection) {
                    await createPeerConnection();
                }

                if (data.answer) {
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                    updateStatus('CONNECTED', 'connected');
                    startTimer();
                } else if (data.candidate) {
                    try {
                        await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                    } catch (e) {
                        console.error('Error adding ICE candidate:', e);
                    }
                }
            });

            socket.on('call-ended', () => {
                endCallHandler();
            });

            socket.on('disconnect', () => {
                updateStatus('DISCONNECTED', 'disconnected');
            });
        }

        // Start call timer
        function startTimer() {
            if (!callStartTime) {
                callStartTime = Date.now();
            }
        }

        // Save notes function
        async function saveNotesHandler() {
            const notesText = document.getElementById('notesText');
            const notes = notesText ? notesText.value.trim() : '';

            if (notes) {
                try {
                    await fetch("/api/notes/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            roomId: ROOM_ID,
                            notes: notes
                        })
                    });
                    alert('Notes saved successfully!');

                    // Close mobile notes panel if open
                    const mobileNotesPanel = document.getElementById('mobileNotesPanel');
                    if (mobileNotesPanel && mobileNotesPanel.classList.contains('active')) {
                        mobileNotesPanel.classList.remove('active');
                        const mt = document.getElementById('mobileToggleNotes');
                        if (mt) mt.classList.remove('active');
                        document.body.style.overflow = '';
                        document.body.classList.remove('mobile-notes-open');
                    }
                } catch (error) {
                    console.error('Error saving notes:', error);
                    alert('Error saving notes');
                }
            } else {
                alert('No notes to save.');
            }
        }

        // End call handler
        async function endCallHandler() {
            const notesText = document.getElementById('notesText');
            const notes = notesText ? notesText.value.trim() : '';

            // Save notes locally first
            if (notes) {
                try {
                    await fetch("/api/notes/save", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            roomId: ROOM_ID,
                            notes: notes
                        })
                    });
                } catch (error) {
                    console.error('Error saving notes:', error);
                }
            }

            // Notify server
            if (socket) {
                socket.emit('doctor-end-call', {
                    roomId: ROOM_ID,
                    appointmentId: APPOINTMENT_ID,
                    notes: notes
                });
            }

            // Close peer connection
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }

            // Stop local stream
            if (localStream) {
                localStream.getTracks().forEach(track => track.stop());
                localStream = null;
            }

            // Complete appointment
            try {
                await fetch(`/appointments/${APPOINTMENT_ID}/complete`, {
                    method: "POST"
                });
            } catch (error) {
                console.error('Error completing appointment:', error);
            }

            // Disconnect socket
            if (socket) {
                socket.disconnect();
            }

            // Redirect to dashboard
            window.location.href = "/doc_video_dashboard";
        }

        // Initialize video call
        async function initVideoCall() {
            updateStatus('INITIALIZING...', 'warning');
            await getLocalStream();
            initSocket();
        }

        // Handle page unload
        window.addEventListener('beforeunload', (e) => {
            if (peerConnection || socket?.connected) {
                e.preventDefault();
                e.returnValue = 'Are you sure you want to leave the call?';
                return e.returnValue;
            }
        });
    </script>

    <!-- Global Loader Script -->
    <script>
        (function () {
            // Create Loader HTML + CSS
            const style = document.createElement("style");
            style.innerHTML = `
                #global-loader {
                    position: fixed;
                    inset: 0;
                    background: #ffffff;
                    z-index: 99999;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
                }

                #global-loader.hidden {
                    opacity: 0;
                    pointer-events: none;
                    transition: opacity 0.3s ease;
                }

                #global-loader .spinner {
                    width: 46px;
                    height: 46px;
                    border: 4px solid #e5e7eb;
                    border-top-color: #2563eb;
                    border-radius: 50%;
                    animation: spin 0.9s linear infinite;
                    margin-bottom: 12px;
                }

                #global-loader p {
                    font-size: 14px;
                    color: #374151;
                }

                @keyframes spin {
                    to { transform: rotate(360deg); }
                }
            `;
            document.head.appendChild(style);

            const loader = document.createElement("div");
            loader.id = "global-loader";
            loader.innerHTML = `
                <div class="spinner"></div>
                <p>Loading, please wait…</p>
            `;
            document.body.appendChild(loader);

            // Hide loader when page loaded
            window.addEventListener("load", () => {
                loader.classList.add("hidden");
                setTimeout(() => loader.remove(), 400);
            });

            // Show loader on link navigation
            document.addEventListener("click", (e) => {
                const link = e.target.closest("a");

                if (!link) return;
                if (link.target === "_blank") return;
                if (link.href.startsWith("mailto:")) return;
                if (link.href.startsWith("tel:")) return;
                if (link.hasAttribute("download")) return;

                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // Show loader on form submit
            document.addEventListener("submit", () => {
                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // Safety fallback (10s)
            setTimeout(() => {
                if (document.body.contains(loader)) {
                    loader.remove();
                }
            }, 10000);
        })();
    </script>
</body>

</html>