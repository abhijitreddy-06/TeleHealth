<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Doctor Consultation | TeleHealth</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            /* Professional Color Palette */
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --secondary: #059669;
            --accent: #7c3aed;
            --background: #0f172a;
            --surface: #1e293b;
            --surface-light: #334155;
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --text-tertiary: #94a3b8;
            --border: #475569;
            --error: #ef4444;
            --success: #10b981;
            --warning: #f59e0b;
            --info: #3b82f6;
            --overlay: rgba(15, 23, 42, 0.95);

            /* Light Theme */
            --light-bg: #f8fafc;
            --light-surface: #ffffff;
            --light-surface-alt: #f1f5f9;
            --light-text: #0f172a;
            --light-text-secondary: #475569;
            --light-border: #e2e8f0;

            /* Design Tokens */
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --radius-sm: 8px;
            --radius: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-full: 9999px;
        }

        [data-theme="light"] {
            --background: var(--light-bg);
            --surface: var(--light-surface);
            --surface-light: var(--light-surface-alt);
            --text-primary: var(--light-text);
            --text-secondary: var(--light-text-secondary);
            --text-tertiary: #64748b;
            --border: var(--light-border);
            --overlay: rgba(255, 255, 255, 0.95);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Inter", "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        body {
            background: var(--background);
            color: var(--text-primary);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.5;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Header - Professional & Compact */
        header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            height: 64px;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 24px;
            height: 100%;
            max-width: 100%;
            margin: 0 auto;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .call-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .patient-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: var(--surface-light);
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 500;
        }

        .patient-badge i {
            color: var(--primary);
        }

        .timer {
            background: linear-gradient(135deg, var(--primary), var(--accent));
            padding: 8px 20px;
            border-radius: var(--radius);
            color: white;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow);
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--surface-light);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            font-size: 16px;
        }

        .icon-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-1px);
        }

        /* Main Video Layout */
        .video-container {
            display: grid;
            grid-template-columns: 1fr 400px;
            grid-template-rows: 1fr auto;
            height: calc(100vh - 64px);
            gap: 16px;
            padding: 16px;
            position: relative;
        }

        /* Main Video Area */
        .video-main {
            grid-column: 1;
            grid-row: 1;
            background: #020617;
            border-radius: var(--radius-lg);
            overflow: hidden;
            position: relative;
            box-shadow: var(--shadow-xl);
        }

        [data-theme="light"] .video-main {
            background: #1e293b;
        }

        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Local Video - PiP */
        .video-local {
            position: absolute;
            bottom: 120px;
            right: 24px;
            width: 240px;
            height: 180px;
            border-radius: var(--radius);
            overflow: hidden;
            border: 3px solid var(--primary);
            box-shadow: var(--shadow-xl);
            background: #000;
            z-index: 10;
            transition: var(--transition);
        }

        .video-local:hover {
            transform: scale(1.02);
            border-color: var(--accent);
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .video-label {
            position: absolute;
            bottom: -28px;
            left: 0;
            right: 0;
            background: var(--overlay);
            color: white;
            padding: 4px 8px;
            font-size: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            backdrop-filter: blur(10px);
        }

        /* Status Overlay */
        .status-overlay {
            position: absolute;
            top: 16px;
            left: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 20;
        }

        .connection-status {
            background: var(--overlay);
            padding: 12px 16px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            max-width: 300px;
        }

        .status-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--success);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        .participant-info {
            background: var(--overlay);
            padding: 12px 16px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
        }

        .participant-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
        }

        /* Notes Panel */
        .notes-panel {
            grid-column: 2;
            grid-row: 1;
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 24px;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .notes-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .notes-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .notes-title i {
            color: var(--primary);
            font-size: 20px;
        }

        .notes-actions {
            display: flex;
            gap: 8px;
        }

        .notes-action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface-light);
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .notes-action-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .notes-textarea {
            flex: 1;
            width: 100%;
            background: var(--surface-light);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            font-family: inherit;
            font-size: 14px;
            line-height: 1.6;
            resize: none;
            transition: var(--transition);
        }

        .notes-textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .notes-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            font-size: 13px;
            color: var(--text-secondary);
        }

        .auto-save {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .auto-save i {
            color: var(--success);
        }

        /* Controls Bar - Professional */
        .controls-bar {
            grid-column: 1 / -1;
            grid-row: 2;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            padding: 16px;
            background: var(--surface);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            margin-top: 16px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .control-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: none;
            background: var(--surface-light);
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: var(--transition);
            position: relative;
            box-shadow: var(--shadow);
        }

        .control-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .control-btn.active {
            background: var(--primary);
            color: white;
        }

        .control-btn.warning {
            background: var(--warning);
            color: white;
        }

        .control-btn.danger {
            background: var(--error);
            color: white;
        }

        .control-btn.danger:hover {
            background: #dc2626;
            transform: scale(1.05);
        }

        .control-label {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Loading State */
        .video-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 5;
        }

        .loading-spinner {
            width: 48px;
            height: 48px;
            border: 3px solid rgba(37, 99, 235, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 16px;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .video-container {
                grid-template-columns: 1fr 350px;
            }

            .notes-panel {
                padding: 20px;
            }
        }

        @media (max-width: 992px) {
            .video-container {
                grid-template-columns: 1fr;
                grid-template-rows: 1fr auto 300px;
                padding: 12px;
            }

            .notes-panel {
                grid-column: 1;
                grid-row: 3;
                margin-top: 0;
            }

            .controls-bar {
                grid-column: 1;
                grid-row: 2;
                margin-top: 12px;
            }

            .video-local {
                width: 180px;
                height: 135px;
                bottom: 100px;
                right: 12px;
            }
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 0 16px;
            }

            .logo-text {
                font-size: 18px;
            }

            .call-info {
                flex-direction: column;
                gap: 8px;
                align-items: flex-start;
            }

            .patient-badge,
            .timer {
                padding: 6px 12px;
                font-size: 13px;
            }

            .video-container {
                padding: 8px;
                gap: 12px;
            }

            .controls-bar {
                gap: 16px;
                padding: 12px;
            }

            .control-btn {
                width: 48px;
                height: 48px;
                font-size: 18px;
            }

            .notes-panel {
                padding: 16px;
            }

            .video-local {
                width: 150px;
                height: 113px;
                bottom: 80px;
                right: 8px;
            }

            .status-overlay {
                top: 8px;
                left: 8px;
            }

            .connection-status,
            .participant-info {
                padding: 8px 12px;
                font-size: 13px;
            }
        }

        @media (max-width: 576px) {
            .video-container {
                grid-template-rows: 1fr auto 250px;
            }

            .controls-bar {
                gap: 12px;
                padding: 8px;
            }

            .control-btn {
                width: 44px;
                height: 44px;
                font-size: 16px;
            }

            .control-label {
                font-size: 11px;
            }

            .video-local {
                width: 120px;
                height: 90px;
                bottom: 60px;
                right: 8px;
            }

            .video-label {
                font-size: 11px;
                bottom: -22px;
            }

            .notes-textarea {
                padding: 12px;
                font-size: 13px;
            }
        }

        @media (max-width: 400px) {
            .logo-text {
                display: none;
            }

            .video-local {
                width: 100px;
                height: 75px;
                bottom: 50px;
            }

            .controls-bar {
                gap: 8px;
            }

            .control-group {
                min-width: 60px;
            }
        }

        /* Utility Classes */
        .hidden {
            display: none !important;
        }

        .visible {
            display: block;
        }

        .text-center {
            text-align: center;
        }

        /* Scrollbar Styling */
        .notes-textarea::-webkit-scrollbar {
            width: 6px;
        }

        .notes-textarea::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 3px;
        }

        .notes-textarea::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 3px;
        }

        .notes-textarea::-webkit-scrollbar-thumb:hover {
            background: var(--primary-hover);
        }

        /* Smooth Animations */
        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Focus States */
        .control-btn:focus,
        .icon-btn:focus,
        .notes-action-btn:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.3);
        }

        /* Loading Animation for Video */
        @keyframes shimmer {
            0% {
                background-position: -1000px 0;
            }

            100% {
                background-position: 1000px 0;
            }
        }

        .video-loading-bg {
            background: linear-gradient(90deg, var(--surface) 25%, var(--surface-light) 50%, var(--surface) 75%);
            background-size: 1000px 100%;
            animation: shimmer 2s infinite;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <nav class="navbar">
            <div class="logo-container">
                <div class="logo-icon">
                    <i class="fas fa-stethoscope"></i>
                </div>
                <div class="logo-text">TeleHealth MD</div>
            </div>

            <div class="call-info">
                <div class="patient-badge">
                    <i class="fas fa-user-injured"></i>
                    <span>Patient Consultation</span>
                </div>
                <div class="timer" id="callTimer">
                    <i class="fas fa-clock"></i>
                    <span>00:00:00</span>
                </div>
            </div>

            <div class="header-controls">
                <button class="icon-btn" id="themeToggle" title="Toggle theme">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main class="video-container">
        <!-- Main Video Area -->
        <div class="video-main">
            <video id="remoteVideo" autoplay playsinline></video>

            <!-- Status Overlay -->
            <div class="status-overlay">
                <div class="connection-status" id="connectionStatus">
                    <div class="status-indicator" id="statusIndicator"></div>
                    <span id="statusText">Connecting...</span>
                </div>

                <div class="participant-info" id="participantInfo">
                    <div class="participant-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <div id="participantName">Patient</div>
                        <div style="font-size: 12px; color: var(--text-secondary);" id="callStatus">
                            Waiting for patient to join...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Local Video PiP -->
            <div class="video-local">
                <video id="localVideo" autoplay muted playsinline></video>
                <div class="video-label">
                    <i class="fas fa-user-md"></i>
                    <span>You</span>
                </div>
            </div>

            <!-- Loading State -->
            <div class="video-loading hidden" id="videoLoading">
                <div class="loading-spinner"></div>
                <p>Establishing connection...</p>
            </div>
        </div>

        <!-- Notes Panel -->
        <div class="notes-panel">
            <div class="notes-header">
                <div class="notes-title">
                    <i class="fas fa-notes-medical"></i>
                    <span>Consultation Notes</span>
                </div>
                <div class="notes-actions">
                    <button class="notes-action-btn" id="clearNotes" title="Clear all notes">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <button class="notes-action-btn" id="saveNotes" title="Save notes">
                        <i class="fas fa-save"></i>
                    </button>
                </div>
            </div>
            <textarea id="notesText" class="notes-textarea" placeholder="Enter consultation notes here...
• Symptoms observed
• Preliminary diagnosis
• Prescription details
• Follow-up recommendations
• Additional observations"></textarea>
            <div class="notes-footer">
                <div class="auto-save">
                    <i class="fas fa-check-circle"></i>
                    <span>Auto-save enabled</span>
                </div>
                <div class="char-count">
                    <span id="charCount">0</span> characters
                </div>
            </div>
        </div>

        <!-- Controls Bar -->
        <div class="controls-bar">
            <div class="control-group">
                <button class="control-btn active" id="toggleMic">
                    <i class="fas fa-microphone"></i>
                </button>
                <span class="control-label">Mic On</span>
            </div>

            <div class="control-group">
                <button class="control-btn active" id="toggleCam">
                    <i class="fas fa-video"></i>
                </button>
                <span class="control-label">Camera On</span>
            </div>

            <div class="control-group">
                <button class="control-btn warning" id="toggleRecord" title="Record consultation">
                    <i class="fas fa-circle"></i>
                </button>
                <span class="control-label">Record</span>
            </div>

            <div class="control-group">
                <button class="control-btn" id="toggleScreenShare" title="Share screen">
                    <i class="fas fa-desktop"></i>
                </button>
                <span class="control-label">Share</span>
            </div>

            <div class="control-group">
                <button class="control-btn danger" id="endCall">
                    <i class="fas fa-phone-slash"></i>
                </button>
                <span class="control-label">End Call</span>
            </div>
        </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Your existing JavaScript code remains exactly the same
        document.addEventListener('DOMContentLoaded', function () {
            // Variables
            const ROOM_ID = "<%= roomId %>";
            const APPOINTMENT_ID = "<%= appointment.id %>";

            let localStream = null;
            let remoteStream = null;
            let peerConnection = null;
            let socket = null;
            let callStartTime = null;
            let isAudioMuted = false;
            let isVideoOff = false;

            // DOM Elements
            const localVideo = document.getElementById('localVideo');
            const remoteVideo = document.getElementById('remoteVideo');
            const toggleMic = document.getElementById('toggleMic');
            const toggleCam = document.getElementById('toggleCam');
            const endCall = document.getElementById('endCall');
            const callTimer = document.getElementById('callTimer');
            const statusText = document.getElementById('statusText');
            const statusIndicator = document.getElementById('statusIndicator');
            const notesText = document.getElementById('notesText');
            const charCount = document.getElementById('charCount');

            // Theme Toggle
            const themeToggle = document.getElementById('themeToggle');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme') || 'dark';
            html.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);

            function toggleTheme() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            }

            function updateThemeIcon(theme) {
                const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }

            themeToggle.addEventListener('click', toggleTheme);

            // Notes Character Counter
            notesText.addEventListener('input', function () {
                charCount.textContent = this.value.length;
            });

            // Initialize Socket.io
            function initSocket() {
                socket = io();

                socket.on('connect', () => {
                    updateStatus('Connecting to patient...', 'warning');
                    socket.emit('join-room', { roomId: ROOM_ID, role: 'doctor' });
                });

                socket.on('user-ready', async () => {
                    updateStatus('Patient connected, establishing call...', 'warning');
                    await createPeerConnection();
                    await createOffer();
                });

                socket.on('signal', async (data) => {
                    if (!peerConnection) {
                        await createPeerConnection();
                    }

                    if (data.answer) {
                        await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                        updateStatus('Call connected', 'connected');
                        startTimer();
                    } else if (data.candidate) {
                        try {
                            await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                        } catch (e) {
                            console.error('Error adding ICE candidate:', e);
                        }
                    }
                });

                socket.on('call-ended', () => {
                    endCallHandler();
                });

                socket.on('disconnect', () => {
                    updateStatus('Disconnected from server', 'disconnected');
                });
            }

            // Update status display
            function updateStatus(message, type) {
                statusText.textContent = message;
                statusIndicator.style.background = type === 'connected' ? 'var(--success)' :
                    type === 'warning' ? 'var(--warning)' :
                        type === 'disconnected' ? 'var(--error)' : 'var(--info)';
            }

            // Get user media
            async function getLocalStream() {
                try {
                    localStream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            width: { ideal: 1280 },
                            height: { ideal: 720 },
                            frameRate: { ideal: 30 }
                        },
                        audio: {
                            echoCancellation: true,
                            noiseSuppression: true,
                            autoGainControl: true
                        }
                    });

                    localVideo.srcObject = localStream;
                } catch (error) {
                    console.error('Error accessing media devices:', error);
                    alert('Unable to access camera and microphone. Please check permissions.');
                }
            }

            // Create peer connection
            async function createPeerConnection() {
                const configuration = {
                    iceServers: [
                        { urls: 'stun:stun.l.google.com:19302' },
                        { urls: 'stun:stun1.l.google.com:19302' },
                        { urls: 'stun:stun2.l.google.com:19302' }
                    ]
                };

                peerConnection = new RTCPeerConnection(configuration);

                // Add local stream tracks
                localStream.getTracks().forEach(track => {
                    peerConnection.addTrack(track, localStream);
                });

                // Handle remote stream
                peerConnection.ontrack = (event) => {
                    if (!remoteVideo.srcObject) {
                        remoteVideo.srcObject = event.streams[0];
                        remoteStream = event.streams[0];
                    }
                };

                // Handle ICE candidates
                peerConnection.onicecandidate = (event) => {
                    if (event.candidate) {
                        socket.emit('signal', {
                            roomId: ROOM_ID,
                            candidate: event.candidate
                        });
                    }
                };

                // Handle connection state changes
                peerConnection.oniceconnectionstatechange = () => {
                    if (peerConnection.iceConnectionState === 'disconnected' ||
                        peerConnection.iceConnectionState === 'failed') {
                        updateStatus('Connection lost', 'disconnected');
                    } else if (peerConnection.iceConnectionState === 'connected') {
                        updateStatus('Call connected', 'connected');
                        startTimer();
                    }
                };
            }

            // Create offer
            async function createOffer() {
                try {
                    const offer = await peerConnection.createOffer({
                        offerToReceiveAudio: true,
                        offerToReceiveVideo: true
                    });

                    await peerConnection.setLocalDescription(offer);

                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        offer: offer
                    });
                } catch (error) {
                    console.error('Error creating offer:', error);
                }
            }

            // Start call timer
            function startTimer() {
                if (!callStartTime) {
                    callStartTime = Date.now();

                    setInterval(() => {
                        const elapsed = Date.now() - callStartTime;
                        const hours = Math.floor(elapsed / 3600000);
                        const minutes = Math.floor((elapsed % 3600000) / 60000);
                        const seconds = Math.floor((elapsed % 60000) / 1000);

                        callTimer.innerHTML = `
                            <i class="fas fa-clock"></i>
                            <span>${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}</span>
                        `;
                    }, 1000);
                }
            }

            // Toggle microphone
            toggleMic.addEventListener('click', () => {
                if (localStream) {
                    localStream.getAudioTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isAudioMuted = !localStream.getAudioTracks()[0].enabled;
                    toggleMic.classList.toggle('active', !isAudioMuted);
                    toggleMic.innerHTML = isAudioMuted ?
                        '<i class="fas fa-microphone-slash"></i>' :
                        '<i class="fas fa-microphone"></i>';

                    document.querySelector('.control-group:nth-child(1) .control-label').textContent =
                        isAudioMuted ? 'Mic Off' : 'Mic On';
                }
            });

            // Toggle camera
            toggleCam.addEventListener('click', () => {
                if (localStream) {
                    localStream.getVideoTracks().forEach(track => {
                        track.enabled = !track.enabled;
                    });

                    isVideoOff = !localStream.getVideoTracks()[0].enabled;
                    toggleCam.classList.toggle('active', !isVideoOff);
                    toggleCam.innerHTML = isVideoOff ?
                        '<i class="fas fa-video-slash"></i>' :
                        '<i class="fas fa-video"></i>';

                    document.querySelector('.control-group:nth-child(2) .control-label').textContent =
                        isVideoOff ? 'Camera Off' : 'Camera On';
                }
            });

            // End call handler
            async function endCallHandler() {
                const notes = notesText.value.trim();

                // Save notes locally first
                if (notes) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notes
                            })
                        });
                    } catch (error) {
                        console.error('Error saving notes:', error);
                    }
                }

                // Notify server and user that doctor is ending call WITH PRESCRIPTION
                if (socket) {
                    socket.emit('doctor-end-call', {
                        roomId: ROOM_ID,
                        appointmentId: APPOINTMENT_ID,
                        notes: notes
                    });
                }

                // Close peer connection
                if (peerConnection) {
                    peerConnection.close();
                    peerConnection = null;
                }

                // Stop local stream
                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                    localStream = null;
                }

                // Complete appointment on server (already done in socket handler)
                try {
                    await fetch(`/appointments/${APPOINTMENT_ID}/complete`, {
                        method: "POST"
                    });
                } catch (error) {
                    console.error('Error completing appointment:', error);
                }

                // Disconnect socket
                if (socket) {
                    socket.disconnect();
                }

                // Redirect to dashboard
                window.location.href = "/doc_video_dashboard";
            }

            endCall.addEventListener('click', endCallHandler);

            // Clear notes
            document.getElementById('clearNotes').addEventListener('click', function () {
                if (confirm('Are you sure you want to clear all notes?')) {
                    notesText.value = '';
                    charCount.textContent = '0';
                }
            });

            // Save notes
            document.getElementById('saveNotes').addEventListener('click', async function () {
                if (notesText.value.trim()) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notesText.value
                            })
                        });
                        alert('Notes saved successfully!');
                    } catch (error) {
                        console.error('Error saving notes:', error);
                        alert('Error saving notes');
                    }
                } else {
                    alert('No notes to save.');
                }
            });

            // Auto-save notes every 30 seconds
            setInterval(async () => {
                if (notesText.value.trim()) {
                    try {
                        await fetch("/api/notes/save", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                roomId: ROOM_ID,
                                notes: notesText.value
                            })
                        });
                    } catch (error) {
                        console.error('Error auto-saving notes:', error);
                    }
                }
            }, 30000);

            // Initialize
            async function init() {
                updateStatus('Initializing call...', 'warning');
                await getLocalStream();
                initSocket();
            }

            init();

            // Handle page unload
            window.addEventListener('beforeunload', (e) => {
                if (peerConnection || socket?.connected) {
                    e.preventDefault();
                    e.returnValue = 'Are you sure you want to leave the call?';
                    return e.returnValue;
                }
            });
        });
    </script>
</body>

</html>