<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeleHealth - Shopping Cart</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root{--primary:#38bdf8;--primary-hover:#0ea5e9;--secondary:#10b981;--background:#f9fafb;--card-bg:#fff;--text-dark:#0f172a;--text-medium:#475569;--border:#e2e8f0;--error:#ef4444;--warning:#f59e0b;--success:#10b981;--transition:all .3s ease;--shadow:0 4px 6px -1px rgba(0,0,0,.1);--radius:12px}
        [data-theme="dark"]{--background:#1e293b;--card-bg:#334155;--text-dark:#f1f5f9;--text-medium:#cbd5e1;--border:#475569}
        *{margin:0;padding:0;box-sizing:border-box;font-family:"Poppins",sans-serif}
        body{background:var(--background);color:var(--text-dark);min-height:100vh;display:flex;flex-direction:column;line-height:1.6}
        a{text-decoration:none!important;color:inherit}
        header{background:var(--card-bg);box-shadow:var(--shadow);position:sticky;top:0;z-index:100}
        .navbar{display:flex;justify-content:space-between;align-items:center;padding:1.2rem 5%;max-width:1400px;margin:0 auto}
        .logo{font-size:1.8rem;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:.5rem}
        .logo i{color:var(--secondary)}.logo-text{background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800}
        .nav-links{display:flex;gap:1rem;align-items:center}
        .nav-links a{color:var(--text-dark);font-weight:500;padding:.5rem .8rem;border-radius:8px;display:flex;align-items:center;gap:.5rem;transition:var(--transition)}
        .nav-links a:hover,.nav-links a.active{color:var(--primary);background:rgba(56,189,248,.1)}
        .theme-toggle{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.2rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center}
        .profile-dropdown{position:relative}
        .profile-btn{background:none;border:none;cursor:pointer;color:var(--text-dark);font-size:1.3rem;padding:.5rem;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;transition:var(--transition)}
        .profile-btn:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .dropdown-menu{position:absolute;top:calc(100% + 4px);right:0;background:var(--card-bg);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);min-width:180px;padding:.5rem 0;display:none;z-index:200;border:1px solid var(--border)}
        .dropdown-menu.active{display:block}
        .dropdown-menu a{display:flex;align-items:center;gap:.8rem;padding:.7rem 1.2rem;font-size:.9rem;color:var(--text-dark);transition:var(--transition);border-radius:0}
        .dropdown-menu a:hover{background:rgba(56,189,248,.1);color:var(--primary)}
        .mobile-controls{display:none;align-items:center;gap:.5rem}
        .mobile-menu-btn{display:none;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%}
        .mobile-menu{position:fixed;top:0;right:-100%;width:280px;height:100vh;background:var(--card-bg);z-index:1000;padding:2rem;transition:var(--transition);box-shadow:-5px 0 15px rgba(0,0,0,.1);display:flex;flex-direction:column;gap:1.5rem}
        .mobile-menu.active{right:0}
        .close-menu{align-self:flex-end;background:none;border:none;color:var(--text-dark);font-size:1.5rem;cursor:pointer;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center}
        .mobile-menu a{display:flex;align-items:center;gap:1rem;padding:.8rem 1rem;border-radius:8px;color:var(--text-dark);transition:var(--transition)}
        .mobile-menu a:hover{color:var(--primary);background:rgba(56,189,248,.1)}

        .cart-container{flex:1;max-width:1200px;margin:0 auto;padding:2rem 5%;width:100%}
        .cart-header{margin-bottom:2rem}
        .cart-header h1{font-size:2rem;background:linear-gradient(135deg,var(--primary),var(--secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:.3rem}
        .cart-layout{display:grid;grid-template-columns:1fr 350px;gap:2rem;align-items:start}
        .cart-items{display:flex;flex-direction:column;gap:1rem}
        .cart-item{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:1.2rem;display:flex;gap:1rem;align-items:center}
        .cart-item img{width:80px;height:80px;border-radius:8px;object-fit:cover;background:#f1f5f9}
        .cart-item-info{flex:1}
        .cart-item-info h3{font-size:.95rem;font-weight:600;margin-bottom:.2rem}
        .cart-item-info .price{color:var(--secondary);font-weight:700;font-size:1rem}
        .cart-item-info .line-total{font-size:.8rem;color:var(--text-medium)}
        .cart-item-info .stock-warn{font-size:.75rem;color:var(--warning)}
        .qty-ctrl{display:flex;align-items:center;gap:.3rem}
        .qty-ctrl button{width:30px;height:30px;border:1px solid var(--border);border-radius:6px;background:var(--card-bg);cursor:pointer;font-size:.9rem;color:var(--text-dark);display:flex;align-items:center;justify-content:center}
        .qty-ctrl button:hover{border-color:var(--primary);color:var(--primary)}
        .qty-ctrl span{width:30px;text-align:center;font-weight:600}
        .remove-btn{background:none;border:none;color:var(--error);cursor:pointer;font-size:1.1rem;padding:.5rem;transition:var(--transition)}
        .remove-btn:hover{transform:scale(1.2)}

        .cart-summary{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:1.5rem;position:sticky;top:100px}
        .cart-summary h2{font-size:1.1rem;margin-bottom:1rem;padding-bottom:.8rem;border-bottom:1px solid var(--border)}
        .summary-row{display:flex;justify-content:space-between;margin-bottom:.6rem;font-size:.9rem}
        .summary-row.total{font-size:1.1rem;font-weight:700;margin-top:.8rem;padding-top:.8rem;border-top:2px solid var(--border)}
        .summary-row.total .amount{color:var(--secondary)}
        .free-shipping{font-size:.8rem;color:var(--success);margin-bottom:1rem;display:flex;align-items:center;gap:.3rem}
        .btn{display:block;width:100%;padding:.8rem;border-radius:8px;font-weight:600;cursor:pointer;transition:var(--transition);border:none;font-size:.95rem;text-align:center}
        .btn-primary{background:var(--primary);color:#fff;margin-bottom:.5rem}
        .btn-primary:hover{background:var(--primary-hover)}
        .btn-outline{background:transparent;border:2px solid var(--border);color:var(--text-dark)}
        .btn-outline:hover{border-color:var(--primary);color:var(--primary)}
        .empty-cart{text-align:center;padding:4rem 0;color:var(--text-medium)}
        .empty-cart i{font-size:4rem;color:var(--border);margin-bottom:1rem}
        .empty-cart a{display:inline-block;margin-top:1rem;padding:.8rem 2rem;background:var(--primary);color:#fff;border-radius:8px;font-weight:600}

        .toast-container{position:fixed;top:80px;right:20px;z-index:9999}
        .toast{background:var(--card-bg);border-radius:8px;padding:1rem 1.5rem;box-shadow:0 8px 24px rgba(0,0,0,.15);display:flex;align-items:center;gap:.8rem;margin-bottom:.5rem;animation:slideIn .3s ease;max-width:360px;border-left:4px solid var(--success)}
        .toast.error{border-left-color:var(--error)}
        @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

        .simple-footer{all:unset;display:block;background:var(--card-bg);border-top:1px solid var(--border);padding:.6rem 5%;margin-top:auto}
        .simple-footer .footer-content{all:unset;max-width:1400px;margin:0 auto;display:grid;grid-template-columns:auto 1fr auto;align-items:center}
        .simple-footer .footer-left{display:flex;align-items:center}
        .simple-footer .footer-logo{display:flex;align-items:center;gap:.5rem;color:var(--primary);font-weight:600}
        .simple-footer .footer-logo i{color:var(--secondary);font-size:1.2rem}
        .simple-footer .footer-center{text-align:center}
        .simple-footer .copyright{color:var(--text-dark);font-size:.9rem}
        .simple-footer .footer-name{color:var(--text-dark);font-weight:600}
        .simple-footer .footer-right{display:flex;gap:1rem;justify-content:flex-end}
        .simple-footer .footer-socials a{color:var(--text-dark);font-size:1.4rem}

        @media(max-width:768px){.nav-links{display:none}.mobile-controls{display:flex}.mobile-menu-btn{display:flex}.cart-layout{grid-template-columns:1fr}.cart-summary{position:static}.simple-footer .footer-content{display:flex;flex-direction:column;gap:.3rem}}
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <a href="/user_home" class="logo"><i class="fas fa-heartbeat"></i><span class="logo-text">TeleHealth</span></a>
            <div class="nav-links">
                <a href="/user_home"><i class="fas fa-home"></i> Home</a>
                <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
                <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
                <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
                <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
                <a href="/records"><i class="fas fa-folder"></i> My Records</a>
                <div class="profile-dropdown">
                    <button class="profile-btn" id="profileBtn"><i class="fas fa-user-circle"></i></button>
                    <div class="dropdown-menu" id="profileDropdown">
                        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
                        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
                    </div>
                </div>
                <button class="theme-toggle" id="themeToggle"><i class="fas fa-moon"></i></button>
            </div>
            <div class="mobile-controls">
                <div class="profile-dropdown">
                    <button class="profile-btn" id="mobileProfileBtn"><i class="fas fa-user-circle"></i></button>
                    <div class="dropdown-menu" id="mobileProfileDropdown">
                        <a href="/user_profile"><i class="fas fa-user"></i> My Profile</a>
                        <a href="/pharmacy/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <a href="/pharmacy/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
                        <a href="/pharmacy/orders"><i class="fas fa-box"></i> My Orders</a>
                    </div>
                </div>
                <button class="theme-toggle" id="mobileThemeToggle"><i class="fas fa-moon"></i></button>
                <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="fas fa-bars"></i></button>
            </div>
        </nav>
    </header>
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu"><i class="fas fa-times"></i></button>
        <a href="/user_home"><i class="fas fa-home"></i> Home</a>
        <a href="/predict"><i class="fas fa-robot"></i> AI Pre Advice</a>
        <a href="/user_video_dashboard"><i class="fas fa-video"></i> Video</a>
        <a href="/pharmacy" class="active"><i class="fas fa-pills"></i> Pharmacy</a>
        <a href="/appointments"><i class="fas fa-user-md"></i> Appointments</a>
        <a href="/records"><i class="fas fa-folder"></i> My Records</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Log Out</a>
    </div>
    <div class="toast-container" id="toastContainer"></div>

    <main class="cart-container">
        <div class="cart-header">
            <h1><i class="fas fa-shopping-cart"></i> Shopping Cart</h1>
            <p style="color:var(--text-medium)"><%= items.length %> item<%= items.length !== 1 ? 's' : '' %> in your cart</p>
        </div>

        <% if (items.length === 0) { %>
        <div class="empty-cart">
            <i class="fas fa-shopping-cart"></i>
            <h2>Your cart is empty</h2>
            <p>Browse our pharmacy and add items to your cart</p>
            <a href="/pharmacy">Continue Shopping</a>
        </div>
        <% } else { %>
        <div class="cart-layout">
            <div class="cart-items" id="cartItems">
                <% items.forEach(item => { %>
                <div class="cart-item" id="cartItem-<%= item.product_id %>">
                    <a href="/pharmacy/product/<%= item.slug %>">
                        <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400' %>" alt="<%= item.name %>" onerror="this.src='https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=400'">
                    </a>
                    <div class="cart-item-info">
                        <a href="/pharmacy/product/<%= item.slug %>"><h3><%= item.name %></h3></a>
                        <div class="price">Rs.<%= parseFloat(item.price).toFixed(0) %></div>
                        <div class="line-total">Total: Rs.<%= (parseFloat(item.price)*item.quantity).toFixed(0) %></div>
                        <% if (item.stock_quantity < item.quantity) { %>
                        <div class="stock-warn"><i class="fas fa-exclamation-triangle"></i> Only <%= item.stock_quantity %> available</div>
                        <% } %>
                    </div>
                    <div class="qty-ctrl">
                        <button onclick="updateQty(<%= item.product_id %>, <%= item.quantity-1 %>)">-</button>
                        <span><%= item.quantity %></span>
                        <button onclick="updateQty(<%= item.product_id %>, <%= item.quantity+1 %>)">+</button>
                    </div>
                    <button class="remove-btn" onclick="removeItem(<%= item.product_id %>)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                </div>
                <% }); %>
            </div>

            <div class="cart-summary">
                <h2>Order Summary</h2>
                <div class="summary-row"><span>Subtotal</span><span id="subtotalAmt">Rs.<%= subtotal.toFixed(0) %></span></div>
                <div class="summary-row"><span>Shipping</span><span id="shippingAmt"><%= subtotal >= 500 ? 'FREE' : 'Rs.49' %></span></div>
                <% if (subtotal < 500) { %>
                <div class="free-shipping"><i class="fas fa-truck"></i> Add Rs.<%= (500 - subtotal).toFixed(0) %> more for free shipping</div>
                <% } else { %>
                <div class="free-shipping"><i class="fas fa-check-circle"></i> You qualify for free shipping!</div>
                <% } %>
                <div class="summary-row total"><span>Total</span><span class="amount" id="totalAmt">Rs.<%= (subtotal + (subtotal>=500?0:49)).toFixed(0) %></span></div>
                <a href="/pharmacy/checkout" class="btn btn-primary"><i class="fas fa-lock"></i> Proceed to Checkout</a>
                <a href="/pharmacy" class="btn btn-outline">Continue Shopping</a>
            </div>
        </div>
        <% } %>
    </main>

    <footer class="simple-footer">
        <div class="footer-content">
            <div class="footer-left"><a href="/user_home" class="footer-logo"><i class="fas fa-heartbeat"></i><span>TeleHealth</span></a></div>
            <div class="footer-center"><span class="copyright">&copy; 2026 Built by <a href="https://abhijitreddy-portfolio.netlify.app/" target="_blank" class="footer-name">Abhijit Reddy</a>.</span></div>
            <div class="footer-right footer-socials">
                <a href="https://www.linkedin.com/in/abhijitreddy75" target="_blank"><i class="fab fa-linkedin"></i></a>
                <a href="https://github.com/abhijitreddy-06" target="_blank"><i class="fab fa-github"></i></a>
            </div>
        </div>
    </footer>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const html=document.documentElement;const saved=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');html.setAttribute('data-theme',saved);
        const tt=document.getElementById('themeToggle'),mtt=document.getElementById('mobileThemeToggle');
        function ui(t){const i=t==='dark'?'fa-sun':'fa-moon';tt.innerHTML='<i class="fas '+i+'"></i>';mtt.innerHTML='<i class="fas '+i+'"></i>';}ui(saved);
        function tog(){const t=html.getAttribute('data-theme')==='dark'?'light':'dark';html.setAttribute('data-theme',t);localStorage.setItem('theme',t);ui(t);}
        tt.addEventListener('click',tog);mtt.addEventListener('click',tog);
        const mm=document.getElementById('mobileMenu');
        document.getElementById('mobileMenuBtn').addEventListener('click',e=>{e.stopPropagation();mm.classList.add('active');document.body.style.overflow='hidden';});
        document.getElementById('closeMenu').addEventListener('click',()=>{mm.classList.remove('active');document.body.style.overflow='';});

        // Profile Dropdown (Desktop + Mobile)
        document.querySelectorAll('.profile-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var dd = btn.nextElementSibling;
                document.querySelectorAll('.dropdown-menu').forEach(function(m) { if (m !== dd) m.classList.remove('active'); });
                dd.classList.toggle('active');
            });
        });
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.profile-dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(function(m) { m.classList.remove('active'); });
            }
        });

        window.updateQty = async function(pid, qty) {
            if(qty<1){removeItem(pid);return;}
            try{
                const res=await fetch('/api/pharmacy/cart/update',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId:pid,quantity:qty})});
                const data=await res.json();
                if(!data.success)throw new Error(data.error||'Failed');
                location.reload();
            }catch(err){showToast(err.message,true);}
        };

        window.removeItem = async function(pid) {
            try{
                const res=await fetch('/api/pharmacy/cart/remove/'+pid,{method:'DELETE'});
                const data=await res.json();
                if(!data.success)throw new Error(data.error||'Failed');
                const el=document.getElementById('cartItem-'+pid);
                if(el)el.remove();
                location.reload();
            }catch(err){showToast(err.message,true);}
        };

        function showToast(msg,isError){
            const c=document.getElementById('toastContainer');const t=document.createElement('div');
            t.className='toast'+(isError?' error':'');
            t.innerHTML='<i class="fas '+(isError?'fa-exclamation-circle':'fa-check-circle')+'" style="color:'+(isError?'var(--error)':'var(--success)')+'"></i><span style="font-size:.9rem;font-weight:500">'+msg+'</span>';
            c.appendChild(t);setTimeout(()=>t.remove(),3000);
        }
    });
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>
</html>
