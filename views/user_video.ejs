<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <link rel="icon" type="image/png" href="/favicon.png">
    <!-- Add to your EJS head section -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <title>User Video Call | TeleHealth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        /* ===============================
           BASE STYLES FROM DOC_HOME (works)
           =============================== */
        :root {
            /* Color Variables */
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;

            /* Other Variables */
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;

            /* Height variables */
            --header-height: 80px;
            --control-bar-height: 80px;
        }

        /* Dark Theme Variables */
        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            line-height: 1.6;
            overflow: hidden;
            /* Prevent body scrolling */
        }

        /* ===============================
           HEADER - EXACT FROM DOC_HOME
           =============================== */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            height: 100%;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: "Poppins", sans-serif;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* ===============================
           MOBILE MENU - EXACT FROM DOC_HOME
           =============================== */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* ===============================
           MAIN LAYOUT CONTAINER
           =============================== */
        .main-container {
            display: flex;
            height: calc(100vh - var(--header-height));
            width: 100vw;
            overflow: hidden;
            /* Prevent scrolling */
            transition: var(--transition);
        }

        /* ===============================
           VIDEO AREA (Left side)
           =============================== */
        .video-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
            padding: 4px;
            /* Minimal gap */
            min-width: 0;
            /* Prevent overflow */
        }

        /* Video Container */
        .video-container {
            flex: 1;
            background-color: #000;
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
            border: 2px solid var(--border);
            margin-bottom: 4px;
            /* Minimal gap */
            min-height: 0;
            /* Allow shrinking */
        }

        /* Remote Video - FIXED SIZE TO PREVENT SCROLLING */
        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background-color: #000;
            display: block;
        }

        /* Local Video (PiP) */
        .local-video-pip {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 160px;
            height: 120px;
            border-radius: var(--radius);
            overflow: hidden;
            border: 2px solid var(--primary);
            background: #000;
            z-index: 5;
            transition: transform 0.3s ease;
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .local-video-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.3rem;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            justify-content: center;
        }

        /* Status Overlay */
        .call-status-overlay {
            position: absolute;
            top: 8px;
            left: 8px;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.5rem 0.8rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            z-index: 10;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-indicator {
            display: flex;
            gap: 0.2rem;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            background-color: var(--secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot:nth-child(2) {
            animation-delay: 0.5s;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.9);
            }
        }

        #callStatusText {
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* Video Loading State */
        .video-loading {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            z-index: 2;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 0.8rem;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===============================
           CONTROL BAR (Not fixed)
           =============================== */
        .controls-bar {
            height: var(--control-bar-height);
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.5rem;
            transition: var(--transition);
            min-height: var(--control-bar-height);
        }

        .controls-wrapper {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        /* MODERN CONTROL BUTTONS */
        .control-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
            background: transparent;
            border: none;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition);
            padding: 0.6rem 0.8rem;
            border-radius: 10px;
            min-width: 60px;
        }

        .control-btn:hover {
            transform: translateY(-1px);
            background: rgba(56, 189, 248, 0.05);
        }

        .control-btn.active {
            color: var(--primary);
        }

        .control-btn.danger {
            color: var(--error);
        }

        .control-btn.danger:hover {
            background: rgba(239, 68, 68, 0.05);
        }

        .control-icon {
            font-size: 1.3rem;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border-radius: 10px;
            border: 1.5px solid var(--border);
            transition: var(--transition);
        }

        .control-btn:hover .control-icon {
            border-color: var(--primary);
        }

        .control-btn.active .control-icon {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .control-btn.danger .control-icon {
            border-color: var(--error);
        }

        .control-btn.danger:hover .control-icon {
            background-color: var(--error);
            color: white;
        }

        .control-label {
            font-size: 0.75rem;
            font-weight: 500;
        }

        /* ===============================
           MOBILE VIEW - INCREASED FONT SIZES
           =============================== */
        @media (max-width: 768px) {
            :root {
                --header-height: 75px;
                --control-bar-height: 75px;
            }

            /* INCREASED MOBILE FONT SIZES */
            body {
                font-size: 16px;
                /* Increased base font size */
            }

            /* Header adjustments */
            .navbar {
                padding: 1rem 4%;
            }

            .logo {
                font-size: 1.6rem;
                /* Increased */
            }

            .logo i {
                font-size: 1.4rem;
                /* Increased */
            }

            /* Hide desktop nav, show mobile */
            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
                font-size: 1.6rem;
                /* Increased */
                width: 44px;
                height: 44px;
            }

            .logo-text {
                display: none;
            }

            /* Main container for mobile */
            .main-container {
                flex-direction: column;
                height: calc(100vh - var(--header-height));
            }

            /* Video area for mobile */
            .video-area {
                height: calc(100vh - var(--header-height) - var(--control-bar-height));
                padding: 3px;
                width: 100%;
                overflow: hidden;
            }

            .video-container {
                margin-bottom: 3px;
                flex: 1;
                min-height: 0;
                height: calc(100vh - 160px);
            }

            /* Remote video fix for mobile */
            #remoteVideo {
                height: 100%;
                object-fit: cover;

            }

            /* Local video PiP larger for mobile */
            .local-video-pip {
                width: 120px;
                height: 90px;
                bottom: 6px;
                right: 6px;
                transition: transform 0.3s ease, bottom 0.3s ease;
            }

            /* Status overlay larger */
            .call-status-overlay {
                top: 6px;
                left: 6px;
                padding: 0.6rem 0.9rem;
            }

            #callStatusText {
                font-size: 0.9rem;
                /* Increased */
                font-weight: 600;
            }

            /* INCREASED CONTROL BAR SIZES */
            .controls-bar {
                padding: 0 0.8rem;
                height: var(--control-bar-height);
                min-height: var(--control-bar-height);
            }

            .controls-wrapper {
                gap: 1.2rem;
                width: 100%;
                justify-content: space-around;
            }

            .control-btn {
                min-width: 70px;
                /* Increased */
                padding: 0.7rem 0.5rem;
            }

            .control-icon {
                width: 56px;
                /* Increased */
                height: 56px;
                /* Increased */
                font-size: 1.4rem;
                /* Increased */
                border-width: 2px;
            }

            .control-label {
                font-size: 0.85rem;
                /* Increased */
                font-weight: 600;
            }
        }

        /* ===============================
           UTILITY CLASSES
           =============================== */
        .hidden {
            display: none !important;
        }

        /* Remove all link underlines */
        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }

        /* Responsive adjustments for very small screens */
        @media (max-width: 480px) {
            :root {
                --header-height: 70px;
                --control-bar-height: 70px;
            }

            .navbar {
                padding: 0.8rem 3%;
            }

            .logo {
                font-size: 1.5rem;
            }

            .mobile-menu-btn {
                font-size: 1.5rem;
                width: 42px;
                height: 42px;
            }

            .controls-wrapper {
                gap: 0.8rem;
            }

            .control-btn {
                min-width: 65px;
                padding: 0.6rem 0.4rem;
            }

            .control-icon {
                width: 52px;
                height: 52px;
                font-size: 1.3rem;
            }

            .control-label {
                font-size: 0.8rem;
            }

            .local-video-pip {
                width: 110px;
                height: 82px;
            }
        }

        /* Small height devices */
        @media (max-height: 700px) and (max-width: 768px) {
            .local-video-pip {
                width: 100px;
                height: 75px;
            }
        }

        /* =====================================================
   FINAL MOBILE VIEWPORT + CONTROL BAR FIX (DROP-IN)
   ===================================================== */

        /* Prevent mobile viewport height bugs */
        html,
        body {
            height: 100%;
            overscroll-behavior: none;
        }

        /* ---------- MAIN LAYOUT FIX ---------- */
        @media (max-width: 768px) {

            /* Let flex manage height instead of vh math */
            .main-container {
                height: calc(100dvh - var(--header-height));
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* Video area becomes flexible container */
            .video-area {
                flex: 1;
                min-height: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* Video container takes remaining space only */
            .video-container {
                flex: 1;
                min-height: 0;
                max-height: 100%;
                overflow: hidden;
            }

            /* Remote video sizing – no zoom, no overflow */
            #remoteVideo {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /* ---------- CONTROL BAR FIX ---------- */
            .controls-bar {
                flex-shrink: 0;
                height: var(--control-bar-height);
                min-height: var(--control-bar-height);
                position: sticky;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 30;
                background-color: var(--card-bg);
            }

            /* Ensure controls never wrap outside */
            .controls-wrapper {
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        /* ---------- EXTRA SAFETY FOR SMALL HEIGHT DEVICES ---------- */
        @media (max-height: 700px) and (max-width: 768px) {
            .controls-bar {
                height: 70px;
                min-height: 70px;
            }
        }

        /* ---------- iOS / Android SAFE AREA SUPPORT ---------- */
        @supports (padding: env(safe-area-inset-bottom)) {
            .controls-bar {
                padding-bottom: env(safe-area-inset-bottom);
            }
        }

        /* ===============================
   CALL ENDED OVERLAY
   =============================== */
        .call-ended-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(2, 6, 23, 0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 1rem;
        }

        .call-ended-content {
            text-align: center;
            background: var(--card-bg);
            padding: 2rem;
            border-radius: var(--radius);
            border: 2px solid var(--border);
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .call-ended-icon {
            font-size: 3rem;
            color: var(--secondary);
            margin-bottom: 1.5rem;
        }

        .call-ended-content h2 {
            color: var(--text-dark);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .call-ended-content p {
            color: var(--text-medium);
            margin-bottom: 2rem;
            font-size: 1rem;
            line-height: 1.6;
        }

        .prescription-download-btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: var(--transition);
            margin: 0 auto;
        }

        .prescription-download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(56, 189, 248, 0.3);
        }

        [data-theme="dark"] .call-ended-overlay {
            background: rgba(15, 23, 42, 0.95);
        }

        [data-theme="dark"] .call-ended-content {
            background: var(--card-bg);
            color: var(--text-dark);
        }
    </style>
</head>

<body>

    <!-- Header - EXACT FROM DOC_HOME -->
    <header>
        <nav class="navbar">
            <a href="/user_video_dashboard" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/user_home"><i class="fas fa-home"></i> Home</a>
                <a href="/user_video_dashboard" class="active"><i class="fas fa-video"></i>Video</a>
                <a href="/user_profile"><i class="fas fa-user-circle"></i> Profile</a>
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- Mobile Menu - EXACT FROM DOC_HOME -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/user_home"><i class="fas fa-home"></i> Home</a>
        <a href="/user_video_dashboard" class="active"><i class="fas fa-video"></i>Video</a>
        <a href="/user_profile"><i class="fas fa-user-circle"></i> Profile</a>
    </div>

    <!-- Main Content Area -->
    <div class="main-container">
        <!-- Video Area (Left side) -->
        <div class="video-area">
            <!-- Video Container -->
            <div class="video-container">
                <!-- Status Overlay -->
                <div class="call-status-overlay" id="connectionStatus">
                    <div class="status-indicator">
                        <div class="status-dot" id="statusIndicator"></div>
                    </div>
                    <span id="statusText">Connecting to doctor...</span>
                </div>

                <!-- Remote Video Stream -->
                <video id="remoteVideo" autoplay playsinline></video>

                <!-- Local Video (Picture-in-Picture) -->
                <div class="local-video-pip">
                    <video id="localVideo" autoplay muted playsinline></video>
                    <div class="local-video-label">
                        <i class="fas fa-user"></i>
                        <span>YOU</span>
                    </div>
                </div>

                <!-- Loading State -->
                <div class="video-loading hidden" id="videoLoading">
                    <div class="loading-spinner"></div>
                    <p>Establishing connection...</p>
                </div>
            </div>

            <!-- Control Bar (Not fixed) -->
            <div class="controls-bar">
                <div class="controls-wrapper">
                    <!-- Microphone Toggle -->
                    <button class="control-btn active" id="toggleMic">
                        <div class="control-icon">
                            <i class="fas fa-microphone"></i>
                        </div>
                        <span class="control-label">Mute</span>
                    </button>

                    <!-- Camera Toggle -->
                    <button class="control-btn active" id="toggleCam">
                        <div class="control-icon">
                            <i class="fas fa-video"></i>
                        </div>
                        <span class="control-label">Camera</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Call Ended Overlay -->
    <div class="call-ended-overlay" id="callEndedOverlay">
        <div class="call-ended-content">
            <div class="call-ended-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>Consultation Completed</h2>
            <p class="text-medium">Your video consultation has ended.</p>
            <button class="prescription-download-btn" id="manualDownloadBtn">
                <i class="fas fa-download"></i>
                Download Prescription
            </button>
            <p class="text-medium" style="margin-top: 1.5rem; font-size: 0.9rem;">
                You will be redirected to your dashboard shortly...
            </p>
        </div>
    </div>

    <!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {

        /* ===============================
           CONSTANTS & STATE
           =============================== */
        const ROOM_ID = "<%= roomId %>";

        let localStream = null;
        let peerConnection = null;
        let socket = null;
        let callStartTime = null;
        let timerInterval = null;

        let isAudioMuted = false;
        let isVideoOff = false;
        let callAlreadyEnded = false;
        let isAutoReloading = false;

        let connectionCheckInterval = null;
        let consecutiveFailures = 0;
        let doctorEverConnected = false;
        let reloadCheckInterval = null;

        const MAX_CONSECUTIVE_FAILURES = 3;
        const CHECK_INTERVAL = 2000;

        /* ===============================
           DOM ELEMENTS
           =============================== */
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const toggleMic = document.getElementById('toggleMic');
        const toggleCam = document.getElementById('toggleCam');

        const statusText = document.getElementById('statusText');
        const statusIndicator = document.getElementById('statusIndicator');

        const callEndedOverlay = document.getElementById('callEndedOverlay');
        const overlayTitle = document.querySelector('.call-ended-content h2');
        const overlayMessage = document.querySelector('.call-ended-content p');
        const downloadBtn = document.getElementById('manualDownloadBtn');

        /* ===============================
           THEME
           =============================== */
        const themeToggle = document.getElementById('themeToggle');
        const mobileThemeToggle = document.getElementById('mobileThemeToggle');
        const html = document.documentElement;

        const savedTheme = localStorage.getItem('theme') || 'dark';
        html.setAttribute('data-theme', savedTheme);
        updateThemeIcon(savedTheme);

        function toggleTheme() {
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateThemeIcon(next);
        }

        function updateThemeIcon(theme) {
            const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
            themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            if (mobileThemeToggle) {
                mobileThemeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }
        }

        themeToggle.addEventListener('click', toggleTheme);
        mobileThemeToggle?.addEventListener('click', toggleTheme);

        /* ===============================
           MOBILE MENU
           =============================== */
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const closeMenuBtn = document.getElementById('closeMenu');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn?.addEventListener('click', e => {
            e.stopPropagation();
            mobileMenu.classList.add('active');
            document.body.style.overflow = 'hidden';
        });

        closeMenuBtn?.addEventListener('click', () => {
            mobileMenu.classList.remove('active');
            document.body.style.overflow = '';
        });

        document.addEventListener('click', e => {
            if (mobileMenu.classList.contains('active') &&
                !mobileMenu.contains(e.target) &&
                e.target !== mobileMenuBtn) {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            }
        });

        /* ===============================
           STATUS UI
           =============================== */
        function updateStatus(msg, type) {
            if (callAlreadyEnded) return;
            statusText.textContent = msg;

            if (type === 'connected') statusIndicator.style.background = 'var(--secondary)';
            if (type === 'warning') statusIndicator.style.background = 'var(--warning)';
            if (type === 'disconnected') statusIndicator.style.background = 'var(--error)';
        }

        /* ===============================
           MEDIA
           =============================== */
        async function getLocalStream() {
            localStream = await navigator.mediaDevices.getUserMedia({
                video: { width: 640, height: 480, frameRate: 24 },
                audio: { echoCancellation: true, noiseSuppression: true }
            });
            localVideo.srcObject = localStream;
            document.getElementById('videoLoading').classList.add('hidden');
        }

        /* ===============================
           WEBRTC
           =============================== */
        async function createPeerConnection() {
            peerConnection = new RTCPeerConnection({
                iceServers: [{ urls: 'stun:stun.l.google.com:19302' }],
                iceCandidatePoolSize: 10
            });

            localStream.getTracks().forEach(t => peerConnection.addTrack(t, localStream));

            peerConnection.ontrack = e => {
                if (!remoteVideo.srcObject) {
                    remoteVideo.srcObject = e.streams[0];
                    updateStatus('Call connected', 'connected');
                    startTimer();
                }
            };

            peerConnection.onicecandidate = e => {
                if (e.candidate) {
                    socket.emit('signal', { roomId: ROOM_ID, candidate: e.candidate });
                }
            };

            peerConnection.oniceconnectionstatechange = () => {
                const s = peerConnection.iceConnectionState;
                if (['failed', 'disconnected'].includes(s)) {
                    updateStatus('Connection lost', 'disconnected');
                }
            };
        }

        /* ===============================
           SOCKET
           =============================== */
        function initSocket() {
            socket = io();

            socket.on('connect', () => {
                updateStatus('Connecting to doctor...', 'warning');
                socket.emit('join-room', { roomId: ROOM_ID, role: 'user' });
            });

            socket.on('signal', async data => {
                if (!peerConnection) await createPeerConnection();

                if (data.offer) {
                     doctorEverConnected = true;
                    await peerConnection.setRemoteDescription(data.offer);
                    const answer = await peerConnection.createAnswer();
                    await peerConnection.setLocalDescription(answer);
                    socket.emit('signal', { roomId: ROOM_ID, answer });
                } else if (data.candidate) {
                    await peerConnection.addIceCandidate(data.candidate);
                }
            });

            socket.on('doctor-ready', () => {
                doctorEverConnected = true; 
                updateStatus('Doctor connected, establishing call...', 'warning');
            });

            socket.on('call-ended-by-doctor', () => {
                callAlreadyEnded = true;
                showCallEndedOverlay(true);
            });

            socket.on('prescription-ready', () => {
                setTimeout(() => downloadPrescription(), 1000);
            });

            socket.on('disconnect', reason => {
                if (!callAlreadyEnded) updateStatus('Disconnected', 'disconnected');
            });
        }

        /* ===============================
           PRESCRIPTION
           =============================== */
        function downloadPrescription() {
            const url = `/api/prescription/download/${ROOM_ID}`;
            const original = downloadBtn.innerHTML;

            downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Downloading...';
            downloadBtn.disabled = true;

            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = url;

            iframe.onload = () => {
                setTimeout(() => {
                    downloadBtn.innerHTML = original;
                    downloadBtn.disabled = false;
                    iframe.remove();
                }, 3000);
            };

            document.body.appendChild(iframe);
            setTimeout(() => window.open(url, '_blank'), 1000);
        }

        /* ===============================
           CALL END
           =============================== */
        function cleanupCall() {
            clearInterval(timerInterval);
            peerConnection?.close();
            localStream?.getTracks().forEach(t => t.stop());
            socket?.disconnect();
        }

        function showCallEndedOverlay(withPrescription) {
            cleanupCall();

            overlayTitle.textContent = withPrescription ? 'Consultation Completed ✓' : 'Consultation Ended';
            overlayMessage.textContent = 'Your video consultation has ended.';
            callEndedOverlay.style.display = 'flex';

            setTimeout(() => {
                window.location.href = '/user_video_dashboard';
            }, withPrescription ? 5000 : 10000);
        }

        /* ===============================
           TIMER
           =============================== */
        function startTimer() {
            if (callStartTime) return;
            callStartTime = Date.now();

            timerInterval = setInterval(() => {
                const elapsed = Date.now() - callStartTime;
                const h = String(Math.floor(elapsed / 3600000)).padStart(2, '0');
                const m = String(Math.floor(elapsed % 3600000 / 60000)).padStart(2, '0');
                const s = String(Math.floor(elapsed % 60000 / 1000)).padStart(2, '0');
                document.querySelector('#callTimer span')?.textContent = `${h}:${m}:${s}`;
            }, 1000);
        }

        /* ===============================
           CONTROLS
           =============================== */
        toggleMic.addEventListener('click', () => {
            localStream.getAudioTracks().forEach(t => t.enabled = !t.enabled);
            isAudioMuted = !isAudioMuted;
        });

        toggleCam.addEventListener('click', () => {
            localStream.getVideoTracks().forEach(t => t.enabled = !t.enabled);
            isVideoOff = !isVideoOff;
        });

        downloadBtn.addEventListener('click', downloadPrescription);

        /* ===============================
           INIT
           =============================== */
        async function init() {
            updateStatus('Initializing call...', 'warning');
            await getLocalStream();
            initSocket();
            startRemotePresenceMonitor(); // ✅ ADD THIS
        }

        window.addEventListener('beforeunload', e => {
            if (!callAlreadyEnded && !isAutoReloading) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
        function startRemotePresenceMonitor() {
            // Wait for initial setup (media + socket)
            setTimeout(() => {
                if (callAlreadyEnded) return;

                reloadCheckInterval = setInterval(() => {
                    if (callAlreadyEnded) {
                        clearInterval(reloadCheckInterval);
                        return;
                    }

                    // If doctor already connected at least once → NEVER reload
                    if (doctorEverConnected) {
                        clearInterval(reloadCheckInterval);
                        return;
                    }

                    // Socket must be connected
                    if (!socket || !socket.connected) return;

                    // Reload ONLY if doctor never connected AND no peer connection
                    if (!doctorEverConnected && !peerConnection) {
                        console.warn('⏳ Doctor not connected, auto-reloading...');
                        isAutoReloading = true;
                        clearInterval(reloadCheckInterval);
                        window.location.reload();
                    }


                }, 12000); // ⏱️ wait 12 seconds before reload
            }, 5000);
        }


    });
</script>


    <!-- Global Loader Script -->
    <script>
        (function () {
            const style = document.createElement("style");
            style.innerHTML = `
                    #global-loader {
                        position: fixed;
                        inset: 0;
                        background: #ffffff;
                        z-index: 99999;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
                    }

                #global-loader.hidden {
                    opacity: 0;
                    pointer-events: none;
                    transition: opacity 0.3s ease;
                }

                #global-loader .spinner {
                    width: 46px;
                    height: 46px;
                    border: 4px solid #e5e7eb;
                    border-top-color: #2563eb;
                    border-radius: 50%;
                    animation: spin 0.9s linear infinite;
                    margin-bottom: 12px;
                }

                #global-loader p {
                    font-size: 14px;
                    color: #374151;
                }

                @keyframes spin {
                    to { transform: rotate(360deg); }
                }
            `;
            document.head.appendChild(style);

            const loader = document.createElement("div");
            loader.id = "global-loader";
            loader.innerHTML = `
                <div class="spinner"></div>
                <p>Loading, please wait…</p>
            `;
            document.body.appendChild(loader);

            window.addEventListener("load", () => {
                loader.classList.add("hidden");
                setTimeout(() => loader.remove(), 400);
            });

            document.addEventListener("click", (e) => {
                const link = e.target.closest("a");
                if (!link) return;
                if (link.target === "_blank") return;
                if (link.href.startsWith("mailto:")) return;
                if (link.href.startsWith("tel:")) return;
                if (link.hasAttribute("download")) return;

                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            document.addEventListener("submit", () => {
                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            if (navigator.connection && navigator.connection.effectiveType) {
                if (navigator.connection.effectiveType.includes("2g")) {
                    loader.querySelector("p").innerText =
                        "Slow network detected… loading";
                }
            }

            setTimeout(() => {
                if (document.body.contains(loader)) {
                    loader.remove();
                }
            }, 10000);
        })();
</script>
</body>

</html>