<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <title>User Video Call | TeleHealth</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        
        :root {
            
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;

            
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;

            
            --header-height: 80px;
            --control-bar-height: 80px;
        }

        
        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            line-height: 1.6;
            overflow: hidden;
        }

        
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            height: 100%;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: "Poppins", sans-serif;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        
        .main-container {
            display: flex;
            height: calc(100vh - var(--header-height));
            width: 100vw;
            overflow: hidden;
            transition: var(--transition);
        }

        
        .video-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
            padding: 4px;
            min-width: 0;
        }

        
        .video-container {
            flex: 1;
            background-color: #000;
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
            border: 2px solid var(--border);
            margin-bottom: 4px;
            min-height: 0;
        }

        
        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background-color: #000;
            display: block;
        }

        
        .local-video-pip {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 160px;
            height: 120px;
            border-radius: var(--radius);
            overflow: hidden;
            border: 2px solid var(--primary);
            background: #000;
            z-index: 5;
            transition: transform 0.3s ease;
        }

        #localVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .local-video-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.3rem;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            justify-content: center;
        }

        
        .call-status-overlay {
            position: absolute;
            top: 8px;
            left: 8px;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.5rem 0.8rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            z-index: 10;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-indicator {
            display: flex;
            gap: 0.2rem;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            background-color: var(--secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot:nth-child(2) {
            animation-delay: 0.5s;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.9);
            }
        }

        #callStatusText {
            font-size: 0.85rem;
            font-weight: 500;
        }

        
        #callTimer {
            margin-left: 15px;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.85rem;
            font-weight: 500;
            background: rgba(0, 0, 0, 0.5);
            padding: 0.3rem 0.6rem;
            border-radius: 4px;
        }

        #callTimer i {
            color: var(--primary);
        }

        
        .video-loading {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            z-index: 2;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 0.8rem;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        
        .controls-bar {
            height: var(--control-bar-height);
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.5rem;
            transition: var(--transition);
            min-height: var(--control-bar-height);
        }

        .controls-wrapper {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        
        .control-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
            background: transparent;
            border: none;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition);
            padding: 0.6rem 0.8rem;
            border-radius: 10px;
            min-width: 60px;
        }

        .control-btn:hover {
            transform: translateY(-1px);
            background: rgba(56, 189, 248, 0.05);
        }

        .control-btn.active {
            color: var(--primary);
        }

        .control-btn.danger {
            color: var(--error);
        }

        .control-btn.danger:hover {
            background: rgba(239, 68, 68, 0.05);
        }

        .control-icon {
            font-size: 1.3rem;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border-radius: 10px;
            border: 1.5px solid var(--border);
            transition: var(--transition);
        }

        .control-btn:hover .control-icon {
            border-color: var(--primary);
        }

        .control-btn.active .control-icon {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .control-btn.danger .control-icon {
            border-color: var(--error);
        }

        .control-btn.danger:hover .control-icon {
            background-color: var(--error);
            color: white;
        }

        .control-label {
            font-size: 0.75rem;
            font-weight: 500;
        }

        
        @media (max-width: 768px) {
            :root {
                --header-height: 75px;
                --control-bar-height: 75px;
            }

            body {
                font-size: 16px;
            }

            .navbar {
                padding: 1rem 4%;
            }

            .logo {
                font-size: 1.6rem;
            }

            .logo i {
                font-size: 1.4rem;
            }

            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
                font-size: 1.6rem;
                width: 44px;
                height: 44px;
            }

            .logo-text {
                display: none;
            }

            .main-container {
                flex-direction: column;
                height: calc(100vh - var(--header-height));
            }

            .video-area {
                height: calc(100vh - var(--header-height) - var(--control-bar-height));
                padding: 3px;
                width: 100%;
                overflow: hidden;
            }

            .video-container {
                margin-bottom: 3px;
                flex: 1;
                min-height: 0;
                height: calc(100vh - 160px);
            }

            #remoteVideo {
                height: 100%;
                object-fit: cover;
            }

            .local-video-pip {
                width: 120px;
                height: 90px;
                bottom: 6px;
                right: 6px;
            }

            .call-status-overlay {
                top: 6px;
                left: 6px;
                padding: 0.6rem 0.9rem;
            }

            #callStatusText {
                font-size: 0.9rem;
                font-weight: 600;
            }

            #callTimer {
                font-size: 0.8rem;
                padding: 0.2rem 0.5rem;
                margin-left: 10px;
            }

            .call-status-overlay {
                flex-wrap: wrap;
                gap: 5px;
            }

            .controls-bar {
                padding: 0 0.8rem;
                height: var(--control-bar-height);
                min-height: var(--control-bar-height);
            }

            .controls-wrapper {
                gap: 1.2rem;
                width: 100%;
                justify-content: space-around;
            }

            .control-btn {
                min-width: 70px;
                padding: 0.7rem 0.5rem;
            }

            .control-icon {
                width: 56px;
                height: 56px;
                font-size: 1.4rem;
                border-width: 2px;
            }

            .control-label {
                font-size: 0.85rem;
                font-weight: 600;
            }
        }

        
        .hidden {
            display: none !important;
        }

        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }

        
        @media (max-width: 480px) {
            :root {
                --header-height: 70px;
                --control-bar-height: 70px;
            }

            .navbar {
                padding: 0.8rem 3%;
            }

            .logo {
                font-size: 1.5rem;
            }

            .mobile-menu-btn {
                font-size: 1.5rem;
                width: 42px;
                height: 42px;
            }

            .controls-wrapper {
                gap: 0.8rem;
            }

            .control-btn {
                min-width: 65px;
                padding: 0.6rem 0.4rem;
            }

            .control-icon {
                width: 52px;
                height: 52px;
                font-size: 1.3rem;
            }

            .control-label {
                font-size: 0.8rem;
            }

            .local-video-pip {
                width: 110px;
                height: 82px;
            }
        }

        
        @media (max-height: 700px) and (max-width: 768px) {
            .local-video-pip {
                width: 100px;
                height: 75px;
            }
        }

        
        html,
        body {
            height: 100%;
            overscroll-behavior: none;
        }

        @media (max-width: 768px) {
            .main-container {
                height: calc(100dvh - var(--header-height));
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .video-area {
                flex: 1;
                min-height: 0;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .video-container {
                flex: 1;
                min-height: 0;
                max-height: 100%;
                overflow: hidden;
            }

            #remoteVideo {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .controls-bar {
                flex-shrink: 0;
                height: var(--control-bar-height);
                min-height: var(--control-bar-height);
                position: sticky;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 30;
                background-color: var(--card-bg);
            }

            .controls-wrapper {
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        @media (max-height: 700px) and (max-width: 768px) {
            .controls-bar {
                height: 70px;
                min-height: 70px;
            }
        }

        @supports (padding: env(safe-area-inset-bottom)) {
            .controls-bar {
                padding-bottom: env(safe-area-inset-bottom);
            }
        }

        
        .call-ended-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(2, 6, 23, 0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 1rem;
        }

        .call-ended-content {
            text-align: center;
            background: var(--card-bg);
            padding: 2rem;
            border-radius: var(--radius);
            border: 2px solid var(--border);
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .call-ended-icon {
            font-size: 3rem;
            color: var(--secondary);
            margin-bottom: 1.5rem;
        }

        .call-ended-content h2 {
            color: var(--text-dark);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .call-ended-content p {
            color: var(--text-medium);
            margin-bottom: 2rem;
            font-size: 1rem;
            line-height: 1.6;
        }

        .prescription-download-btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: var(--transition);
            margin: 0 auto;
        }

        .prescription-download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(56, 189, 248, 0.3);
        }

        [data-theme="dark"] .call-ended-overlay {
            background: rgba(15, 23, 42, 0.95);
        }

        [data-theme="dark"] .call-ended-content {
            background: var(--card-bg);
            color: var(--text-dark);
        }

        
        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--card-bg);
            color: var(--text-dark);
            padding: 1rem 1.5rem;
            border-radius: var(--radius);
            border-left: 4px solid var(--primary);
            box-shadow: var(--shadow);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            max-width: 350px;
            transform: translateY(100px);
            opacity: 0;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast i {
            font-size: 1.2rem;
            color: var(--primary);
        }

        .toast.error {
            border-left-color: var(--error);
        }

        .toast.error i {
            color: var(--error);
        }

        .toast.warning {
            border-left-color: var(--warning);
        }

        .toast.warning i {
            color: var(--warning);
        }

        .toast.success {
            border-left-color: var(--secondary);
        }

        .toast.success i {
            color: var(--secondary);
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar">
            <a href="/user_video_dashboard" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/user_home" class="active"><i class="fas fa-home"></i> Home</a>
                <a href="/predict"><i class="fas fa-robot"></i>AI Pre Advice</a>
                <a href="/user_video_dashboard"><i class="fas fa-video"></i>video</a>
                <a href="/appointments"><i class="fas fa-user-md"></i>Appointments</a>
                <a href="/records"><i class="fas fa-folder"></i> My Records</a>
                <a href="/user_profile"><i class="fas fa-user-circle"></i> Profile</a>
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
                <a href="/user_home" class="active"><i class="fas fa-home"></i> Home</a>
                <a href="/predict"><i class="fas fa-robot"></i>AI Pre Advice</a>
                <a href="/user_video_dashboard"><i class="fas fa-video"></i>video</a>
                <a href="/appointments"><i class="fas fa-user-md"></i>Appointments</a>
                <a href="/records"><i class="fas fa-folder"></i> My Records</a>
                <a href="/user_profile"><i class="fas fa-user-circle"></i> Profile</a>
    </div>

    <div class="main-container">
        <div class="video-area">
            <div class="video-container">
                <div class="call-status-overlay" id="connectionStatus">
                    <div class="status-indicator">
                        <div class="status-dot" id="statusIndicator"></div>
                    </div>
                    <span id="statusText">Connecting to doctor...</span>
                    <div id="callTimer">
                        <i class="fas fa-clock"></i>
                        <span>00:00:00</span>
                    </div>
                </div>

                <video id="remoteVideo" autoplay playsinline></video>

                <div class="local-video-pip">
                    <video id="localVideo" autoplay muted playsinline></video>
                    <div class="local-video-label">
                        <i class="fas fa-user"></i>
                        <span>YOU</span>
                    </div>
                </div>

                <div class="video-loading hidden" id="videoLoading">
                    <div class="loading-spinner"></div>
                    <p>Establishing connection...</p>
                </div>
            </div>

            <div class="controls-bar">
                <div class="controls-wrapper">
                    <button class="control-btn active" id="toggleMic">
                        <div class="control-icon">
                            <i class="fas fa-microphone"></i>
                        </div>
                        <span class="control-label">Mute</span>
                    </button>

                    <!-- Camera Toggle -->
                    <button class="control-btn active" id="toggleCam">
                        <div class="control-icon">
                            <i class="fas fa-video"></i>
                        </div>
                        <span class="control-label">Camera</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="call-ended-overlay" id="callEndedOverlay">
        <div class="call-ended-content">
            <div class="call-ended-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>Consultation Completed</h2>
            <p class="text-medium" id="callEndedMessage">Your video consultation has ended.</p>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem;">
                <button class="prescription-download-btn" id="manualDownloadBtn">
                    <i class="fas fa-download"></i>
                    Download Prescription
                </button>
                <button class="prescription-download-btn" id="skipDownloadBtn" style="background: var(--text-medium);">
                    <i class="fas fa-arrow-right"></i>
                    Skip & Go to Dashboard
                </button>
                </div>
        </div>
    </div>

    <div class="toast hidden" id="toast">
        <i class="fas fa-info-circle"></i>
        <span id="toastMessage"></span>
    </div>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {

        
        const ROOM_ID = "<%= roomId %>";
        const USER_ID = "<%= userId || '' %>";
        const USER_NAME = "<%= userName || 'Patient' %>";
        let localStream = null;
        let peerConnection = null;
        let socket = null;
        let callStartTime = null;
        let timerInterval = null;
        let isAudioMuted = false;
        let isVideoOff = false;
        let callEnded = false;
        let reconnectAttempts = 0;
        const MAX_RECONNECT_ATTEMPTS = 5;
        let iceCandidates = [];

        
        const localVideo = document.getElementById('localVideo');
        const remoteVideo = document.getElementById('remoteVideo');
        const toggleMic = document.getElementById('toggleMic');
        const toggleCam = document.getElementById('toggleCam');
        const statusText = document.getElementById('statusText');
        const statusIndicator = document.getElementById('statusIndicator');
        const callTimer = document.getElementById('callTimer');
        const callEndedOverlay = document.getElementById('callEndedOverlay');
        const callEndedMessage = document.getElementById('callEndedMessage');
        const downloadBtn = document.getElementById('manualDownloadBtn');
        const skipDownloadBtn = document.getElementById('skipDownloadBtn');
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');

        
        function showToast(message, type = 'info') {
            toastMessage.textContent = message;
            toast.className = `toast ${type}`;
            toast.querySelector('i').className = type === 'error' ? 'fas fa-exclamation-circle' :
                type === 'warning' ? 'fas fa-exclamation-triangle' :
                    type === 'success' ? 'fas fa-check-circle' : 'fas fa-info-circle';

            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('show'), 10);

            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 3000);
        }

        
        const themeToggle = document.getElementById('themeToggle');
        const mobileThemeToggle = document.getElementById('mobileThemeToggle');
        const html = document.documentElement;

        function initTheme() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            html.setAttribute('data-theme', savedTheme);
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const currentTheme = html.getAttribute('data-theme');
            const icon = currentTheme === 'dark' ? 'fa-sun' : 'fa-moon';

            if (themeToggle) {
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }
            if (mobileThemeToggle) {
                mobileThemeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }
        }

        function toggleTheme() {
            const currentTheme = html.getAttribute('data-theme');
            const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

            html.setAttribute('data-theme', nextTheme);
            localStorage.setItem('theme', nextTheme);
            updateThemeIcon();
            showToast(`Theme changed to ${nextTheme} mode`, 'info');
        }

        initTheme();
        themeToggle.addEventListener('click', toggleTheme);
        mobileThemeToggle.addEventListener('click', toggleTheme);

        
        function updateStatus(message, type = 'warning') {
            if (callEnded) return;
            statusText.textContent = message;

            if (type === 'connected') {
                statusIndicator.style.backgroundColor = 'var(--secondary)';
                statusIndicator.style.animation = 'pulse 2s infinite';
            } else if (type === 'warning') {
                statusIndicator.style.backgroundColor = 'var(--warning)';
                statusIndicator.style.animation = 'pulse 1s infinite';
            } else if (type === 'disconnected') {
                statusIndicator.style.backgroundColor = 'var(--error)';
                statusIndicator.style.animation = 'none';
            }
        }

        
        async function getLocalStream() {
            try {
                localStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 640 },
                        height: { ideal: 480 },
                        frameRate: { ideal: 24 }
                    },
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });

                localVideo.srcObject = localStream;
                document.getElementById('videoLoading').classList.add('hidden');

                toggleMic.disabled = false;
                toggleCam.disabled = false;

                updateMicButton();
                updateCamButton();

                return true;
            } catch (error) {
                console.error('Error accessing media devices:', error);
                updateStatus('Media access failed', 'disconnected');
                showToast('Please allow camera and microphone access', 'error');
                return false;
            }
        }

        async function checkAppointmentStatus() {
            if (callEnded) return;

            try {
                const response = await fetch(`/api/appointments/${APPOINTMENT_ID}/status`);
                const data = await response.json();

                if (data.status === 'completed') {
                    console.log('Appointment was completed by doctor');
                    callEnded = true;

                    clearInterval(timerInterval);
                    cleanupWebRTC();

                    if (localStream) {
                        localStream.getTracks().forEach(track => track.stop());
                        localStream = null;
                    }
                    localVideo.srcObject = null;

                    const message = 'Your consultation has ended. Your prescription is ready.';
                    callEndedMessage.textContent = message;
                    callEndedOverlay.style.display = 'flex';
                    downloadBtn.style.display = 'inline-flex';

                    showToast('Consultation ended. Prescription is ready!', 'success');

                    if (socket) {
                        socket.disconnect();
                        socket = null;
                    }
                } else {
                    updateStatus('Doctor disconnected. Checking status...', 'warning');
                    setTimeout(() => {
                        if (!callEnded) {
                            checkAppointmentStatus();
                        }
                    }, 2000);
                }
            } catch (error) {
                console.error('Error checking appointment status:', error);
                updateStatus('Connection issue. Retrying...', 'warning');
                setTimeout(() => {
                    if (!callEnded) {
                        checkAppointmentStatus();
                    }
                }, 2000);
            }
        }

        function updateMicButton() {
            const icon = toggleMic.querySelector('.control-icon i');
            const label = toggleMic.querySelector('.control-label');

            if (isAudioMuted) {
                toggleMic.classList.remove('active');
                icon.className = 'fas fa-microphone-slash';
                label.textContent = 'Unmute';
            } else {
                toggleMic.classList.add('active');
                icon.className = 'fas fa-microphone';
                label.textContent = 'Mute';
            }
        }

        function updateCamButton() {
            const icon = toggleCam.querySelector('.control-icon i');
            const label = toggleCam.querySelector('.control-label');

            if (isVideoOff) {
                toggleCam.classList.remove('active');
                icon.className = 'fas fa-video-slash';
                label.textContent = 'Camera';
            } else {
                toggleCam.classList.add('active');
                icon.className = 'fas fa-video';
                label.textContent = 'Camera';
            }
        }

        
        function createPeerConnection() {
            console.log('Creating peer connection...');
            const configuration = {
                iceServers: [
                    { urls: 'stun:stun.l.google.com:19302' },
                    { urls: 'stun:stun1.l.google.com:19302' },
                    { urls: 'stun:stun2.l.google.com:19302' },
                    { urls: 'stun:stun3.l.google.com:19302' },
                    { urls: 'stun:stun4.l.google.com:19302' },
                    { urls: 'stun:stun.stunprotocol.org:3478' },
                    {
                        urls: 'turn:openrelay.metered.ca:80',
                        username: 'openrelayproject',
                        credential: 'openrelayproject'
                    },
                    {
                        urls: 'turn:openrelay.metered.ca:443',
                        username: 'openrelayproject',
                        credential: 'openrelayproject'
                    }
                ],
                iceCandidatePoolSize: 10,
                iceTransportPolicy: 'all'
            };

            peerConnection = new RTCPeerConnection(configuration);
            if (localStream) {
                localStream.getTracks().forEach(track => {
                    peerConnection.addTrack(track, localStream);
                });
            }
            peerConnection.ontrack = (event) => {
                console.log('Received remote track:', event.track.kind);
                if (!remoteVideo.srcObject) {
                    remoteVideo.srcObject = event.streams[0];
                    updateStatus('Call connected', 'connected');
                    startTimer();
                    showToast('Connected to doctor', 'success');
                    remoteVideo.onloadedmetadata = () => {
                        console.log('Remote video metadata loaded');
                        remoteVideo.play().catch(e => console.log('Remote video play error:', e));
                    };
                }
            };
            peerConnection.onicecandidate = (event) => {
                if (event.candidate && socket) {
                    console.log('Sending ICE candidate');
                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        candidate: event.candidate
                    });
                } else if (event.candidate === null) {
                    console.log('ICE gathering complete');
                }
            };
            peerConnection.oniceconnectionstatechange = () => {
                const state = peerConnection.iceConnectionState;
                console.log('ICE connection state:', state);

                if (state === 'connected' || state === 'completed') {
                    updateStatus('Call connected', 'connected');
                    reconnectAttempts = 0;
                } else if (state === 'disconnected') {
                    updateStatus('Connection unstable', 'warning');
                    showToast('Connection unstable', 'warning');
                } else if (state === 'failed') {
                    updateStatus('Connection failed', 'disconnected');
                    showToast('Connection lost. Reconnecting...', 'error');
                    attemptReconnect();
                }
            };

            peerConnection.onconnectionstatechange = () => {
                console.log('Connection state:', peerConnection.connectionState);
            };
            iceCandidates.forEach(candidate => {
                if (candidate) {
                    peerConnection.addIceCandidate(candidate).catch(e => console.error('Error adding stored ICE candidate:', e));
                }
            });
            iceCandidates = [];
        }

        async function handleSignal(data) {
            try {
                if (!peerConnection) {
                    console.log('Creating peer connection for incoming signal');
                    createPeerConnection();
                }

                if (data.offer) {
                    console.log('Received offer from doctor');
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));

                    const answer = await peerConnection.createAnswer({
                        offerToReceiveAudio: true,
                        offerToReceiveVideo: true
                    });

                    await peerConnection.setLocalDescription(answer);

                    socket.emit('signal', {
                        roomId: ROOM_ID,
                        answer: answer
                    });

                    console.log('Answer created and sent');
                } else if (data.answer) {
                    console.log('Received answer from doctor');
                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                } else if (data.candidate) {
                    console.log('Received ICE candidate from doctor');
                    try {
                        if (peerConnection.remoteDescription) {
                            await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                        } else {
                            iceCandidates.push(new RTCIceCandidate(data.candidate));
                            console.log('Stored ICE candidate for later');
                        }
                    } catch (error) {
                        console.error('Error adding ICE candidate:', error);
                    }
                }
            } catch (error) {
                console.error('Error handling signal:', error);
            }
        }

        
        function attemptReconnect() {
            if (reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
                showToast('Max reconnection attempts reached. Please refresh the page.', 'error');
                return;
            }

            reconnectAttempts++;
            console.log(`Reconnection attempt ${reconnectAttempts}/${MAX_RECONNECT_ATTEMPTS}`);

            setTimeout(() => {
                if (!callEnded && socket && !socket.connected) {
                    socket.connect();
                } else if (!callEnded && peerConnection && peerConnection.iceConnectionState === 'failed') {
                    cleanupWebRTC();
                    if (localStream) {
                        createPeerConnection();
                    }
                }
            }, reconnectAttempts * 2000);
        }

        function cleanupWebRTC() {
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }
            if (remoteVideo.srcObject) {
                remoteVideo.srcObject = null;
            }
            iceCandidates = [];
        }

        
        function initSocket() {
            socket = io({
                reconnection: true,
                reconnectionAttempts: MAX_RECONNECT_ATTEMPTS,
                reconnectionDelay: 1000,
                reconnectionDelayMax: 5000,
                timeout: 20000
            });

            socket.on('connect', () => {
                console.log('Socket connected:', socket.id);
                updateStatus('Connecting to doctor...', 'warning');
                reconnectAttempts = 0;

                socket.emit('join-room', {
                    roomId: ROOM_ID,
                    role: 'user'
                });
            });

            socket.on('user-joined', (data) => {
                console.log('User joined room:', data);
                updateStatus('Waiting for doctor to join...', 'warning');

                if (!peerConnection) {
                    createPeerConnection();
                }
            });

            socket.on('doctor-ready', async () => {
                console.log('Doctor is ready in room');
                updateStatus('Doctor connected, establishing call...', 'warning');
                showToast('Doctor joined the call', 'success');

                if (!peerConnection) {
                    createPeerConnection();
                }

                socket.emit('user-ready-ack', { roomId: ROOM_ID });
            });

            socket.on('signal', async (data) => {
                console.log('Received signal:', data.type || 'candidate');
                await handleSignal(data);
            });

            socket.on('call-ended-by-doctor', (data) => {
                console.log('Call ended by doctor:', data);
                callEnded = true;

                clearInterval(timerInterval);
                cleanupWebRTC();

                if (localStream) {
                    localStream.getTracks().forEach(track => track.stop());
                    localStream = null;
                }
                localVideo.srcObject = null;

                const message = 'Your consultation has ended. Your prescription is ready.';
                callEndedMessage.textContent = message;
                callEndedOverlay.style.display = 'flex';
                downloadBtn.style.display = 'inline-flex';

                showToast('Doctor ended the call. Prescription is ready!', 'success');

                setTimeout(() => {
                    if (socket) {
                        socket.disconnect();
                        socket = null;
                    }
                }, 1000);
            });

            socket.on('prescription-ready', (data) => {
                console.log('Prescription ready:', data);
                downloadBtn.style.display = 'inline-flex';
            });

            socket.on('doctor-disconnected', () => {
                console.log('Doctor disconnected');
                if (!callEnded) {
                    checkAppointmentStatus();
                }
            });

            socket.on('connect_error', (error) => {
                console.error('Socket connection error:', error);
                if (!callEnded) {
                    updateStatus('Connection error', 'disconnected');
                    checkAppointmentStatus();
                }
            });

            socket.on('disconnect', (reason) => {
                console.log('Socket disconnected:', reason);
                if (!callEnded && reason !== 'io client disconnect') {
                    checkAppointmentStatus();
                }
            });

            socket.on('error', (error) => {
                console.error('Socket error:', error);
                showToast('Connection error: ' + error.message, 'error');
            });
        }

        
        toggleMic.addEventListener('click', () => {
            if (!localStream) return;

            isAudioMuted = !isAudioMuted;
            localStream.getAudioTracks().forEach(track => {
                track.enabled = !isAudioMuted;
            });

            updateMicButton();

            if (isAudioMuted) {
                showToast('Microphone muted', 'warning');
            } else {
                showToast('Microphone unmuted', 'success');
            }

            if (socket && socket.connected) {
                socket.emit('user-mute-state', {
                    roomId: ROOM_ID,
                    isMuted: isAudioMuted
                });
            }
        });

        toggleCam.addEventListener('click', () => {
            if (!localStream) return;

            isVideoOff = !isVideoOff;
            localStream.getVideoTracks().forEach(track => {
                track.enabled = !isVideoOff;
            });

            updateCamButton();

            if (isVideoOff) {
                showToast('Camera turned off', 'warning');
            } else {
                showToast('Camera turned on', 'success');
            }

            if (socket && socket.connected) {
                socket.emit('user-camera-state', {
                    roomId: ROOM_ID,
                    isVideoOff: isVideoOff
                });
            }
        });

        
        function downloadPrescription() {
            const url = `/api/prescription/download/${ROOM_ID}`;
            const original = downloadBtn.innerHTML;

            downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Downloading...';
            downloadBtn.disabled = true;

            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Download failed');
                    return response.blob();
                })
                .then(blob => {
                    const blobUrl = window.URL.createObjectURL(blob);
                    const anchor = document.createElement('a');
                    anchor.style.display = 'none';
                    anchor.href = blobUrl;
                    anchor.download = `prescription-${ROOM_ID}.pdf`;
                    document.body.appendChild(anchor);
                    anchor.click();
                    window.URL.revokeObjectURL(blobUrl);
                    document.body.removeChild(anchor);
                    
                    showToast('Prescription downloaded successfully!', 'success');
                    
                    setTimeout(() => {
                        window.location.href = '/user_video_dashboard';
                    }, 1500);
                })
                .catch(error => {
                    console.error('Download error:', error);
                    downloadBtn.innerHTML = original;
                    downloadBtn.disabled = false;
                    showToast('Download failed. Please try again.', 'error');
                });
        }

        downloadBtn.addEventListener('click', downloadPrescription);

        skipDownloadBtn.addEventListener('click', () => {
            window.location.href = '/user_video_dashboard';
        });

        
        function cleanupCall() {
            clearInterval(timerInterval);
            cleanupWebRTC();

            if (localStream) {
                localStream.getTracks().forEach(track => {
                    track.stop();
                });
            }

            localVideo.srcObject = null;

            if (socket) {
                socket.disconnect();
                socket = null;
            }
        }

        function showCallEndedOverlay(showPrescription = false, message = 'Your video consultation has ended.') {
            callEnded = true;
            cleanupCall();

            callEndedMessage.textContent = message;
            callEndedOverlay.style.display = 'flex';

            if (showPrescription) {
                downloadBtn.style.display = 'inline-flex';
            } else {
                downloadBtn.style.display = 'none';
                setTimeout(() => {
                    window.location.href = '/user_video_dashboard';
                }, 3000);
            }
        }

        
        function startTimer() {
            if (callStartTime) return;
            callStartTime = Date.now();

            timerInterval = setInterval(() => {
                const elapsed = Date.now() - callStartTime;
                const hours = Math.floor(elapsed / 3600000);
                const minutes = Math.floor((elapsed % 3600000) / 60000);
                const seconds = Math.floor((elapsed % 60000) / 1000);

                callTimer.querySelector('span').textContent =
                    `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        
        async function initializeCall() {
            try {
                updateStatus('Initializing call...', 'warning');

                const mediaSuccess = await getLocalStream();
                if (!mediaSuccess) {
                    showToast('Cannot join call without camera/microphone access', 'error');
                    return;
                }

                initSocket();

            } catch (error) {
                console.error('Initialization error:', error);
                updateStatus('Initialization failed', 'error');
                showToast('Failed to initialize video call', 'error');
            }
        }
        window.addEventListener('load', () => {
            setTimeout(initializeCall, 500);
        });

        
        window.addEventListener('beforeunload', (e) => {
            if (callEnded) return;
            if (socket?.connected || peerConnection) {
                e.preventDefault();
                e.returnValue = 'Are you sure you want to leave? The consultation will end.';
            }
        });
    });
</script>

</body>

</html>