<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>User Consultation | TeleHealth</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            /* Color Variables */
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #0f172a;
            --dark-bg: #1e293b;
            --card-bg: #1e293b;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #0f172a;

            /* Other Variables */
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;

            /* Height variables - SAME AS DOCTOR PAGE */
            --header-height: 80px;
            --control-bar-height: 80px;
        }

        /* Light Theme Variables */
        [data-theme="light"] {
            --background: #f9fafb;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --footer-bg: #1e293b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            line-height: 1.6;
            overflow: hidden;
            /* Prevent body scrolling */
        }

        /* ===============================
           HEADER - MODIFIED FOR NEW LAYOUT
           =============================== */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--header-height);
            border-bottom: 1px solid var(--border);
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            height: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            /* Increased from 1.5rem */
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: "Poppins", sans-serif;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .call-info {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .doctor-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-medium);
        }

        .doctor-info i {
            color: var(--primary);
        }

        .timer-container {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 0.5rem 1.25rem;
            border-radius: 20px;
            color: white;
            font-weight: 600;
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.2);
        }

        .timer-container i {
            margin-right: 0.5rem;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* ===============================
           MAIN LAYOUT CONTAINER - SAME AS DOCTOR PAGE
           =============================== */
        .main-container {
            display: flex;
            height: calc(100vh - var(--header-height));
            width: 100vw;
            overflow: hidden;
            transition: var(--transition);
        }

        /* ===============================
           VIDEO AREA (Left side) - SAME AS DOCTOR PAGE
           =============================== */
        .video-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
            padding: 4px;
            min-width: 0;
        }

        /* Video Container */
        .video-container {
            flex: 1;
            background-color: #020617;
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
            border: 2px solid var(--border);
            margin-bottom: 4px;
            min-height: 0;
        }

        [data-theme="light"] .video-container {
            background: #1e293b;
        }

        /* Remote Video */
        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #020617;
            display: block;
        }

        [data-theme="light"] #remoteVideo {
            background: #1e293b;
        }

        /* Local Video (PiP) - NEW POSITIONING */
        #localVideo {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 160px;
            height: 120px;
            border: 3px solid var(--primary);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            background: #000;
            z-index: 10;
            transition: var(--transition);
            object-fit: cover;
        }

        #localVideo:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
        }

        .local-video-label {
            position: absolute;
            bottom: 0;
            right: 8px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.3rem;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            justify-content: center;
            z-index: 11;
            backdrop-filter: blur(10px);
        }

        .local-video-label i {
            color: var(--primary);
        }

        /* Connection Status */
        .connection-status {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(15, 23, 42, 0.9);
            padding: 0.5rem 0.8rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-dark);
            font-size: 0.85rem;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            z-index: 20;
        }

        [data-theme="light"] .connection-status {
            background: rgba(255, 255, 255, 0.9);
            color: var(--text-dark);
        }

        .status-indicator {
            width: 6px;
            height: 6px;
            background-color: var(--secondary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.9);
            }
        }

        /* Doctor Info Overlay */
        .doctor-info-overlay {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(15, 23, 42, 0.9);
            padding: 0.5rem 0.8rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-dark);
            font-size: 0.85rem;
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            z-index: 20;
        }

        [data-theme="light"] .doctor-info-overlay {
            background: rgba(255, 255, 255, 0.9);
            color: var(--text-dark);
        }

        .doctor-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Loading Overlay */
        .loading-overlay {
            position: absolute;
            inset: 0;
            background: rgba(2, 6, 23, 0.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            transition: var(--transition);
        }

        [data-theme="light"] .loading-overlay {
            background: rgba(15, 23, 42, 0.95);
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 0.8rem;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===============================
           CONTROL BAR - SAME MODERN STYLE AS DOCTOR PAGE
           =============================== */
        .controls-bar {
            height: var(--control-bar-height);
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.5rem;
            transition: var(--transition);
            min-height: var(--control-bar-height);
        }

        .controls-wrapper {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        /* MODERN CONTROL BUTTONS - SAME AS DOCTOR PAGE */
        .control-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.3rem;
            background: transparent;
            border: none;
            color: var(--text-dark);
            cursor: pointer;
            transition: var(--transition);
            padding: 0.6rem 0.8rem;
            border-radius: 10px;
            min-width: 60px;
        }

        .control-btn:hover {
            transform: translateY(-1px);
            background: rgba(56, 189, 248, 0.05);
        }

        .control-btn.active {
            color: var(--primary);
        }

        .control-btn.danger {
            color: var(--error);
        }

        .control-btn.danger:hover {
            background: rgba(239, 68, 68, 0.05);
        }

        .control-icon {
            font-size: 1.3rem;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border-radius: 10px;
            border: 1.5px solid var(--border);
            transition: var(--transition);
        }

        .control-btn:hover .control-icon {
            border-color: var(--primary);
        }

        .control-btn.active .control-icon {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .control-btn.danger .control-icon {
            border-color: var(--error);
        }

        .control-btn.danger:hover .control-icon {
            background-color: var(--error);
            color: white;
        }

        .control-label {
            font-size: 0.75rem;
            font-weight: 500;
        }

        /* Call Ended Overlay */
        .call-ended-overlay {
            position: absolute;
            inset: 0;
            background: rgba(2, 6, 23, 0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 200;
        }

        .call-ended-content {
            text-align: center;
            background: var(--card-bg);
            padding: 2rem;
            border-radius: var(--radius);
            border: 2px solid var(--border);
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .call-ended-icon {
            font-size: 3rem;
            color: var(--secondary);
            margin-bottom: 1.5rem;
        }

        .call-ended-content h2 {
            color: var(--text-dark);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .call-ended-content p {
            color: var(--text-medium);
            margin-bottom: 2rem;
            font-size: 1rem;
        }

        .prescription-download-btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0 auto;
            transition: var(--transition);
        }

        .prescription-download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(56, 189, 248, 0.3);
        }

        /* Utility Classes */
        .hidden {
            display: none !important;
        }

        .visible {
            display: flex;
        }

        /* ===============================
           MOBILE VIEW - INCREASED FONT SIZES
           =============================== */
        @media (max-width: 768px) {
            :root {
                --header-height: 75px;
                --control-bar-height: 75px;
            }

            /* INCREASED MOBILE FONT SIZES */
            body {
                font-size: 16px;
            }

            /* Header adjustments */
            .navbar {
                padding: 1rem;
            }

            .logo {
                font-size: 1.6rem;
            }

            .logo i {
                font-size: 1.4rem;
            }

            .logo-text {
                display: none;
            }

            .call-info {
                flex-direction: column;
                gap: 0.5rem;
                align-items: flex-start;
            }

            .doctor-info {
                font-size: 0.9rem;
            }

            .timer-container {
                font-size: 0.9rem;
                padding: 0.4rem 1rem;
            }

            /* Main container for mobile */
            .main-container {
                flex-direction: column;
                height: calc(100vh - var(--header-height));
            }

            /* Video area for mobile */
            .video-area {
                height: calc(100vh - var(--header-height) - var(--control-bar-height));
                padding: 3px;
                width: 100%;
                overflow: hidden;
            }

            .video-container {
                margin-bottom: 3px;
                flex: 1;
                min-height: 0;
            }

            /* Remote video fix for mobile */
            #remoteVideo {
                object-fit: cover;
            }

            /* Local video PiP larger for mobile */
            #localVideo {
                width: 120px;
                height: 90px;
                bottom: 6px;
                right: 6px;
            }

            .local-video-label {
                right: 6px;
                bottom: 0;
                font-size: 0.75rem;
                padding: 0.2rem 0.5rem;
            }

            /* Status overlay larger */
            .connection-status {
                top: 6px;
                left: 6px;
                padding: 0.4rem 0.8rem;
            }

            .status-indicator {
                width: 6px;
                height: 6px;
            }

            .doctor-info-overlay {
                display: none;
            }

            /* INCREASED CONTROL BAR SIZES */
            .controls-bar {
                padding: 0 0.8rem;
                height: var(--control-bar-height);
                min-height: var(--control-bar-height);
            }

            .controls-wrapper {
                gap: 1.2rem;
                width: 100%;
                justify-content: center;
            }

            .control-btn {
                min-width: 70px;
                padding: 0.7rem 0.5rem;
            }

            .control-icon {
                width: 56px;
                height: 56px;
                font-size: 1.4rem;
                border-width: 2px;
            }

            .control-label {
                font-size: 0.85rem;
                font-weight: 600;
            }

            /* Call ended overlay adjustments */
            .call-ended-content {
                padding: 1.5rem;
                margin: 1rem;
            }

            .call-ended-icon {
                font-size: 2.5rem;
            }

            .call-ended-content h2 {
                font-size: 1.5rem;
            }

            .call-ended-content p {
                font-size: 0.95rem;
            }
        }

        /* ===============================
           UTILITY CLASSES
           =============================== */
        .hidden {
            display: none !important;
        }

        /* Remove all link underlines */
        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }

        /* Responsive adjustments for very small screens */
        @media (max-width: 480px) {
            :root {
                --header-height: 70px;
                --control-bar-height: 70px;
            }

            .navbar {
                padding: 0.8rem;
            }

            .logo {
                font-size: 1.5rem;
            }

            .logo i {
                font-size: 1.3rem;
            }

            .call-info {
                gap: 0.3rem;
            }

            .doctor-info {
                font-size: 0.85rem;
            }

            .timer-container {
                font-size: 0.85rem;
                padding: 0.3rem 0.8rem;
            }

            .controls-wrapper {
                gap: 0.8rem;
            }

            .control-btn {
                min-width: 65px;
                padding: 0.6rem 0.4rem;
            }

            .control-icon {
                width: 52px;
                height: 52px;
                font-size: 1.3rem;
            }

            .control-label {
                font-size: 0.8rem;
            }

            #localVideo {
                width: 110px;
                height: 82px;
                bottom: 5px;
                right: 5px;
            }

            .local-video-label {
                right: 5px;
                font-size: 0.7rem;
                padding: 0.2rem 0.4rem;
            }
        }

        /* Small height devices */
        @media (max-height: 700px) and (max-width: 768px) {
            #localVideo {
                width: 100px;
                height: 75px;
            }

            .local-video-label {
                font-size: 0.7rem;
            }

            .control-icon {
                width: 48px;
                height: 48px;
                font-size: 1.2rem;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header>
        <nav class="navbar">
            <a href="/user_video_dashboard" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="call-info">
                <div class="doctor-info">
                    <i class="fas fa-user-md"></i>
                    <span class="text-dark">Doctor Consultation</span>
                </div>
                <div class="timer-container" id="callTimer">
                    <i class="fas fa-clock"></i>
                    <span>00:00:00</span>
                </div>
            </div>

            <div class="header-controls">
                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content Area - SAME LAYOUT AS DOCTOR PAGE -->
    <div class="main-container">
        <!-- Video Area (Left side) -->
        <div class="video-area">
            <!-- Video Container -->
            <div class="video-container">
                <!-- Connection Status -->
                <div class="connection-status" id="connectionStatus">
                    <div class="status-indicator" id="statusIndicator"></div>
                    <span class="text-dark" id="statusText">Connecting to doctor...</span>
                </div>

                <!-- Doctor Info Overlay -->
                <div class="doctor-info-overlay">
                    <div class="doctor-avatar">DR</div>
                    <div>Dr. Smith</div>
                </div>

                <!-- Remote Video (Doctor) -->
                <video id="remoteVideo" autoplay playsinline></video>

                <!-- Local Video (User) -->
                <video id="localVideo" autoplay muted playsinline></video>
                <div class="local-video-label">
                    <i class="fas fa-user"></i>
                    <span>You</span>
                </div>

                <!-- Loading State -->
                <div class="loading-overlay hidden" id="videoLoading">
                    <div class="loading-spinner"></div>
                    <p>Establishing connection...</p>
                </div>
            </div>

            <!-- Control Bar (Not fixed) -->
            <div class="controls-bar">
                <div class="controls-wrapper">
                    <!-- Microphone Toggle -->
                    <div class="control-group">
                        <button class="control-btn active" id="toggleMic">
                            <div class="control-icon">
                                <i class="fas fa-microphone"></i>
                            </div>
                            <span class="control-label">Mic On</span>
                        </button>
                    </div>

                    <!-- Camera Toggle -->
                    <div class="control-group">
                        <button class="control-btn active" id="toggleCam">
                            <div class="control-icon">
                                <i class="fas fa-video"></i>
                            </div>
                            <span class="control-label">Camera On</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call Ended Overlay -->
    <div class="call-ended-overlay" id="callEndedOverlay">
        <div class="call-ended-content">
            <div class="call-ended-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>Consultation Completed</h2>
            <p class="text-medium">Your video consultation has ended.</p>
            <button class="prescription-download-btn" id="manualDownloadBtn">
                <i class="fas fa-download"></i>
                Download Prescription
            </button>
            <p class="text-medium" style="margin-top: 1.5rem; font-size: 0.9rem;">
                You will be redirected to your dashboard shortly...
            </p>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Variables
            const ROOM_ID = "<%= roomId %>";

            let localStream = null;
            let remoteStream = null;
            let peerConnection = null;
            let socket = null;
            let callStartTime = null;
            let isAudioMuted = false;
            let isVideoOff = false;
            let timerInterval = null;
            let callAlreadyEnded = false;

            // DOM Elements
            const localVideo = document.getElementById('localVideo');
            const remoteVideo = document.getElementById('remoteVideo');
            const toggleMic = document.getElementById('toggleMic');
            const toggleCam = document.getElementById('toggleCam');
            const callTimer = document.getElementById('callTimer');
            const statusText = document.getElementById('statusText');
            const statusIndicator = document.getElementById('statusIndicator');
            const callEndedOverlay = document.getElementById('callEndedOverlay');
            const overlayTitle = document.querySelector('.call-ended-content h2');
            const overlayMessage = document.querySelector('.call-ended-content p');
            const downloadBtn = document.getElementById('manualDownloadBtn');

            // Theme Toggle
            const themeToggle = document.getElementById('themeToggle');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme') || 'dark';
            html.setAttribute('data-theme', savedTheme);
            updateThemeIcon(savedTheme);

            function toggleTheme() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon(newTheme);
            }

            function updateThemeIcon(theme) {
                const icon = theme === 'dark' ? 'fa-sun' : 'fa-moon';
                themeToggle.innerHTML = `<i class="fas ${icon}"></i>`;
            }

            themeToggle.addEventListener('click', toggleTheme);

            // Function to download prescription
            function downloadPrescription(roomId) {
                const downloadUrl = `/api/prescription/download/${roomId}`;

                // Show loading state
                const downloadBtn = document.getElementById('manualDownloadBtn');
                const originalText = downloadBtn.innerHTML;
                downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Downloading...';
                downloadBtn.disabled = true;

                // Create hidden iframe for download
                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = downloadUrl;

                iframe.onload = function () {
                    // Re-enable button after 3 seconds
                    setTimeout(() => {
                        downloadBtn.innerHTML = originalText;
                        downloadBtn.disabled = false;

                        // Check if download was successful
                        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
                        const iframeText = iframeDoc.body ? iframeDoc.body.innerText : '';

                        if (iframeText.includes('Error') || iframeText.includes('Not Found')) {
                            // Show error message to user
                            overlayMessage.textContent = 'Prescription download failed. Please try again or contact support.';

                            // Also try direct fetch to see the error
                            fetch(downloadUrl)
                                .then(response => {
                                    if (!response.ok) {
                                        return response.text().then(text => {
                                            console.error('Download error:', text);
                                        });
                                    }
                                })
                                .catch(fetchError => {
                                    console.error('Fetch error:', fetchError);
                                });
                        } else {
                            console.log('✅ Prescription download initiated successfully');
                        }

                        // Remove iframe after processing
                        document.body.removeChild(iframe);
                    }, 3000);
                };

                iframe.onerror = function () {

                    downloadBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Try Again';
                    downloadBtn.disabled = false;
                    document.body.removeChild(iframe);
                };

                document.body.appendChild(iframe);

                // Also open in new tab as backup (after delay)
                setTimeout(() => {
                    window.open(downloadUrl, '_blank');
                }, 1000);
            }

            // Function to cleanup and end call
            function cleanupCall() {
                // Clear timer interval
                if (timerInterval) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }

                // Close peer connection
                if (peerConnection) {
                    try {
                        peerConnection.close();
                    } catch (e) {
                        console.warn('Error closing peer connection:', e);
                    }
                    peerConnection = null;
                }

                // Stop local stream
                if (localStream) {
                    localStream.getTracks().forEach(track => {
                        track.stop();
                    });
                    localStream = null;
                    if (localVideo.srcObject) {
                        localVideo.srcObject = null;
                    }
                }

                // Clear remote video
                if (remoteVideo.srcObject) {
                    remoteVideo.srcObject = null;
                }

                // Update status
                updateStatus('Call ended', 'disconnected');
            }

            // Show call ended overlay
            function showCallEndedOverlay(prescriptionReady = false) {
                if (callAlreadyEnded) return;
                callAlreadyEnded = true;



                // Cleanup call resources
                cleanupCall();

                // Disconnect socket
                if (socket && socket.connected) {
                    socket.disconnect();
                }

                // Update overlay message based on prescription status
                if (prescriptionReady) {
                    overlayTitle.textContent = 'Consultation Completed ✓';
                    overlayMessage.textContent = 'Your video consultation has ended. Your prescription is being downloaded...';
                    downloadBtn.innerHTML = '<i class="fas fa-download"></i> Download Prescription Again';

                    // Automatically download prescription after a short delay
                    setTimeout(() => {
                        downloadPrescription(ROOM_ID);
                    }, 500);
                } else {
                    overlayTitle.textContent = 'Consultation Ended';
                    overlayMessage.textContent = 'Your video consultation has ended.';
                    downloadBtn.innerHTML = '<i class="fas fa-download"></i> Check for Prescription';
                }

                // Show overlay
                callEndedOverlay.style.display = 'flex';

                // Auto-redirect after delay
                const redirectDelay = prescriptionReady ? 15000 : 10000;
                setTimeout(() => {
                    window.location.href = "/user_video_dashboard";
                }, redirectDelay);
            }

            // Update status display
            function updateStatus(message, type) {
                if (callAlreadyEnded) return;

                statusText.textContent = message;

                // Update status indicator color
                if (type === 'connected') {
                    statusIndicator.style.background = 'var(--secondary)';
                } else if (type === 'disconnected') {
                    statusIndicator.style.background = 'var(--error)';
                } else if (type === 'warning') {
                    statusIndicator.style.background = 'var(--warning)';
                }
            }

            // Get user media
            async function getLocalStream() {
                try {
                    localStream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            width: { ideal: 640 },
                            height: { ideal: 480 },
                            frameRate: { ideal: 24 }
                        },
                        audio: {
                            echoCancellation: true,
                            noiseSuppression: true,
                            autoGainControl: true
                        }
                    });

                    localVideo.srcObject = localStream;
                } catch (error) {
                    updateStatus('Camera/mic permission required', 'disconnected');
                    alert('Unable to access camera and microphone. Please check permissions and try again.');
                }
            }

            // Initialize Socket.io
            function initSocket() {
                socket = io();

                socket.on('connect', () => {
                    updateStatus('Connecting to doctor...', 'warning');
                    socket.emit('join-room', { roomId: ROOM_ID, role: 'user' });
                });

                socket.on('signal', async (data) => {
                    if (!peerConnection) {
                        await createPeerConnection();
                    }

                    if (data.offer) {
                        updateStatus('Doctor connected, establishing call...', 'warning');

                        await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));

                        const answer = await peerConnection.createAnswer();
                        await peerConnection.setLocalDescription(answer);

                        socket.emit('signal', {
                            roomId: ROOM_ID,
                            answer: answer
                        });

                    } else if (data.candidate) {
                        try {
                            await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                        } catch (e) {
                            console.error('Error adding ICE candidate:', e);
                        }
                    }
                });

                // When doctor ends the call with prescription
                socket.on('call-ended-with-prescription', (data) => {
                    showCallEndedOverlay(true);
                });

                // When doctor ends the call without prescription
                socket.on('call-ended', (data) => {
                    showCallEndedOverlay(false);
                });

                // When user is ready (doctor initiated)
                socket.on('user-ready', () => {
                    console.log('✅ User ready signal received');
                });

                socket.on('disconnect', (reason) => {

                    if (!callAlreadyEnded) {
                        updateStatus('Disconnected from server', 'disconnected');
                    }
                });

                socket.on('connect_error', (error) => {
                    updateStatus('Connection error', 'disconnected');
                });

                socket.on('error', (error) => {
                    console.error('Socket error:', error);
                });
            }

            // Create peer connection
            async function createPeerConnection() {
                const configuration = {
                    iceServers: [
                        { urls: 'stun:stun.l.google.com:19302' },
                        { urls: 'stun:stun1.l.google.com:19302' },
                        { urls: 'stun:stun2.l.google.com:19302' },
                        { urls: 'stun:stun3.l.google.com:19302' },
                        { urls: 'stun:stun4.l.google.com:19302' }
                    ],
                    iceCandidatePoolSize: 10
                };

                peerConnection = new RTCPeerConnection(configuration);

                // Add local stream tracks
                if (localStream) {
                    localStream.getTracks().forEach(track => {
                        peerConnection.addTrack(track, localStream);
                    });
                }

                // Handle remote stream
                peerConnection.ontrack = (event) => {
                    if (!remoteVideo.srcObject) {
                        remoteVideo.srcObject = event.streams[0];
                        remoteStream = event.streams[0];

                        // Update UI
                        updateStatus('Call connected', 'connected');
                        startTimer();
                    }
                };

                // Handle ICE candidates
                peerConnection.onicecandidate = (event) => {
                    if (event.candidate) {
                        socket.emit('signal', {
                            roomId: ROOM_ID,
                            candidate: event.candidate
                        });
                    }
                };

                // Handle connection state changes
                peerConnection.oniceconnectionstatechange = () => {
                    const state = peerConnection.iceConnectionState;

                    switch (state) {
                        case 'connected':
                            updateStatus('Call connected', 'connected');
                            startTimer();
                            break;
                        case 'disconnected':
                            updateStatus('Connection lost', 'disconnected');
                            break;
                        case 'failed':
                            updateStatus('Connection failed', 'disconnected');
                            break;
                        case 'closed':
                            console.log('Peer connection closed');
                            break;
                    }
                };

                // Handle signaling state changes
                peerConnection.onsignalingstatechange = () => {
                    console.log('Signaling state:', peerConnection.signalingState);
                };

                // Handle connection state
                peerConnection.onconnectionstatechange = () => {
                    console.log('Connection state:', peerConnection.connectionState);
                };
            }

            // Start call timer
            function startTimer() {
                if (!callStartTime) {
                    callStartTime = Date.now();

                    timerInterval = setInterval(() => {
                        const elapsed = Date.now() - callStartTime;
                        const hours = Math.floor(elapsed / 3600000);
                        const minutes = Math.floor((elapsed % 3600000) / 60000);
                        const seconds = Math.floor((elapsed % 60000) / 1000);

                        const timeString = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

                        // Update timer display
                        const timerSpan = callTimer.querySelector('span');
                        if (timerSpan) {
                            timerSpan.textContent = timeString;
                        }

                    }, 1000);
                }
            }

            // Toggle microphone - UPDATED FOR NEW BUTTON STYLE
            toggleMic.addEventListener('click', () => {
                if (localStream) {
                    const audioTracks = localStream.getAudioTracks();
                    if (audioTracks.length > 0) {
                        audioTracks.forEach(track => {
                            track.enabled = !track.enabled;
                        });

                        isAudioMuted = !audioTracks[0].enabled;
                        toggleMic.classList.toggle('active', !isAudioMuted);
                        toggleMic.querySelector('.control-icon i').className = isAudioMuted ?
                            'fas fa-microphone-slash' :
                            'fas fa-microphone';

                        // Update icon border color based on active state
                        if (!isAudioMuted) {
                            toggleMic.querySelector('.control-icon').style.borderColor = 'var(--primary)';
                        } else {
                            toggleMic.querySelector('.control-icon').style.borderColor = 'var(--border)';
                        }

                        toggleMic.querySelector('.control-label').textContent =
                            isAudioMuted ? 'Mic Off' : 'Mic On';
                    }
                }
            });

            // Toggle camera - UPDATED FOR NEW BUTTON STYLE
            toggleCam.addEventListener('click', () => {
                if (localStream) {
                    const videoTracks = localStream.getVideoTracks();
                    if (videoTracks.length > 0) {
                        videoTracks.forEach(track => {
                            track.enabled = !track.enabled;
                        });

                        isVideoOff = !videoTracks[0].enabled;
                        toggleCam.classList.toggle('active', !isVideoOff);
                        toggleCam.querySelector('.control-icon i').className = isVideoOff ?
                            'fas fa-video-slash' :
                            'fas fa-video';

                        // Update icon border color based on active state
                        if (!isVideoOff) {
                            toggleCam.querySelector('.control-icon').style.borderColor = 'var(--primary)';
                        } else {
                            toggleCam.querySelector('.control-icon').style.borderColor = 'var(--border)';
                        }

                        toggleCam.querySelector('.control-label').textContent =
                            isVideoOff ? 'Camera Off' : 'Camera On';
                    }
                }
            });

            // Manual download prescription button
            downloadBtn.addEventListener('click', function () {
                downloadPrescription(ROOM_ID);
            });

            // Initialize
            async function init() {
                updateStatus('Initializing call...', 'warning');
                await getLocalStream();
                initSocket();
            }

            // Start initialization
            init();

            // Handle page unload
            window.addEventListener('beforeunload', (e) => {
                if ((peerConnection && peerConnection.connectionState !== 'closed') ||
                    (socket && socket.connected)) {
                    e.preventDefault();
                    e.returnValue = 'Are you sure you want to leave the video call?';
                    return e.returnValue;
                }
            });

            // Handle page visibility change
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    console.log('📱 Page hidden');
                } else {
                    console.log('📱 Page visible');
                }
            });
        });
    </script>
    <script>
        (function () {
            // -------------------------------
            // 1. Create Loader HTML + CSS
            // -------------------------------
            const style = document.createElement("style");
            style.innerHTML = `
    #global-loader {
      position: fixed;
      inset: 0;
      background: #ffffff;
      z-index: 99999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    #global-loader.hidden {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    #global-loader .spinner {
      width: 46px;
      height: 46px;
      border: 4px solid #e5e7eb;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
      margin-bottom: 12px;
    }

    #global-loader p {
      font-size: 14px;
      color: #374151;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  `;
            document.head.appendChild(style);

            const loader = document.createElement("div");
            loader.id = "global-loader";
            loader.innerHTML = `
    <div class="spinner"></div>
    <p>Loading, please wait…</p>
  `;
            document.body.appendChild(loader);

            // -------------------------------
            // 2. Hide loader when page loaded
            // -------------------------------
            window.addEventListener("load", () => {
                loader.classList.add("hidden");
                setTimeout(() => loader.remove(), 400);
            });

            // -------------------------------
            // 3. Show loader on link navigation
            // -------------------------------
            document.addEventListener("click", (e) => {
                const link = e.target.closest("a");

                if (!link) return;
                if (link.target === "_blank") return;
                if (link.href.startsWith("mailto:")) return;
                if (link.href.startsWith("tel:")) return;
                if (link.hasAttribute("download")) return;

                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // -------------------------------
            // 4. Show loader on form submit
            // -------------------------------
            document.addEventListener("submit", () => {
                loader.classList.remove("hidden");
                loader.style.display = "flex";
            });

            // -------------------------------
            // 5. Slow network hint (optional)
            // -------------------------------
            if (navigator.connection && navigator.connection.effectiveType) {
                if (navigator.connection.effectiveType.includes("2g")) {
                    loader.querySelector("p").innerText =
                        "Slow network detected… loading";
                }
            }

            // -------------------------------
            // 6. Safety fallback (10s)
            // -------------------------------
            setTimeout(() => {
                if (document.body.contains(loader)) {
                    loader.remove();
                }
            }, 10000);
        })();
    </script>

</body>

