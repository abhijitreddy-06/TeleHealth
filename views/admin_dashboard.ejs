<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TeleHealth - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/shared.css">
    <style>
        :root {
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --success: #22c55e;
            --muted: #94a3b8;
            --footer-bg: #1e293b;

            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1),
                0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
        }

        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        /* Header */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: "Poppins", sans-serif;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* Mobile nav */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* Main content */
        main {
            flex: 1;
            padding: 3rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .page-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-header p {
            color: var(--text-medium);
            font-size: 1.05rem;
        }

        /* Stats cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background-color: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.8rem;
            display: flex;
            align-items: center;
            gap: 1.2rem;
            transition: var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            flex-shrink: 0;
        }

        .stat-icon.patients {
            background: linear-gradient(135deg, #38bdf8, #0ea5e9);
        }

        .stat-icon.doctors {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .stat-icon.appointments {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .stat-icon.completed {
            background: linear-gradient(135deg, #22c55e, #16a34a);
        }

        .stat-info h3 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
        }

        .stat-info p {
            color: var(--text-medium);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Tabs */
        .tabs-container {
            background-color: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .tabs-header {
            display: flex;
            border-bottom: 2px solid var(--border);
        }

        .tab-btn {
            flex: 1;
            padding: 1rem 1.5rem;
            background: none;
            border: none;
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-medium);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-family: "Poppins", sans-serif;
            position: relative;
        }

        .tab-btn:hover {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.05);
        }

        .tab-btn.active {
            color: var(--primary);
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 3px 3px 0 0;
        }

        .tab-content {
            display: none;
            padding: 2rem;
        }

        .tab-content.active {
            display: block;
        }

        /* Filter bar */
        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding: 1.2rem;
            background-color: var(--background);
            border-radius: 8px;
            align-items: flex-end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .filter-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-medium);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .filter-control {
            padding: 0.6rem 1rem;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 0.9rem;
            background-color: var(--card-bg);
            color: var(--text-dark);
            transition: var(--transition);
            font-family: "Poppins", sans-serif;
        }

        .filter-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
        }

        .btn {
            padding: 0.6rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            font-family: "Poppins", sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(56, 189, 248, 0.3);
        }

        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
            border-radius: 6px;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
        }

        .btn-outline:hover {
            background-color: var(--primary);
            color: white;
        }

        .btn-warning {
            background-color: var(--warning);
            color: white;
        }

        .btn-warning:hover {
            background-color: #d97706;
        }

        .btn-secondary {
            background-color: var(--secondary);
            color: white;
        }

        .btn-secondary:hover {
            background-color: #059669;
        }

        /* Tables */
        .table-wrapper {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
        }

        .data-table th {
            text-align: left;
            padding: 1rem;
            background-color: var(--background);
            font-weight: 600;
            color: var(--text-dark);
            border-bottom: 2px solid var(--border);
            white-space: nowrap;
        }

        .data-table td {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-dark);
        }

        .data-table tbody tr:hover {
            background-color: rgba(56, 189, 248, 0.04);
        }

        .data-table .empty-row td {
            text-align: center;
            padding: 2.5rem 1rem;
            color: var(--muted);
            font-style: italic;
        }

        /* Status badges */
        .badge {
            display: inline-block;
            padding: 0.25rem 0.7rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: capitalize;
        }

        .badge-scheduled {
            background-color: rgba(56, 189, 248, 0.15);
            color: #0284c7;
        }

        .badge-started {
            background-color: rgba(245, 158, 11, 0.15);
            color: #b45309;
        }

        .badge-completed {
            background-color: rgba(34, 197, 94, 0.15);
            color: #15803d;
        }

        .badge-cancelled {
            background-color: rgba(239, 68, 68, 0.15);
            color: #b91c1c;
        }

        [data-theme="dark"] .badge-scheduled {
            color: #7dd3fc;
        }

        [data-theme="dark"] .badge-started {
            color: #fcd34d;
        }

        [data-theme="dark"] .badge-completed {
            color: #86efac;
        }

        [data-theme="dark"] .badge-cancelled {
            color: #fca5a5;
        }

        /* Pharmacy order badges */
        .badge-pending { background-color: rgba(148,163,184,0.15); color: #64748b; }
        .badge-confirmed { background-color: rgba(56,189,248,0.15); color: #0284c7; }
        .badge-processing { background-color: rgba(245,158,11,0.15); color: #b45309; }
        .badge-shipped { background-color: rgba(139,92,246,0.15); color: #7c3aed; }
        .badge-delivered { background-color: rgba(34,197,94,0.15); color: #15803d; }
        .badge-returned { background-color: rgba(239,68,68,0.15); color: #b91c1c; }
        [data-theme="dark"] .badge-pending { color: #cbd5e1; }
        [data-theme="dark"] .badge-confirmed { color: #7dd3fc; }
        [data-theme="dark"] .badge-processing { color: #fcd34d; }
        [data-theme="dark"] .badge-shipped { color: #c4b5fd; }
        [data-theme="dark"] .badge-delivered { color: #86efac; }
        [data-theme="dark"] .badge-returned { color: #fca5a5; }

        /* Product/stock styles */
        .stock-low { color: var(--error); font-weight: 600; }
        .stock-ok { color: var(--success); font-weight: 600; }
        .badge-active { background-color: rgba(34,197,94,0.15); color: #15803d; }
        .badge-inactive { background-color: rgba(148,163,184,0.15); color: #64748b; }
        [data-theme="dark"] .badge-active { color: #86efac; }
        [data-theme="dark"] .badge-inactive { color: #cbd5e1; }

        .stat-icon.orders { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
        .stat-icon.revenue { background: linear-gradient(135deg, #06b6d4, #0891b2); }
        .stat-icon.low-stock { background: linear-gradient(135deg, #ef4444, #dc2626); }

        .tab-badge { background: var(--error); color: white; font-size: 0.7rem; padding: 0.1rem 0.45rem; border-radius: 10px; margin-left: 0.3rem; font-weight: 700; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        @media (max-width: 576px) { .form-row { grid-template-columns: 1fr; } }

        .btn-danger { background-color: var(--error); color: white; }
        .btn-danger:hover { background-color: #dc2626; }

        .search-bar { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
        .search-bar input, .search-bar select { padding: 0.6rem 1rem; border: 2px solid var(--border); border-radius: 8px; font-size: 0.9rem; background-color: var(--card-bg); color: var(--text-dark); font-family: "Poppins", sans-serif; transition: var(--transition); }
        .search-bar input:focus, .search-bar select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(56,189,248,0.1); }
        .search-bar .spacer { flex: 1; }

        /* Pagination */
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        .pagination button {
            padding: 0.5rem 1.2rem;
            border: 2px solid var(--border);
            border-radius: 8px;
            background-color: var(--card-bg);
            color: var(--text-dark);
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            font-family: "Poppins", sans-serif;
        }

        .pagination button:hover:not(:disabled) {
            border-color: var(--primary);
            color: var(--primary);
        }

        .pagination button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .pagination .page-info {
            color: var(--text-medium);
            font-weight: 500;
            font-size: 0.95rem;
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background-color: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 520px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border);
        }

        .modal-header h3 {
            font-size: 1.3rem;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .modal-close {
            background: none;
            border: none;
            color: var(--text-medium);
            font-size: 1.3rem;
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .modal-close:hover {
            background-color: rgba(239, 68, 68, 0.1);
            color: var(--error);
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-body .form-group {
            margin-bottom: 1.5rem;
        }

        .modal-body .form-group label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .modal-body .form-group label i {
            color: var(--primary);
        }

        .modal-body .form-control {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            background-color: var(--card-bg);
            color: var(--text-dark);
            transition: var(--transition);
            font-family: "Poppins", sans-serif;
        }

        .modal-body .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
        }

        .modal-body select.form-control {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2338bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1.2rem;
            padding-right: 3rem;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            padding: 1.2rem 2rem;
            border-top: 1px solid var(--border);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.6rem 0;
            border-bottom: 1px solid var(--border);
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: var(--text-medium);
            font-weight: 500;
        }

        .info-value {
            color: var(--text-dark);
            font-weight: 600;
        }

        /* Schedule display */
        .schedule-list {
            list-style: none;
            padding: 0;
        }

        .schedule-list li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            margin-bottom: 0.5rem;
            background-color: var(--background);
            transition: var(--transition);
        }

        .schedule-list li:hover {
            background-color: rgba(56, 189, 248, 0.08);
        }

        .schedule-day {
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .schedule-day i {
            color: var(--primary);
        }

        .schedule-time {
            color: var(--text-medium);
            font-size: 0.9rem;
        }

        .no-schedule {
            text-align: center;
            padding: 2rem;
            color: var(--muted);
            font-style: italic;
        }

        /* Simple Footer */
        .simple-footer {
            all: unset;
            display: block;
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            padding: 0.6rem 5%;
            margin-top: auto;
        }

        .simple-footer .footer-content {
            all: unset;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
        }

        .simple-footer .footer-left {
            display: flex;
            align-items: center;
        }

        .simple-footer .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .simple-footer .footer-logo i {
            color: var(--secondary);
            font-size: 1.2rem;
        }

        .simple-footer .footer-center {
            text-align: center;
        }

        .simple-footer .copyright {
            color: var(--text-dark);
            font-size: 0.9rem;
            white-space: nowrap;
        }

        .simple-footer .footer-name {
            color: var(--text-dark);
            font-weight: 600;
            text-decoration: none;
        }

        .simple-footer .footer-name:hover {
            text-decoration: underline;
        }

        .simple-footer .footer-right {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
        }

        .simple-footer .footer-socials a {
            color: var(--text-dark);
            font-size: 1.4rem;
            text-decoration: none;
        }

        .simple-footer .footer-socials a:hover {
            opacity: 0.7;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .mobile-menu {
                display: flex;
            }

            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .tabs-header {
                overflow-x: auto;
            }

            .tab-btn {
                font-size: 0.85rem;
                padding: 0.8rem 1rem;
                white-space: nowrap;
            }

            .tab-content {
                padding: 1.2rem;
            }

            .filter-bar {
                flex-direction: column;
            }

            .filter-group {
                width: 100%;
            }

            .filter-control {
                width: 100%;
            }

            .simple-footer {
                padding: 0.5rem 5%;
            }

            .simple-footer .footer-content {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
            }

            .simple-footer .footer-center {
                text-align: center;
            }

            .simple-footer .footer-right {
                justify-content: center;
            }

            .simple-footer .copyright {
                font-size: 0.8rem;
            }

            .simple-footer .footer-socials a {
                font-size: 1.3rem;
            }
        }

        @media (max-width: 576px) {
            .page-header h1 {
                font-size: 2rem;
            }

            .stats-row {
                grid-template-columns: 1fr;
            }

            .stat-card {
                padding: 1.2rem;
            }

            .navbar {
                padding: 1rem 5%;
            }

            main {
                padding: 2rem 5%;
            }

            .modal {
                margin: 0.5rem;
            }

            .modal-header,
            .modal-body,
            .modal-footer {
                padding-left: 1.2rem;
                padding-right: 1.2rem;
            }
        }

        a,
        a:hover,
        a:focus,
        a:active,
        a:visited {
            text-decoration: none !important;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar">
            <a href="/admin/dashboard" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/admin/dashboard" class="active"><i class="fas fa-chart-line"></i> Dashboard</a>
                <button class="theme-toggle" id="themeToggle"><i class="fas fa-moon"></i></button>
                <a href="/logout" class="nav-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/admin/dashboard" class="active"><i class="fas fa-chart-line"></i> Dashboard</a>
        <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <main>
        <div class="page-header">
            <h1>Admin Dashboard</h1>
            <p>Monitor and manage the TeleHealth platform</p>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon patients">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.totalPatients %></h3>
                    <p>Total Patients</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon doctors">
                    <i class="fas fa-user-md"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.totalDoctors %></h3>
                    <p>Total Doctors</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon appointments">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.activeAppointments %></h3>
                    <p>Active Appointments</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon completed">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.completedToday %></h3>
                    <p>Completed Today</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon orders">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.totalOrders %></h3>
                    <p>Pharmacy Orders</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon revenue">
                    <i class="fas fa-rupee-sign"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.totalRevenue ? '₹' + Number(stats.totalRevenue).toLocaleString('en-IN') : '₹0' %></h3>
                    <p>Total Revenue</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon low-stock">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-info">
                    <h3><%= stats.lowStockCount %></h3>
                    <p>Low Stock Alerts</p>
                </div>
            </div>
        </div>

        <!-- Tabs Section -->
        <div class="tabs-container">
            <div class="tabs-header">
                <button class="tab-btn active" data-tab="appointments">
                    <i class="fas fa-calendar-alt"></i> Appointments
                </button>
                <button class="tab-btn" data-tab="doctors">
                    <i class="fas fa-user-md"></i> Doctors
                </button>
                <button class="tab-btn" data-tab="patients">
                    <i class="fas fa-users"></i> Patients
                </button>
                <button class="tab-btn" data-tab="products">
                    <i class="fas fa-pills"></i> Products
                </button>
                <button class="tab-btn" data-tab="categories">
                    <i class="fas fa-tags"></i> Categories
                </button>
                <button class="tab-btn" data-tab="orders">
                    <i class="fas fa-shopping-bag"></i> Orders
                </button>
                <button class="tab-btn" data-tab="inventory">
                    <i class="fas fa-boxes"></i> Inventory<% if (stats.lowStockCount > 0) { %><span class="tab-badge"><%= stats.lowStockCount %></span><% } %>
                </button>
            </div>

            <!-- Appointments Tab -->
            <div class="tab-content active" id="tab-appointments">
                <div class="filter-bar">
                    <div class="filter-group">
                        <label for="filterStatus">Status</label>
                        <select id="filterStatus" class="filter-control">
                            <option value="">All</option>
                            <option value="scheduled">Scheduled</option>
                            <option value="started">Started</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="filterDoctorId">Doctor ID</label>
                        <input type="text" id="filterDoctorId" class="filter-control" placeholder="e.g. 5">
                    </div>
                    <div class="filter-group">
                        <label for="filterDate">Date</label>
                        <input type="date" id="filterDate" class="filter-control">
                    </div>
                    <div class="filter-group" style="justify-content: flex-end;">
                        <label>&nbsp;</label>
                        <button class="btn btn-primary" id="filterBtn">
                            <i class="fas fa-search"></i> Filter
                        </button>
                    </div>
                </div>

                <div class="table-wrapper">
                    <table class="data-table" id="appointmentsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="appointmentsBody">
                            <tr class="empty-row">
                                <td colspan="7">Loading appointments...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="pagination" id="appointmentsPagination">
                    <button id="apptPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="apptPageInfo">Page 1</span>
                    <button id="apptNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>

            <!-- Doctors Tab -->
            <div class="tab-content" id="tab-doctors">
                <div class="table-wrapper">
                    <table class="data-table" id="doctorsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Specialization</th>
                                <th>Experience</th>
                                <th>Hospital</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="doctorsBody">
                            <tr class="empty-row">
                                <td colspan="6">Loading doctors...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="pagination" id="doctorsPagination">
                    <button id="docPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="docPageInfo">Page 1</span>
                    <button id="docNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>

            <!-- Patients Tab -->
            <div class="tab-content" id="tab-patients">
                <div class="table-wrapper">
                    <table class="data-table" id="patientsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Gender</th>
                                <th>Blood Group</th>
                            </tr>
                        </thead>
                        <tbody id="patientsBody">
                            <tr class="empty-row">
                                <td colspan="5">Loading patients...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="pagination" id="patientsPagination">
                    <button id="patPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="patPageInfo">Page 1</span>
                    <button id="patNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>

            <!-- Products Tab -->
            <div class="tab-content" id="tab-products">
                <div class="search-bar">
                    <input type="text" id="productSearch" placeholder="Search products..." style="flex:1; min-width:180px;">
                    <select id="productCategoryFilter">
                        <option value="">All Categories</option>
                    </select>
                    <button class="btn btn-primary btn-sm" onclick="loadProducts(1)"><i class="fas fa-search"></i> Search</button>
                    <span class="spacer"></span>
                    <button class="btn btn-secondary btn-sm" onclick="openProductModal()"><i class="fas fa-plus"></i> Add Product</button>
                </div>
                <div class="table-wrapper">
                    <table class="data-table" id="productsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>SKU</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productsBody">
                            <tr class="empty-row"><td colspan="8">Click the Products tab to load data</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="pagination" id="productsPagination">
                    <button id="prodPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="prodPageInfo">Page 1</span>
                    <button id="prodNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>

            <!-- Categories Tab -->
            <div class="tab-content" id="tab-categories">
                <div class="search-bar">
                    <span class="spacer"></span>
                    <button class="btn btn-secondary btn-sm" onclick="openCategoryModal()"><i class="fas fa-plus"></i> Add Category</button>
                </div>
                <div class="table-wrapper">
                    <table class="data-table" id="categoriesTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Slug</th>
                                <th>Description</th>
                                <th>Products</th>
                                <th>Sort Order</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesBody">
                            <tr class="empty-row"><td colspan="8">Click the Categories tab to load data</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Orders Tab -->
            <div class="tab-content" id="tab-orders">
                <div class="search-bar">
                    <select id="orderStatusFilter">
                        <option value="">All Statuses</option>
                        <option value="pending">Pending</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="processing">Processing</option>
                        <option value="shipped">Shipped</option>
                        <option value="delivered">Delivered</option>
                        <option value="cancelled">Cancelled</option>
                        <option value="returned">Returned</option>
                    </select>
                    <button class="btn btn-primary btn-sm" onclick="loadOrders(1)"><i class="fas fa-search"></i> Filter</button>
                </div>
                <div class="table-wrapper">
                    <table class="data-table" id="ordersTable">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="ordersBody">
                            <tr class="empty-row"><td colspan="7">Click the Orders tab to load data</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="pagination" id="ordersPagination">
                    <button id="orderPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="orderPageInfo">Page 1</span>
                    <button id="orderNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>

            <!-- Inventory Tab -->
            <div class="tab-content" id="tab-inventory">
                <div class="search-bar">
                    <button class="btn btn-danger btn-sm" onclick="loadLowStock()"><i class="fas fa-exclamation-triangle"></i> Show Low Stock Only</button>
                    <button class="btn btn-primary btn-sm" onclick="loadProducts(1, true)"><i class="fas fa-list"></i> Show All</button>
                </div>
                <div class="table-wrapper">
                    <table class="data-table" id="inventoryTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Stock Qty</th>
                                <th>Low Threshold</th>
                                <th>Last Restocked</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="inventoryBody">
                            <tr class="empty-row"><td colspan="8">Click the Inventory tab to load data</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="pagination" id="inventoryPagination">
                    <button id="invPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="invPageInfo">Page 1</span>
                    <button id="invNextBtn">Next <i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>
    </main>

    <!-- Override Status Modal -->
    <div class="modal-overlay" id="overrideModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-exchange-alt"></i> Override Appointment Status</h3>
                <button class="modal-close" onclick="closeOverrideModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="overrideInfo" style="margin-bottom: 1.5rem;"></div>
                <div class="form-group">
                    <label for="overrideStatus">
                        <i class="fas fa-tag"></i>
                        New Status
                    </label>
                    <select id="overrideStatus" class="form-control">
                        <option value="scheduled">Scheduled</option>
                        <option value="started">Started</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeOverrideModal()">Cancel</button>
                <button class="btn btn-warning" id="confirmOverrideBtn" onclick="submitOverride()">
                    <i class="fas fa-check"></i> Confirm Override
                </button>
            </div>
        </div>
    </div>

    <!-- View Schedule Modal -->
    <div class="modal-overlay" id="scheduleModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-calendar-week"></i> Doctor Schedule</h3>
                <button class="modal-close" onclick="closeScheduleModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="scheduleContent">
                    <p class="no-schedule">Loading schedule...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeScheduleModal()">Close</button>
            </div>
        </div>
    </div>

    <!-- Product Modal (Add/Edit) -->
    <div class="modal-overlay" id="productModal">
        <div class="modal" style="max-width:640px;">
            <div class="modal-header">
                <h3><i class="fas fa-pills"></i> <span id="productModalTitle">Add Product</span></h3>
                <button class="modal-close" onclick="closeProductModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="productEditId">
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-tag"></i> Name *</label>
                        <input type="text" id="prodName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-layer-group"></i> Category *</label>
                        <select id="prodCategoryId" class="form-control"></select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-rupee-sign"></i> Price *</label>
                        <input type="number" step="0.01" id="prodPrice" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-rupee-sign"></i> Compare At Price</label>
                        <input type="number" step="0.01" id="prodComparePrice" class="form-control">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-barcode"></i> SKU *</label>
                        <input type="text" id="prodSku" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-industry"></i> Manufacturer</label>
                        <input type="text" id="prodManufacturer" class="form-control">
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-align-left"></i> Description</label>
                    <textarea id="prodDescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-align-left"></i> Short Description</label>
                    <input type="text" id="prodShortDesc" class="form-control" maxlength="500">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-image"></i> Image URL</label>
                        <input type="text" id="prodImageUrl" class="form-control">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-capsules"></i> Dosage Form</label>
                        <input type="text" id="prodDosageForm" class="form-control" placeholder="e.g. Tablet, Syrup">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-bolt"></i> Strength</label>
                        <input type="text" id="prodStrength" class="form-control" placeholder="e.g. 500mg">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-box"></i> Pack Size</label>
                        <input type="text" id="prodPackSize" class="form-control" placeholder="e.g. 10 tablets">
                    </div>
                </div>
                <div class="form-row" id="prodStockRow">
                    <div class="form-group">
                        <label><i class="fas fa-cubes"></i> Stock Quantity</label>
                        <input type="number" id="prodStockQty" class="form-control" value="0" min="0">
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-exclamation-triangle"></i> Low Stock Threshold</label>
                        <input type="number" id="prodLowThreshold" class="form-control" value="10" min="0">
                    </div>
                </div>
                <div class="form-group">
                    <label style="cursor:pointer;">
                        <input type="checkbox" id="prodPrescription" style="margin-right:0.5rem;">
                        Prescription Required
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeProductModal()">Cancel</button>
                <button class="btn btn-primary" id="saveProductBtn" onclick="saveProduct()"><i class="fas fa-save"></i> Save Product</button>
            </div>
        </div>
    </div>

    <!-- Category Modal (Add/Edit) -->
    <div class="modal-overlay" id="categoryModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-tags"></i> <span id="categoryModalTitle">Add Category</span></h3>
                <button class="modal-close" onclick="closeCategoryModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="categoryEditId">
                <div class="form-group">
                    <label><i class="fas fa-tag"></i> Name *</label>
                    <input type="text" id="catName" class="form-control" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-align-left"></i> Description</label>
                    <textarea id="catDescription" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-image"></i> Image URL</label>
                    <input type="text" id="catImageUrl" class="form-control">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-sort"></i> Sort Order</label>
                    <input type="number" id="catSortOrder" class="form-control" value="0" min="0">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeCategoryModal()">Cancel</button>
                <button class="btn btn-primary" id="saveCategoryBtn" onclick="saveCategory()"><i class="fas fa-save"></i> Save Category</button>
            </div>
        </div>
    </div>

    <!-- Order Status Modal -->
    <div class="modal-overlay" id="orderStatusModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-shipping-fast"></i> Update Order Status</h3>
                <button class="modal-close" onclick="closeOrderStatusModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="orderEditId">
                <div id="orderStatusInfo" style="margin-bottom:1.5rem;"></div>
                <div class="form-group">
                    <label><i class="fas fa-tag"></i> New Status</label>
                    <select id="newOrderStatus" class="form-control">
                        <option value="pending">Pending</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="processing">Processing</option>
                        <option value="shipped">Shipped</option>
                        <option value="delivered">Delivered</option>
                        <option value="cancelled">Cancelled</option>
                        <option value="returned">Returned</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeOrderStatusModal()">Cancel</button>
                <button class="btn btn-warning" id="confirmOrderStatusBtn" onclick="submitOrderStatus()"><i class="fas fa-check"></i> Update Status</button>
            </div>
        </div>
    </div>

    <!-- Stock Update Modal -->
    <div class="modal-overlay" id="stockModal">
        <div class="modal">
            <div class="modal-header">
                <h3><i class="fas fa-cubes"></i> Update Stock</h3>
                <button class="modal-close" onclick="closeStockModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="stockProductId">
                <div id="stockInfo" style="margin-bottom:1.5rem;"></div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-cubes"></i> Stock Quantity *</label>
                        <input type="number" id="stockQty" class="form-control" min="0" required>
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-exclamation-triangle"></i> Low Threshold</label>
                        <input type="number" id="stockThreshold" class="form-control" min="0">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeStockModal()">Cancel</button>
                <button class="btn btn-primary" id="saveStockBtn" onclick="saveStock()"><i class="fas fa-save"></i> Update Stock</button>
            </div>
        </div>
    </div>

