                <div class="pagination" id="doctorsPagination">
                    <button id="docPrevBtn" disabled><i class="fas fa-chevron-left"></i> Previous</button>
                    <span class="page-info" id="docPageInfo">Page 1</span>
                    <button id="docNextBtn">Next <i class="fas fa-chevron-right"></i></button>
