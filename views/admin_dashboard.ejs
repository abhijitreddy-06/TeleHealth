    <script src="/js/shared.js"></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function () {

            // ─── Mobile Menu ───
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeMenuBtn = document.getElementById('closeMenu');
            const mobileMenu = document.getElementById('mobileMenu');

            mobileMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                mobileMenu.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });

            document.addEventListener('click', (e) => {
                if (mobileMenu.classList.contains('active') &&
                    !mobileMenu.contains(e.target) &&
                    e.target !== mobileMenuBtn) {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            // ─── Tab Switching ───
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = btn.getAttribute('data-tab');

                    tabBtns.forEach(b => b.classList.remove('active'));
                    tabContents.forEach(c => c.classList.remove('active'));

                    btn.classList.add('active');
                    document.getElementById('tab-' + target).classList.add('active');

                    // Load data for the selected tab if not yet loaded
                    if (target === 'appointments' && !appointmentsLoaded) loadAppointments(1);
                    if (target === 'doctors' && !doctorsLoaded) loadDoctors(1);
                    if (target === 'patients' && !patientsLoaded) loadPatients(1);
                });
            });

            // ─── State ───
            let currentApptPage = 1;
            let currentDocPage = 1;
            let currentPatPage = 1;
            let appointmentsLoaded = false;
            let doctorsLoaded = false;
            let patientsLoaded = false;
            let currentOverrideId = null;

            // ─── Escape HTML utility ───
            function escapeHtml(str) {
                if (!str) return '';
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            // ─── Status badge helper ───
            function statusBadge(status) {
                const s = (status || '').toLowerCase();
                return '<span class="badge badge-' + escapeHtml(s) + '">' + escapeHtml(s) + '</span>';
            }

            // ─── Load Appointments ───
            async function loadAppointments(page) {
                currentApptPage = page;
                const status = document.getElementById('filterStatus').value;
                const doctorId = document.getElementById('filterDoctorId').value.trim();
                const date = document.getElementById('filterDate').value;

                let url = '/api/admin/appointments?page=' + page;
                if (status) url += '&status=' + encodeURIComponent(status);
                if (doctorId) url += '&doctorId=' + encodeURIComponent(doctorId);
                if (date) url += '&date=' + encodeURIComponent(date);

                const tbody = document.getElementById('appointmentsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load appointments');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Error loading data</td></tr>';
                        return;
                    }

                    const appointments = data.appointments || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(appointments) || appointments.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="7">No appointments found</td></tr>';
                    } else {
                        tbody.innerHTML = appointments.map(function (a) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(a.id)) + '</td>' +
                                '<td>' + escapeHtml(a.patient_name || a.patientName || '-') + '</td>' +
                                '<td>' + escapeHtml(a.doctor_name || a.doctorName || '-') + '</td>' +
                                '<td>' + escapeHtml(a.appointment_date || a.date || '-') + '</td>' +
                                '<td>' + escapeHtml(a.appointment_time || a.time || '-') + '</td>' +
                                '<td>' + statusBadge(a.status) + '</td>' +
                                '<td><button class="btn btn-warning btn-sm" onclick="showOverrideModal(' + a.id + ', \'' + escapeHtml(a.status || '') + '\', \'' + escapeHtml(a.patient_name || a.patientName || '') + '\', \'' + escapeHtml(a.doctor_name || a.doctorName || '') + '\')"><i class="fas fa-edit"></i> Override</button></td>' +
                                '</tr>';
                        }).join('');
                    }

                    // Update pagination
                    document.getElementById('apptPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('apptPrevBtn').disabled = (page <= 1);
                    document.getElementById('apptNextBtn').disabled = (page >= totalPages);
                    appointmentsLoaded = true;
                } catch (err) {
                    console.error('Error loading appointments:', err);
                    Toast.error('Failed to load appointments');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Error loading data</td></tr>';
                }
            }

            // ─── Load Doctors ───
            async function loadDoctors(page) {
                currentDocPage = page;
                const url = '/api/admin/doctors?page=' + page;
                const tbody = document.getElementById('doctorsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load doctors');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Error loading data</td></tr>';
                        return;
                    }

                    const doctors = data.doctors || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(doctors) || doctors.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">No doctors found</td></tr>';
                    } else {
                        tbody.innerHTML = doctors.map(function (d) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(d.id)) + '</td>' +
                                '<td>' + escapeHtml(d.full_name || d.fullName || d.name || '-') + '</td>' +
                                '<td>' + escapeHtml(d.specialization || '-') + '</td>' +
                                '<td>' + escapeHtml(d.experience ? d.experience + ' yrs' : '-') + '</td>' +
                                '<td>' + escapeHtml(d.hospital || d.hospital_name || '-') + '</td>' +
                                '<td><button class="btn btn-secondary btn-sm" onclick="showScheduleModal(' + d.id + ', \'' + escapeHtml(d.full_name || d.fullName || d.name || '') + '\')"><i class="fas fa-calendar-week"></i> View Schedule</button></td>' +
                                '</tr>';
                        }).join('');
                    }

                    document.getElementById('docPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('docPrevBtn').disabled = (page <= 1);
                    document.getElementById('docNextBtn').disabled = (page >= totalPages);
                    doctorsLoaded = true;
                } catch (err) {
                    console.error('Error loading doctors:', err);
                    Toast.error('Failed to load doctors');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Error loading data</td></tr>';
                }
            }

            // ─── Load Patients ───
            async function loadPatients(page) {
                currentPatPage = page;
                const url = '/api/admin/patients?page=' + page;
                const tbody = document.getElementById('patientsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load patients');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Error loading data</td></tr>';
                        return;
                    }

                    const patients = data.patients || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(patients) || patients.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="5">No patients found</td></tr>';
                    } else {
                        tbody.innerHTML = patients.map(function (p) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(p.id)) + '</td>' +
                                '<td>' + escapeHtml(p.full_name || p.fullName || p.name || '-') + '</td>' +
                                '<td>' + escapeHtml(p.phone || '-') + '</td>' +
                                '<td>' + escapeHtml(p.gender || '-') + '</td>' +
                                '<td>' + escapeHtml(p.blood_group || p.bloodGroup || '-') + '</td>' +
                                '</tr>';
                        }).join('');
                    }

                    document.getElementById('patPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('patPrevBtn').disabled = (page <= 1);
                    document.getElementById('patNextBtn').disabled = (page >= totalPages);
                    patientsLoaded = true;
                } catch (err) {
                    console.error('Error loading patients:', err);
                    Toast.error('Failed to load patients');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Error loading data</td></tr>';
                }
            }

            // ─── Override Modal ───
            window.showOverrideModal = function (appointmentId, currentStatus, patientName, doctorName) {
                currentOverrideId = appointmentId;
                const infoHtml =
                    '<div class="info-row"><span class="info-label">Appointment ID</span><span class="info-value">#' + escapeHtml(String(appointmentId)) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Patient</span><span class="info-value">' + escapeHtml(patientName) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Doctor</span><span class="info-value">' + escapeHtml(doctorName) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Current Status</span><span class="info-value">' + statusBadge(currentStatus) + '</span></div>';
                document.getElementById('overrideInfo').innerHTML = infoHtml;
                document.getElementById('overrideStatus').value = currentStatus || 'scheduled';
                document.getElementById('overrideModal').classList.add('active');
            };

            window.closeOverrideModal = function () {
                document.getElementById('overrideModal').classList.remove('active');
                currentOverrideId = null;
            };

            window.submitOverride = async function () {
                if (!currentOverrideId) return;

                const newStatus = document.getElementById('overrideStatus').value;
                const btn = document.getElementById('confirmOverrideBtn');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

                try {
                    const res = await fetch('/api/admin/appointments/' + currentOverrideId + '/override', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ status: newStatus })
                    });

                    const data = await res.json();

                    if (res.ok && (data.success !== false)) {
                        Toast.success('Appointment status updated to "' + newStatus + '"');
                        closeOverrideModal();
                        loadAppointments(currentApptPage);
                    } else {
                        Toast.error(data.error || data.message || 'Failed to override status');
                    }
                } catch (err) {
                    console.error('Override error:', err);
                    Toast.error('Failed to update appointment status');
                }

                btn.disabled = false;
                btn.innerHTML = originalText;
            };

            // ─── Schedule Modal ───
            window.showScheduleModal = async function (doctorId, doctorName) {
                const content = document.getElementById('scheduleContent');
                content.innerHTML = '<p class="no-schedule">Loading schedule...</p>';
                document.getElementById('scheduleModal').classList.add('active');

                // Update modal title with doctor name
                document.querySelector('#scheduleModal .modal-header h3').innerHTML =
                    '<i class="fas fa-calendar-week"></i> Schedule - ' + escapeHtml(doctorName);

                try {
                    const res = await fetch('/api/admin/doctors/' + doctorId + '/schedule', {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        content.innerHTML = '<p class="no-schedule">Failed to load schedule</p>';
                        return;
                    }

                    const schedule = data.schedule || data.data || data || [];
                    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

                    if (Array.isArray(schedule) && schedule.length > 0) {
                        let listHtml = '<ul class="schedule-list">';
                        schedule.forEach(function (slot) {
                            const dayName = slot.day_name || slot.dayName || dayNames[slot.day_of_week] || slot.day || 'Unknown';
                            const startTime = slot.start_time || slot.startTime || '';
                            const endTime = slot.end_time || slot.endTime || '';
                            const timeRange = startTime && endTime ? startTime + ' - ' + endTime : 'N/A';
                            listHtml += '<li>' +
                                '<span class="schedule-day"><i class="fas fa-clock"></i> ' + escapeHtml(dayName) + '</span>' +
                                '<span class="schedule-time">' + escapeHtml(timeRange) + '</span>' +
                                '</li>';
                        });
                        listHtml += '</ul>';
                        content.innerHTML = listHtml;
                    } else if (typeof schedule === 'object' && !Array.isArray(schedule)) {
                        // Handle object-format schedule (keyed by day)
                        let listHtml = '<ul class="schedule-list">';
                        let hasEntries = false;
                        dayNames.forEach(function (dayName) {
                            const dayKey = dayName.toLowerCase();
                            if (schedule[dayKey] || schedule[dayName]) {
                                hasEntries = true;
                                const slot = schedule[dayKey] || schedule[dayName];
                                const timeRange = typeof slot === 'string' ? slot : (slot.start + ' - ' + slot.end);
                                listHtml += '<li>' +
                                    '<span class="schedule-day"><i class="fas fa-clock"></i> ' + escapeHtml(dayName) + '</span>' +
                                    '<span class="schedule-time">' + escapeHtml(timeRange) + '</span>' +
                                    '</li>';
                            }
                        });
                        listHtml += '</ul>';
                        content.innerHTML = hasEntries ? listHtml : '<p class="no-schedule">No schedule available for this doctor</p>';
                    } else {
                        content.innerHTML = '<p class="no-schedule">No schedule available for this doctor</p>';
                    }
                } catch (err) {
                    console.error('Schedule error:', err);
                    content.innerHTML = '<p class="no-schedule">Failed to load schedule</p>';
                }
            };

            window.closeScheduleModal = function () {
                document.getElementById('scheduleModal').classList.remove('active');
            };

            // ─── Close modals on overlay click ───
            document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) {
                        overlay.classList.remove('active');
                        currentOverrideId = null;
                    }
                });
            });

            // ─── Close modals on Escape ───
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeOverrideModal();
                    closeScheduleModal();
                }
            });

            // ─── Filter Button ───
            document.getElementById('filterBtn').addEventListener('click', function () {
                loadAppointments(1);
            });

            // ─── Pagination Buttons ───
            document.getElementById('apptPrevBtn').addEventListener('click', function () {
                if (currentApptPage > 1) loadAppointments(currentApptPage - 1);
            });

            document.getElementById('apptNextBtn').addEventListener('click', function () {
                loadAppointments(currentApptPage + 1);
            });

            document.getElementById('docPrevBtn').addEventListener('click', function () {
                if (currentDocPage > 1) loadDoctors(currentDocPage - 1);
            });

            document.getElementById('docNextBtn').addEventListener('click', function () {
                loadDoctors(currentDocPage + 1);
            });

            document.getElementById('patPrevBtn').addEventListener('click', function () {
                if (currentPatPage > 1) loadPatients(currentPatPage - 1);
            });

            document.getElementById('patNextBtn').addEventListener('click', function () {
                loadPatients(currentPatPage + 1);
            });

            // ─── Initial Load ───
            loadAppointments(1);
        });
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>

</html>
