                    <span>TeleHealth</span>
                </a>
            </div>
            <div class="footer-center">
                <span class="copyright">
                    &copy; 2026 Built by
                    <a href="https://abhijitreddy-portfolio.netlify.app/" target="_blank" rel="noopener"
                        class="footer-name">
                        Abhijit Reddy
                    </a>.
                </span>
            </div>
            <div class="footer-right footer-socials">
                <a href="https://www.linkedin.com/in/abhijitreddy75" target="_blank" aria-label="LinkedIn">
                    <i class="fab fa-linkedin"></i>
                </a>
                <a href="https://github.com/abhijitreddy-06" target="_blank" aria-label="GitHub">
                    <i class="fab fa-github"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="/js/shared.js"></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function () {

            // ─── Mobile Menu ───
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeMenuBtn = document.getElementById('closeMenu');
            const mobileMenu = document.getElementById('mobileMenu');

            mobileMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                mobileMenu.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });

            document.addEventListener('click', (e) => {
                if (mobileMenu.classList.contains('active') &&
                    !mobileMenu.contains(e.target) &&
                    e.target !== mobileMenuBtn) {
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            // ─── Tab Switching ───
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = btn.getAttribute('data-tab');

                    tabBtns.forEach(b => b.classList.remove('active'));
                    tabContents.forEach(c => c.classList.remove('active'));

                    btn.classList.add('active');
                    document.getElementById('tab-' + target).classList.add('active');

                    // Load data for the selected tab if not yet loaded
                    if (target === 'appointments' && !appointmentsLoaded) loadAppointments(1);
                    if (target === 'doctors' && !doctorsLoaded) loadDoctors(1);
                    if (target === 'patients' && !patientsLoaded) loadPatients(1);
                    if (target === 'products' && !productsLoaded) { loadCategoriesForFilter(); loadProducts(1); }
                    if (target === 'categories' && !categoriesLoaded) loadCategories();
                    if (target === 'orders' && !ordersLoaded) loadOrders(1);
                    if (target === 'inventory' && !inventoryLoaded) loadProducts(1, true);
                });
            });

            // ─── State ───
            let currentApptPage = 1;
            let currentDocPage = 1;
            let currentPatPage = 1;
            let currentProdPage = 1;
            let currentOrderPage = 1;
            let currentInvPage = 1;
            let appointmentsLoaded = false;
            let doctorsLoaded = false;
            let patientsLoaded = false;
            let productsLoaded = false;
            let categoriesLoaded = false;
            let ordersLoaded = false;
            let inventoryLoaded = false;
            let currentOverrideId = null;
            let categoriesCache = [];

            // ─── Escape HTML utility ───
            function escapeHtml(str) {
                if (!str) return '';
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            // ─── Status badge helper ───
            function statusBadge(status) {
                const s = (status || '').toLowerCase();
                return '<span class="badge badge-' + escapeHtml(s) + '">' + escapeHtml(s) + '</span>';
            }

            // ─── Load Appointments ───
            async function loadAppointments(page) {
                currentApptPage = page;
                const status = document.getElementById('filterStatus').value;
                const doctorId = document.getElementById('filterDoctorId').value.trim();
                const date = document.getElementById('filterDate').value;

                let url = '/api/admin/appointments?page=' + page;
                if (status) url += '&status=' + encodeURIComponent(status);
                if (doctorId) url += '&doctorId=' + encodeURIComponent(doctorId);
                if (date) url += '&date=' + encodeURIComponent(date);

                const tbody = document.getElementById('appointmentsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load appointments');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Error loading data</td></tr>';
                        return;
                    }

                    const appointments = data.appointments || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(appointments) || appointments.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="7">No appointments found</td></tr>';
                    } else {
                        tbody.innerHTML = appointments.map(function (a) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(a.id)) + '</td>' +
                                '<td>' + escapeHtml(a.patient_name || a.patientName || '-') + '</td>' +
                                '<td>' + escapeHtml(a.doctor_name || a.doctorName || '-') + '</td>' +
                                '<td>' + escapeHtml(a.appointment_date || a.date || '-') + '</td>' +
                                '<td>' + escapeHtml(a.appointment_time || a.time || '-') + '</td>' +
                                '<td>' + statusBadge(a.status) + '</td>' +
                                '<td><button class="btn btn-warning btn-sm" onclick="showOverrideModal(' + a.id + ', \'' + escapeHtml(a.status || '') + '\', \'' + escapeHtml(a.patient_name || a.patientName || '') + '\', \'' + escapeHtml(a.doctor_name || a.doctorName || '') + '\')"><i class="fas fa-edit"></i> Override</button></td>' +
                                '</tr>';
                        }).join('');
                    }

                    // Update pagination
                    document.getElementById('apptPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('apptPrevBtn').disabled = (page <= 1);
                    document.getElementById('apptNextBtn').disabled = (page >= totalPages);
                    appointmentsLoaded = true;
                } catch (err) {
                    console.error('Error loading appointments:', err);
                    Toast.error('Failed to load appointments');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Error loading data</td></tr>';
                }
            }

            // ─── Load Doctors ───
            async function loadDoctors(page) {
                currentDocPage = page;
                const url = '/api/admin/doctors?page=' + page;
                const tbody = document.getElementById('doctorsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load doctors');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Error loading data</td></tr>';
                        return;
                    }

                    const doctors = data.doctors || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(doctors) || doctors.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">No doctors found</td></tr>';
                    } else {
                        tbody.innerHTML = doctors.map(function (d) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(d.id)) + '</td>' +
                                '<td>' + escapeHtml(d.full_name || d.fullName || d.name || '-') + '</td>' +
                                '<td>' + escapeHtml(d.specialization || '-') + '</td>' +
                                '<td>' + escapeHtml(d.experience ? d.experience + ' yrs' : '-') + '</td>' +
                                '<td>' + escapeHtml(d.hospital || d.hospital_name || '-') + '</td>' +
                                '<td><button class="btn btn-secondary btn-sm" onclick="showScheduleModal(' + d.id + ', \'' + escapeHtml(d.full_name || d.fullName || d.name || '') + '\')"><i class="fas fa-calendar-week"></i> View Schedule</button></td>' +
                                '</tr>';
                        }).join('');
                    }

                    document.getElementById('docPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('docPrevBtn').disabled = (page <= 1);
                    document.getElementById('docNextBtn').disabled = (page >= totalPages);
                    doctorsLoaded = true;
                } catch (err) {
                    console.error('Error loading doctors:', err);
                    Toast.error('Failed to load doctors');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="6">Error loading data</td></tr>';
                }
            }

            // ─── Load Patients ───
            async function loadPatients(page) {
                currentPatPage = page;
                const url = '/api/admin/patients?page=' + page;
                const tbody = document.getElementById('patientsBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Loading...</td></tr>';

                try {
                    const res = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || 'Failed to load patients');
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Error loading data</td></tr>';
                        return;
                    }

                    const patients = data.patients || data.data || data || [];
                    const totalPages = data.totalPages || data.pages || 1;

                    if (!Array.isArray(patients) || patients.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="5">No patients found</td></tr>';
                    } else {
                        tbody.innerHTML = patients.map(function (p) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(p.id)) + '</td>' +
                                '<td>' + escapeHtml(p.full_name || p.fullName || p.name || '-') + '</td>' +
                                '<td>' + escapeHtml(p.phone || '-') + '</td>' +
                                '<td>' + escapeHtml(p.gender || '-') + '</td>' +
                                '<td>' + escapeHtml(p.blood_group || p.bloodGroup || '-') + '</td>' +
                                '</tr>';
                        }).join('');
                    }

                    document.getElementById('patPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('patPrevBtn').disabled = (page <= 1);
                    document.getElementById('patNextBtn').disabled = (page >= totalPages);
                    patientsLoaded = true;
                } catch (err) {
                    console.error('Error loading patients:', err);
                    Toast.error('Failed to load patients');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="5">Error loading data</td></tr>';
                }
            }

            // ─── Override Modal ───
            window.showOverrideModal = function (appointmentId, currentStatus, patientName, doctorName) {
                currentOverrideId = appointmentId;
                const infoHtml =
                    '<div class="info-row"><span class="info-label">Appointment ID</span><span class="info-value">#' + escapeHtml(String(appointmentId)) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Patient</span><span class="info-value">' + escapeHtml(patientName) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Doctor</span><span class="info-value">' + escapeHtml(doctorName) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Current Status</span><span class="info-value">' + statusBadge(currentStatus) + '</span></div>';
                document.getElementById('overrideInfo').innerHTML = infoHtml;
                document.getElementById('overrideStatus').value = currentStatus || 'scheduled';
                document.getElementById('overrideModal').classList.add('active');
            };

            window.closeOverrideModal = function () {
                document.getElementById('overrideModal').classList.remove('active');
                currentOverrideId = null;
            };

            window.submitOverride = async function () {
                if (!currentOverrideId) return;

                const newStatus = document.getElementById('overrideStatus').value;
                const btn = document.getElementById('confirmOverrideBtn');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

                try {
                    const res = await fetch('/api/admin/appointments/' + currentOverrideId + '/override', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({ status: newStatus })
                    });

                    const data = await res.json();

                    if (res.ok && (data.success !== false)) {
                        Toast.success('Appointment status updated to "' + newStatus + '"');
                        closeOverrideModal();
                        loadAppointments(currentApptPage);
                    } else {
                        Toast.error(data.error || data.message || 'Failed to override status');
                    }
                } catch (err) {
                    console.error('Override error:', err);
                    Toast.error('Failed to update appointment status');
                }

                btn.disabled = false;
                btn.innerHTML = originalText;
            };

            // ─── Schedule Modal ───
            window.showScheduleModal = async function (doctorId, doctorName) {
                const content = document.getElementById('scheduleContent');
                content.innerHTML = '<p class="no-schedule">Loading schedule...</p>';
                document.getElementById('scheduleModal').classList.add('active');

                // Update modal title with doctor name
                document.querySelector('#scheduleModal .modal-header h3').innerHTML =
                    '<i class="fas fa-calendar-week"></i> Schedule - ' + escapeHtml(doctorName);

                try {
                    const res = await fetch('/api/admin/doctors/' + doctorId + '/schedule', {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!res.ok) {
                        content.innerHTML = '<p class="no-schedule">Failed to load schedule</p>';
                        return;
                    }

                    const schedule = data.schedule || data.data || data || [];
                    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

                    if (Array.isArray(schedule) && schedule.length > 0) {
                        let listHtml = '<ul class="schedule-list">';
                        schedule.forEach(function (slot) {
                            const dayName = slot.day_name || slot.dayName || dayNames[slot.day_of_week] || slot.day || 'Unknown';
                            const startTime = slot.start_time || slot.startTime || '';
                            const endTime = slot.end_time || slot.endTime || '';
                            const timeRange = startTime && endTime ? startTime + ' - ' + endTime : 'N/A';
                            listHtml += '<li>' +
                                '<span class="schedule-day"><i class="fas fa-clock"></i> ' + escapeHtml(dayName) + '</span>' +
                                '<span class="schedule-time">' + escapeHtml(timeRange) + '</span>' +
                                '</li>';
                        });
                        listHtml += '</ul>';
                        content.innerHTML = listHtml;
                    } else if (typeof schedule === 'object' && !Array.isArray(schedule)) {
                        // Handle object-format schedule (keyed by day)
                        let listHtml = '<ul class="schedule-list">';
                        let hasEntries = false;
                        dayNames.forEach(function (dayName) {
                            const dayKey = dayName.toLowerCase();
                            if (schedule[dayKey] || schedule[dayName]) {
                                hasEntries = true;
                                const slot = schedule[dayKey] || schedule[dayName];
                                const timeRange = typeof slot === 'string' ? slot : (slot.start + ' - ' + slot.end);
                                listHtml += '<li>' +
                                    '<span class="schedule-day"><i class="fas fa-clock"></i> ' + escapeHtml(dayName) + '</span>' +
                                    '<span class="schedule-time">' + escapeHtml(timeRange) + '</span>' +
                                    '</li>';
                            }
                        });
                        listHtml += '</ul>';
                        content.innerHTML = hasEntries ? listHtml : '<p class="no-schedule">No schedule available for this doctor</p>';
                    } else {
                        content.innerHTML = '<p class="no-schedule">No schedule available for this doctor</p>';
                    }
                } catch (err) {
                    console.error('Schedule error:', err);
                    content.innerHTML = '<p class="no-schedule">Failed to load schedule</p>';
                }
            };

            window.closeScheduleModal = function () {
                document.getElementById('scheduleModal').classList.remove('active');
            };

            // ─── Close modals on overlay click ───
            document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) {
                        overlay.classList.remove('active');
                        currentOverrideId = null;
                    }
                });
            });

            // ─── Close modals on Escape ───
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeOverrideModal();
                    closeScheduleModal();
                    closeProductModal();
                    closeCategoryModal();
                    closeOrderStatusModal();
                    closeStockModal();
                }
            });

            // ─── Filter Button ───
            document.getElementById('filterBtn').addEventListener('click', function () {
                loadAppointments(1);
            });

            // ─── Pagination Buttons ───
            document.getElementById('apptPrevBtn').addEventListener('click', function () {
                if (currentApptPage > 1) loadAppointments(currentApptPage - 1);
            });

            document.getElementById('apptNextBtn').addEventListener('click', function () {
                loadAppointments(currentApptPage + 1);
            });

            document.getElementById('docPrevBtn').addEventListener('click', function () {
                if (currentDocPage > 1) loadDoctors(currentDocPage - 1);
            });

            document.getElementById('docNextBtn').addEventListener('click', function () {
                loadDoctors(currentDocPage + 1);
            });

            document.getElementById('patPrevBtn').addEventListener('click', function () {
                if (currentPatPage > 1) loadPatients(currentPatPage - 1);
            });

            document.getElementById('patNextBtn').addEventListener('click', function () {
                loadPatients(currentPatPage + 1);
            });

            document.getElementById('prodPrevBtn').addEventListener('click', function () {
                if (currentProdPage > 1) loadProducts(currentProdPage - 1);
            });
            document.getElementById('prodNextBtn').addEventListener('click', function () {
                loadProducts(currentProdPage + 1);
            });
            document.getElementById('orderPrevBtn').addEventListener('click', function () {
                if (currentOrderPage > 1) loadOrders(currentOrderPage - 1);
            });
            document.getElementById('orderNextBtn').addEventListener('click', function () {
                loadOrders(currentOrderPage + 1);
            });
            document.getElementById('invPrevBtn').addEventListener('click', function () {
                if (currentInvPage > 1) loadProducts(currentInvPage - 1, true);
            });
            document.getElementById('invNextBtn').addEventListener('click', function () {
                loadProducts(currentInvPage + 1, true);
            });

            // ════════════════════════════════════════════
            // PHARMACY – Products
            // ════════════════════════════════════════════

            async function loadCategoriesForFilter() {
                try {
                    const res = await fetch('/api/admin/pharmacy/categories', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    const data = await res.json();
                    categoriesCache = data.data || data || [];
                    const sel = document.getElementById('productCategoryFilter');
                    const prodSel = document.getElementById('prodCategoryId');
                    sel.innerHTML = '<option value="">All Categories</option>';
                    prodSel.innerHTML = '';
                    categoriesCache.forEach(function (c) {
                        sel.innerHTML += '<option value="' + c.id + '">' + escapeHtml(c.name) + '</option>';
                        prodSel.innerHTML += '<option value="' + c.id + '">' + escapeHtml(c.name) + '</option>';
                    });
                } catch (e) { console.error('Load categories filter:', e); }
            }

            async function loadProducts(page, forInventory) {
                if (forInventory) {
                    currentInvPage = page;
                } else {
                    currentProdPage = page;
                }
                const search = document.getElementById('productSearch') ? document.getElementById('productSearch').value.trim() : '';
                const categoryId = document.getElementById('productCategoryFilter') ? document.getElementById('productCategoryFilter').value : '';

                let url = '/api/admin/pharmacy/products?page=' + page;
                if (search) url += '&search=' + encodeURIComponent(search);
                if (categoryId) url += '&categoryId=' + encodeURIComponent(categoryId);

                const tbody = forInventory ? document.getElementById('inventoryBody') : document.getElementById('productsBody');
                const cols = forInventory ? 8 : 8;
                tbody.innerHTML = '<tr class="empty-row"><td colspan="' + cols + '">Loading...</td></tr>';

                try {
                    const res = await fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    const json = await res.json();
                    if (!res.ok) { Toast.error(json.error || 'Failed to load products'); return; }

                    const result = json.data || json;
                    const products = result.products || result || [];
                    const total = result.total || 0;
                    const totalPages = Math.max(1, Math.ceil(total / 20));

                    if (!Array.isArray(products) || products.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="' + cols + '">No products found</td></tr>';
                    } else if (forInventory) {
                        tbody.innerHTML = products.map(function (p) {
                            var qty = p.stock_quantity != null ? p.stock_quantity : '-';
                            var thresh = p.low_stock_threshold != null ? p.low_stock_threshold : '-';
                            var isLow = (p.stock_quantity != null && p.low_stock_threshold != null && p.stock_quantity <= p.low_stock_threshold);
                            var stockClass = isLow ? 'stock-low' : 'stock-ok';
                            return '<tr>' +
                                '<td>' + escapeHtml(String(p.id)) + '</td>' +
                                '<td>' + escapeHtml(p.name || '-') + '</td>' +
                                '<td>' + escapeHtml(p.sku || '-') + '</td>' +
                                '<td class="' + stockClass + '">' + qty + '</td>' +
                                '<td>' + thresh + '</td>' +
                                '<td>' + (p.last_restocked ? escapeHtml(new Date(p.last_restocked).toLocaleDateString()) : '-') + '</td>' +
                                '<td>' + (isLow ? '<span class="badge badge-cancelled">Low</span>' : '<span class="badge badge-completed">OK</span>') + '</td>' +
                                '<td><button class="btn btn-primary btn-sm" onclick="openStockModal(' + p.id + ', \'' + escapeHtml(p.name || '') + '\', ' + (p.stock_quantity || 0) + ', ' + (p.low_stock_threshold || 10) + ')"><i class="fas fa-edit"></i> Update</button></td>' +
                                '</tr>';
                        }).join('');
                        inventoryLoaded = true;
                    } else {
                        tbody.innerHTML = products.map(function (p) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(p.id)) + '</td>' +
                                '<td>' + escapeHtml(p.name || '-') + '</td>' +
                                '<td>' + escapeHtml(p.category_name || '-') + '</td>' +
                                '<td>₹' + escapeHtml(String(p.price || 0)) + '</td>' +
                                '<td>' + escapeHtml(p.sku || '-') + '</td>' +
                                '<td>' + (p.stock_quantity != null ? p.stock_quantity : '-') + '</td>' +
                                '<td>' + (p.is_active !== false ? '<span class="badge badge-active">Active</span>' : '<span class="badge badge-inactive">Inactive</span>') + '</td>' +
                                '<td>' +
                                    '<button class="btn btn-primary btn-sm" onclick="openEditProduct(' + p.id + ')" style="margin-right:0.3rem;"><i class="fas fa-edit"></i></button>' +
                                    '<button class="btn btn-danger btn-sm" onclick="deleteProduct(' + p.id + ', \'' + escapeHtml(p.name || '') + '\')"><i class="fas fa-trash"></i></button>' +
                                '</td>' +
                                '</tr>';
                        }).join('');
                        productsLoaded = true;
                    }

                    // Update pagination
                    if (forInventory) {
                        document.getElementById('invPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                        document.getElementById('invPrevBtn').disabled = (page <= 1);
                        document.getElementById('invNextBtn').disabled = (page >= totalPages);
                    } else {
                        document.getElementById('prodPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                        document.getElementById('prodPrevBtn').disabled = (page <= 1);
                        document.getElementById('prodNextBtn').disabled = (page >= totalPages);
                    }
                } catch (err) {
                    console.error('Load products error:', err);
                    Toast.error('Failed to load products');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="' + cols + '">Error loading data</td></tr>';
                }
            }

            window.openProductModal = function (editData) {
                document.getElementById('productEditId').value = '';
                document.getElementById('productModalTitle').textContent = 'Add Product';
                document.getElementById('prodName').value = '';
                document.getElementById('prodPrice').value = '';
                document.getElementById('prodComparePrice').value = '';
                document.getElementById('prodSku').value = '';
                document.getElementById('prodManufacturer').value = '';
                document.getElementById('prodDescription').value = '';
                document.getElementById('prodShortDesc').value = '';
                document.getElementById('prodImageUrl').value = '';
                document.getElementById('prodDosageForm').value = '';
                document.getElementById('prodStrength').value = '';
                document.getElementById('prodPackSize').value = '';
                document.getElementById('prodStockQty').value = '0';
                document.getElementById('prodLowThreshold').value = '10';
                document.getElementById('prodPrescription').checked = false;
                document.getElementById('prodStockRow').style.display = '';

                if (editData) {
                    document.getElementById('productEditId').value = editData.id;
                    document.getElementById('productModalTitle').textContent = 'Edit Product';
                    document.getElementById('prodName').value = editData.name || '';
                    if (editData.category_id) document.getElementById('prodCategoryId').value = editData.category_id;
                    document.getElementById('prodPrice').value = editData.price || '';
                    document.getElementById('prodComparePrice').value = editData.compare_at_price || '';
                    document.getElementById('prodSku').value = editData.sku || '';
                    document.getElementById('prodManufacturer').value = editData.manufacturer || '';
                    document.getElementById('prodDescription').value = editData.description || '';
                    document.getElementById('prodShortDesc').value = editData.short_description || '';
                    document.getElementById('prodImageUrl').value = editData.image_url || '';
                    document.getElementById('prodDosageForm').value = editData.dosage_form || '';
                    document.getElementById('prodStrength').value = editData.strength || '';
                    document.getElementById('prodPackSize').value = editData.pack_size || '';
                    document.getElementById('prodPrescription').checked = editData.prescription_required || false;
                    document.getElementById('prodStockRow').style.display = 'none';
                }
                document.getElementById('productModal').classList.add('active');
            };

            window.openEditProduct = async function (id) {
                try {
                    await loadCategoriesForFilter();
                    const res = await fetch('/api/admin/pharmacy/products?page=1&search=', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    const json = await res.json();
                    const result = json.data || json;
                    const products = result.products || result || [];
                    const product = products.find(function(p) { return p.id === id; });
                    if (product) {
                        openProductModal(product);
                    } else {
                        Toast.error('Product not found');
                    }
                } catch (e) {
                    console.error('Load product for edit:', e);
                    Toast.error('Failed to load product');
                }
            };

            window.closeProductModal = function () {
                document.getElementById('productModal').classList.remove('active');
            };

            window.saveProduct = async function () {
                var editId = document.getElementById('productEditId').value;
                var isEdit = !!editId;
                var body = {
                    name: document.getElementById('prodName').value.trim(),
                    categoryId: parseInt(document.getElementById('prodCategoryId').value),
                    price: parseFloat(document.getElementById('prodPrice').value),
                    sku: document.getElementById('prodSku').value.trim(),
                    description: document.getElementById('prodDescription').value.trim(),
                    shortDescription: document.getElementById('prodShortDesc').value.trim(),
                    imageUrl: document.getElementById('prodImageUrl').value.trim(),
                    manufacturer: document.getElementById('prodManufacturer').value.trim(),
                    dosageForm: document.getElementById('prodDosageForm').value.trim(),
                    strength: document.getElementById('prodStrength').value.trim(),
                    packSize: document.getElementById('prodPackSize').value.trim(),
                    prescriptionRequired: document.getElementById('prodPrescription').checked
                };

                var cmp = document.getElementById('prodComparePrice').value;
                if (cmp) body.compareAtPrice = parseFloat(cmp);

                if (!isEdit) {
                    body.stockQuantity = parseInt(document.getElementById('prodStockQty').value) || 0;
                    body.lowStockThreshold = parseInt(document.getElementById('prodLowThreshold').value) || 10;
                }

                if (!body.name || !body.sku || !body.price) {
                    Toast.error('Name, SKU and Price are required');
                    return;
                }

                var btn = document.getElementById('saveProductBtn');
                var orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

                try {
                    var url = isEdit ? '/api/admin/pharmacy/products/' + editId : '/api/admin/pharmacy/products';
                    var method = isEdit ? 'PUT' : 'POST';
                    var res = await fetch(url, {
                        method: method,
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success(isEdit ? 'Product updated' : 'Product created');
                        closeProductModal();
                        loadProducts(currentProdPage);
                    } else {
                        Toast.error(data.error || 'Failed to save product');
                    }
                } catch (e) {
                    console.error('Save product error:', e);
                    Toast.error('Failed to save product');
                }
                btn.disabled = false;
                btn.innerHTML = orig;
            };

            window.deleteProduct = async function (id, name) {
                if (!confirm('Deactivate product "' + name + '"?')) return;
                try {
                    var res = await fetch('/api/admin/pharmacy/products/' + id, {
                        method: 'DELETE',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success('Product deactivated');
                        loadProducts(currentProdPage);
                    } else {
                        Toast.error(data.error || 'Failed to deactivate product');
                    }
                } catch (e) {
                    console.error('Delete product error:', e);
                    Toast.error('Failed to deactivate product');
                }
            };

            // ════════════════════════════════════════════
            // PHARMACY – Categories
            // ════════════════════════════════════════════

            async function loadCategories() {
                var tbody = document.getElementById('categoriesBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="8">Loading...</td></tr>';

                try {
                    var res = await fetch('/api/admin/pharmacy/categories', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    var json = await res.json();
                    if (!res.ok) { Toast.error(json.error || 'Failed to load categories'); return; }

                    var categories = json.data || json || [];
                    categoriesCache = categories;

                    if (!Array.isArray(categories) || categories.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="8">No categories found</td></tr>';
                    } else {
                        tbody.innerHTML = categories.map(function (c) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(c.id)) + '</td>' +
                                '<td>' + escapeHtml(c.name || '-') + '</td>' +
                                '<td>' + escapeHtml(c.slug || '-') + '</td>' +
                                '<td>' + escapeHtml((c.description || '-').substring(0, 60)) + '</td>' +
                                '<td>' + (c.product_count || 0) + '</td>' +
                                '<td>' + (c.sort_order || 0) + '</td>' +
                                '<td>' + (c.is_active !== false ? '<span class="badge badge-active">Active</span>' : '<span class="badge badge-inactive">Inactive</span>') + '</td>' +
                                '<td>' +
                                    '<button class="btn btn-primary btn-sm" onclick=\'openCategoryModal(' + JSON.stringify({id:c.id,name:c.name||'',description:c.description||'',image_url:c.image_url||'',sort_order:c.sort_order||0}) + ')\' style="margin-right:0.3rem;"><i class="fas fa-edit"></i></button>' +
                                    '<button class="btn btn-danger btn-sm" onclick="deleteCategory(' + c.id + ', \'' + escapeHtml(c.name || '') + '\')"><i class="fas fa-trash"></i></button>' +
                                '</td>' +
                                '</tr>';
                        }).join('');
                    }
                    categoriesLoaded = true;
                } catch (e) {
                    console.error('Load categories error:', e);
                    Toast.error('Failed to load categories');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="8">Error loading data</td></tr>';
                }
            }

            window.openCategoryModal = function (editData) {
                document.getElementById('categoryEditId').value = '';
                document.getElementById('categoryModalTitle').textContent = 'Add Category';
                document.getElementById('catName').value = '';
                document.getElementById('catDescription').value = '';
                document.getElementById('catImageUrl').value = '';
                document.getElementById('catSortOrder').value = '0';

                if (editData && editData.id) {
                    document.getElementById('categoryEditId').value = editData.id;
                    document.getElementById('categoryModalTitle').textContent = 'Edit Category';
                    document.getElementById('catName').value = editData.name || '';
                    document.getElementById('catDescription').value = editData.description || '';
                    document.getElementById('catImageUrl').value = editData.image_url || '';
                    document.getElementById('catSortOrder').value = editData.sort_order || 0;
                }
                document.getElementById('categoryModal').classList.add('active');
            };

            window.closeCategoryModal = function () {
                document.getElementById('categoryModal').classList.remove('active');
            };

            window.saveCategory = async function () {
                var editId = document.getElementById('categoryEditId').value;
                var isEdit = !!editId;
                var body = {
                    name: document.getElementById('catName').value.trim(),
                    description: document.getElementById('catDescription').value.trim(),
                    imageUrl: document.getElementById('catImageUrl').value.trim(),
                    sortOrder: parseInt(document.getElementById('catSortOrder').value) || 0
                };

                if (!body.name) { Toast.error('Category name is required'); return; }

                var btn = document.getElementById('saveCategoryBtn');
                var orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

                try {
                    var url = isEdit ? '/api/admin/pharmacy/categories/' + editId : '/api/admin/pharmacy/categories';
                    var method = isEdit ? 'PUT' : 'POST';
                    var res = await fetch(url, {
                        method: method,
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success(isEdit ? 'Category updated' : 'Category created');
                        closeCategoryModal();
                        loadCategories();
                        loadCategoriesForFilter();
                    } else {
                        Toast.error(data.error || 'Failed to save category');
                    }
                } catch (e) {
                    console.error('Save category error:', e);
                    Toast.error('Failed to save category');
                }
                btn.disabled = false;
                btn.innerHTML = orig;
            };

            window.deleteCategory = async function (id, name) {
                if (!confirm('Deactivate category "' + name + '"?')) return;
                try {
                    var res = await fetch('/api/admin/pharmacy/categories/' + id, {
                        method: 'DELETE',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success('Category deactivated');
                        loadCategories();
                    } else {
                        Toast.error(data.error || 'Failed to deactivate category');
                    }
                } catch (e) {
                    console.error('Delete category error:', e);
                    Toast.error('Failed to deactivate category');
                }
            };

            // ════════════════════════════════════════════
            // PHARMACY – Orders
            // ════════════════════════════════════════════

            async function loadOrders(page) {
                currentOrderPage = page;
                var status = document.getElementById('orderStatusFilter') ? document.getElementById('orderStatusFilter').value : '';
                var url = '/api/admin/pharmacy/orders?page=' + page;
                if (status) url += '&status=' + encodeURIComponent(status);

                var tbody = document.getElementById('ordersBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Loading...</td></tr>';

                try {
                    var res = await fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    var json = await res.json();
                    if (!res.ok) { Toast.error(json.error || 'Failed to load orders'); return; }

                    var result = json.data || json;
                    var orders = result.orders || result || [];
                    var total = result.total || 0;
                    var totalPages = Math.max(1, Math.ceil(total / 20));

                    if (!Array.isArray(orders) || orders.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="7">No orders found</td></tr>';
                    } else {
                        tbody.innerHTML = orders.map(function (o) {
                            return '<tr>' +
                                '<td>#' + escapeHtml(String(o.id)) + '</td>' +
                                '<td>' + escapeHtml(o.customer_name || '-') + '</td>' +
                                '<td>' + (o.item_count || '-') + '</td>' +
                                '<td>₹' + escapeHtml(String(o.total_amount || 0)) + '</td>' +
                                '<td>' + statusBadge(o.status) + '</td>' +
                                '<td>' + (o.created_at ? escapeHtml(new Date(o.created_at).toLocaleDateString()) : '-') + '</td>' +
                                '<td><button class="btn btn-warning btn-sm" onclick="openOrderStatusModal(' + o.id + ', \'' + escapeHtml(o.status || '') + '\', \'' + escapeHtml(o.customer_name || '') + '\', \'₹' + escapeHtml(String(o.total_amount || 0)) + '\')"><i class="fas fa-edit"></i> Status</button></td>' +
                                '</tr>';
                        }).join('');
                    }

                    document.getElementById('orderPageInfo').textContent = 'Page ' + page + ' of ' + totalPages;
                    document.getElementById('orderPrevBtn').disabled = (page <= 1);
                    document.getElementById('orderNextBtn').disabled = (page >= totalPages);
                    ordersLoaded = true;
                } catch (e) {
                    console.error('Load orders error:', e);
                    Toast.error('Failed to load orders');
                    tbody.innerHTML = '<tr class="empty-row"><td colspan="7">Error loading data</td></tr>';
                }
            }

            window.openOrderStatusModal = function (id, currentStatus, customer, total) {
                document.getElementById('orderEditId').value = id;
                document.getElementById('orderStatusInfo').innerHTML =
                    '<div class="info-row"><span class="info-label">Order</span><span class="info-value">#' + escapeHtml(String(id)) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Customer</span><span class="info-value">' + escapeHtml(customer) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Total</span><span class="info-value">' + escapeHtml(total) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Current Status</span><span class="info-value">' + statusBadge(currentStatus) + '</span></div>';
                document.getElementById('newOrderStatus').value = currentStatus || 'pending';
                document.getElementById('orderStatusModal').classList.add('active');
            };

            window.closeOrderStatusModal = function () {
                document.getElementById('orderStatusModal').classList.remove('active');
            };

            window.submitOrderStatus = async function () {
                var id = document.getElementById('orderEditId').value;
                if (!id) return;
                var newStatus = document.getElementById('newOrderStatus').value;
                var btn = document.getElementById('confirmOrderStatusBtn');
                var orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

                try {
                    var res = await fetch('/api/admin/pharmacy/orders/' + id + '/status', {
                        method: 'PUT',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ status: newStatus })
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success('Order status updated to "' + newStatus + '"');
                        closeOrderStatusModal();
                        loadOrders(currentOrderPage);
                    } else {
                        Toast.error(data.error || 'Failed to update order status');
                    }
                } catch (e) {
                    console.error('Update order status error:', e);
                    Toast.error('Failed to update order status');
                }
                btn.disabled = false;
                btn.innerHTML = orig;
            };

            // ════════════════════════════════════════════
            // PHARMACY – Inventory / Stock
            // ════════════════════════════════════════════

            window.loadLowStock = async function () {
                var tbody = document.getElementById('inventoryBody');
                tbody.innerHTML = '<tr class="empty-row"><td colspan="8">Loading low stock items...</td></tr>';

                try {
                    var res = await fetch('/api/admin/pharmacy/low-stock', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                    var json = await res.json();
                    if (!res.ok) { Toast.error(json.error || 'Failed to load'); return; }

                    var products = json.data || json || [];
                    if (!Array.isArray(products) || products.length === 0) {
                        tbody.innerHTML = '<tr class="empty-row"><td colspan="8">No low stock items</td></tr>';
                    } else {
                        tbody.innerHTML = products.map(function (p) {
                            return '<tr>' +
                                '<td>' + escapeHtml(String(p.id)) + '</td>' +
                                '<td>' + escapeHtml(p.name || '-') + '</td>' +
                                '<td>' + escapeHtml(p.sku || '-') + '</td>' +
                                '<td class="stock-low">' + (p.stock_quantity != null ? p.stock_quantity : '-') + '</td>' +
                                '<td>' + (p.low_stock_threshold != null ? p.low_stock_threshold : '-') + '</td>' +
                                '<td>' + (p.last_restocked ? escapeHtml(new Date(p.last_restocked).toLocaleDateString()) : '-') + '</td>' +
                                '<td><span class="badge badge-cancelled">Low</span></td>' +
                                '<td><button class="btn btn-primary btn-sm" onclick="openStockModal(' + p.id + ', \'' + escapeHtml(p.name || '') + '\', ' + (p.stock_quantity || 0) + ', ' + (p.low_stock_threshold || 10) + ')"><i class="fas fa-edit"></i> Update</button></td>' +
                                '</tr>';
                        }).join('');
                    }
                    document.getElementById('inventoryPagination').style.display = 'none';
                } catch (e) {
                    console.error('Load low stock error:', e);
                    Toast.error('Failed to load low stock items');
                }
            };

            window.openStockModal = function (productId, productName, currentQty, currentThreshold) {
                document.getElementById('stockProductId').value = productId;
                document.getElementById('stockInfo').innerHTML =
                    '<div class="info-row"><span class="info-label">Product</span><span class="info-value">' + escapeHtml(productName) + '</span></div>' +
                    '<div class="info-row"><span class="info-label">Current Stock</span><span class="info-value">' + currentQty + '</span></div>';
                document.getElementById('stockQty').value = currentQty;
                document.getElementById('stockThreshold').value = currentThreshold;
                document.getElementById('stockModal').classList.add('active');
            };

            window.closeStockModal = function () {
                document.getElementById('stockModal').classList.remove('active');
            };

            window.saveStock = async function () {
                var productId = document.getElementById('stockProductId').value;
                if (!productId) return;
                var body = {
                    stockQuantity: parseInt(document.getElementById('stockQty').value) || 0
                };
                var thresh = document.getElementById('stockThreshold').value;
                if (thresh !== '') body.lowStockThreshold = parseInt(thresh);

                var btn = document.getElementById('saveStockBtn');
                var orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

                try {
                    var res = await fetch('/api/admin/pharmacy/products/' + productId + '/stock', {
                        method: 'PUT',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    var data = await res.json();
                    if (res.ok && data.success !== false) {
                        Toast.success('Stock updated');
                        closeStockModal();
                        // Reload inventory tab if visible
                        if (document.getElementById('tab-inventory').classList.contains('active')) {
                            loadProducts(currentInvPage, true);
                        }
                        if (document.getElementById('tab-products').classList.contains('active')) {
                            loadProducts(currentProdPage);
                        }
                    } else {
                        Toast.error(data.error || 'Failed to update stock');
                    }
                } catch (e) {
                    console.error('Update stock error:', e);
                    Toast.error('Failed to update stock');
                }
                btn.disabled = false;
                btn.innerHTML = orig;
            };

            // ─── Initial Load ───
            loadAppointments(1);
        });
    </script>
    <script>window.history.replaceState(null, document.title, window.location.href);</script>
</body>

</html>
