<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Video Dashboard | TeleHealth</title>
<!-- Add to your EJS head section -->
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <!-- Fonts & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <style>
        :root {
            /* Color Variables */
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #10b981;
            --background: #f9fafb;
            --dark-bg: #1e293b;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-light: #f1f5f9;
            --text-medium: #475569;
            --border: #e2e8f0;
            --error: #ef4444;
            --warning: #f59e0b;
            --info: #60a5fa;
            --disabled: #9ca3af;
            --footer-bg: #1e293b;
            --success: #22c55e;
            --muted: #94a3b8;

            /* Other Variables */
            --transition: all 0.3s ease;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
        }

        /* Dark Theme Variables */
        [data-theme="dark"] {
            --background: #1e293b;
            --card-bg: #334155;
            --text-dark: #f1f5f9;
            --text-light: #0f172a;
            --text-medium: #cbd5e1;
            --border: #475569;
            --footer-bg: #0f172a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", "Inter", "Roboto", sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text-dark);
            transition: var(--transition);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
        }

        /* ================= HEADER & NAVIGATION ================= */
        header {
            background-color: var(--card-bg);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo i {
            color: var(--secondary);
            font-size: 1.5rem;
        }

        .logo-text {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 800;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-links a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        .nav-links a:hover:not(.active) {
            color: var(--primary);
            background-color: rgba(56, 189, 248, 0.1);
        }

        .theme-toggle {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dark);
            font-size: 1.2rem;
            padding: 0.5rem;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .theme-toggle:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* Mobile Controls */
        .mobile-controls {
            display: none;
            align-items: center;
            gap: 0.5rem;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
        }

        .mobile-menu-btn:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        /* Mobile Menu */
        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background-color: var(--card-bg);
            z-index: 1000;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-menu.active {
            right: 0;
        }

        .close-menu {
            align-self: flex-end;
            background: none;
            border: none;
            color: var(--text-dark);
            font-size: 1.5rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-menu:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: var(--text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            background-color: rgba(56, 189, 248, 0.1);
            color: var(--primary);
        }

        /* ================= MAIN CONTENT ================= */
        main {
            flex: 1;
            padding: 3rem 5%;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .dashboard-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--text-dark);
        }

        .dashboard-header p {
            color: var(--text-medium);
            max-width: 700px;
            margin: 0 auto;
            font-size: 1.1rem;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .appointment-card {
            background-color: var(--card-bg);
            padding: 2.5rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .appointment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .appointment-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .appointment-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .appointment-header h2 {
            font-size: 1.8rem;
            color: var(--text-dark);
        }

        .info-group {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 0;
            border-bottom: 1px solid var(--border);
        }

        .info-label {
            color: var(--text-medium);
            font-weight: 500;
        }

        .info-value {
            color: var(--text-dark);
            font-weight: 600;
        }

        .status-container {
            margin-top: 1rem;
            padding: 1.5rem;
            border-radius: 8px;
            background-color: rgba(56, 189, 248, 0.1);
            border-left: 4px solid var(--primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .status {
            font-weight: 600;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .status i {
            font-size: 1.2rem;
        }

        .status.waiting {
            color: var(--warning);
        }

        .status.ready {
            color: var(--success);
        }

        .status.completed {
            color: var(--muted);
        }

        .btn {
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-primary {
            background-color: var(--primary);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(56, 189, 248, 0.3);
        }

        .btn-primary:disabled {
            background-color: var(--disabled);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-success {
            background-color: var(--success);
            color: white;
        }

        .btn-success:hover {
            background-color: #16a34a;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(34, 197, 94, 0.3);
        }

        .btn-completed {
            background-color: var(--muted);
            color: white;
            cursor: not-allowed;
        }

        /* Instructions Card */
        .instructions-card {
            background-color: var(--card-bg);
            padding: 2.5rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .instructions-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .instructions-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .instructions-list {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        .instruction-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .instruction-number {
            min-width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .instruction-content h4 {
            margin-bottom: 0.3rem;
            color: var(--text-dark);
        }

        .instruction-content p {
            color: var(--text-medium);
            font-size: 0.95rem;
        }

        /* Simple Footer */
        .simple-footer {
            background-color: var(--card-bg);
            border-top: 1px solid var(--border);
            padding: 1.5rem 5%;
            text-align: center;
            margin-top: auto;
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .footer-left {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .footer-logo i {
            color: var(--secondary);
            font-size: 1.2rem;
        }

        .copyright {
            color: var(--text-medium);
            font-size: 0.9rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .footer-links a {
            color: var(--text-medium);
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        .footer-links .separator {
            color: var(--border);
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .mobile-controls {
                display: flex;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .mobile-menu {
                display: flex;
            }

            .simple-footer {
                padding: 1rem 5%;
            }

            .footer-content {
                flex-direction: column;
                gap: 0.8rem;
                text-align: center;
            }

            .footer-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 1rem;
            }

            .separator {
                display: none;
            }

            .footer-links a {
                font-size: 0.85rem;
            }

            .appointment-card,
            .instructions-card {
                padding: 2rem;
            }

            .status-container {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }
        }

        @media (max-width: 576px) {
            .dashboard-header h1 {
                font-size: 2rem;
            }

            .appointment-header h2 {
                font-size: 1.5rem;
            }

            .navbar {
                padding: 1rem 5%;
            }

            main {
                padding: 2rem 5%;
            }

            .info-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.3rem;
            }
        }

        /* Dark theme adjustments */
        [data-theme="dark"] footer {
            color: var(--text-dark);
        }

        [data-theme="dark"] .footer-links a,
        [data-theme="dark"] .footer-bottom-links a {
            color: var(--text-dark);
            opacity: 0.9;
        }

        [data-theme="dark"] .status-container {
            background-color: rgba(56, 189, 248, 0.2);
        }
    /* ===============================
   STRICT SIMPLE FOOTER OVERRIDE
   =============================== */

.simple-footer {
    all: unset;
    display: block;
    background-color: var(--card-bg);
    border-top: 1px solid var(--border);
    padding: 0.6rem 5%;          /* compact height */
    margin-top: auto;
}

/* GRID LAYOUT – DESKTOP SAFE */
.simple-footer .footer-content {
    all: unset;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
}

/* LEFT */
.simple-footer .footer-left {
    display: flex;
    align-items: center;
}

.simple-footer .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
}

.simple-footer .footer-logo i {
    color: var(--secondary);
    font-size: 1.2rem;
}

/* CENTER TEXT */
.simple-footer .footer-center {
    text-align: center;
}

.simple-footer .copyright {
    color: var(--text-dark);
    font-size: 0.9rem;
    white-space: nowrap;
}

.simple-footer .footer-name {
    color: var(--text-dark);
    font-weight: 600;
    text-decoration: none;
}

.simple-footer .footer-name:hover {
    text-decoration: underline;
}

/* RIGHT ICONS */
.simple-footer .footer-right {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
}

.simple-footer .footer-socials a {
    color: var(--text-dark);
    font-size: 1.4rem; /* BIG icons */
    text-decoration: none;
}

.simple-footer .footer-socials a:hover {
    opacity: 0.7;
}

/* ===============================
   MOBILE – SMALLER HEIGHT
   =============================== */
@media (max-width: 768px) {
    .simple-footer {
        padding: 0.5rem 5%;     /* reduced height */
    }

    .simple-footer .footer-content {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .simple-footer .footer-center {
        text-align: center;
    }

    .simple-footer .footer-right {
        justify-content: center;
    }

    .simple-footer .copyright {
        font-size: 0.8rem;
    }

    .simple-footer .footer-socials a {
        font-size: 1.3rem;
    }
}
a,
a:hover,
a:focus,
a:active,
a:visited {
    text-decoration: none !important;
}
</style>
</head>

<body>
    <!-- ================= HEADER & NAVIGATION ================= -->
    <header>
        <nav class="navbar">
            <a href="/doc_home" class="logo">
                <i class="fas fa-heartbeat"></i>
                <span class="logo-text">TeleHealth</span>
            </a>

            <div class="nav-links">
                <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
                <a href="/doc_video_dashboard" class="active"><i class="fas fa-video"></i> Video</a>
                <a href="/doc_profile"><i class="fas fa-user-md"></i> Profile</a>

                <button class="theme-toggle" id="themeToggle">
                    <i class="fas fa-moon"></i>
                </button>
            </div>

            <div class="mobile-controls">
                <button class="theme-toggle" id="mobileThemeToggle">
                    <i class="fas fa-moon"></i>
                </button>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>
    </header>

    <!-- ================= MOBILE MENU ================= -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/doc_home"><i class="fas fa-home"></i> Home</a>
        <a href="/doc_video_dashboard" class="active"><i class="fas fa-video"></i> Video</a>
        <a href="/doc_profile"><i class="fas fa-user-md"></i> Profile</a>
    </div>

    <!-- ================= MAIN CONTENT ================= -->
    <main>
        <div class="dashboard-header">
            <h1>Video Consultation Dashboard</h1>
            <p>Start and manage your virtual consultations with patients</p>
        </div>

        <div class="dashboard-grid">
            <!-- Appointment Details Card -->
            <div class="appointment-card">
                <div class="appointment-header">
                    <div class="appointment-icon">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <h2>Upcoming Appointment</h2>
                </div>

                <% if (hasAppointment && appointment) { %>
                    <div class="info-group">
                        <div class="info-item">
                            <span class="info-label">Patient:</span>
                            <span class="info-value">
                                <%= appointment.user_name || 'Patient' %>
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Date:</span>
                            <span class="info-value">
                                <%= appointment.appointment_date || '—' %>
                            </span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Time:</span>
                            <span class="info-value">
                                <%= appointment.appointment_time || '—' %>
                            </span>
                        </div>
                    </div>

                    <div class="status-container">
                        <p class="status">
                            <% if (appointment.status==='scheduled' ) { %>
                                <i class="fas fa-clock"></i>
                                Appointment is scheduled and ready to start
                                <% } else if (appointment.status==='started' && appointment.room_id) { %>
                                    <i class="fas fa-video"></i>
                                    Call is in progress
                                    <% } else if (appointment.status==='completed' ) { %>
                                        <i class="fas fa-check-circle"></i>
                                        Appointment completed
                                        <% } else { %>
                                            <i class="fas fa-exclamation-triangle"></i>
                                            Unknown status
                                            <% } %>
                        </p>

                        <% if (appointment.status==='scheduled' ) { %>
                            <button class="btn btn-primary" onclick="startCall('<%= appointment.id %>')">
                                <i class="fas fa-video"></i> Start Call
                            </button>
                            <% } else if (appointment.status==='started' && appointment.room_id) { %>
                            <button class="btn btn-success join-call-btn" data-room-id="<%= appointment.room_id %>">
                                    <i class="fas fa-sign-in-alt"></i> Join Call
                                </button>
                                <% } else if (appointment.status==='completed' ) { %>
                                    <button class="btn btn-completed" disabled>
                                        <i class="fas fa-check-circle"></i> Completed
                                    </button>
                                    <% } else { %>
<button class="btn btn-primary start-call-btn" data-appointment-id="<%= appointment.id %>">
    <i class="fas fa-video"></i> Start Call
</button>
                                        <% } %>
                    </div>
                    <% } else { %>
                        <div class="info-group">
                            <div class="info-item">
                                <span class="info-label">Patient:</span>
                                <span class="info-value">—</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Date:</span>
                                <span class="info-value">—</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Time:</span>
                                <span class="info-value">—</span>
                            </div>
                        </div>

                        <div class="status-container">
                            <p class="status completed">
                                <i class="fas fa-calendar-times"></i>
                                No upcoming appointments.
                            </p>
                            <button class="btn btn-completed" disabled>
                                <i class="fas fa-calendar-times"></i> No Appointments
                            </button>
                        </div>
                        <% } %>
            </div>

            <!-- Instructions Card -->
            <div class="instructions-card">
                <h3><i class="fas fa-info-circle"></i> Consultation Guidelines</h3>
                <div class="instructions-list">
                    <div class="instruction-item">
                        <div class="instruction-number">1</div>
                        <div class="instruction-content">
                            <h4>Prepare Consultation Room</h4>
                            <p>Ensure your environment is professional, quiet, and well-lit</p>
                        </div>
                    </div>
                    <div class="instruction-item">
                        <div class="instruction-number">2</div>
                        <div class="instruction-content">
                            <h4>Check Equipment</h4>
                            <p>Test your camera, microphone, and internet connection before starting</p>
                        </div>
                    </div>
                    <div class="instruction-item">
                        <div class="instruction-number">3</div>
                        <div class="instruction-content">
                            <h4>Review Patient Information</h4>
                            <p>Have the patient's medical history and notes ready</p>
                        </div>
                    </div>
                    <div class="instruction-item">
                        <div class="instruction-number">4</div>
                        <div class="instruction-content">
                            <h4>End Consultation Properly</h4>
                            <p>Summarize the consultation and provide follow-up instructions</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

