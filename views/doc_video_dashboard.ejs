    <script src="/js/shared.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
            document.addEventListener('DOMContentLoaded', function () {
            // --- Real-time Dashboard via Socket.IO /dashboard namespace ---
            let dashboardSocket = null;
            let fallbackTimer = null;

            function initDashboardSocket() {
                try {
                    dashboardSocket = io('/dashboard', {
                        reconnection: true,
                        reconnectionAttempts: 5,
                        reconnectionDelay: 2000,
                        timeout: 15000
                    });

                    dashboardSocket.on('connect', () => {
                        console.log('Dashboard socket connected:', dashboardSocket.id);
                        if (fallbackTimer) {
                            clearTimeout(fallbackTimer);
                            fallbackTimer = null;
                        }
                    });

                    dashboardSocket.on('appointment-updated', (data) => {
                        console.log('Appointment updated:', data);
                        handleDashboardUpdate(data);
                    });

                    dashboardSocket.on('connect_error', (error) => {
                        console.error('Dashboard socket error:', error);
                        startFallbackReload();
                    });

                    dashboardSocket.on('disconnect', (reason) => {
                        console.log('Dashboard socket disconnected:', reason);
                        if (reason !== 'io client disconnect') {
                            startFallbackReload();
                        }
                    });

                    // Fallback: if socket doesn't connect within 15s, use polling
                    fallbackTimer = setTimeout(() => {
                        if (!dashboardSocket || !dashboardSocket.connected) {
                            console.log('Dashboard socket fallback: using polling');
                            startFallbackReload();
                        }
                    }, 15000);

                } catch (error) {
                    console.error('Failed to initialize dashboard socket:', error);
                    startFallbackReload();
                }
            }

            function handleDashboardUpdate(data) {
                if (data.status === 'booked') {
                    // New appointment booked - add to appointments list
                    const scrollList = document.querySelector('.appointments-scroll-list');
                    const noApptMsg = document.querySelector('.no-appointments-message');
                    if (noApptMsg) noApptMsg.remove();

                    if (scrollList) {
                        const item = document.createElement('div');
                        item.className = 'appointment-list-item';
                        item.innerHTML = `
                            <div class="appt-patient-info">
                                <i class="fas fa-user-circle"></i>
                                <span class="appt-patient-name">New Patient</span>
                            </div>
                            <div class="appt-details">
                                <span class="appt-date"><i class="fas fa-calendar-day"></i> ${data.appointmentDate || ''}</span>
                                <span class="appt-time"><i class="fas fa-clock"></i> ${data.appointmentTime || ''}</span>
                            </div>
                            <div class="appt-status">
                                <span class="status-badge scheduled"><i class="fas fa-hourglass-half"></i> Scheduled</span>
                            </div>
                        `;
                        scrollList.appendChild(item);
                    }

                    if (typeof Toast !== 'undefined' && Toast.success) {
                        Toast.success('A new appointment has been booked!', 'New Appointment');
                    }

                    // Reload to get full patient details and update upcoming card
                    setTimeout(() => window.location.reload(), 2000);

                } else if (data.status === 'started' && data.roomId) {
                    // Update the upcoming card to show "Join Call" instead of "Start Call"
                    const statusContainer = document.querySelector('.status-container');
                    if (statusContainer) {
                        const statusP = statusContainer.querySelector('.status');
                        if (statusP) {
                            statusP.innerHTML = '<i class="fas fa-video"></i> Call is in progress';
                        }
                        const startBtn = document.getElementById('startCallBtn');
                        const timerEl = document.getElementById('startCallTimer');
                        if (startBtn) {
                            const joinBtn = document.createElement('button');
                            joinBtn.className = 'btn btn-success join-call-btn';
                            joinBtn.setAttribute('data-room-id', data.roomId);
                            joinBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Join Call';
                            joinBtn.onclick = () => { window.location.href = '/doc_video/' + data.roomId; };
                            startBtn.parentNode.replaceChild(joinBtn, startBtn);
                            if (timerEl) timerEl.remove();
                        }
                    }

                    // Update appointment list item status badge
                    const listItems = document.querySelectorAll('.appointment-list-item');
                    listItems.forEach(item => {
                        const badge = item.querySelector('.status-badge');
                        if (badge && badge.classList.contains('scheduled')) {
                            badge.className = 'status-badge active';
                            badge.innerHTML = '<i class="fas fa-video"></i> In Progress';
                            item.classList.add('in-progress');
                        }
                    });

                } else if (data.status === 'cancelled') {
                    if (typeof Toast !== 'undefined' && Toast.info) {
                        Toast.info('An appointment has been cancelled.', 'Cancelled');
                    }
                    // Reload to refresh the full list
                    setTimeout(() => window.location.reload(), 1500);

                } else if (data.status === 'completed') {
                    if (typeof Toast !== 'undefined' && Toast.success) {
                        Toast.success('Appointment completed.', 'Completed');
                    }
                    setTimeout(() => window.location.reload(), 1500);
                }
            }

            function startFallbackReload() {
                // Fallback to page reload every 30s if socket fails
                if (!window._fallbackInterval) {
                    window._fallbackInterval = setInterval(() => {
                        window.location.reload();
                    }, 30000);
                }
            }

            initDashboardSocket();
        });
</script>
    <script>
            // Start Call Function
            async function startCall(appointmentId) {
                if (!appointmentId) return;

                try {
                    const res = await fetch(`/appointments/${appointmentId}/start`, {
                        method: "POST",
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await res.json();

                    if (!res.ok) {
                        Toast.error(data.error || "Unable to start call");
                        return;
                    }
                    window.location.href = `/doc_video/${data.roomId}`;
                } catch (err) {
                    Toast.error("Server error while starting call");
                }
            }

            function joinCall(roomId) {
                if (!roomId) return;
                window.location.href = `/doc_video/${roomId}`;
            }

            // --- Start Call Time Window Check ---
            (function checkStartCallWindow() {
                const btn = document.getElementById('startCallBtn');
                const timerEl = document.getElementById('startCallTimer');
                if (!btn || !timerEl) return;

                const apptDate = btn.getAttribute('data-appt-date');
                const apptTime = btn.getAttribute('data-appt-time');
                if (!apptDate || !apptTime) return;

                const BEFORE_MINUTES = 10;
                const parsedDate = new Date(apptDate);
                const [h, m] = apptTime.split(':').map(Number);
                parsedDate.setHours(h, m, 0, 0);
                const apptDateTime = parsedDate;
                const windowStart = new Date(apptDateTime.getTime() - BEFORE_MINUTES * 60 * 1000);

                function update() {
                    const now = new Date();
                    if (now >= windowStart) {
                        btn.disabled = false;
                        timerEl.innerHTML = '<i class="fas fa-check-circle" style="color: var(--success);"></i> Ready to start';
                    } else {
                        btn.disabled = true;
                        const diff = windowStart - now;
                        const hours = Math.floor(diff / (1000 * 60 * 60));
                        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                        const secs = Math.floor((diff % (1000 * 60)) / 1000);
                        if (hours > 0) {
                            timerEl.innerHTML = `<i class="fas fa-clock" style="color: var(--warning);"></i> Call can start in ${hours}h ${mins}m`;
                        } else {
                            timerEl.innerHTML = `<i class="fas fa-clock" style="color: var(--warning);"></i> Call can start in ${mins}m ${secs}s`;
                        }
                    }
                }
                update();
                setInterval(update, 1000);
            })();

        // Cancel Appointment Modal for Doctors
            function showCancelModal(appointmentId) {
            const existingModal = document.getElementById('cancelModal');
            if (existingModal) existingModal.remove();

            const modal = document.createElement('div');
            modal.id = 'cancelModal';
            modal.className = 'modal-overlay active';
            modal.innerHTML = `
                <div class="modal" style="max-width: 450px;">
                    <div class="modal-header">
                        <h2><i class="fas fa-calendar-times" style="color: var(--error)"></i> Cancel Appointment</h2>
                        <button class="modal-close" onclick="closeCancelModal()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p style="margin-bottom: 1rem;">Are you sure you want to cancel this appointment?</p>
                        <div class="form-group">
                            <label for="cancelReason"><i class="fas fa-comment-alt"></i> Reason (optional)</label>
                            <textarea id="cancelReason" class="form-control" rows="3" placeholder="Please provide a reason for cancellation..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" onclick="closeCancelModal()">Keep Appointment</button>
                        <button class="btn btn-danger" onclick="cancelAppointment('${appointmentId}')">Cancel Appointment</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            document.body.style.overflow = 'hidden';
        }

            function closeCancelModal() {
            const modal = document.getElementById('cancelModal');
            if (modal) {
                modal.remove();
                document.body.style.overflow = '';
            }
        }

            async function cancelAppointment(appointmentId) {
            const reason = document.getElementById('cancelReason').value;
            const confirmBtn = document.querySelector('#cancelModal .btn-danger');
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Cancelling...';

            try {
                const response = await fetch(`/api/appointments/${appointmentId}/cancel`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ reason })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    closeCancelModal();
                    Toast.success('The appointment has been cancelled.', 'Appointment Cancelled');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    Toast.error(result.error || 'Failed to cancel appointment');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = 'Cancel Appointment';
                }
            } catch (error) {
                console.error('Cancel error:', error);
                Toast.error('Unable to cancel appointment. Please try again.');
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = 'Cancel Appointment';
            }
        }

            document.addEventListener('click', function (event) {
                const startBtn = event.target.closest('.start-call-btn');
                if (startBtn) {
                    event.preventDefault();
                    const appointmentId = startBtn.getAttribute('data-appointment-id');
                startCall(appointmentId);
                return;
            }
            const joinBtn = event.target.closest('.join-call-btn');
            if (joinBtn) {
                event.preventDefault();
                const roomId = joinBtn.getAttribute('data-room-id');
                joinCall(roomId);
                return;
            }
        });
                </script>
<script>window.history.replaceState(null, document.title, window.location.href);</script>
